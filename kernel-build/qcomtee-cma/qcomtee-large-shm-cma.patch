--- a/drivers/tee/qcomtee/shm.c
+++ b/drivers/tee/qcomtee/shm.c
@@ -5,6 +5,8 @@
 
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
+#include <linux/cma.h>
+#include <linux/dma-map-ops.h>
 #include <linux/firmware/qcom/qcom_tzmem.h>
 #include <linux/mm.h>
 
@@ -114,15 +116,95 @@
 	return 0;
 }
 
+/*
+ * Large messages (for example a signed fingerprint TA) need physically
+ * contiguous storage for the non-FF-A QTEE transport. The buddy allocator
+ * used by tee_dyn_shm_alloc_helper() is unreliable at high orders after
+ * fragmentation. Keep small messages unchanged; use the movable CMA area
+ * for page-aligned allocations of at least 1 MiB. Never substitute a
+ * virtually contiguous scatterlist for a physical range passed to QTEE.
+ */
+#define QCOMTEE_CMA_MIN_SIZE SZ_1M
+
 static int pool_op_alloc(struct tee_shm_pool *pool, struct tee_shm *shm,
 			 size_t size, size_t align)
 {
-	return tee_dyn_shm_alloc_helper(shm, size, align, qcomtee_shm_register);
+	struct cma *cma;
+	struct page *first;
+	struct page **pages;
+	size_t num_pages;
+	unsigned int i;
+	int ret;
+
+	size = PAGE_ALIGN(size);
+	if (!size)
+		return -EINVAL;
+
+	if (!IS_ENABLED(CONFIG_DMA_CMA) || size < QCOMTEE_CMA_MIN_SIZE)
+		return tee_dyn_shm_alloc_helper(shm, size, align,
+						qcomtee_shm_register);
+
+	cma = dev_get_cma_area(&shm->ctx->teedev->dev);
+	if (!cma)
+		return -ENOMEM;
+
+	num_pages = size >> PAGE_SHIFT;
+	first = cma_alloc(cma, num_pages, 0, false);
+	if (!first)
+		return -ENOMEM;
+
+	pages = kzalloc_objs(*pages, num_pages);
+	if (!pages) {
+		ret = -ENOMEM;
+		goto err_release;
+	}
+	for (i = 0; i < num_pages; i++)
+		pages[i] = first + i;
+
+	shm->kaddr = page_address(first);
+	shm->paddr = page_to_phys(first);
+	shm->size = size;
+	shm->pages = pages;
+	shm->num_pages = num_pages;
+	memzero_explicit(shm->kaddr, size);
+
+	ret = qcomtee_shm_register(shm->ctx, shm, pages, num_pages,
+				   (unsigned long)shm->kaddr);
+	if (ret)
+		goto err_pages;
+
+	return 0;
+
+err_pages:
+	shm->kaddr = NULL;
+	shm->paddr = 0;
+	shm->size = 0;
+	shm->pages = NULL;
+	shm->num_pages = 0;
+	kfree(pages);
+err_release:
+	WARN_ON_ONCE(!cma_release(cma, first, num_pages));
+	return ret;
 }
 
 static void pool_op_free(struct tee_shm_pool *pool, struct tee_shm *shm)
 {
-	tee_dyn_shm_free_helper(shm, qcomtee_shm_unregister);
+	struct cma *cma;
+
+	if (!IS_ENABLED(CONFIG_DMA_CMA) || shm->size < QCOMTEE_CMA_MIN_SIZE) {
+		tee_dyn_shm_free_helper(shm, qcomtee_shm_unregister);
+		return;
+	}
+
+	cma = dev_get_cma_area(&shm->ctx->teedev->dev);
+	qcomtee_shm_unregister(shm->ctx, shm);
+	WARN_ON_ONCE(!cma_release(cma, shm->pages[0], shm->num_pages));
+	shm->kaddr = NULL;
+	shm->paddr = 0;
+	shm->size = 0;
+	kfree(shm->pages);
+	shm->pages = NULL;
+	shm->num_pages = 0;
 }
 
