From: Paul Schuldesz <paulschuldesz@gmail.com>
Subject: [PATCH] drm/panel: novatek-nt37705: add 90, 60 and 30 Hz modes

The BOE BJ631JHM-T71-D900 (NT37705) panel of the Fairphone (Gen. 6) has
only one mode, 1116x2484 at 120 Hz. The vendor panel description
(dsi-panel-nt37705-boe-amoled-cmd.dtsi) has five command-mode timings
with the same porches and DSC setup: 120, 60, 90, 30 and 10 Hz. They
differ only in the skip-frame tables (0xba at offsets 0x1c..0xa4) and in
the rate commands at the end of the init sequence:

  120 Hz: 2f 02, 5a 01, 2f 30, 6d 00   (native 120 Hz scan)
   90 Hz: 2f 01                         (native 90 Hz scan)
   60 Hz: 2f 02, 5a 01, 2f 30, 6d 01   (120 Hz scan, skip 1 of 2)
   30 Hz: 2f 02, 5a 01, 2f 30, 6d 03   (120 Hz scan, skip 3 of 4)

Expose 120 (preferred, unchanged), 90, 60 and 30 Hz. drm_panel has no
mode argument in prepare(), so look up the mode being committed through
the connector's CRTC state, as panel-novatek-nt35950 does. A rate change
is a full modeset: the panel is powered down and re-initialised with the
new sequence. The 10 Hz timing (always-on/idle) is not a mode.

FP6 port: candidate only, not built into kernel6, not booted.
---
--- a/drivers/gpu/drm/panel/panel-novatek-nt37705.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt37705.c
@@ -15,6 +15,9 @@
 
 #include <drm/display/drm_dsc.h>
 #include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_crtc.h>
 #include <drm/drm_mipi_dsi.h>
 #include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
@@ -26,8 +29,110 @@
 	struct drm_dsc_config dsc;
 	struct regulator_bulk_data *supplies;
 	struct gpio_desc *reset_gpio;
+	/* Set by get_modes; used to look up the mode being enabled. */
+	struct drm_connector *connector;
 };
 
+/*
+ * Refresh rates, from the vendor (T2M/Fairphone) panel description
+ * dsi-panel-nt37705-boe-amoled-cmd.dtsi, timings @0 (120 Hz), @2 (90 Hz)
+ * @1 (60 Hz) and @3 (30 Hz). The panel scans natively at 120 Hz (CMD
+ * 0x2f 0x02) or 90 Hz (0x2f 0x01); 60 and 30 Hz are the 120 Hz scan with
+ * 1 or 3 of every 2 or 4 frames skipped (skip-frame sequence 1 and 0x6d).
+ * The 10 Hz vendor timing (always-on/idle) is not exposed as a mode, so
+ * compositors cannot pick it. All rates share the porches,
+ * DSC configuration and the rest of the init sequence; the mode clock
+ * scales with the rate, as the vendor driver derives it from the
+ * framerate.
+ */
+struct nt37705_rate {
+	unsigned int vrefresh;
+	bool native_90hz;
+	u8 skip_count;		/* 0x6d payload (120 Hz scan only) */
+	u8 skip_seq1[17];	/* 0xba at offset 0x1c */
+	u8 skip_seq2[17];	/* 0xba at offset 0x2c */
+	u8 skip_seq3[17];	/* 0xba at offset 0x3c */
+	u8 skip_seq4[17];	/* 0xba at offset 0x4c */
+	u8 skip_blank[17];	/* 0xba at offsets 0x6c and 0x7c */
+	u8 seq_cycle[9];	/* 0xba at offset 0x9c */
+	u8 seq_a4[5];		/* 0xba at offset 0xa4 */
+};
+
+#define NT37705_TABLES_120HZ \
+	.skip_seq1 = { 0xba, 0x01, 0x01, 0x01, 0x01, 0x00, 0x00, 0x00, 0x00, \
+		       0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }, \
+	.skip_seq2 = { 0xba, 0x00, 0x01, 0x01, 0x01, 0x00, 0x05, 0x05, 0x05, \
+		       0x00, 0x05, 0x05, 0x05, 0x00, 0x00, 0x00, 0x00 }, \
+	.skip_seq3 = { 0xba, 0x00, 0x00, 0x01, 0x01, 0x00, 0x00, 0x0b, 0x0b, \
+		       0x00, 0x00, 0x0b, 0x0b, 0x00, 0x00, 0x00, 0x00 }, \
+	.skip_seq4 = { 0xba, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x1d, \
+		       0x00, 0x00, 0x00, 0x1d, 0x00, 0x00, 0x00, 0x00 }, \
+	.skip_blank = { 0xba, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x0b, 0x77, \
+			0x77, 0x00, 0x00, 0x0b, 0x00, 0x1d, 0x00, 0x1d }, \
+	.seq_cycle = { 0xba, 0x11, 0x11, 0x20, 0x02, 0x00, 0x03, 0x00, 0x00 }, \
+	.seq_a4 = { 0xba, 0x00, 0xc0, 0x40, 0x08 }
+
+/* Fixed rates on the 120 Hz scan: no automatic skip sequences 2..4. */
+#define NT37705_TABLES_FIXED(skip) \
+	.skip_seq1 = { 0xba, 0x01, 0x01, 0x01, 0x01, (skip), 0x00, 0x00, 0x00, \
+		       (skip), 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }, \
+	.skip_seq2 = { 0xba }, \
+	.skip_seq3 = { 0xba }, \
+	.skip_seq4 = { 0xba }, \
+	.skip_blank = { 0xba, 0x01, 0x01, 0x02, 0x03, 0x04, 0x05, 0x0b, 0x77, \
+			0x01, 0x01, 0x01, 0x0b, 0x01, 0x1d, 0x01, 0x01 }, \
+	.seq_cycle = { 0xba, 0x11, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }, \
+	.seq_a4 = { 0xba, 0x00, 0x00, 0x00, 0x00 }
+
+/* The first entry is the default (preferred) mode. */
+static const struct nt37705_rate nt37705_rates[] = {
+	{
+		.vrefresh = 120,
+		.skip_count = 0x00,
+		NT37705_TABLES_120HZ,
+	}, {
+		.vrefresh = 90,
+		.native_90hz = true,
+		NT37705_TABLES_120HZ,
+	}, {
+		.vrefresh = 60,
+		.skip_count = 0x01,
+		NT37705_TABLES_FIXED(0x01),
+	}, {
+		.vrefresh = 30,
+		.skip_count = 0x03,
+		NT37705_TABLES_FIXED(0x03),
+	},
+};
+
+#define NT37705_HTOTAL (1116 + 100 + 30 + 100)
+#define NT37705_VTOTAL (2484 + 70 + 48 + 70)
+
+#define NT37705_MODE(hz) { \
+	.clock = NT37705_HTOTAL * NT37705_VTOTAL * (hz) / 1000, \
+	.hdisplay = 1116, \
+	.hsync_start = 1116 + 100, \
+	.hsync_end = 1116 + 100 + 30, \
+	.htotal = NT37705_HTOTAL, \
+	.vdisplay = 2484, \
+	.vsync_start = 2484 + 70, \
+	.vsync_end = 2484 + 70 + 48, \
+	.vtotal = NT37705_VTOTAL, \
+	.width_mm = 66, \
+	.height_mm = 146, \
+	.type = DRM_MODE_TYPE_DRIVER, \
+}
+
+/* Same order as nt37705_rates[]. */
+static const struct drm_display_mode nt37705_modes[] = {
+	NT37705_MODE(120),
+	NT37705_MODE(90),
+	NT37705_MODE(60),
+	NT37705_MODE(30),
+};
+
+static_assert(ARRAY_SIZE(nt37705_modes) == ARRAY_SIZE(nt37705_rates));
+
 static const struct regulator_bulk_data nt37705_supplies[] = {
 	{ .supply = "vddio" },
 	{ .supply = "dvdd" },
@@ -49,7 +154,50 @@
 	usleep_range(10000, 11000);
 }
 
-static int nt37705_on(struct nt37705_panel *ctx)
+/*
+ * The rate of the mode being enabled. prepare() runs in the atomic commit
+ * tail, after the new state has been swapped in, so the connector's CRTC
+ * state is the one being committed (as in panel-novatek-nt35950.c).
+ */
+static const struct nt37705_rate *nt37705_current_rate(struct nt37705_panel *ctx)
+{
+	struct drm_connector *connector = ctx->connector;
+	const struct drm_crtc_state *crtc_state;
+	unsigned int i;
+	int vrefresh;
+
+	if (!connector || !connector->state || !connector->state->crtc)
+		return &nt37705_rates[0];
+
+	crtc_state = connector->state->crtc->state;
+	if (!crtc_state)
+		return &nt37705_rates[0];
+
+	vrefresh = drm_mode_vrefresh(&crtc_state->mode);
+	for (i = 0; i < ARRAY_SIZE(nt37705_rates); i++)
+		if (nt37705_rates[i].vrefresh == vrefresh)
+			return &nt37705_rates[i];
+
+	return &nt37705_rates[0];
+}
+
+static void nt37705_set_rate(struct mipi_dsi_multi_context *dsi_ctx,
+			     const struct nt37705_rate *rate)
+{
+	if (rate->native_90hz) {
+		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x2f, 0x01);
+		return;
+	}
+
+	/* Normal display, 120 Hz scan, skip rate->skip_count frames */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x2f, 0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x5a, 0x01);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x2f, 0x30);
+	mipi_dsi_dcs_write_var_seq_multi(dsi_ctx, 0x6d, rate->skip_count);
+}
+
+static int nt37705_on(struct nt37705_panel *ctx,
+		      const struct nt37705_rate *rate)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 
@@ -60,51 +208,39 @@
