-
 static int nt37705_get_modes(struct drm_panel *panel,
 			     struct drm_connector *connector)
 {
-	return drm_connector_helper_get_modes_fixed(connector, &nt37705_mode);
+	struct nt37705_panel *ctx = to_nt37705_panel(panel);
+	struct drm_display_mode *mode;
+	unsigned int i;
+
+	ctx->connector = connector;
+
+	for (i = 0; i < ARRAY_SIZE(nt37705_modes); i++) {
+		mode = drm_mode_duplicate(connector->dev, &nt37705_modes[i]);
+		if (!mode) {
+			dev_err(panel->dev, "failed to add %u Hz mode\n",
+				nt37705_rates[i].vrefresh);
+			return i;
+		}
+
+		drm_mode_set_name(mode);
+		/* 120 Hz stays the default, as before. */
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+		drm_mode_probed_add(connector, mode);
+	}
+
+	connector->display_info.width_mm = nt37705_modes[0].width_mm;
+	connector->display_info.height_mm = nt37705_modes[0].height_mm;
+
+	return ARRAY_SIZE(nt37705_modes);
 }
 
