-				     0x11, 0x11, 0x20, 0x02, 0x00, 0x03, 0x00,
-				     0x00);
+	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, rate->seq_cycle,
+					sizeof(rate->seq_cycle));
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0xa4);
