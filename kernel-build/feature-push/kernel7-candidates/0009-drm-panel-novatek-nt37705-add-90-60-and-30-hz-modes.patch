-	.clock = (1116 + 100 + 30 + 100) * (2484 + 70 + 48 + 70) * 120 / 1000,
-	.hdisplay = 1116,
-	.hsync_start = 1116 + 100,
-	.hsync_end = 1116 + 100 + 30,
