-				     0x00, 0x1d);
+	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, rate->skip_blank,
+					sizeof(rate->skip_blank));
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x7c);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xba,
