From: Paul Schuldesz <paulschuldesz@gmail.com>
Subject: [PATCH] drm/panel: novatek-nt37705: runtime panel rate without a modeset

A DRM mode change on this command-mode panel is a full modeset: the
panel is powered off and re-initialised, so the screen blanks for about
200 ms. That rules out an adaptive rate (high while touched, low when
idle) through modes.

The vendor driver switches between its 120/60/30/10 Hz timings
seamlessly with qcom,mdss-dsi-timing-switch-command, sent in HS mode
while the display runs: only skip-frame sequence 1 (0xba at offset 0x1c)
and the skip count (0x6d) change on the 120 Hz scan.

Add two attributes on the DSI device:
  panel_rate_hz (rw): the panel's current rate (0 while off). Writing
    120, 60, 30 or 10 sends the vendor switch sequence. It must not be
    above the committed mode's rate and is refused on the 90 Hz mode
    (other scan). prepare() resets it to the mode's rate.
  panel_rates (ro): the values accepted now.
The DRM mode, DSI link clock and DPU tear check stay as committed.

A mutex serialises the attribute with prepare/unprepare and with the
backlight update, which also toggles MIPI_DSI_MODE_LPM.

FP6 port: candidate only, not built into kernel6, not booted. Applies
after 0009.
---
--- a/drivers/gpu/drm/panel/panel-novatek-nt37705.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt37705.c
@@ -9,6 +9,8 @@
 #include <linux/gpio/consumer.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/sysfs.h>
 #include <linux/regulator/consumer.h>
 
 #include <video/mipi_display.h>
@@ -31,6 +33,14 @@
 	struct gpio_desc *reset_gpio;
 	/* Set by get_modes; used to look up the mode being enabled. */
 	struct drm_connector *connector;
+	/*
+	 * Runtime rate (panel_rate_hz). lock serialises it with
+	 * prepare/unprepare; mode_rate is the committed mode's rate while
+	 * the panel is on, NULL while it is off.
+	 */
+	struct mutex lock;
+	const struct nt37705_rate *mode_rate;
+	unsigned int runtime_hz;
 };
 
 /*
@@ -133,6 +143,27 @@
 
 static_assert(ARRAY_SIZE(nt37705_modes) == ARRAY_SIZE(nt37705_rates));
 
+/*
+ * Seamless panel-side rates on the 120 Hz scan, from the vendor
+ * qcom,mdss-dsi-timing-switch-command of timings @0 (120), @1 (60), @3
+ * (30) and @4 (10 Hz): only skip-frame sequence 1 and 0x6d change, sent in
+ * HS mode while the display runs. The DRM mode (DSI link, DPU tear check)
+ * stays as committed; the panel shows every (skip + 1)-th scan. Used for
+ * an idle rate drop without a modeset (no blank), see panel_rate_hz.
+ */
+struct nt37705_runtime_rate {
+	unsigned int hz;
+	u8 seq1;	/* 0xba offset 0x1c bytes 5 and 9 */
+	u8 skip;	/* 0x6d */
+};
+
+static const struct nt37705_runtime_rate nt37705_runtime_rates[] = {
+	{ .hz = 120, .seq1 = 0x00, .skip = 0x00 },
+	{ .hz = 60, .seq1 = 0x01, .skip = 0x01 },
+	{ .hz = 30, .seq1 = 0x03, .skip = 0x03 },
+	{ .hz = 10, .seq1 = 0x0b, .skip = 0x06 },
+};
+
 static const struct regulator_bulk_data nt37705_supplies[] = {
 	{ .supply = "vddio" },
 	{ .supply = "dvdd" },
@@ -338,6 +369,8 @@
 		return ret;
 	}
 
+	guard(mutex)(&ctx->lock);
+
 	nt37705_reset(ctx);
 
 	dev_dbg(dev, "panel on at %u Hz\n", rate->vrefresh);
@@ -366,6 +399,9 @@
 
 	msleep(28); /* TODO: Is this panel-dependent? */
 
+	ctx->mode_rate = rate;
+	ctx->runtime_hz = rate->vrefresh;
+
 	return 0;
 }
 
@@ -375,6 +411,10 @@
 	struct device *dev = &ctx->dsi->dev;
 	int ret;
 
+	guard(mutex)(&ctx->lock);
+	ctx->mode_rate = NULL;
+	ctx->runtime_hz = 0;
+
 	ret = nt37705_off(ctx);
 	if (ret < 0)
 		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
@@ -424,9 +464,13 @@
 static int nt37705_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct nt37705_panel *ctx = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
 
+	/* Serialised with panel_rate_hz, which also toggles MODE_LPM. */
+	guard(mutex)(&ctx->lock);
+
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
@@ -457,6 +501,124 @@
 					      &nt37705_bl_ops, &props);
 }
 
+/* Runtime rates allowed on top of the committed mode (locked). */
+static bool nt37705_runtime_allowed(const struct nt37705_panel *ctx,
+				    unsigned int hz)
+{
+	return ctx->mode_rate && !ctx->mode_rate->native_90hz &&
+	       hz <= ctx->mode_rate->vrefresh;
+}
+
+static int nt37705_set_runtime_rate(struct nt37705_panel *ctx,
+				    const struct nt37705_runtime_rate *r)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+	const u8 seq1[] = { 0xba, 0x01, 0x01, 0x01, 0x01, r->seq1, 0x00, 0x00,
+			    0x00, r->seq1, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+			    0x00 };
+	unsigned long flags = dsi->mode_flags;
+
+	/* The vendor sends the switch in HS mode, like the brightness. */
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0,
+				     0x55, 0xaa, 0x52, 0x08, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x1b);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xba, 0x18);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x1c);
+	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, seq1, sizeof(seq1));
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2f, 0x02);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5a, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2f, 0x30);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0x6d, r->skip);
+
+	dsi->mode_flags = flags;
+
+	return dsi_ctx.accum_err;
+}
+
+/*
+ * panel_rate_hz: the panel's refresh rate while it is on (0 while off).
+ * Writing 120, 60, 30 or 10 (at most the committed mode's rate; not on the
+ * 90 Hz mode) changes it without a modeset. Every prepare() resets it to
+ * the mode's rate.
+ */
+static ssize_t panel_rate_hz_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct nt37705_panel *ctx = mipi_dsi_get_drvdata(to_mipi_dsi_device(dev));
+
+	guard(mutex)(&ctx->lock);
+	return sysfs_emit(buf, "%u\n", ctx->runtime_hz);
+}
+
+static ssize_t panel_rate_hz_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct nt37705_panel *ctx = mipi_dsi_get_drvdata(to_mipi_dsi_device(dev));
+	const struct nt37705_runtime_rate *r = NULL;
+	unsigned int hz, i;
+	int ret;
+
+	ret = kstrtouint(buf, 10, &hz);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(nt37705_runtime_rates); i++)
+		if (nt37705_runtime_rates[i].hz == hz)
+			r = &nt37705_runtime_rates[i];
+	if (!r)
+		return -EINVAL;
+
+	guard(mutex)(&ctx->lock);
+	if (!ctx->mode_rate)
+		return -EBUSY;
+	if (!nt37705_runtime_allowed(ctx, hz))
+		return -EINVAL;
+	if (hz == ctx->runtime_hz)
+		return count;
+
+	ret = nt37705_set_runtime_rate(ctx, r);
+	if (ret < 0) {
+		dev_err(dev, "failed to switch to %u Hz: %d\n", hz, ret);
+		return ret;
+	}
+	ctx->runtime_hz = hz;
+
+	return count;
+}
+static DEVICE_ATTR_RW(panel_rate_hz);
+
+/* panel_rates: the values panel_rate_hz accepts now (empty while off). */
+static ssize_t panel_rates_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct nt37705_panel *ctx = mipi_dsi_get_drvdata(to_mipi_dsi_device(dev));
+	ssize_t len = 0;
+	unsigned int i;
+
+	guard(mutex)(&ctx->lock);
+	for (i = 0; i < ARRAY_SIZE(nt37705_runtime_rates); i++) {
+		unsigned int hz = nt37705_runtime_rates[i].hz;
+
+		if (nt37705_runtime_allowed(ctx, hz))
+			len += sysfs_emit_at(buf, len, "%s%u", len ? " " : "", hz);
+	}
+	len += sysfs_emit_at(buf, len, "\n");
+
+	return len;
+}
+static DEVICE_ATTR_RO(panel_rates);
+
+static struct attribute *nt37705_attrs[] = {
+	&dev_attr_panel_rate_hz.attr,
+	&dev_attr_panel_rates.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(nt37705);
+
 static int nt37705_probe(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
@@ -469,6 +631,10 @@
 	if (IS_ERR(ctx))
 		return PTR_ERR(ctx);
 
+	ret = devm_mutex_init(dev, &ctx->lock);
+	if (ret)
+		return ret;
+
 	ret = devm_regulator_bulk_get_const(dev,
 					    ARRAY_SIZE(nt37705_supplies),
 					    nt37705_supplies,
@@ -550,6 +716,7 @@
 	.driver = {
 		.name = "panel-novatek-nt37705",
 		.of_match_table = nt37705_of_match,
+		.dev_groups = nt37705_groups,
 	},
 };
 module_mipi_dsi_driver(nt37705_driver);
