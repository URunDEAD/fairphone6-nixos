From: Paul Schuldesz <paulschuldesz@gmail.com>
Date: Tue, 27 Oct 2026 14:00:00 +0200
Subject: [PATCH] ASoC: qcom: q6apm-dai: support hostless front ends

A stream subgraph without a shared-memory endpoint (WR/RD_SHARED_MEM_EP,
SH_MEM_PULL/PUSH_MODE) connects only DSP endpoints, e.g. the modem voice
stream of a circuit-switched call to the codec DMA / I2S device subgraphs.
Such a front end exchanges no data with the host: opening, preparing and
starting the PCM must only open, configure and start the graph, while
DPCM starts the back ends as usual. This is how q6voice's VoiceMMode1
front end works on the APR stack (q6voiced/PAL open it and never write).

Detect hostless graphs at open (q6apm_is_graph_hostless()) and then:
 - prepare: only prepare and start the graph; no media format (the host
   PCM parameters do not describe a voice stream, which runs at the
   vocoder rate), no fragments, no shmem media format, no capture buffer
   queueing;
 - ack/pointer: nothing moves, report position 0;
 - close/re-prepare: no fragments to free;
 - accept mono host parameters (voice clients open S16 mono).

No change for graphs that have a shared-memory endpoint.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Paul Schuldesz <paulschuldesz@gmail.com>
---
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -704,6 +704,28 @@
 }
 EXPORT_SYMBOL_GPL(q6apm_is_graph_in_push_pull_mode);
 
+/*
+ * A hostless graph has no shared-memory endpoint: its stream subgraph only
+ * connects DSP endpoints (e.g. a modem voice stream to a codec DMA/I2S
+ * device). The front end then exchanges no data with the host; opening and
+ * starting it only builds and starts the graph (DPCM still starts the BEs).
+ */
+bool q6apm_is_graph_hostless(struct q6apm_graph *graph)
+{
+	static const uint32_t shmem_mids[] = {
+		MODULE_ID_WR_SHARED_MEM_EP, MODULE_ID_RD_SHARED_MEM_EP,
+		MODULE_ID_SH_MEM_PULL_MODE, MODULE_ID_SH_MEM_PUSH_MODE,
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(shmem_mids); i++)
+		if (q6apm_find_module_by_mid(graph, shmem_mids[i]))
+			return false;
+
+	return true;
+}
+EXPORT_SYMBOL_GPL(q6apm_is_graph_hostless);
+
 static int q6apm_graph_get_module_iid(struct q6apm_graph *graph, uint32_t mid)
 {
 	struct audioreach_module *module;
--- a/sound/soc/qcom/qdsp6/q6apm.h
+++ b/sound/soc/qcom/qdsp6/q6apm.h
@@ -161,6 +161,7 @@
 int q6apm_set_real_module_id(struct device *dev, struct q6apm_graph *graph, uint32_t codec_id);
 int q6apm_get_hw_pointer(struct q6apm_graph *graph, int dir);
 bool q6apm_is_graph_in_push_pull_mode(struct q6apm_graph *graph);
+bool q6apm_is_graph_hostless(struct q6apm_graph *graph);
 bool q6apm_is_graph_in_push_pull_mode_from_id(struct device *dev, unsigned int graph_id, int dir);
 int q6apm_push_pull_config(struct q6apm_graph *graph, phys_addr_t bphys,
 			   phys_addr_t pphys, uint32_t size);
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -81,6 +81,7 @@
 	struct q6apm_graph *graph;
 	spinlock_t lock;
 	bool notify_on_drain;
+	bool hostless;
 };
 
 struct q6apm_dai_data {
@@ -239,11 +240,34 @@
 	if (prtd->state) {
 		/* clear the previous setup if any  */
 		q6apm_graph_stop(prtd->graph);
-		q6apm_free_fragments(prtd->graph, substream->stream);
+		if (!prtd->hostless)
+			q6apm_free_fragments(prtd->graph, substream->stream);
 	}
 
 	prtd->last_pos_index = 0;
 	prtd->pcm_count = snd_pcm_lib_period_bytes(substream);
+	if (prtd->hostless) {
+		/*
+		 * No host buffer, and the host PCM parameters say nothing about
+		 * the graph (a voice stream runs at the vocoder rate): no media
+		 * format, just prepare and start it.
+		 */
+		ret = q6apm_graph_prepare(prtd->graph);
+		if (ret) {
+			dev_err(dev, "Failed to prepare hostless Graph %d\n", ret);
+			return ret;
+		}
+
+		ret = q6apm_graph_start(prtd->graph);
+		if (ret) {
+			dev_err(dev, "Failed to Start hostless Graph %d\n", ret);
+			return ret;
+		}
+
+		prtd->state = Q6APM_STREAM_RUNNING;
+		return 0;
+	}
+
 	if (q6apm_is_graph_in_push_pull_mode(prtd->graph)) {
 		if (prtd->pcm_size != prtd->push_pull_size) {
 			ret = q6apm_push_pull_config(prtd->graph, prtd->phys, prtd->pos_phys,
@@ -317,7 +341,7 @@
 	struct q6apm_dai_rtd *prtd = runtime->private_data;
 	int i, ret = 0, avail_periods;
 
-	if (q6apm_is_graph_in_push_pull_mode(prtd->graph))
+	if (prtd->hostless || q6apm_is_graph_in_push_pull_mode(prtd->graph))
 		return 0;
 
 	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
@@ -401,6 +425,16 @@
 	else if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
 		runtime->hw = q6apm_dai_hardware_capture;
 
+	prtd->hostless = q6apm_is_graph_hostless(prtd->graph);
+	if (prtd->hostless) {
+		/*
+		 * The PCM parameters only describe the (unused) host side;
+		 * accept the mono S16 8/16/48 kHz setups voice clients use.
+		 */
+		runtime->hw.channels_min = 1;
+		dev_dbg(dev, "graph %d is hostless\n", graph_id);
+	}
+
 	/* Ensure that buffer size is a multiple of period size */
 	ret = snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
 	if (ret < 0) {
@@ -461,7 +495,8 @@
 	if (prtd->state) {
 		/* only stop graph that is started */
 		q6apm_graph_stop(prtd->graph);
-		q6apm_free_fragments(prtd->graph, substream->stream);
+		if (!prtd->hostless)
+			q6apm_free_fragments(prtd->graph, substream->stream);
 	}
 
 	q6apm_graph_close(prtd->graph);
@@ -479,6 +514,10 @@
 	struct q6apm_dai_rtd *prtd = runtime->private_data;
 	snd_pcm_uframes_t ptr;
 
+	/* Nothing moves through the host buffer of a hostless graph. */
+	if (prtd->hostless)
+		return 0;
+
 	if (q6apm_is_graph_in_push_pull_mode(prtd->graph)) {
 		int retries = 10;
 		uint32_t index, fc1, fc2;
