	0x4557, 0x080011bd, 20, 0, 0x1, 0x2, 0x0, 0x1, 0x0, 0x0, 0x4557, 0x080011be, 20, 0, 0x1, 0x1, 0xf0010, 0x1, 0x3, 0x0,
	0x4654, 0x080010d0, 18, 0, 0xbb80, 0xf0010, 0x1, 0x1, 0x3, 0x0)')dnl
