ICR_MODULE(`m455b', 1, 3, 0x455b, 0x07001004, 1, 1, 1, 2, 0x455c, `buffer', `', `', `', `AR_TKN_U32_MODULE_FMT_INTERLEAVE "1"')
ICR_MODULE(`m455c', 1, 3, 0x455c, 0x0700101a, 1, 1, 1, 2, 0x455d, `buffer', `', `', `', `AR_TKN_U32_MODULE_LOG_CODE "0x1536" AR_TKN_U32_MODULE_LOG_TAP_POINT_ID "2" AR_TKN_U32_MODULE_LOG_MODE "0"')
ICR_MODULE(`m455d', 1, 3, 0x455d, 0x07001001, 1, 0, 1, 2, 0x0, `aif_out', `MultiMedia3 Capture', `', `', `')

SectionControlMixer."VoiceMMode1 Record" {
	reg "-1"
	index "2"
	max "1"
	invert "false"
	channel."fl" {
		reg "-1"
		max "1"
	}
	ops."ctl" {
		get "SND_SOC_AR_TPLG_FE_BE_GRAPH_CTL_MIX"
		put "SND_SOC_AR_TPLG_FE_BE_GRAPH_CTL_MIX"
		info "1"
	}
	data [
		"stream2.sub_graph1_data"
	]
}
SectionWidget."MultiMedia3 Mixer" {
	reg "-1"
	index "2"
	type "mixer"
	mixer [
		"VoiceMMode1 Record"
	]
	data [
		"stream2.sub_graph1_data"
	]
}
dnl DAPM only (gives DPCM the TX_CODEC_DMA_TX_3 back end through the voice
dnl capture mixer VoiceMMode1 Mixer). The source is not a module, so the mixer adds no APM
dnl connection: the real ones are in stream2.voice_taps.
SectionGraph."stream2.incall record Graph" {
	index "2"
	lines [
		"stream2.m429a, , MultiMedia3 Mixer"
