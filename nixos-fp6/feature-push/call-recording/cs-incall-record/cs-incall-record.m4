dnl In-call record (and optional in-call music) front ends for the FP6
dnl voice graph. Generated by gen-incall-m4.py from the stock ACDB
dnl (acdbdata/volcano_mtp_fps: StreamTX INCALL_RECORD B1000000=B100000C,
dnl StreamRX INCALL_MUSIC A1000000=A1000013). Do not edit by hand.
dnl Append to cs-call-audio milos-voice-graph.m4 (FP6_VOICE_GRAPH); needs
dnl kernel candidates 0006 + 0008. Options (define before this file):
dnl   FP6_INCALL_RECORD_DIR  1 UL, 2 DL, 3 UL+DL mono, 4 UL+DL stereo (default 4)
dnl   FP6_INCALL_MUSIC       also add the in-call music (uplink inject) FE
include(`audioreach/audioreach.m4')dnl
include(`audioreach/tokens.m4')dnl
include(`util/pcm.m4')dnl
include(`audioreach/subgraph.m4')dnl
include(`audioreach/container.m4')dnl
include(`audioreach/module_generic.m4')dnl
ifdef(`FP6_INCALL_RECORD_DIR', `', `define(`FP6_INCALL_RECORD_DIR', `4')')dnl
dnl ICR_MODULE(name, sgidx, container-idx, iid, module-id, max-ip, max-op,
dnl            src-port, dst-port, dst-iid, widget-type, stream-name,
dnl            cfg-data-name, open-data-name, extra tuples)
define(`ICR_MODULE',
`'
`SectionVendorTuples."NAME_PREFIX.$1_tuples" {'
`        tokens "audioreach_tokens"'
`        tuples."word.u32_data" {'
`                AR_TKN_U32_MODULE_INSTANCE_ID STR($4)'
`                AR_TKN_U32_MODULE_ID STR($5)'
`                AR_TKN_U32_MODULE_MAX_IP_PORTS STR($6)'
`                AR_TKN_U32_MODULE_MAX_OP_PORTS STR($7)'
`                AR_TKN_U32_MODULE_SRC_OP_PORT_ID STR($8)'
`                AR_TKN_U32_MODULE_DST_IN_PORT_ID STR($9)'
`                AR_TKN_U32_MODULE_SRC_INSTANCE_ID STR($4)'
`                AR_TKN_U32_MODULE_DST_INSTANCE_ID STR($10)'
`                $15'
`        }'
`}'
`SectionData."NAME_PREFIX.$1_data" {'
`        tuples "NAME_PREFIX.$1_tuples"'
`}'
`SectionWidget."NAME_PREFIX.$1" {'
`        index STR($2)'
`        type STR($11)'
`ifelse(`$12', `', `', `        stream_name "$12"')'
`        no_pm "true"'
`        subseq "10"'
`        data ['
`                "NAME_PREFIX.sub_graph$2_data"'
`                "NAME_PREFIX.container$3_data"'
`                "NAME_PREFIX.$1_data"'
`ifelse(`$13', `', `', `                "$13"')'
`ifelse(`$14', `', `', `                "$14"')'
`        ]'
`}')dnl
dnl ---- in-call record: stock SG 0xb00000d0, 11 modules -> "MultiMedia3 Capture" ----
define(`NAME_PREFIX', `stream2')dnl
AR_PCM_CAPTURE(2, `S16_LE', 48000, 48000, 1, 2)
