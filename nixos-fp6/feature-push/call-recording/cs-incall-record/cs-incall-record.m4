ICR_MODULE(`m4559', 1, 3, 0x4559, 0x0700101a, 1, 1, 1, 2, 0x455a, `buffer', `', `', `', `AR_TKN_U32_MODULE_LOG_CODE "0x19b1" AR_TKN_U32_MODULE_LOG_TAP_POINT_ID "2" AR_TKN_U32_MODULE_LOG_MODE "0"')
