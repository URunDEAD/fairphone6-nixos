# FP6 call recording (results/feature-push-20261024/call-recording/README.md).
#
#  * fp6-callrec (Rust, user service): follows oFono (CS) and imsd (VoLTE)
#    call state on the system bus and records each call to two files,
#    uplink and downlink, plus a sidecar JSON:
#      ~/Recordings/Calls/<date>/<date>T<time>_<in|out>_<who>_{uplink,downlink}.flac
#    Taps: VoLTE = imsd's PipeWire streams; CS = AudioReach in-call record
#    front end (optional, csIncallRecord, needs cs-call-audio); fallback =
#    default mic + output monitor (labelled "fallback").
#  * Dialer (overlay patch): Record button + REC indicator in the call
#    screen, Settings > Call recording (off / manual / automatic for all /
#    for chosen numbers, format, announcement tone, debug "record all"),
#    a Recordings list (play, share, delete) and a first-use legal notice.
#
# Recording is never on by default: GSettings com.fairphone6.callrecording
# mode = 'off' until the user picks a mode (after the notice).
{ config, lib, pkgs, ... }:
let
  cfg = config.hardware.fairphone6.callRecording;
  cs = cfg.csIncallRecord;
  user = config.services.fp6LomiriSensors.user or "user";
  schema = pkgs.callPackage ./schema.nix { };
  package = pkgs.callPackage ./package.nix { fp6-callrecording-schema = schema; };
  patchDialer = import ./dialer/dialer.nix { inherit lib pkgs schema; };
  contacts = config.system.build.fp6-contacts or null;
  dialer = patchDialer contacts.dialer;

  csConf = pkgs.writeText "cs-incall-record.conf" (''
    # Generated by call-recording-fp6.nix (hardware.fairphone6.callRecording.csIncallRecord).
    # See nixos-fp6/feature-push/call-recording/cs-incall-record/NOTES.txt.
    enable = true
    card = ${cs.card}
    pcm = ${cs.pcm}
    channels = ${toString cs.channels}
    rate = ${toString cs.rate}
    uplink_channel = ${toString cs.uplinkChannel}
    downlink_channel = ${if cs.downlinkChannel == null then "none" else toString cs.downlinkChannel}
  '' + lib.concatMapStrings (c: "control = '${c.name}' ${toString c.value}\n") cs.onControls
     + lib.concatMapStrings (c: "off_control = '${c.name}' ${toString c.value}\n") cs.offControls);

  controlType = lib.types.submodule {
    options = {
      name = lib.mkOption { type = lib.types.str; };
      value = lib.mkOption { type = lib.types.int; };
    };
  };
in {
  options.hardware.fairphone6.callRecording = {
    enable = lib.mkEnableOption "call recording (fp6-callrec service and the dialer's recording UI; recording itself stays off until the user turns it on)";
    csIncallRecord = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = ''
          Record CS calls from the AudioReach in-call record front end. Needs
          cs-call-audio's voice path (kernel 0005-0008, its voice graph) and a
          topology built with cs-incall-record/voice-graph-with-incall.nix.
          Off: CS calls use the labelled fallback (mic + output monitor).
        '';
      };
      card = lib.mkOption { type = lib.types.str; default = "F6"; };
      pcm = lib.mkOption {
        type = lib.types.str;
        default = "MultiMedia3";
        description = "Record front end, matched as a prefix of the /proc/asound/pcm id.";
      };
      channels = lib.mkOption { type = lib.types.ints.between 1 2; default = 2; };
      rate = lib.mkOption { type = lib.types.int; default = 48000; };
      uplinkChannel = lib.mkOption { type = lib.types.ints.between 0 1; default = 0; };
      downlinkChannel = lib.mkOption { type = lib.types.nullOr (lib.types.ints.between 0 1); default = 1; };
      onControls = lib.mkOption {
        type = lib.types.listOf controlType;
        default = [{ name = "MultiMedia3 Mixer VoiceMMode1 Record"; value = 1; }];
      };
      offControls = lib.mkOption {
        type = lib.types.listOf controlType;
        default = [{ name = "MultiMedia3 Mixer VoiceMMode1 Record"; value = 0; }];
      };
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = contacts != null && config.programs.fp6TelephonyFrontends.enable;
        message = "call-recording-fp6.nix patches the dialer built by contacts/contacts-fp6.nix (programs.fp6TelephonyFrontends).";
      }
      {
        assertion = !cs.enable || (config.hardware.fairphone6.csCallAudio.enable or false);
        message = "callRecording.csIncallRecord needs hardware.fairphone6.csCallAudio (the CS voice path).";
      }
    ];

    # contacts-fp6.nix sets this list with mkForce (priority 50); replace
    # only its dialer with the patched one.
    programs.fp6TelephonyFrontends.packages = lib.mkOverride 40 [ contacts.addressbook dialer contacts.messaging ];

    environment.systemPackages = [ package ];
    environment.etc."fp6-callrec/cs-incall-record.conf" = lib.mkIf cs.enable { source = csConf; };

    systemd.user.services.fp6-callrec = {
      description = "FP6 call recorder (records calls only when turned on in Phone > Settings)";
      wantedBy = [ "graphical-session.target" ];
      partOf = [ "graphical-session.target" ];
      after = [ "graphical-session.target" "pipewire.service" "wireplumber.service" ];
      unitConfig.ConditionUser = user;
      serviceConfig = {
        ExecStart = "${package}/bin/fp6-callrec run";
        Restart = "on-failure";
        RestartSec = 5;
        NoNewPrivileges = true;
        UMask = "0077";
      };
    };

    system.build.fp6-call-recording = { inherit package schema dialer csConf; };
  };
}
