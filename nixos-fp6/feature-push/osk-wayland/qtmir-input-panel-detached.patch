 using namespace mir::geometry;
 
+namespace {
+// fp6: the shell (Lomiri's InputMethod item) draws the input panel and makes
+// room for it (Stage.qml), so Mir must not lay the panel out as a window
+// attached to an output edge. miral recomputes the application zone whenever
+// an attached window changes state or size, or a window is moved to an output
+// (zwp_input_panel_surface_v1.set_toplevel, on every keyboard show), subtracts
+// the panel's exclusive rect, and re-places every Mir-maximized window (all
+// staged windows, see lomiri-staged-maximized.patch) to that zone by itself.
+// That overrides the geometry Lomiri asked for (e.g. 828 px tall under the
+// 24 px top panel, 10 ms after Lomiri resized the app above the keyboard),
+// uses a keyboard height off by the shell's panel offset, and also shrinks
+// Maliit D-Bus (Qt5) clients, which make room themselves (shrunk twice). So
+// the panel is "restored" instead of "attached", and gets no exclusive rect,
+// attached edges or output assignment.
+void detachInputPanel(miral::WindowSpecification &spec)
+{
+    if (spec.state().is_set() && spec.state().value() == mir_window_state_attached) {
+        spec.state() = mir_window_state_restored;
+    }
+    if (spec.exclusive_rect().is_set()) {
+        spec.exclusive_rect().consume();
+    }
+    if (spec.attached_edges().is_set()) {
+        spec.attached_edges().consume();
+    }
+    if (spec.output_id().is_set()) {
+        spec.output_id().consume();
+    }
+}
+} // namespace
