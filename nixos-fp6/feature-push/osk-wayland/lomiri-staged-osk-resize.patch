+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+
+#pragma once
+
+#include <QFileSystemWatcher>
+#include <QObject>
+#include <QString>
+
+/*
+ * Which kind of client the on-screen keyboard is currently serving, as
+ * published by maliit-server (FP6 hybrid D-Bus + Wayland connection) in
+ * $XDG_RUNTIME_DIR/maliit-active-client/state: "wayland", "dbus" or "none".
+ *
+ * Maliit D-Bus clients (Qt5 apps with the Maliit input-context plugin) are
+ * told the keyboard rectangle and make room themselves. Wayland text-input
+ * clients (GTK3/GTK4 apps, Firefox, Qt6 apps) are not: Mir sends them no
+ * panel geometry (text-input-v3 has none at all), so the shell has to resize
+ * their window. client is "" when the file does not exist (no hybrid Maliit),
+ * and the shell then keeps upstream behaviour.
+ */
+class InputMethodClient : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(QString client READ client NOTIFY clientChanged)
+    Q_PROPERTY(bool waylandTextInput READ waylandTextInput NOTIFY clientChanged)
+
+public:
+    explicit InputMethodClient(QObject *parent = nullptr);
+
+    QString client() const { return m_client; }
+    bool waylandTextInput() const { return m_client == QLatin1String("wayland"); }
+
+Q_SIGNALS:
+    void clientChanged();
+
+private:
+    void reload();
+
+    QString m_dirPath;
+    QString m_filePath;
+    QString m_client;
+    QFileSystemWatcher m_watcher;
+};
