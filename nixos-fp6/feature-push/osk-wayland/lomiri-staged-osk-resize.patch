+
+#include "inputmethodclient.h"
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+
+InputMethodClient::InputMethodClient(QObject *parent)
+    : QObject(parent)
+{
+    const QString runtimeDir = qEnvironmentVariable("XDG_RUNTIME_DIR");
+    if (runtimeDir.isEmpty())
+        return;
+
+    // maliit-server replaces the file atomically (write + rename), so watch
+    // the directory: it reports the rename, and also the first write when
+    // maliit starts after the shell.
+    m_dirPath = QDir(runtimeDir).filePath(QStringLiteral("maliit-active-client"));
+    m_filePath = QDir(m_dirPath).filePath(QStringLiteral("state"));
+    QDir().mkpath(m_dirPath);
+    if (QFileInfo::exists(m_dirPath))
+        m_watcher.addPath(m_dirPath);
+    connect(&m_watcher, &QFileSystemWatcher::directoryChanged, this, &InputMethodClient::reload);
+    reload();
+}
+
+void InputMethodClient::reload()
+{
+    QString client;
+    QFile file(m_filePath);
+    if (!m_filePath.isEmpty() && file.open(QIODevice::ReadOnly | QIODevice::Text))
+        client = QString::fromLatin1(file.read(64)).trimmed();
+
+    if (client == m_client)
+        return;
+    m_client = client;
+    Q_EMIT clientChanged();
+}
