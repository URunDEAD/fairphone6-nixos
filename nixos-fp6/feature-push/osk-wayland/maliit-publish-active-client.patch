+/*
+ * $XDG_RUNTIME_DIR/maliit-active-client/state is "wayland", "dbus" or "none".
+ * D-Bus clients (the Qt5 Maliit plugin) get the keyboard rectangle through
+ * updateInputMethodArea() and make room themselves. Wayland text-input clients
+ * get no panel geometry from the compositor, so Lomiri resizes their window
+ * while the keyboard is shown for them. Written synchronously, before
+ * showInputMethod(), so the shell knows it when the panel appears.
+ */
+void HybridInputContextConnection::publishActiveClient()
+{
+    const QByteArray state = activeConnection == 0 ? QByteArrayLiteral("none")
+                           : waylandActive()       ? QByteArrayLiteral("wayland")
+                                                   : QByteArrayLiteral("dbus");
+    if (state == mPublishedClient)
+        return;
+
+    const QString runtimeDir = qEnvironmentVariable("XDG_RUNTIME_DIR");
+    if (runtimeDir.isEmpty())
+        return;
+    const QString dir = QDir(runtimeDir).filePath(QStringLiteral("maliit-active-client"));
+    if (!QDir().mkpath(dir))
+        return;
+
+    QSaveFile file(QDir(dir).filePath(QStringLiteral("state")));
+    if (!file.open(QIODevice::WriteOnly | QIODevice::Text))
+        return;
+    file.write(state + '\n');
+    if (file.commit())
+        mPublishedClient = state;
+}
