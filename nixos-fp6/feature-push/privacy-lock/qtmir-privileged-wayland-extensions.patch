+namespace {
+// FP6 privacy-lock. Upstream qtmir offered these to every Wayland client:
+// with them any app could type or tap into other apps (virtual keyboard /
+// pointer), list and activate every window (foreign toplevel), try to
+// capture the screen (screencopy) or become the input method and see what
+// is typed (input-method-v2). Nothing on the phone needs them: Maliit types
+// through zwp_input_method_v1 (Mir's TextInputHub), the shell draws its own
+// panels and screen-capture reads back the shell's own frames. They are
+// offered to nobody; FP6_WAYLAND_PRIVILEGED_ALLOW_ALL=1 in Lomiri's
+// environment restores the upstream behaviour (tests only).
+void fp6RestrictPrivilegedExtensions(miral::WaylandExtensions& extensions)
+{
+    static bool const allowAll = qEnvironmentVariableIntValue("FP6_WAYLAND_PRIVILEGED_ALLOW_ALL") == 1;
+    for (char const* name : {miral::WaylandExtensions::zwp_virtual_keyboard_manager_v1,
+                             miral::WaylandExtensions::zwlr_virtual_pointer_manager_v1,
+                             miral::WaylandExtensions::zwlr_foreign_toplevel_manager_v1,
+                             miral::WaylandExtensions::zwlr_screencopy_manager_v1,
+                             miral::WaylandExtensions::zwp_input_method_manager_v2}) {
+        extensions.conditionally_enable(name, [](miral::WaylandExtensions::EnableInfo const& info) {
+            qCInfo(QTMIR_MIR_MESSAGES) << info.name() << (allowAll ? "offered to" : "not offered to")
+                                       << "pid" << miral::pid_of(info.app());
+            return allowAll;
+        });
+    }
+}
