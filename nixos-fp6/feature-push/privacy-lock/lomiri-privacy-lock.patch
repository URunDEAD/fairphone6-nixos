diff --git a/qml/Greeter/EmergencyInfo.qml b/qml/Greeter/EmergencyInfo.qml
new file mode 100644
index 0000000..a5efdba
--- /dev/null
+++ b/qml/Greeter/EmergencyInfo.qml
@@ -0,0 +1,209 @@
+/*
+ * FP6 privacy-lock: emergency information on the lock screen, readable
+ * without unlocking. The owner sets it in System Settings > Security &
+ * Privacy > Emergency information; fp6-privacyd keeps a sanitised copy in
+ * /var/lib/fp6-privacy/emergency.json (owner + group lightdm only, so both
+ * this session's lock screen and the LightDM greeter can read it). While
+ * the owner has not turned "Show on lock screen" on, the file says
+ * {"show": false} and the Emergency button goes straight to the dialer.
+ * SPDX-License-Identifier: GPL-3.0-only
+ */
+import QtQuick 2.15
+import Lomiri.Components 1.3
+
+Rectangle {
+    id: root
+
+    property var info: ({})
+    readonly property bool available: !!info && info.show === true
+    readonly property bool testMode: available && info.testMode === true
+    property string toast: ""
+
+    signal emergencyCall()
+
+    color: "#e6111111"
+    visible: false
+    focus: visible
+
+    function load() {
+        var xhr = new XMLHttpRequest();
+        xhr.open("GET", "file:///var/lib/fp6-privacy/emergency.json", false);
+        try {
+            xhr.send();
+            root.info = JSON.parse(xhr.responseText || "{}");
+        } catch (e) {
+            root.info = ({});
+        }
+    }
+
+    // Emergency pressed: the sheet if the owner set it up, else the dialer.
+    function request() {
+        load();
+        if (available) {
+            toast = "";
+            visible = true;
+        } else {
+            root.emergencyCall();
+        }
+    }
+
+    function close() { visible = false; toast = ""; }
+
+    function pickAccount() {
+        try {
+            if (telepathyHelper.defaultCallAccount && telepathyHelper.defaultCallAccount.active)
+                return telepathyHelper.defaultCallAccount.accountId;
+            var list = telepathyHelper.phoneAccounts.active;
+            for (var i = 0; i < list.length; i++)
+                if (list[i].active) return list[i].accountId;
+        } catch (e) {}
+        return "";
+    }
+
+    function callContact(name, number) {
+        if (testMode) {
+            toast = i18n.tr("Test mode: would call %1 (%2). No call placed.").arg(name || number).arg(number);
+            return;
+        }
+        var account = pickAccount();
+        if (account === "") {
+            toast = i18n.tr("No mobile network for calls. Use Emergency call.");
+            return;
+        }
+        // The live call takes over the lock screen (Shell startLockedApp).
+        callManager.startCall(number, account);
+        close();
+    }
+
+    Keys.onEscapePressed: close()
+
+    MouseArea { anchors.fill: parent } // nothing below reacts while open
+
+    Flickable {
+        id: flick
+        anchors.fill: parent
+        anchors.topMargin: units.gu(4)
+        contentHeight: column.height + units.gu(6)
+        clip: true
+
+        Column {
+            id: column
+            anchors { left: parent.left; right: parent.right; margins: units.gu(3) }
+            spacing: units.gu(1.5)
+
+            Item {
+                width: parent.width
+                height: units.gu(5)
+                Label {
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: i18n.tr("Emergency information")
+                    fontSize: "large"
+                    color: "white"
+                }
+                AbstractButton {
+                    anchors { right: parent.right; verticalCenter: parent.verticalCenter }
+                    width: units.gu(5); height: width
+                    onClicked: root.close()
+                    Icon { anchors.centerIn: parent; width: units.gu(3); height: width; name: "close"; color: "white" }
+                }
+            }
+
+            Label {
+                visible: root.testMode
+                width: parent.width
+                wrapMode: Text.WordWrap
+                color: "#f99b0f"
+                text: i18n.tr("Test mode is on: the call buttons below only show what they would do.")
+            }
+
+            Button {
+                width: parent.width
+                height: units.gu(6)
+                color: "#c7162b"
+                text: i18n.tr("Emergency call")
+                onClicked: { root.close(); root.emergencyCall(); }
+            }
+
+            Label {
+                visible: !!root.info.ownerMessage
+                width: parent.width
+                wrapMode: Text.WordWrap
+                color: "white"
+                fontSize: "medium"
+                text: root.info.ownerMessage || ""
+            }
+
+            Repeater {
+                model: [
+                    { label: i18n.tr("Name"), key: "ownerName" },
+                    { label: i18n.tr("Blood type"), key: "bloodType" },
+                    { label: i18n.tr("Allergies"), key: "allergies" },
+                    { label: i18n.tr("Medications"), key: "medications" },
+                    { label: i18n.tr("Medical conditions"), key: "conditions" },
+                    { label: i18n.tr("Notes"), key: "notes" }
+                ]
+                delegate: Column {
+                    width: column.width
+                    visible: !!root.info[modelData.key]
+                    spacing: units.gu(0.25)
+                    Label { text: modelData.label; color: "#aaaaaa"; fontSize: "small" }
+                    Label { width: parent.width; wrapMode: Text.WordWrap; color: "white"; text: root.info[modelData.key] || "" }
+                }
+            }
+
+            Label {
+                visible: root.info.organDonor === true
+                color: "white"
+                text: i18n.tr("Organ donor")
+            }
+
+            Label {
+                visible: !!root.info.contacts && root.info.contacts.length > 0
+                text: i18n.tr("Emergency contacts")
+                color: "#aaaaaa"
+                fontSize: "small"
+            }
+
+            Repeater {
+                model: root.info.contacts || []
+                delegate: Item {
+                    width: column.width
+                    height: units.gu(6)
+                    Column {
+                        anchors { left: parent.left; right: callButton.left; verticalCenter: parent.verticalCenter }
+                        Label {
+                            width: parent.width
+                            elide: Text.ElideRight
+                            color: "white"
+                            text: modelData.name + (modelData.relation ? " (" + modelData.relation + ")" : "")
+                        }
+                        Label { color: "#aaaaaa"; fontSize: "small"; text: modelData.number }
+                    }
+                    Button {
+                        id: callButton
+                        anchors { right: parent.right; verticalCenter: parent.verticalCenter }
+                        text: i18n.tr("Call")
+                        color: theme.palette.normal.positive
+                        onClicked: root.callContact(modelData.name, modelData.number)
+                    }
+                }
+            }
+
+            Label {
+                visible: root.toast !== ""
+                width: parent.width
+                wrapMode: Text.WordWrap
+                color: "#f99b0f"
+                text: root.toast
+            }
+
+            Label {
+                width: parent.width
+                wrapMode: Text.WordWrap
+                color: "#888888"
+                fontSize: "x-small"
+                text: i18n.tr("Shown on the lock screen by the owner of this phone. Calls to emergency contacts work without unlocking.")
+            }
+        }
+    }
+}
