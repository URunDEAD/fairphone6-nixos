# FP6 lock sounds: the fp6-lock-sounds tool (Rust), the bundled sounds, the
# com.fairphone6.lock-sounds schema, the shared QML (catalog + player) and
# the Settings > Sound additions.
{ lib, stdenvNoCC, writeText, rustPlatform, glib, makeWrapper, dconf, buildPackages
, sound-theme-freedesktop, kdePackages, lomiri
, home ? "/home/user" }:
let
  tool = rustPlatform.buildRustPackage {
    pname = "fp6-lock-sounds";
    version = "0.1.0";
    src = lib.fileset.toSource {
      root = ./fp6-lock-sounds;
      fileset = lib.fileset.unions [ ./fp6-lock-sounds/Cargo.toml ./fp6-lock-sounds/Cargo.lock ./fp6-lock-sounds/src ];
    };
    cargoLock.lockFile = ./fp6-lock-sounds/Cargo.lock;
    nativeBuildInputs = [ makeWrapper ];
    # cargo test: trimming/normalising, WAV round trip, GVariant text, sync.
    doCheck = true;
    postInstall = ''
      # User units do not get the session's GIO_EXTRA_MODULES: without dconf's
      # module gsettings would use the memory backend.
      wrapProgram $out/bin/fp6-lock-sounds \
        --set-default FP6_GSETTINGS ${lib.getBin glib}/bin/gsettings \
        --prefix GIO_EXTRA_MODULES : ${lib.getLib dconf}/lib/gio/modules \
        --prefix XDG_DATA_DIRS : ${schema}/share/gsettings-schemas/${schema.name}
    '';
    meta = {
      description = "Prepares the FP6 lock/unlock sounds (decode, trim, normalise to WAV)";
      license = lib.licenses.gpl3Only;
      mainProgram = "fp6-lock-sounds";
      platforms = lib.platforms.linux;
    };
  };

  schema = stdenvNoCC.mkDerivation {
    pname = "fp6-lock-sounds-schema";
    version = "0.1.0";
    dontUnpack = true;
    nativeBuildInputs = [ glib ];
    installPhase = ''
      schemas=$out/share/gsettings-schemas/$name/glib-2.0/schemas
      install -Dm644 ${./com.fairphone6.lock-sounds.gschema.xml} $schemas/com.fairphone6.lock-sounds.gschema.xml
      glib-compile-schemas --strict $schemas
    '';
  };

  catalog = import ./sounds.nix {
    inherit sound-theme-freedesktop;
    ocean-sound-theme = kdePackages.ocean-sound-theme;
    lomiri-sounds = lomiri.lomiri-sounds;
  };

  # Converted with the build platform's tool (pure data, any platform).
  converter = buildPackages.callPackage ./package.nix { inherit home; };
  sounds = stdenvNoCC.mkDerivation {
    pname = "fp6-lock-sounds-bundle";
    version = "0.1.0";
    dontUnpack = true;
    nativeBuildInputs = [ converter.tool ];
    installPhase = ''
      dir=$out/share/sounds/fp6-lock
      mkdir -p $dir
      ${lib.concatMapStrings (s: ''
        fp6-lock-sounds convert ${lib.escapeShellArg s.src} $dir/${s.id}.wav
        printf '%s.wav  "%s"\n  from %s\n  %s, %s\n\n' ${lib.escapeShellArgs [ s.id s.name (baseNameOf s.src) s.credit s.license ]} >> $dir/CREDITS
      '') catalog}
    '';
    meta.license = with lib.licenses; [ cc-by-sa-30 cc-by-sa-40 ];
  };

  # Shared by Lomiri and Settings: ids, names, the bundle directory and
  # the value -> playable file resolution.
  catalogJs = writeText "Fp6LockSoundCatalog.js" ''
    .pragma library
    // Generated by nixos-fp6/feature-push/lock-sounds/package.nix.
    var dir = "${sounds}/share/sounds/fp6-lock";
    var sounds = ${builtins.toJSON (map (s: { inherit (s) id name; }) catalog)};
    var defaults = { lockSound: "pop-down", unlockSound: "pop-up" };
    function find(id) {
        for (var i = 0; i < sounds.length; i++) if (sounds[i].id === id) return sounds[i];
        return null;
    }
    function isCustom(v) { return !!v && v.charAt(0) === "/"; }
    // "" -> "", bundled id -> its WAV, custom path -> its prepared WAV
    // (prepared-files pairs) or the file itself.
    function resolve(v, prepared) {
        if (!v) return "";
        if (!isCustom(v)) return find(v) ? dir + "/" + v + ".wav" : "";
        var p = prepared || [];
        for (var i = 0; i + 1 < p.length; i += 2) if (p[i] === v) return p[i + 1];
        return v;
    }
    function fileName(path) {
        var n = path.substring(path.lastIndexOf("/") + 1);
        var dot = n.lastIndexOf(".");
        return dot > 0 ? n.substring(0, dot) : n;
    }
    function toUrl(path) {
        return path ? "file://" + path.split("/").map(encodeURIComponent).join("/") : "";
    }
  '';

  qml = stdenvNoCC.mkDerivation {
    pname = "fp6-lock-sounds-qml";
    version = "0.1.0";
    src = ./qml;
    dontConfigure = true;
    dontBuild = true;
    installPhase = ''
      mkdir -p $out
      cp *.qml $out/
      cp ${catalogJs} $out/Fp6LockSoundCatalog.js
    '';
  };

  lssPage = stdenvNoCC.mkDerivation {
    pname = "lomiri-system-settings-lock-sounds";
    version = "0.1.0";
    src = ./settings-page;
    dontConfigure = true;
    dontBuild = true;
    installPhase = ''
      mkdir -p $out
      cp *.qml $out/
      substituteInPlace $out/Fp6LockSoundFiles.qml --replace-fail '@fp6Home@' ${lib.escapeShellArg home}
      cp ${qml}/Fp6LockSoundPlayer.qml ${qml}/Fp6LockSoundCatalog.js $out/
    '';
  };
  # Lomiri postPatch (module overlay and the tests): the shell component,
  # player and catalog into qml/Components, the instance in Shell.qml
  # (anchored on the stock cursorHidingTimer, kept in place for others).
  # Anchors are plain strings: indentation inside them matters.
  shellAnchor = "    Timer {\n        id: cursorHidingTimer\n";
  shellInsert = lib.concatStringsSep "\n" [
    "    // FP6 lock sounds (nixos-fp6/feature-push/lock-sounds)"
    "    Fp6LockSounds {"
    "        id: fp6LockSounds"
    "        greeterActive: !!greeter && greeter.active"
    "        inCall: callManager.hasCalls"
    "        suppressed: wizard.active || shell.mode === \"greeter\" || !screenWindow.primary"
    "    }"
    "" ""
  ];
  lomiriPostPatch = { withDnd }: let
    dndExpr = if withDnd then "fp6LockSoundsDnd.dndActive === true" else "false";
    dndSettings = lib.optionalString withDnd
      "GSettings { id: fp6LockSoundsDnd; schema.id: \"com.fairphone6.notifications\" }";
  in ''
    # FP6 lock sounds (after every other module's Lomiri edits)
    install -m644 ${qml}/Fp6LockSounds.qml ${qml}/Fp6LockSoundPlayer.qml \
      ${qml}/Fp6LockSoundCatalog.js qml/Components/
    substituteInPlace qml/Components/Fp6LockSounds.qml \
      --replace-fail '@fp6LockSoundsDnd@' ${lib.escapeShellArg dndExpr} \
      --replace-fail '@fp6LockSoundsDndSettings@' ${lib.escapeShellArg dndSettings}
    substituteInPlace qml/Shell.qml \
      --replace-fail ${lib.escapeShellArg shellAnchor} ${lib.escapeShellArg (shellInsert + shellAnchor)}
    grep -q 'Fp6LockSounds {' qml/Shell.qml
  '';

  # lomiri-system-settings wrapper postInstall: the Sound page section in
  # place of the stock placeholder "Lock sound" switch (showAllUI only,
  # never wired), which is hidden.
  lssPlaceholder = "                text: i18n.tr(\"Lock sound\")\n                visible: showAllUI\n";
  lssDivider = "            SettingsListItems.ThinDivider {\n                visible: showAllUI\n            }\n";
  lssSection = lib.concatStringsSep "\n" [
    "            SettingsListItems.ThinDivider {"
    "                visible: false"
    "            }"
    ""
    "            // FP6 lock sounds (nixos-fp6/feature-push/lock-sounds)"
    "            Fp6LockSoundsSection {"
    "                anchors.left: parent.left"
    "                anchors.right: parent.right"
    "                page: root"
    "            }"
    ""
  ];
  lssPostInstall = ''
    # FP6 lock sounds
    dir=$out/share/lomiri-system-settings/qml-plugins/sound
    page=$dir/PageComponent.qml
    if [ -L "$page" ]; then cp --remove-destination "$(readlink -f "$page")" "$page"; fi
    chmod u+w "$page"
    install -m644 ${lssPage}/*.qml ${lssPage}/*.js "$dir"/
    substituteInPlace "$page" \
      --replace-fail ${lib.escapeShellArg lssPlaceholder} \
        ${lib.escapeShellArg "                text: i18n.tr(\"Lock sound\")\n                visible: false\n"} \
      --replace-fail ${lib.escapeShellArg lssDivider} ${lib.escapeShellArg lssSection}
    grep -q 'Fp6LockSoundsSection {' "$page"
  '';
in { inherit tool schema sounds qml lssPage catalog lomiriPostPatch lssPostInstall; }
