+#if MIR_SERVER_VERSION >= MIR_VERSION_NUMBER(2, 28, 0)
+namespace {
+// FP6 Mir 2.28: Mir now follows logind's Lock/Unlock signals (loginctl
+// lock-session) with its own session lock, which drops keyboard focus and
+// hides surfaces that are not ext-session-lock surfaces. Lomiri's greeter
+// is the lock screen and does not use ext-session-lock; log the transitions
+// so a stuck Mir lock is visible in the journal.
+miral::SessionLockListener fp6SessionLockLog()
+{
+    return miral::SessionLockListener{
+        [] { qCWarning(QTMIR_MIR_MESSAGES) << "Mir session locked (logind Lock); Lomiri's greeter stays the lock screen"; },
+        [] { qCInfo(QTMIR_MIR_MESSAGES) << "Mir session unlocked (logind Unlock)"; }};
+}
+} // namespace
+#endif
