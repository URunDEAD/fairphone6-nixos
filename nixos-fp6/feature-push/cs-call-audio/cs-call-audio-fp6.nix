# Circuit-switched (2G/3G/CSFB) call audio on the FP6: modem <-> ADSP voice
# path through a hostless q6apm VoiceMMode1 front end.
#
# hardware.fairphone6.csCallAudio.enable = false (default): nothing changes.
#
# Stages (results/feature-push-20261024/cs-call-audio/README.md):
#   enable + dryRun (default when enabled): fp6-csvoiced follows oFono call
#     state and only LOGS what it would do. Safe on kernel6; no topology change.
#   enable + dryRun = false: needs a kernel with the kernel7 candidates
#     0005 (hostless FE) + 0006 (topology module config) + 0007 (qrtr
#     forwarding) + 0008 (GRAPH_OPEN extra params) and a voice graph generated from the stock ACDB
#     (voiceGraph). Installs the voice topology and opens the hostless PCMs
#     during calls.
#
# The UCM side needs no change: lomiri-telephony-service already switches
# the card to the "Voice Call (Earpiece|Speaker, Mic1)" profile during a
# call (amp receiver/voice profiles, mic path); this module only adds the
# DSP voice graph and the daemon that starts it.
{ config, lib, pkgs, ... }:
let
  cfg = config.hardware.fairphone6.csCallAudio;

  csvoiced = pkgs.callPackage ./package.nix { };

  topology = pkgs.callPackage ./topology/package.nix {
    inherit (cfg) voiceGraph;
  };

  ctlLines = key: map ({ name, value }: "${key} = ${name}|${toString value}");

  configFile = pkgs.writeText "fp6-csvoiced.conf" (lib.concatStringsSep "\n" ([
    "# Generated by hardware.fairphone6.csCallAudio"
    "card = ${cfg.card}"
    "pcm_id = ${cfg.pcmId}"
    "capture = ${lib.boolToString cfg.capture}"
    "rate = ${toString cfg.rate}"
    "channels = ${toString cfg.channels}"
    "states = ${lib.concatStringsSep "," cfg.callStates}"
    "dry_run = ${lib.boolToString cfg.dryRun}"
  ]
  ++ ctlLines "on_control" cfg.onControls
  ++ ctlLines "off_control" cfg.offControls
  ++ lib.optional (cfg.muteControl != null)
    "mute_control = ${cfg.muteControl.name}|${toString cfg.muteControl.muted}|${toString cfg.muteControl.unmuted}"
  ++ lib.optional (cfg.volumeControl != null)
    "volume_control = ${cfg.volumeControl.name}|${toString cfg.volumeControl.min}|${toString cfg.volumeControl.max}"
  ) + "\n");

  controlType = lib.types.submodule {
    options = {
      name = lib.mkOption { type = lib.types.str; };
      value = lib.mkOption { type = lib.types.int; };
    };
  };

  ofonoOverlay = _final: prev: {
    ofono = prev.ofono.overrideAttrs (old: {
      patches = (old.patches or [ ]) ++ [ ./ofono-qrtrqmi-sw-call-volume.patch ];
    });
  };
in
{
  options.hardware.fairphone6.csCallAudio = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Circuit-switched call audio: run fp6-csvoiced, which starts the
        ADSP voice graph (hostless VoiceMMode1 PCMs) while oFono reports a
        call that needs audio.
      '';
    };

    dryRun = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Only log the call-state decisions and the PCMs/controls that would be
        used; never open a PCM or write a control. The first supervised test
        runs like this on kernel6.
      '';
    };

    kernelHasVoiceSupport = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Set when the booted kernel carries the kernel7 candidates 0005
        (q6apm-dai hostless front ends), 0006 (topology module config for any
        module), 0007 (qrtr forwarding between endpoints) and 0008 (topology
        GRAPH_OPEN extra params). Required for dryRun = false.
      '';
    };

    voiceGraph = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      default = null;
      description = ''
        m4 description of the voice stream subgraphs, generated from the
        stock FP6 ACDB by topology/acdb2m4.py (topology/milos-voice-graph.m4).
        When set, the FP6 topology is rebuilt with the VoiceMMode1 graph and
        installed ahead of the device firmware. Required for dryRun = false.
      '';
    };

    ofonoCallVolume = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Patch oFono's qrtrqmi plugin with a software org.ofono.CallVolume
        atom (Muted, SpeakerVolume), so the dialer's mute works and
        fp6-csvoiced can follow it. The modem is not touched.
      '';
    };

    card = lib.mkOption { type = lib.types.str; default = "F6"; };
    pcmId = lib.mkOption {
      type = lib.types.str;
      default = "VoiceMMode1";
      description = "Prefix of the hostless FE PCM ids (\"VoiceMMode1 Playback (*)\", \"VoiceMMode1 Capture (*)\").";
    };
    capture = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Open the uplink (VoiceMMode1 Capture) too; false = downlink only (bring-up fallback).";
    };
    rate = lib.mkOption { type = lib.types.int; default = 48000; };
    channels = lib.mkOption { type = lib.types.int; default = 1; };
    callStates = lib.mkOption {
      type = lib.types.listOf (lib.types.enum [ "active" "held" "dialing" "alerting" "incoming" "waiting" ]);
      # Only once the call is connected: on 2026-10-27 opening the voice
      # graphs while the modem's voice service was idle crashed it (modem
      # SSR). Whether "alerting" (in-band ringback) is safe is part of the
      # first supervised call test.
      default = [ "active" "held" ];
      description = "oFono VoiceCall states that need the voice path.";
    };

    onControls = lib.mkOption {
      type = lib.types.listOf controlType;
      description = ''
        Mixer writes before the voice PCMs are opened (DPCM needs the FE->BE
        routes first). The MultiMedia1/2 routes are cut for the call, so the
        device subgraphs have one stream input each.
      '';
      default = [
        { name = "SEN_MI2S_RX Audio Mixer MultiMedia1"; value = 0; }
        { name = "MultiMedia2 Mixer TX_CODEC_DMA_TX_3"; value = 0; }
        { name = "SEN_MI2S_RX Audio Mixer VoiceMMode1"; value = 1; }
        { name = "VoiceMMode1 Mixer TX_CODEC_DMA_TX_3 Voice"; value = 1; }
      ];
    };
    offControls = lib.mkOption {
      type = lib.types.listOf controlType;
      description = "Mixer writes after the voice PCMs are closed (restore the HiFi routes).";
      default = [
        { name = "SEN_MI2S_RX Audio Mixer VoiceMMode1"; value = 0; }
        { name = "VoiceMMode1 Mixer TX_CODEC_DMA_TX_3 Voice"; value = 0; }
        { name = "SEN_MI2S_RX Audio Mixer MultiMedia1"; value = 1; }
        { name = "MultiMedia2 Mixer TX_CODEC_DMA_TX_3"; value = 1; }
      ];
    };
    muteControl = lib.mkOption {
      type = lib.types.nullOr (lib.types.submodule {
        options = {
          name = lib.mkOption { type = lib.types.str; };
          muted = lib.mkOption { type = lib.types.int; };
          unmuted = lib.mkOption { type = lib.types.int; };
        };
      });
      # The WCD9378 TX decimator volume is in the UCM Mic1 path and safe to
      # zero; 84 is the UCM value.
      default = { name = "TX_DEC0 Volume"; muted = 0; unmuted = 84; };
      description = "Uplink mute control driven by oFono CallVolume.Muted.";
    };
    volumeControl = lib.mkOption {
      type = lib.types.nullOr (lib.types.submodule {
        options = {
          name = lib.mkOption { type = lib.types.str; };
          min = lib.mkOption { type = lib.types.int; };
          max = lib.mkOption { type = lib.types.int; };
        };
      });
      default = null;
      description = ''
        Downlink volume control driven by oFono CallVolume.SpeakerVolume
        (0..100 -> min..max). Unset by default: the amplifier volume belongs
        to UCM (capped at 352) and the voice graph's soft-volume module has
        no control until the ACDB graph is known.
      '';
    };
  };

  config = lib.mkIf cfg.enable (lib.mkMerge [
    {
      assertions = [
        {
          assertion = cfg.dryRun || cfg.kernelHasVoiceSupport;
          message = "hardware.fairphone6.csCallAudio: dryRun = false needs kernelHasVoiceSupport (kernel7 candidates 0005-0008).";
        }
        {
          assertion = cfg.dryRun || cfg.voiceGraph != null;
          message = "hardware.fairphone6.csCallAudio: dryRun = false needs voiceGraph (generated from the stock ACDB).";
        }
        {
          assertion = cfg.volumeControl == null || !(lib.hasPrefix "Amplifier" cfg.volumeControl.name);
          message = "hardware.fairphone6.csCallAudio: the amplifier volume is UCM's (352 cap); do not drive it from the daemon.";
        }
        {
          assertion = !(config.services.ofono.enable or false) || !(config.networking.modemmanager.enable or false);
          message = "hardware.fairphone6.csCallAudio follows oFono; ModemManager must be off.";
        }
      ];

      environment.etc."fp6-csvoiced.conf".source = configFile;
      environment.systemPackages = [ csvoiced ];

      systemd.services.fp6-csvoiced = {
        description = "FP6 circuit-switched call voice path (oFono -> q6apm VoiceMMode1)";
        wantedBy = [ "multi-user.target" ];
        after = [ "ofono.service" "sound.target" ];
        wants = [ "ofono.service" ];
        restartTriggers = [ configFile ];
        serviceConfig = {
          ExecStart = "${lib.getExe csvoiced} run --config /etc/fp6-csvoiced.conf";
          Restart = "on-failure";
          RestartSec = 2;
          # /dev/snd + system bus only.
          SupplementaryGroups = [ "audio" ];
          DynamicUser = false;
          ProtectSystem = "strict";
          ProtectHome = true;
          PrivateTmp = true;
          NoNewPrivileges = true;
          DeviceAllow = [ "char-alsa rw" ];
          DevicePolicy = "closed";
          RestrictAddressFamilies = [ "AF_UNIX" ];
          CapabilityBoundingSet = "";
        };
      };

      system.build.fp6-csvoiced = csvoiced;
      system.build.fp6-cs-call-topology = topology;
    }
    (lib.mkIf cfg.ofonoCallVolume {
      # Composes with the cellular package's own ofono overrideAttrs.
      nixpkgs.overlays = [ ofonoOverlay ];
    })
    (lib.mkIf (cfg.voiceGraph != null) {
      # First package in hardware.firmware wins; the device firmware is
      # mkBefore (500), so 400 puts the voice topology ahead of it.
      hardware.firmware = lib.mkOrder 400 [ topology ];
    })
  ]);
}
