+// FP6 app-ready (nixos-fp6/feature-push/app-ready): background launches and
+// a focus file for the fp6-app-ready daemon.
+//  * $XDG_RUNTIME_DIR/fp6-app-ready/background/<appId> (written by the daemon
+//    right before it starts the app, at most 60 s old): the app's windows of
+//    the next 30 s are not activated and go to the bottom of the stack; they
+//    stay fp6Background (off screen) until the user focuses them.
+//  * $XDG_RUNTIME_DIR/fp6-app-ready/focused: app id of the focused window.
+//  * "fp6-app-ready:" journal lines (added / first-frame / focus) for launch
+//    time measurements.
+namespace {
+QString fp6AppReadyDir()
+{
+    const QString runtime = qEnvironmentVariable("XDG_RUNTIME_DIR");
+    return runtime.isEmpty() ? QString() : runtime + QStringLiteral("/fp6-app-ready");
+}
+
+bool fp6OpensInBackground(const QString &appId)
+{
+    static QHash<QString, qint64> backgroundUntil;
+    if (appId.isEmpty() || appId.contains(QLatin1Char('/'))) {
+        return false;
+    }
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    const QString dir = fp6AppReadyDir();
+    if (!dir.isEmpty()) {
+        const QFileInfo marker(dir + QStringLiteral("/background/") + appId);
+        if (marker.exists()) {
+            const qint64 age = now - marker.lastModified().toMSecsSinceEpoch();
+            QFile::remove(marker.filePath());
+            if (age >= 0 && age < 60000) {
+                backgroundUntil.insert(appId, now + 30000);
+            }
+        }
+    }
+    auto it = backgroundUntil.find(appId);
+    if (it == backgroundUntil.end()) {
+        return false;
+    }
+    if (it.value() < now) {
+        backgroundUntil.erase(it);
+        return false;
+    }
+    return true;
+}
+
+void fp6WriteFocused(const QString &appId)
+{
+    const QString dir = fp6AppReadyDir();
+    if (dir.isEmpty() || !QDir().mkpath(dir)) {
+        return;
+    }
+    QSaveFile file(dir + QStringLiteral("/focused"));
+    if (file.open(QIODevice::WriteOnly)) {
+        file.write(appId.toUtf8() + '\n');
+        file.commit();
+    }
+}
+} // namespace
