--- a/liblomiri-app-launch/registry.cpp
+++ b/liblomiri-app-launch/registry.cpp
@@ -26,6 +26,9 @@
 #include "registry-impl.h"
 #include "registry.h"
 
+#include <cstdlib>
+#include <mutex>
+
 namespace lomiri
 {
 namespace app_launch
@@ -87,6 +90,14 @@ std::shared_ptr<Registry> Registry::getDefault()
     if (!defaultRegistry)
     {
         defaultRegistry = std::make_shared<Registry>();
+        /* Drop the default registry (and so quit and join its GLib context
+           thread) from an exit handler registered now, which runs before the
+           static destructors of everything constructed earlier, the
+           application's own globals among them. Left to the library's own
+           static destructor, the thread kept dispatching D-Bus signals into
+           already destroyed objects during __run_exit_handlers. */
+        static std::once_flag atexitFlag;
+        std::call_once(atexitFlag, []() { std::atexit([]() { Registry::clearDefault(); }); });
     }
 
     return defaultRegistry;
