+namespace {
+struct Fp6Kind { const char *kind; const char *icon; };
+// Kinds offered in "Type"; icons from Suru (fp6-audio-earbuds-symbolic is
+// shipped by the FP6 module into hicolor).
+const Fp6Kind FP6_KINDS[] = {
+    { "car",        "audio-carkit-symbolic" },
+    { "speaker",    "audio-speakers-symbolic" },
+    { "headphones", "audio-headphones-symbolic" },
+    { "earbuds",    "fp6-audio-earbuds-symbolic" },
+    { "headset",    "audio-headset-symbolic" },
+    { "watch",      "smartwatch-symbolic" },
+    { "keyboard",   "input-keyboard-symbolic" },
+    { "mouse",      "input-mouse-symbolic" },
+    { "gamepad",    "input-gaming-symbolic" },
+    { "phone",      "phone-smartphone-symbolic" },
+    { "computer",   "computer-symbolic" },
+    { "tv",         "video-display-symbolic" },
+    { "other",      "bluetooth-active" },
+};
+
+struct Fp6Profile { const char *uuid16; const char *label; };
+// Profiles shown on the device page (only the ones the device lists in
+// UUIDs). Connect/DisconnectProfile go to BlueZ; routing stays with the
+// audio stack.
+const Fp6Profile FP6_PROFILES[] = {
+    { "110b", "media" },      // A2DP sink: media audio
+    { "111e", "calls" },      // HFP hands-free: calls
+    { "1108", "calls" },      // HSP headset: calls
+    { "1124", "input" },      // HID
+    { "1812", "input" },      // HOGP (HID over GATT)
+    { "1105", "files" },      // OBEX object push
+    { "1106", "files" },      // OBEX file transfer
+    { "1116", "network" },    // PAN NAP
+};
+}
+
+QStringList Device::knownKinds()
+{
+    QStringList kinds;
+    for (const auto &k : FP6_KINDS)
+        kinds << QString::fromLatin1(k.kind);
+    return kinds;
+}
+
+QString Device::iconForKind(const QString &kind)
+{
+    for (const auto &k : FP6_KINDS)
+        if (kind == QLatin1String(k.kind))
+            return QString::fromLatin1(k.icon);
+    return QString();
+}
+
+QString Device::getName() const
+{
+    // BlueZ fills Alias with the name, or with the address ("AA-BB-..")
+    // when there is no name; never show the address as the name.
+    QString dashed = m_address;
+    dashed.replace(QLatin1Char(':'), QLatin1Char('-'));
+    if (!m_alias.isEmpty() && m_alias.compare(dashed, Qt::CaseInsensitive) != 0)
+        return m_alias;
+    if (m_name == QLatin1String("unknown") && !m_alias.isEmpty())
+        return QString();
+    return m_name;
+}
+
+bool Device::hasCustomName() const
+{
+    QString dashed = m_address;
+    dashed.replace(QLatin1Char(':'), QLatin1Char('-'));
+    return !m_alias.isEmpty() && m_alias != m_name
+        && m_alias.compare(dashed, Qt::CaseInsensitive) != 0;
+}
+
+QString Device::getAutoKind() const
+{
+    // Appearance (LE) first, it distinguishes earbuds.
+    // GAP Appearance: category = bits 15..6, subcategory = bits 5..0.
+    switch (m_appearance >> 6) {
+    case 0x001: return QStringLiteral("phone");     // 0x0040 Phone
+    case 0x002: return QStringLiteral("computer");  // 0x0080 Computer
+    case 0x003: return QStringLiteral("watch");     // 0x00C0 Watch
+    case 0x005: return QStringLiteral("tv");        // 0x0140 Display
+    case 0x00f: // 0x03C0 HID
+        switch (m_appearance & 0x3f) {
+        case 0x01: return QStringLiteral("keyboard");
+        case 0x02: return QStringLiteral("mouse");
+        case 0x03:
+        case 0x04: return QStringLiteral("gamepad");
+        }
+        break;
+    case 0x021: return QStringLiteral("speaker");   // 0x0840 Speaker
+    case 0x025: // 0x0940 Wearable audio device
+        switch (m_appearance & 0x3f) {
+        case 0x01: return QStringLiteral("earbuds");
+        case 0x02: return QStringLiteral("headset");
+        default:   return QStringLiteral("headphones");
+        }
+    }
+
+    switch (m_type) {
+    case Type::Headset:    return QStringLiteral("headset");
+    case Type::Headphones: return QStringLiteral("headphones");
+    case Type::Carkit:     return QStringLiteral("car");
+    case Type::Speakers:
+    case Type::OtherAudio: return QStringLiteral("speaker");
+    case Type::Video:      return QStringLiteral("tv");
+    case Type::Mouse:
+    case Type::Tablet:     return QStringLiteral("mouse");
+    case Type::Keyboard:
+    case Type::Keypad:     return QStringLiteral("keyboard");
+    case Type::Joypad:     return QStringLiteral("gamepad");
+    case Type::Cellular:
+    case Type::Smartphone:
+    case Type::Phone:      return QStringLiteral("phone");
+    case Type::Computer:   return QStringLiteral("computer");
+    case Type::Watch:      return QStringLiteral("watch");
+    default: break;
+    }
+
+    // BlueZ's Icon property as the last hint.
+    const QString &i = m_fallbackIconName;
+    if (i == QLatin1String("audio-headset")) return QStringLiteral("headset");
+    if (i == QLatin1String("audio-headphones")) return QStringLiteral("headphones");
+    if (i == QLatin1String("audio-card")) return QStringLiteral("speaker");
+    if (i == QLatin1String("input-keyboard")) return QStringLiteral("keyboard");
+    if (i == QLatin1String("input-mouse") || i == QLatin1String("input-tablet")) return QStringLiteral("mouse");
+    if (i == QLatin1String("input-gaming")) return QStringLiteral("gamepad");
+    if (i == QLatin1String("phone")) return QStringLiteral("phone");
+    if (i == QLatin1String("computer")) return QStringLiteral("computer");
+    if (i == QLatin1String("video-display")) return QStringLiteral("tv");
+    return QStringLiteral("other");
+}
+
+QString Device::getKind() const
+{
+    return m_kindOverride.isEmpty() ? getAutoKind() : m_kindOverride;
+}
+
+QVariantList Device::getProfiles() const
+{
+    QVariantList list;
+    QStringList seenLabels;
+    for (const auto &p : FP6_PROFILES) {
+        const QString label = QString::fromLatin1(p.label);
+        if (seenLabels.contains(label))
+            continue;
+        const QString prefix = QStringLiteral("0000%1-").arg(QLatin1String(p.uuid16));
+        for (const QString &uuid : m_uuids) {
+            if (uuid.startsWith(prefix, Qt::CaseInsensitive)) {
+                QVariantMap m;
+                m[QStringLiteral("uuid")] = uuid;
+                m[QStringLiteral("kind")] = label;
+                list << m;
+                seenLabels << label;
+                break;
+            }
+        }
+    }
+    return list;
+}
+
+void Device::reloadStore()
+{
+    const QString kind = Fp6Store::kindOverride(m_address);
+    const QString valid = iconForKind(kind).isEmpty() ? QString() : kind;
+    if (valid != m_kindOverride) {
+        m_kindOverride = valid;
+        updateIcon();
+        Q_EMIT(iconNameChanged());
+    }
+    const qint64 last = Fp6Store::lastConnected(m_address);
+    if (last != m_lastConnected) {
+        m_lastConnected = last;
+        Q_EMIT(lastConnectedChanged());
+    }
+}
+
+void Device::setKindOverride(const QString &kind)
+{
+    const QString valid = iconForKind(kind).isEmpty() ? QString() : kind;
+    Fp6Store::setKindOverride(m_address, valid, iconForKind(valid));
+    m_kindOverride = valid;
+    updateIcon();
+    Q_EMIT(iconNameChanged());
+}
+
+void Device::setBattery(int percentage)
+{
+    if (percentage < -1 || percentage > 100)
+        percentage = -1;
+    if (m_battery != percentage) {
+        m_battery = percentage;
+        Q_EMIT(batteryChanged());
+        Q_EMIT(deviceChanged());
+    }
+}
+
+void Device::setPairingFlag(bool pairing)
+{
+    if (m_isPairing != pairing) {
+        m_isPairing = pairing;
+        Q_EMIT(pairingChanged());
+    }
+}
+
+void Device::noteConnectionTransition(bool connected)
+{
+    Q_UNUSED(connected);
+    // "Last connected": stamped when a connection starts and when it ends.
+    if (!m_address.isEmpty() && m_paired) {
+        m_lastConnected = QDateTime::currentSecsSinceEpoch();
+        Fp6Store::setLastConnected(m_address, m_lastConnected);
+        Q_EMIT(lastConnectedChanged());
+    }
+}
+
+void Device::setAlias(const QString &alias)
+{
+    // An empty alias makes BlueZ fall back to the device's own name.
+    auto call = m_bluezDeviceProperties->Set(BLUEZ_DEVICE_IFACE, "Alias", QDBusVariant(alias.trimmed()));
+    auto watcher = new QDBusPendingCallWatcher(call, this);
+    QObject::connect(watcher, &QDBusPendingCallWatcher::finished, [this](QDBusPendingCallWatcher *watcher) {
+        QDBusPendingReply<void> reply = *watcher;
+        if (reply.isError())
+            qWarning() << "Could not rename device:" << reply.error().name();
+        Q_EMIT(aliasActionDone(!reply.isError()));
+        watcher->deleteLater();
+    });
+}
+
+void Device::connectProfile(const QString &uuid)
+{
+    auto call = m_bluezDevice->ConnectProfile(uuid);
+    auto watcher = new QDBusPendingCallWatcher(call, this);
+    QObject::connect(watcher, &QDBusPendingCallWatcher::finished, [this, uuid](QDBusPendingCallWatcher *watcher) {
+        QDBusPendingReply<void> reply = *watcher;
+        if (reply.isError())
+            qWarning() << "ConnectProfile failed:" << reply.error().name();
+        Q_EMIT(profileActionDone(uuid, true, !reply.isError(), reply.isError() ? reply.error().name() : QString()));
+        watcher->deleteLater();
+    });
+}
+
+void Device::disconnectProfile(const QString &uuid)
+{
+    auto call = m_bluezDevice->DisconnectProfile(uuid);
+    auto watcher = new QDBusPendingCallWatcher(call, this);
+    QObject::connect(watcher, &QDBusPendingCallWatcher::finished, [this, uuid](QDBusPendingCallWatcher *watcher) {
+        QDBusPendingReply<void> reply = *watcher;
+        if (reply.isError())
+            qWarning() << "DisconnectProfile failed:" << reply.error().name();
+        Q_EMIT(profileActionDone(uuid, false, !reply.isError(), reply.isError() ? reply.error().name() : QString()));
+        watcher->deleteLater();
+    });
+}
+
+void Device::slotBatteryChanged(const QString &interface, const QVariantMap &changedProperties,
+                                const QStringList &invalidatedProperties)
+{
+    Q_UNUSED(invalidatedProperties);
+    if (interface != BLUEZ_BATTERY_IFACE)
+        return;
+    if (changedProperties.contains(QStringLiteral("Percentage")))
+        setBattery(changedProperties.value(QStringLiteral("Percentage")).toInt());
+}
 
