+bool Agent::refuseUnsolicited(const QSharedPointer<Device> &device, const char *functionName)
+{
+    if (m_allowIncoming || (device && device->isPairing()))
+        return false;
+
+    qWarning() << "Refusing unsolicited pairing request (" << functionName
+               << "): pairing requests are off";
+    // Only our error reply, not QtDBus' automatic empty (= accepted) one.
+    setDelayedReply(true);
+    reject(message(), functionName);
+    return true;
+}
