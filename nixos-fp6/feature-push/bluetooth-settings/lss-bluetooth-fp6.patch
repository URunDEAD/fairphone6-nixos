+void Bluetooth::loadSettings()
+{
+    QSettings system(QString::fromLatin1(FP6_SYSTEM_DEFAULTS), QSettings::IniFormat);
+    QSettings user(Fp6Store::settingsPath(), QSettings::IniFormat);
+    auto value = [&](const char *key, const QVariant &fallback) {
+        const QString k = QString::fromLatin1(key);
+        return user.value(k, system.value(k, fallback));
+    };
+    m_visibleSetting = value("visible", true).toBool();
+    m_visibilityTimeout = qBound(0, value("visibility-timeout", 0).toInt(), 24 * 3600);
+    m_allowPairing = value("allow-pairing", true).toBool();
+    m_agent.setAllowIncoming(m_allowPairing);
+}
+
+void Bluetooth::saveSettings()
+{
+    QSettings user(Fp6Store::settingsPath(), QSettings::IniFormat);
+    user.setValue(QStringLiteral("visible"), m_visibleSetting);
+    user.setValue(QStringLiteral("visibility-timeout"), m_visibilityTimeout);
+    user.setValue(QStringLiteral("allow-pairing"), m_allowPairing);
+    user.sync();
+}
+
+bool Bluetooth::wantPairable() const
+{
+    return (m_allowPairing && m_active) || m_tempPairable;
+}
+
+void Bluetooth::applyVisibility(bool arm)
+{
+    if (!m_devices.hasAdapter() || !m_devices.isPowered())
+        return;
+
+    if (!m_visibleSetting) {
+        m_devices.trySetDiscoverable(false);
+        return;
+    }
+
+    if (m_visibilityTimeout > 0) {
+        // Timed: armed when the page opens or the switch is turned on;
+        // leaving the page does not end it, BlueZ does after the timeout.
+        if (arm) {
+            m_devices.setAdapterProperty(QStringLiteral("DiscoverableTimeout"), (uint) m_visibilityTimeout);
+            m_devices.setAdapterProperty(QStringLiteral("Discoverable"), true);
+        }
+        return;
+    }
+
+    // While the page is open.
+    if (m_active) {
+        m_devices.setAdapterProperty(QStringLiteral("DiscoverableTimeout"), FP6_SAFETY_TIMEOUT);
+        if (arm || !m_devices.isDiscoverable())
+            m_devices.setAdapterProperty(QStringLiteral("Discoverable"), true);
+    } else {
+        m_devices.trySetDiscoverable(false);
+    }
+}
+
+void Bluetooth::applyPolicy()
+{
+    m_agent.setAllowIncoming(m_allowPairing && m_active);
+
+    if (!m_devices.hasAdapter() || !m_devices.isPowered())
+        return;
+
+    // Keep-alive: re-arm the safety timeout of "while open" visibility.
+    if (m_visibleSetting && m_visibilityTimeout == 0 && m_active && m_devices.isDiscoverable())
+        m_devices.setAdapterProperty(QStringLiteral("DiscoverableTimeout"), FP6_SAFETY_TIMEOUT);
+
+    const bool want = wantPairable();
+    if (want) {
+        // Setting PairableTimeout restarts BlueZ's pairable timer.
+        m_devices.setAdapterProperty(QStringLiteral("PairableTimeout"), FP6_SAFETY_TIMEOUT);
+        if (!m_devices.isPairable())
+            m_devices.setAdapterProperty(QStringLiteral("Pairable"), true);
+    } else if (m_devices.isPairable() || !m_policyApplied) {
+        m_devices.setAdapterProperty(QStringLiteral("Pairable"), false);
+    }
+    m_policyApplied = true;
+}
+
+void Bluetooth::setVisibleSetting(bool visible)
+{
+    if (m_visibleSetting == visible)
+        return;
+    m_visibleSetting = visible;
+    saveSettings();
+    Q_EMIT(settingsChanged());
+    applyVisibility(true);
+}
+
+void Bluetooth::setVisibilityTimeout(int seconds)
+{
+    seconds = qBound(0, seconds, 24 * 3600);
