diff --git a/plugins/bluetooth/Fp6DeviceTypePage.qml b/plugins/bluetooth/Fp6DeviceTypePage.qml
new file mode 100644
index 0000000..ce218c9
--- /dev/null
+++ b/plugins/bluetooth/Fp6DeviceTypePage.qml
@@ -0,0 +1,73 @@
+/*
+ * FP6: choose the type (icon) of a paired device. Stored per user in
+ * $XDG_CONFIG_HOME/fp6-bluetooth/devices.ini (see fp6store.h), shared with
+ * the Bluetooth indicator and the sound UI. BlueZ's Icon is read-only.
+ * GPL-3.0, part of the FP6 lomiri-system-settings Bluetooth patch.
+ */
+import QtQuick 2.12
+import SystemSettings 1.0
+import SystemSettings.ListItems 1.0 as SettingsListItems
+import Lomiri.Components 1.3
+import Lomiri.SystemSettings.Bluetooth 1.0
+import "Fp6Kinds.js" as Fp6Kinds
+
+Page {
+    id: typePage
+    objectName: "fp6DeviceTypePage"
+
+    property LomiriBluetoothPanel backend: null
+    property var device: null
+
+    header: PageHeader {
+        title: i18n.tr("Device type")
+        flickable: typeFlick
+    }
+
+    function choose(kind) {
+        if (device)
+            device.setKindOverride(kind)
+        pageStack.removePages(typePage)
+    }
+
+    Flickable {
+        id: typeFlick
+        anchors.fill: parent
+        contentHeight: typeColumn.height
+        flickableDirection: Flickable.VerticalFlick
+
+        Column {
+            id: typeColumn
+            anchors { left: parent.left; right: parent.right }
+
+            SettingsListItems.Icon {
+                objectName: "fp6Kind_auto"
+                iconSource: device ? "image://theme/" + backend.iconForKind(device.autoKind) : ""
+                text: i18n.tr("Automatic")
+                layout.subtitle.text: device ? Fp6Kinds.label(device.autoKind) : ""
+                Icon {
+                    name: "tick"
+                    width: units.gu(2.5); height: width
+                    visible: device ? device.kindOverride.length === 0 : false
+                    SlotsLayout.position: SlotsLayout.Trailing
+                }
+                onClicked: typePage.choose("")
+            }
+
+            Repeater {
+                model: backend ? backend.kinds() : []
+                delegate: SettingsListItems.Icon {
+                    objectName: "fp6Kind_" + modelData
+                    iconSource: "image://theme/" + backend.iconForKind(modelData)
+                    text: Fp6Kinds.label(modelData)
+                    Icon {
+                        name: "tick"
+                        width: units.gu(2.5); height: width
+                        visible: device ? device.kindOverride === modelData : false
+                        SlotsLayout.position: SlotsLayout.Trailing
+                    }
+                    onClicked: typePage.choose(modelData)
+                }
+            }
+        }
+    }
+}
diff --git a/plugins/bluetooth/Fp6Kinds.js b/plugins/bluetooth/Fp6Kinds.js
new file mode 100644
index 0000000..6eeff73
--- /dev/null
+++ b/plugins/bluetooth/Fp6Kinds.js
@@ -0,0 +1,19 @@
+// FP6: labels of the device types (Device::knownKinds()). Not a
+// .pragma library, so i18n from the importing component is in scope.
+function label(kind) {
+    switch (kind) {
+    case "car":        return i18n.tr("Car")
+    case "speaker":    return i18n.tr("Speaker")
+    case "headphones": return i18n.tr("Headphones")
+    case "earbuds":    return i18n.tr("Earbuds")
+    case "headset":    return i18n.tr("Headset")
+    case "watch":      return i18n.tr("Watch")
+    case "keyboard":   return i18n.tr("Keyboard")
+    case "mouse":      return i18n.tr("Mouse")
+    case "gamepad":    return i18n.tr("Game controller")
+    case "phone":      return i18n.tr("Phone")
+    case "computer":   return i18n.tr("Computer")
+    case "tv":         return i18n.tr("TV")
+    default:           return i18n.tr("Other")
+    }
+}
diff --git a/plugins/bluetooth/Fp6RenameDialog.qml b/plugins/bluetooth/Fp6RenameDialog.qml
new file mode 100644
index 0000000..92b279b
--- /dev/null
+++ b/plugins/bluetooth/Fp6RenameDialog.qml
@@ -0,0 +1,53 @@
+/*
+ * FP6: rename dialog for this phone (adapter Alias) and paired devices
+ * (Device1.Alias). An empty name restores the system/device name.
+ * GPL-3.0, part of the FP6 lomiri-system-settings Bluetooth patch.
+ */
+import QtQuick 2.12
+import Lomiri.Components 1.3
+import Lomiri.Components.Popups 1.3
+
+Dialog {
+    id: dialog
+    objectName: "fp6RenameDialog"
+
+    property string name: ""
+    property string resetLabel: ""
+    property var saveHandler: null
+
+    function save(value) {
+        if (saveHandler)
+            saveHandler(value)
+        PopupUtils.close(dialog)
+    }
+
+    TextField {
+        id: field
+        objectName: "fp6RenameField"
+        text: dialog.name
+        maximumLength: 248 // HCI local name limit, in bytes for ASCII
+        inputMethodHints: Qt.ImhNoPredictiveText
+        Component.onCompleted: { selectAll(); forceActiveFocus() }
+        onAccepted: if (text.trim().length > 0) dialog.save(text)
+    }
+
+    Button {
+        objectName: "fp6RenameSave"
+        text: i18n.tr("Save")
+        color: theme.palette.normal.positive
+        enabled: field.text.trim().length > 0
+        onClicked: dialog.save(field.text)
+    }
+
+    Button {
+        objectName: "fp6RenameReset"
+        visible: dialog.resetLabel.length > 0
+        text: dialog.resetLabel
+        onClicked: dialog.save("")
+    }
+
+    Button {
+        text: i18n.tr("Cancel")
+        onClicked: PopupUtils.close(dialog)
+    }
+}
