diff --git a/plugins/bluetooth/fp6store.cpp b/plugins/bluetooth/fp6store.cpp
new file mode 100644
index 0000000..dcb6601
--- /dev/null
+++ b/plugins/bluetooth/fp6store.cpp
@@ -0,0 +1,96 @@
+#include "fp6store.h"
+
+#include <QCryptographicHash>
+#include <QDir>
+#include <QFileInfo>
+#include <QSettings>
+#include <QStandardPaths>
+
+namespace {
+QString xdgDir(const char *var, const QString &fallback)
+{
+    QString base = qEnvironmentVariable(var);
+    if (base.isEmpty() || !QDir::isAbsolutePath(base))
+        base = QDir::homePath() + fallback;
+    return base + QStringLiteral("/fp6-bluetooth");
+}
+
+QString configDir() { return xdgDir("XDG_CONFIG_HOME", QStringLiteral("/.config")); }
+QString stateDir() { return xdgDir("XDG_STATE_HOME", QStringLiteral("/.local/state")); }
+
+void ensureDir(const QString &file)
+{
+    QDir().mkpath(QFileInfo(file).absolutePath());
+}
+}
+
+QString Fp6Store::deviceKey(const QString &address)
+{
+    if (address.isEmpty())
+        return QString();
+    return QString::fromLatin1(QCryptographicHash::hash(address.toUpper().toUtf8(),
+                                                        QCryptographicHash::Sha256).toHex());
+}
+
+QString Fp6Store::devicesPath() { return configDir() + QStringLiteral("/devices.ini"); }
+QString Fp6Store::lastConnectedPath() { return stateDir() + QStringLiteral("/last-connected.ini"); }
+QString Fp6Store::settingsPath() { return configDir() + QStringLiteral("/settings.ini"); }
+
+QString Fp6Store::kindOverride(const QString &address)
+{
+    const QString key = deviceKey(address);
+    if (key.isEmpty())
+        return QString();
+    QSettings s(devicesPath(), QSettings::IniFormat);
+    return s.value(key + QStringLiteral("/type")).toString();
+}
+
+void Fp6Store::setKindOverride(const QString &address, const QString &kind, const QString &icon)
+{
+    const QString key = deviceKey(address);
+    if (key.isEmpty())
+        return;
+    ensureDir(devicesPath());
+    QSettings s(devicesPath(), QSettings::IniFormat);
+    if (kind.isEmpty()) {
+        s.remove(key);
+    } else {
+        s.setValue(key + QStringLiteral("/type"), kind);
+        s.setValue(key + QStringLiteral("/icon"), icon);
+    }
+    s.sync();
+}
+
+qint64 Fp6Store::lastConnected(const QString &address)
+{
+    const QString key = deviceKey(address);
+    if (key.isEmpty())
+        return 0;
+    QSettings s(lastConnectedPath(), QSettings::IniFormat);
+    return s.value(key + QStringLiteral("/last-connected")).toLongLong();
+}
+
+void Fp6Store::setLastConnected(const QString &address, qint64 when)
+{
+    const QString key = deviceKey(address);
+    if (key.isEmpty())
+        return;
+    ensureDir(lastConnectedPath());
+    QSettings s(lastConnectedPath(), QSettings::IniFormat);
+    s.setValue(key + QStringLiteral("/last-connected"), when);
+    s.sync();
+}
+
+void Fp6Store::forget(const QString &address)
+{
+    const QString key = deviceKey(address);
+    if (key.isEmpty())
+        return;
+    for (const QString &path : { devicesPath(), lastConnectedPath() }) {
+        if (!QFileInfo::exists(path))
+            continue;
+        QSettings s(path, QSettings::IniFormat);
+        s.remove(key);
+        s.sync();
+    }
+}
diff --git a/plugins/bluetooth/fp6store.h b/plugins/bluetooth/fp6store.h
new file mode 100644
index 0000000..d495ae2
--- /dev/null
+++ b/plugins/bluetooth/fp6store.h
@@ -0,0 +1,36 @@
+/*
+ * FP6: small per-user store shared with the Bluetooth indicator and the
+ * audio UI. Format (documented in results/feature-push-20261024/
+ * bluetooth-settings/README.md):
+ *
+ *   $XDG_CONFIG_HOME/fp6-bluetooth/devices.ini   (written by System Settings)
+ *     [<key>]
+ *     type=car            one of Device::knownKinds()
+ *     icon=audio-carkit-symbolic
+ *
+ *   $XDG_STATE_HOME/fp6-bluetooth/last-connected.ini
+ *     [<key>]
+ *     last-connected=1761500000     (unix seconds, UTC)
+ *
+ *   <key> = lowercase hex SHA-256 of the device address in upper case with
+ *   colons ("AA:BB:CC:DD:EE:FF", UTF-8, no newline). No address or name is
+ *   stored in clear.
+ */
+#ifndef FP6_BLUETOOTH_STORE_H
+#define FP6_BLUETOOTH_STORE_H
+
+#include <QString>
+
+namespace Fp6Store {
+    QString deviceKey(const QString &address);
+    QString devicesPath();
+    QString lastConnectedPath();
+    QString settingsPath();
+    QString kindOverride(const QString &address);
+    void setKindOverride(const QString &address, const QString &kind, const QString &icon);
+    qint64 lastConnected(const QString &address);
+    void setLastConnected(const QString &address, qint64 when);
+    void forget(const QString &address);
+}
+
+#endif
