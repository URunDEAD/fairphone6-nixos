+/**
+ * FP6: per-user store shared with System Settings > Bluetooth and the sound
+ * UI (format: lomiri-system-settings plugins/bluetooth/fp6store.h).
+ *   $XDG_CONFIG_HOME/fp6-bluetooth/devices.ini
+ *     [AA:BB:CC:DD:EE:FF]  name=  type=  icon=     (all optional)
+ *   $XDG_STATE_HOME/fp6-bluetooth/last-connected.ini
+ *     [AA:BB:CC:DD:EE:FF]  last-connected=<unix seconds>
+ * Directories 0700, files 0600, replaced atomically.
+ */
+public class Fp6Store : Object
+{
+  private KeyFile devices = new KeyFile ();
+  private FileMonitor? monitor = null;
+
+  public signal void changed ();
+
+  public static string key_for (string address)
+  {
+    return address.up ();
+  }
+
+  public static string devices_path ()
+  {
+    return Path.build_filename (Environment.get_user_config_dir (), "fp6-bluetooth", "devices.ini");
+  }
+
+  public static string state_path ()
+  {
+    var state = Environment.get_variable ("XDG_STATE_HOME");
+    if (state == null || !Path.is_absolute (state))
+      state = Path.build_filename (Environment.get_home_dir (), ".local", "state");
+    return Path.build_filename (state, "fp6-bluetooth", "last-connected.ini");
+  }
+
+  /* Icon for a type of the shared vocabulary (null = unknown type). */
+  public static string? icon_for_type (string type)
+  {
+    switch (type)
+      {
+        case "car":        return "audio-carkit-symbolic";
+        case "speaker":
+        case "hifi":
+        case "portable":   return "audio-speakers-symbolic";
+        case "headphones": return "audio-headphones-symbolic";
+        case "earbuds":    return "fp6-audio-earbuds-symbolic";
+        case "headset":    return "audio-headset-symbolic";
+        case "watch":      return "smartwatch-symbolic";
+        case "keyboard":   return "input-keyboard-symbolic";
+        case "mouse":      return "input-mouse-symbolic";
+        case "gamepad":    return "input-gaming-symbolic";
+        case "phone":      return "phone-smartphone-symbolic";
+        case "computer":   return "computer-symbolic";
+        case "tv":         return "video-display-symbolic";
+        case "other":      return "bluetooth-active";
+      }
+    return null;
+  }
+
+  public Fp6Store ()
+  {
+    reload ();
+    try
+      {
+        var dir = File.new_for_path (Path.get_dirname (devices_path ()));
+        // Watch the directory: QSettings replaces the file atomically.
+        DirUtils.create_with_parents (dir.get_path (), 0700);
+        monitor = dir.monitor_directory (FileMonitorFlags.NONE, null);
+        monitor.changed.connect ((file, other, event) => {
+          if (file.get_basename () == "devices.ini" &&
+              (event == FileMonitorEvent.CHANGES_DONE_HINT ||
+               event == FileMonitorEvent.CREATED ||
+               event == FileMonitorEvent.DELETED ||
+               event == FileMonitorEvent.RENAMED ||
+               event == FileMonitorEvent.MOVED_IN))
+            {
+              reload ();
+              changed ();
+            }
+        });
+      }
+    catch (Error e)
+      {
+        debug (@"fp6 store: no monitor: $(e.message)");
+      }
+  }
+
+  private void reload ()
+  {
+    devices = new KeyFile ();
+    try { devices.load_from_file (devices_path (), KeyFileFlags.NONE); }
+    catch (Error e) { }
+  }
+
+  /* The user's icon for this device (from type=, else icon=), or null. */
+  public string? icon_for (string? address)
+  {
+    if (address == null)
+      return null;
+    try
+      {
+        var type = devices.get_string (key_for (address), "type");
+        var icon = icon_for_type (type);
+        if (icon != null)
+          return icon;
+      }
+    catch (Error e) { }
+    try
+      {
+        var icon = devices.get_string (key_for (address), "icon");
+        return (icon != null && icon != "") ? icon : null;
+      }
+    catch (Error e)
+      {
+        return null;
+      }
+  }
+
+  /* The name chosen in Settings, or null (BlueZ Alias is used then). */
+  public string? name_for (string? address)
+  {
+    if (address == null)
+      return null;
+    try
+      {
+        var name = devices.get_string (key_for (address), "name").strip ();
+        return name != "" ? name : null;
+      }
+    catch (Error e)
+      {
+        return null;
+      }
+  }
+
+  public void record_connection (string? address)
+  {
+    if (address == null)
+      return;
+    var path = state_path ();
+    var kf = new KeyFile ();
+    try { kf.load_from_file (path, KeyFileFlags.KEEP_COMMENTS); } catch (Error e) { }
+    kf.set_int64 (key_for (address), "last-connected", get_real_time () / 1000000);
+    try
+      {
+        DirUtils.create_with_parents (Path.get_dirname (path), 0700);
+        FileUtils.set_contents_full (path, kf.to_data (), -1,
+                                     FileSetContentsFlags.CONSISTENT, 0600);
+        FileUtils.chmod (path, 0600);
+      }
+    catch (Error e)
+      {
+        debug (@"fp6 store: $(e.message)");
+      }
+  }
+
+  /* Same choice as System Settings when the user picked no type. */
+  public static string auto_icon (uint32 cls, uint16 appearance, string? bluez_icon)
+  {
+    switch (appearance >> 6)
+      {
+        case 0x001: return "phone-smartphone-symbolic";
+        case 0x002: return "computer-symbolic";
+        case 0x003: return "smartwatch-symbolic";
+        case 0x005: return "video-display-symbolic";
+        case 0x00f:
+          switch (appearance & 0x3f)
+            {
+              case 0x01: return "input-keyboard-symbolic";
+              case 0x02: return "input-mouse-symbolic";
+              case 0x03:
+              case 0x04: return "input-gaming-symbolic";
+            }
+          break;
+        case 0x021: return "audio-speakers-symbolic";
+        case 0x025:
+          switch (appearance & 0x3f)
+            {
+              case 0x01: return "fp6-audio-earbuds-symbolic";
+              case 0x02: return "audio-headset-symbolic";
+              default:   return "audio-headphones-symbolic";
+            }
+      }
+
+    var minor = (cls & 0xfc) >> 2;
+    switch ((cls & 0x1f00) >> 8)
+      {
+        case 0x01: return "computer-symbolic";
+        case 0x02: return "phone-smartphone-symbolic";
+        case 0x04:
+          switch (minor)
+            {
+              case 0x01:
+              case 0x02: return "audio-headset-symbolic";
+              case 0x06: return "audio-headphones-symbolic";
+              case 0x08: return "audio-carkit-symbolic";
+              case 0x0b:
+              case 0x0c:
+              case 0x0d:
+              case 0x0f: return "video-display-symbolic";
+              default:   return "audio-speakers-symbolic";
+            }
+        case 0x05:
+          if ((cls & 0x40) != 0) return "input-keyboard-symbolic";
+          if ((cls & 0x80) != 0) return "input-mouse-symbolic";
+          if (((cls & 0x1e) >> 2) == 0x01 || ((cls & 0x1e) >> 2) == 0x02) return "input-gaming-symbolic";
+          break;
+        case 0x07:
+          if ((cls & 0x4) != 0) return "smartwatch-symbolic";
+          break;
+      }
+
+    switch (bluez_icon ?? "")
+      {
+        case "audio-headset":    return "audio-headset-symbolic";
+        case "audio-headphones": return "audio-headphones-symbolic";
+        case "audio-card":       return "audio-speakers-symbolic";
+        case "input-keyboard":   return "input-keyboard-symbolic";
+        case "input-mouse":
+        case "input-tablet":     return "input-mouse-symbolic";
+        case "input-gaming":     return "input-gaming-symbolic";
+        case "phone":            return "phone-smartphone-symbolic";
+        case "computer":         return "computer-symbolic";
+        case "video-display":    return "video-display-symbolic";
+      }
+    return "bluetooth-active";
+  }
+}
