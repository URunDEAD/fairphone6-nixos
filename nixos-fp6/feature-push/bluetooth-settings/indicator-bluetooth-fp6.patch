+        return false;
+      });
+  }
+
+  static int compare_devices (Device a, Device b)
+  {
+    if (a.is_connected != b.is_connected)
+      return a.is_connected ? -1 : 1;
+    return a.name.collate (b.name);
+  }
+
+  string subtitle_for (Device device)
+  {
+    if (device.is_connected)
+      {
+        if (device.battery >= 0)
+          return _("Connected · battery %d %%").printf (device.battery);
+        return _("Connected");
+      }
+    return _("Not connected");
+  }
+
+  void rebuild_device_section ()
+  {
+    device_section.remove_all ();
+    if (!bluetooth.enabled)
+      return;
+
+    var devices = new List<unowned Device> ();
+    foreach (var d in bluetooth.get_devices ())
+      if (d.is_paired)
+        devices.insert_sorted (d, compare_devices);
+
+    foreach (var device in devices)
+      {
+        var id = device.id;
+        var name = @"phone-device-$(id)-connected";
+        var subtitle_name = @"phone-device-$(id)-subtitle";
+
+        var a = connect_actions.lookup (id);
+        if (a == null)
+          {
+            a = new SimpleAction.stateful (name, VariantType.BOOLEAN,
+                                           new Variant.boolean (device.is_connected));
+            a.activate.connect ((action, param) => action.change_state (param));
+            a.change_state.connect ((action, requested) =>
+              bluetooth.set_device_connected (id, requested.get_boolean ()));
+            connect_actions.insert (id, a);
+            action_group.add_action (a);
+          }
+        else
+          a.set_state (new Variant.boolean (device.is_connected));
+
+        var s = subtitle_actions.lookup (id);
+        if (s == null)
+          {
+            s = new SimpleAction.stateful (subtitle_name, null,
+                                           new Variant.string (subtitle_for (device)));
+            subtitle_actions.insert (id, s);
+            action_group.add_action (s);
+          }
+        else
+          s.set_state (new Variant.string (subtitle_for (device)));
+
+        var item = new MenuItem (device.name, @"indicator.$(name)(true)");
+        item.set_attribute ("x-ayatana-type", "s", "org.ayatana.indicator.switch");
+        item.set_attribute ("x-ayatana-subtitle-action", "s", @"indicator.$(subtitle_name)");
+        item.set_attribute_value ("icon", device.icon.serialize ());
+        device_section.append_item (item);
+      }
+  }
