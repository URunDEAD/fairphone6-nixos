@@ -18,10 +18,116 @@
 
 #include "ucunits_p.h"
 
+#include <QtCore/QCoreApplication>
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileSystemWatcher>
+#include <QtCore/QStandardPaths>
+#include <QtCore/QTimer>
+
 UT_NAMESPACE_BEGIN
 
 UCFontUtils *UCFontUtils::m_instance = nullptr;
 
+// FP6 text size (System Settings > Display Comfort).
+// UITK_FONT_SCALE (0.5..2.0, set by lomiri-session at login) is the start
+// value. When it is set, $XDG_CONFIG_HOME/lomiri-ui-toolkit/font-scale (one
+// integer, percent, 50..200; written by fp6-display-comfort) overrides it and
+// is watched, so the size also changes in running processes. Unset (greeter,
+// tests, other sessions): stock sizes, no file access, no watch.
+namespace {
+float g_userScale = -1.0f;
+
+bool validScale(float value)
+{
+    return value >= 0.5f && value <= 2.0f;
+}
+
+float envScale(bool *isSet)
+{
+    *isSet = qEnvironmentVariableIsSet("UITK_FONT_SCALE");
+    bool ok = false;
+    const float value = qEnvironmentVariable("UITK_FONT_SCALE").toFloat(&ok);
+    return (ok && validScale(value)) ? value : 1.0f;
+}
+
+QString liveScaleDir()
+{
+    return QStandardPaths::writableLocation(QStandardPaths::ConfigLocation)
+        + QStringLiteral("/lomiri-ui-toolkit");
+}
+
+QString liveScaleFile()
+{
+    return liveScaleDir() + QStringLiteral("/font-scale");
+}
+
+float fileScale(float fallback)
+{
+    QFile file(liveScaleFile());
+    if (!file.open(QIODevice::ReadOnly)) {
+        return fallback;
+    }
+    bool ok = false;
+    const int percent = file.read(16).trimmed().toInt(&ok);
+    return (ok && percent >= 50 && percent <= 200) ? percent / 100.0f : fallback;
+}
+
+void reloadLiveScale(QFileSystemWatcher *watcher)
+{
+    // Atomic writes (rename) drop the file watch; the directory watch stays.
+    const QString file = liveScaleFile();
+    if (!watcher->files().contains(file) && QFile::exists(file)) {
+        watcher->addPath(file);
+    }
+    bool isSet = false;
+    const float value = fileScale(envScale(&isSet));
+    if (qFuzzyCompare(value, g_userScale)) {
+        return;
+    }
+    g_userScale = value;
+    // The toolkit's own "units changed" path: Labels recompute their pixel
+    // size, and the units/FontUtils context properties are re-set, so every
+    // binding using units.gu() or FontUtils.sizeToPixels() is re-evaluated.
+    Q_EMIT UCUnits::instance()->gridUnitChanged();
+}
+} // namespace
+
+float UCFontUtils::userScale()
+{
+    if (g_userScale < 0.0f) {
+        bool isSet = false;
+        const float value = envScale(&isSet);
+        g_userScale = isSet ? fileScale(value) : value;
+    }
+    return g_userScale;
+}
+
+void UCFontUtils::watchUserScale()
+{
+    static bool started = false;
+    bool isSet = false;
+    envScale(&isSet);
+    if (started || !isSet || !QCoreApplication::instance()) {
+        return;
+    }
+    started = true;
+    userScale();
+    auto *watcher = new QFileSystemWatcher(QCoreApplication::instance());
+    QDir().mkpath(liveScaleDir());
+    watcher->addPath(liveScaleDir());
+    if (QFile::exists(liveScaleFile())) {
+        watcher->addPath(liveScaleFile());
+    }
+    // Coalesce the events of one write (create, modify, rename).
+    auto *debounce = new QTimer(watcher);
+    debounce->setSingleShot(true);
+    debounce->setInterval(150);
+    QObject::connect(debounce, &QTimer::timeout, watcher, [watcher] { reloadLiveScale(watcher); });
+    QObject::connect(watcher, &QFileSystemWatcher::directoryChanged, debounce, [debounce] { debounce->start(); });
+    QObject::connect(watcher, &QFileSystemWatcher::fileChanged, debounce, [debounce] { debounce->start(); });
+}
+
