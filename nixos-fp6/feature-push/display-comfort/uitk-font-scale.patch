diff -ru a/src/LomiriToolkit/ucfontutils.cpp b/src/LomiriToolkit/ucfontutils.cpp
--- a/src/LomiriToolkit/ucfontutils.cpp
+++ b/src/LomiriToolkit/ucfontutils.cpp
@@ -22,6 +22,16 @@
 
 UCFontUtils *UCFontUtils::m_instance = nullptr;
 
+float UCFontUtils::userScale()
+{
+    static const float scale = [] {
+        bool ok = false;
+        const float value = qEnvironmentVariable("UITK_FONT_SCALE").toFloat(&ok);
+        return (ok && value >= 0.5f && value <= 2.0f) ? value : 1.0f;
+    }();
+    return scale;
+}
+
 /*!
  * \qmltype FontUtils
  * \instantiates UCFontUtils
@@ -68,7 +78,7 @@
  */
 qreal UCFontUtils::sizeToPixels(const QString &size)
 {
-    return modularScale(size) * UCUnits::instance()->dp(fontUnits);
+    return modularScale(size) * UCUnits::instance()->dp(fontUnits) * userScale();
 }
 
 /*!
