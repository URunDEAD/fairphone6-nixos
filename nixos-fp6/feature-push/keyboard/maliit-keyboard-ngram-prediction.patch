diff --git a/tests/fp6/ngrampredictor_test.cpp b/tests/fp6/ngrampredictor_test.cpp
new file mode 100644
index 0000000..7e567a8
--- /dev/null
+++ b/tests/fp6/ngrampredictor_test.cpp
@@ -0,0 +1,158 @@
+// Unit test for plugins/westernsupport/ngrampredictor.{h,cpp} (FP6).
+// Build: c++ -std=c++17 -fPIC -I../plugins/westernsupport ngrampredictor_test.cpp
+//        ../plugins/westernsupport/ngrampredictor.cpp $(pkg-config --cflags --libs Qt5Core)
+// Run:   ./ngrampredictor_test [MODEL.tsv PARITY.tsv]...
+// The optional pairs check that C++ predictions equal those of the Rust
+// model builder (fp6-kbd-ngram parity output: left \t prefix \t a|b|c).
+#include "ngrampredictor.h"
+
+#include <QCoreApplication>
+#include <QDir>
+#include <QFile>
+#include <QTemporaryDir>
+#include <QTextStream>
+
+#include <cstdio>
+
+static int failures = 0;
+#define CHECK_EQ(a, b) do { const auto _a = (a); const auto _b = (b); if (!(_a == _b)) { \
+    ++failures; fprintf(stderr, "FAIL %s:%d: %s\n  got:      %s\n  expected: %s\n", __FILE__, __LINE__, #a, \
+    qPrintable(QVariant::fromValue(_a).toStringList().join(QLatin1Char('|')) + QVariant::fromValue(_a).toString()), \
+    qPrintable(QVariant::fromValue(_b).toStringList().join(QLatin1Char('|')) + QVariant::fromValue(_b).toString())); } } while (0)
+#define CHECK(c) do { if (!(c)) { ++failures; fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+static QString u(const char *s) { return QString::fromUtf8(s); }
+static QStringList ul(std::initializer_list<const char *> l) { QStringList r; for (auto s : l) r << u(s); return r; }
+
+static NgramModel modelFrom(const QString &tsv)
+{
+    QTemporaryDir dir;
+    const QString p = dir.path() + QStringLiteral("/m.tsv");
+    QFile f(p);
+    f.open(QIODevice::WriteOnly);
+    f.write(tsv.toUtf8());
+    f.close();
+    NgramModel m;
+    QString err;
+    CHECK(m.load(p, &err));
+    return m;
+}
+
+int main(int argc, char **argv)
+{
+    QCoreApplication app(argc, argv);
+    using namespace NgramText;
+
+    // Romanian normalisation: cedilla -> comma below, old marks.
+    CHECK_EQ(normalize(u("ro"), u("şi ţară ŞI ŢARĂ")), u("și țară ȘI ȚARĂ"));
+    CHECK_EQ(normalize(u("ro"), u("şi țara")), u("și țara"));
+    CHECK_EQ(normalize(u("ro"), u("mãr făcù s’a")), u("măr făcu s-a"));
+    CHECK_EQ(normalize(u("tr"), u("şeker")), u("şeker"));
+    CHECK_EQ(fold(u("ăâîșțşţ")), u("aaistst"));
+
+    // Tokenising and context.
+    QList<QStringList> s = sentences(u("Ș-apoi într-o zi, s-au dus. Ce-i? 12 mere"));
+    CHECK_EQ(s.size(), 3);
+    CHECK_EQ(s.value(0), ul({"Ș-apoi", "într-o", "zi", "s-au", "dus"}));
+    CHECK_EQ(s.value(2), ul({"mere"}));
+    CHECK_EQ(contextOf(u("ro"), u("")), ul({"<s>", "<s>"}));
+    CHECK_EQ(contextOf(u("ro"), u("Bună ziua. Ce ")), ul({"<s>", "ce"}));
+    CHECK_EQ(contextOf(u("ro"), u("Mă duc acasă, şi ")), ul({"acasă", "și"}));
+    CHECK_EQ(contextOf(u("en"), u("Hello!\n")), ul({"<s>", "<s>"}));
+
+    // Completed-word detection for learning.
+    CHECK_EQ(lastCompletedWord(u("ro"), u("Mă duc acasă ")), ul({"mă", "duc", "acasă"}));
+    CHECK_EQ(lastCompletedWord(u("ro"), u("Bună ziua. ")), ul({"<s>", "bună", "ziua"}));
+    CHECK_EQ(lastCompletedWord(u("ro"), u("Ana ")), ul({"<s>", "<s>", "Ana"}));
+    CHECK(lastCompletedWord(u("ro"), u("Mă duc aca")).isEmpty());
+    CHECK(lastCompletedWord(u("ro"), u("   ")).isEmpty());
+    CHECK(lastCompletedWord(u("ro"), u("")).isEmpty());
+
+    // Prediction over a small model (same fixture as the Rust tests).
+    const QString tsv = u("#fp6-ngram\t1\n#lang\tro\n"
+        "1\tfață\tfață\t2\n1\tfată\tfată\t1\n1\tfata\tfata\t1\n1\tștergi\tștergi\t1\n"
+        "2\t<s>\tfață\t1\n2\tfață\tfață\t1\n2\tfață\tfată\t1\n2\tfată\tfata\t1\n2\tfata\tștergi\t1\n");
+    NgramModel m = modelFrom(tsv);
+    CHECK_EQ(m.vocabulary(), 4);
+    CHECK_EQ(m.total(), quint64(5));
+    const QStringList ctx = contextOf(u("ro"), u(""));
+    CHECK_EQ(m.predict(nullptr, ctx, u("fat"), 5), ul({"față", "fata", "fată"}));
+    CHECK(m.predict(nullptr, ctx, u("fă"), 5).isEmpty());
+    CHECK_EQ(m.predict(nullptr, ctx, u("ster"), 5), ul({"ștergi"}));
+    CHECK_EQ(m.predict(nullptr, ctx, u("ș"), 5), ul({"ștergi"}));
+    CHECK(m.predict(nullptr, ctx, u("fata"), 5).isEmpty() || !m.predict(nullptr, ctx, u("fata"), 5).contains(u("fata")));
+
+    // Learning, persistence, user weight.
+    NgramModel user;
+    user.learn(ctx, u("fată"));
+    CHECK_EQ(m.predict(&user, ctx, u("fat"), 1), ul({"fată"}));
+    user.learn(ul({"<s>", "ion"}), u("Calculator"));
+    CHECK_EQ(m.predict(&user, ul({"<s>", "ion"}), u("calc"), 3), ul({"Calculator"}));
+    QTemporaryDir dir;
+    const QString up = dir.path() + QStringLiteral("/sub/ro_ngram_user.tsv");
+    CHECK(user.save(up, u("ro")));
+    NgramModel back;
+    CHECK(back.load(up));
+    CHECK_EQ(back.entries(), user.entries());
+    CHECK_EQ(m.predict(&back, ul({"<s>", "ion"}), u("calc"), 3), ul({"Calculator"}));
+    back.pruneSingletons();
+    CHECK_EQ(back.entries(), 0);
+
+    // Malformed files are rejected.
+    {
+        QTemporaryDir d;
+        QFile f(d.path() + QStringLiteral("/bad.tsv"));
+        f.open(QIODevice::WriteOnly);
+        f.write("#fp6-ngram\t1\n2\ta\tb\tq\n");
+        f.close();
+        NgramModel bad;
+        QString err;
+        CHECK(!bad.load(f.fileName(), &err));
+        CHECK(bad.isEmpty());
+        CHECK(!bad.load(d.path() + QStringLiteral("/missing.tsv")));
+    }
+
+    // Parity with the Rust builder on real models.
+    int parity = 0;
+    for (int i = 1; i + 1 < argc; i += 2) {
+        NgramModel real;
+        QString err;
+        if (!real.load(QString::fromLocal8Bit(argv[i]), &err)) {
+            ++failures;
+            fprintf(stderr, "FAIL cannot load %s: %s\n", argv[i], qPrintable(err));
+            continue;
+        }
+        QFile pf(QString::fromLocal8Bit(argv[i + 1]));
+        CHECK(pf.open(QIODevice::ReadOnly | QIODevice::Text));
+        QTextStream in(&pf);
+        in.setCodec("UTF-8");
+        QString lang;
+        {
+            QFile mf(QString::fromLocal8Bit(argv[i]));
+            mf.open(QIODevice::ReadOnly);
+            mf.readLine();
+            lang = QString::fromUtf8(mf.readLine()).trimmed().section(QLatin1Char('\t'), 1);
+        }
+        while (!in.atEnd()) {
+            const QStringList f = in.readLine().split(QLatin1Char('\t'));
+            if (f.size() != 3)
+                continue;
+            const QStringList expected = f.at(2).isEmpty() ? QStringList() : f.at(2).split(QLatin1Char('|'));
+            const QStringList got = real.predict(nullptr, contextOf(lang, f.at(0)), normalize(lang, f.at(1)), 5);
+            if (got != expected) {
+                ++failures;
+                fprintf(stderr, "FAIL parity %s [%s|%s]\n  c++:  %s\n  rust: %s\n", qPrintable(lang),
+                        qPrintable(f.at(0)), qPrintable(f.at(1)), qPrintable(got.join(QLatin1Char('|'))),
+                        qPrintable(expected.join(QLatin1Char('|'))));
+            }
+            ++parity;
+        }
+    }
+
+    if (failures) {
+        fprintf(stderr, "ngrampredictor_test: %d failure(s)\n", failures);
+        return 1;
+    }
+    printf("ngrampredictor_test: ok (%d parity queries)\n", parity);
+    return 0;
+}
