+#include "ngrampredictor.h"
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QSaveFile>
+#include <QTextStream>
+
+#include <algorithm>
+
+const double NgramModel::BackoffBigram = 0.4;
+const double NgramModel::BackoffUnigram = 0.16;
+const double NgramModel::UserWeight = 4.0;
+
+namespace NgramText {
+
+const QString SentenceStart = QStringLiteral("<s>");
+
+QString normalize(const QString &lang, const QString &text)
+{
+    const bool ro = (lang == QLatin1String("ro"));
+    QString out;
+    out.reserve(text.size());
+    for (int i = 0; i < text.size(); ++i) {
+        QChar c = text.at(i);
+        const ushort u = c.unicode();
+        if (u == 0x2019 || u == 0x2018 || u == 0x02BC)
+            c = QLatin1Char('\'');
+        else if (u == 0x2010 || u == 0x2011)
+            c = QLatin1Char('-');
+        if (ro) {
+            // s/t + combining comma below (U+0326) or cedilla (U+0327)
+            if ((c == QLatin1Char('s') || c == QLatin1Char('t') || c == QLatin1Char('S') || c == QLatin1Char('T'))
+                    && i + 1 < text.size()
+                    && (text.at(i + 1).unicode() == 0x0326 || text.at(i + 1).unicode() == 0x0327)) {
+                static const QString commaBelow = QString::fromUtf8("șțȘȚ");
+                out.append(commaBelow.at(QStringLiteral("stST").indexOf(c)));
+                ++i;
+                continue;
+            }
+            switch (c.unicode()) {
+            case 0x015F: c = QChar(0x0219); break; // ş -> ș
+            case 0x0163: c = QChar(0x021B); break; // ţ -> ț
+            case 0x015E: c = QChar(0x0218); break; // Ş -> Ș
+            case 0x0162: c = QChar(0x021A); break; // Ţ -> Ț
+            case 0x00E3: c = QChar(0x0103); break; // ã -> ă
+            case 0x00C3: c = QChar(0x0102); break; // Ã -> Ă
+            case 0x00E0: c = QLatin1Char('a'); break; // old stress marks
+            case 0x00E8: c = QLatin1Char('e'); break;
+            case 0x00EC: c = QLatin1Char('i'); break;
+            case 0x00F2: c = QLatin1Char('o'); break;
+            case 0x00F9: c = QLatin1Char('u'); break;
+            case 0x00C0: c = QLatin1Char('A'); break;
+            case 0x00C8: c = QLatin1Char('E'); break;
+            case 0x00CC: c = QLatin1Char('I'); break;
+            case 0x00D2: c = QLatin1Char('O'); break;
+            case 0x00D9: c = QLatin1Char('U'); break;
+            case '\'': c = QLatin1Char('-'); break;
+            default: break;
+            }
+        }
+        out.append(c);
+    }
+    return out;
+}
+
+QChar foldChar(QChar c)
+{
+    static const struct { const char *from; char to; } table[] = {
+        { "àáâãäåāăą", 'a' }, { "çćĉċč", 'c' }, { "ďđ", 'd' },
+        { "èéêëēĕėęě", 'e' }, { "ĝğġģ", 'g' }, { "ìíîïĩīĭįı", 'i' },
+        { "łľĺļ", 'l' }, { "ñńňņ", 'n' }, { "òóôõöøōŏő", 'o' },
+        { "ŕř", 'r' }, { "śŝşšș", 's' }, { "ţťț", 't' },
+        { "ùúûüũūŭůűų", 'u' }, { "ýÿ", 'y' }, { "źżž", 'z' },
+    };
+    static QHash<QChar, QChar> map;
+    if (map.isEmpty()) {
+        QHash<QChar, QChar> m;
+        for (const auto &row : table) {
+            const QString from = QString::fromUtf8(row.from);
+            for (QChar f : from)
+                m.insert(f, QLatin1Char(row.to));
+        }
+        map = m;
+    }
+    if (c.unicode() < 0x80)
+        return c;
+    return map.value(c, c);
+}
+
+QString fold(const QString &s)
+{
+    QString out(s);
+    for (int i = 0; i < out.size(); ++i)
+        out[i] = foldChar(out.at(i));
+    return out;
+}
+
+bool isSentenceBreak(QChar c)
+{
+    switch (c.unicode()) {
+    case '.': case '!': case '?': case ';': case ':': case '\n': case '\r': case 0x2026:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool isJoiner(QChar c)
+{
+    return c == QLatin1Char('-') || c == QLatin1Char('\'');
+}
+
+QList<QStringList> sentences(const QString &text)
+{
+    QList<QStringList> out;
+    QStringList cur;
+    QString word;
+    bool junk = false;
+    auto flush = [&]() {
+        int b = 0, e = word.size();
+        while (b < e && isJoiner(word.at(b))) ++b;
+        while (e > b && isJoiner(word.at(e - 1))) --e;
+        const QString w = word.mid(b, e - b);
+        if (!junk && !w.isEmpty())
+            cur.append(w);
+        word.clear();
+        junk = false;
+    };
+    for (int i = 0; i < text.size(); ++i) {
+        const QChar c = text.at(i);
+        if (c.isLetter()) {
+            word.append(c);
+        } else if (isJoiner(c) && !word.isEmpty() && i + 1 < text.size() && text.at(i + 1).isLetter()) {
+            word.append(c);
+        } else if (c.isDigit() && !word.isEmpty()) {
+            junk = true;
+            word.append(c);
+        } else {
+            flush();
+            if (isSentenceBreak(c) && !cur.isEmpty()) {
+                out.append(cur);
+                cur.clear();
+            }
+        }
+    }
+    flush();
+    if (!cur.isEmpty())
+        out.append(cur);
+    return out;
+}
+
+static QString currentSentence(const QString &norm)
+{
+    for (int i = norm.size() - 1; i >= 0; --i) {
+        if (isSentenceBreak(norm.at(i)))
+            return norm.mid(i + 1);
+    }
+    return norm;
+}
+
+static QStringList lastTwo(const QStringList &words)
+{
+    QStringList ctx { SentenceStart, SentenceStart };
+    for (const QString &w : words)
+        ctx.append(w.toLower());
+    return ctx.mid(ctx.size() - 2);
+}
+
+QStringList contextOf(const QString &lang, const QString &left)
+{
+    const QString tail = currentSentence(normalize(lang, left));
+    QStringList words;
+    for (const QStringList &s : sentences(tail))
+        words += s;
+    return lastTwo(words);
+}
+
+QStringList lastCompletedWord(const QString &lang, const QString &left)
+{
+    if (left.isEmpty() || left.at(left.size() - 1).isLetter()
+            || isJoiner(left.at(left.size() - 1)) || left.at(left.size() - 1).isDigit())
+        return QStringList();
+    const QString norm = normalize(lang, left);
+    // Drop trailing separators, then look at the sentence that ends there.
+    int end = norm.size();
+    while (end > 0 && !norm.at(end - 1).isLetter())
+        --end;
+    if (end == 0)
+        return QStringList();
+    const QString tail = currentSentence(norm.left(end));
+    QStringList words;
+    for (const QStringList &s : sentences(tail))
+        words += s;
+    if (words.isEmpty())
+        return QStringList();
+    const QString word = words.takeLast();
+    return lastTwo(words) << word;
+}
+
+} // namespace NgramText
+
+using namespace NgramText;
+
+QString NgramModel::triKey(const QString &h2, const QString &h1)
+{
+    return h2 + QChar(0x1f) + h1;
+}
+
+void NgramModel::clear()
+{
+    m_uni.clear();
+    m_bi.clear();
+    m_tri.clear();
+    m_biCtx.clear();
+    m_triCtx.clear();
+    m_total = 0;
+    m_indexDirty = true;
+}
+
+int NgramModel::entries() const
+{
+    int n = m_uni.size();
+    for (const auto &m : m_bi) n += m.size();
+    for (const auto &m : m_tri) n += m.size();
+    return n;
+}
+
+bool NgramModel::load(const QString &path, QString *error)
+{
+    clear();
+    QFile f(path);
+    if (!f.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        if (error) *error = f.errorString();
+        return false;
+    }
+    QTextStream in(&f);
+    in.setCodec("UTF-8");
+    QString line = in.readLine();
+    if (line != QLatin1String("#fp6-ngram\t1")) {
+        if (error) *error = QStringLiteral("not an fp6-ngram v1 file");
+        return false;
+    }
+    int lineNo = 1;
+    bool ok = true;
+    while (!in.atEnd()) {
+        line = in.readLine();
+        ++lineNo;
+        if (line.isEmpty() || line.startsWith(QLatin1Char('#')))
+            continue;
+        const QStringList f = line.split(QLatin1Char('\t'));
+        bool numOk = false;
+        if (f.at(0) == QLatin1String("1") && f.size() == 4) {
+            const quint64 c = f.at(3).toULongLong(&numOk);
+            m_uni.insert(f.at(1), Uni { f.at(2), c });
+            m_total += c;
+        } else if (f.at(0) == QLatin1String("2") && f.size() == 4) {
+            const quint64 c = f.at(3).toULongLong(&numOk);
+            m_bi[f.at(1)].insert(f.at(2), c);
+            m_biCtx[f.at(1)] += c;
+        } else if (f.at(0) == QLatin1String("3") && f.size() == 5) {
+            const quint64 c = f.at(4).toULongLong(&numOk);
+            const QString k = triKey(f.at(1), f.at(2));
+            m_tri[k].insert(f.at(3), c);
+            m_triCtx[k] += c;
+        }
+        if (!numOk) {
+            ok = false;
+            break;
+        }
+    }
+    if (!ok) {
+        if (error) *error = QStringLiteral("malformed record on line %1").arg(lineNo);
+        clear();
+        return false;
+    }
+    m_indexDirty = true;
+    return true;
+}
+
+bool NgramModel::save(const QString &path, const QString &lang) const
+{
+    QDir().mkpath(QFileInfo(path).absolutePath());
+    QSaveFile f(path);
+    if (!f.open(QIODevice::WriteOnly | QIODevice::Text))
+        return false;
+    QTextStream out(&f);
+    out.setCodec("UTF-8");
+    out << "#fp6-ngram\t1\n#lang\t" << lang << "\n#source\tlearned on this device\n";
+    QStringList keys = m_uni.keys();
+    std::sort(keys.begin(), keys.end());
+    for (const QString &k : keys)
+        out << "1\t" << k << '\t' << m_uni.value(k).surface << '\t' << m_uni.value(k).count << '\n';
+    QStringList ctxs = m_bi.keys();
+    std::sort(ctxs.begin(), ctxs.end());
+    for (const QString &h : ctxs) {
+        QStringList ws = m_bi.value(h).keys();
+        std::sort(ws.begin(), ws.end());
+        for (const QString &w : ws)
+            out << "2\t" << h << '\t' << w << '\t' << m_bi.value(h).value(w) << '\n';
+    }
+    ctxs = m_tri.keys();
+    std::sort(ctxs.begin(), ctxs.end());
+    for (const QString &k : ctxs) {
+        const QStringList hs = k.split(QChar(0x1f));
+        QStringList ws = m_tri.value(k).keys();
+        std::sort(ws.begin(), ws.end());
+        for (const QString &w : ws)
+            out << "3\t" << hs.value(0) << '\t' << hs.value(1) << '\t' << w << '\t' << m_tri.value(k).value(w) << '\n';
+    }
+    out.flush();
+    return f.commit();
+}
+
+void NgramModel::learn(const QStringList &context, const QString &word)
+{
+    const QString l = word.toLower();
+    if (l.isEmpty() || l.contains(QLatin1Char('\t')) || l == SentenceStart)
+        return;
+    const QString h1 = context.value(context.size() - 1, SentenceStart);
+    auto it = m_uni.find(l);
+    if (it == m_uni.end()) {
+        // Keep the typed capitalisation of words seen mid-sentence (names).
+        m_uni.insert(l, Uni { h1 != SentenceStart ? word : l, 1 });
+        m_indexDirty = true;
+    } else {
+        it->count += 1;
+    }
+    m_total += 1;
+    m_bi[h1][l] += 1;
+    m_biCtx[h1] += 1;
+    if (h1 != SentenceStart) {
+        const QString h2 = context.size() >= 2 ? context.at(context.size() - 2) : SentenceStart;
+        const QString k = triKey(h2, h1);
+        m_tri[k][l] += 1;
+        m_triCtx[k] += 1;
+    }
+}
+
+void NgramModel::pruneSingletons()
+{
+    for (auto it = m_tri.begin(); it != m_tri.end();) {
+        for (auto w = it->begin(); w != it->end();)
+            w = (w.value() <= 1) ? it->erase(w) : std::next(w);
+        it = it->isEmpty() ? m_tri.erase(it) : std::next(it);
+    }
+    for (auto it = m_bi.begin(); it != m_bi.end();) {
+        for (auto w = it->begin(); w != it->end();)
+            w = (w.value() <= 1) ? it->erase(w) : std::next(w);
+        it = it->isEmpty() ? m_bi.erase(it) : std::next(it);
+    }
+    for (auto it = m_uni.begin(); it != m_uni.end();)
+        it = (it->count <= 1) ? m_uni.erase(it) : std::next(it);
+    m_total = 0;
+    for (const Uni &u : m_uni) m_total += u.count;
+    m_biCtx.clear();
+    for (auto it = m_bi.constBegin(); it != m_bi.constEnd(); ++it)
+        for (quint64 c : it.value()) m_biCtx[it.key()] += c;
+    m_triCtx.clear();
+    for (auto it = m_tri.constBegin(); it != m_tri.constEnd(); ++it)
+        for (quint64 c : it.value()) m_triCtx[it.key()] += c;
+    m_indexDirty = true;
+}
+
+void NgramModel::reindex() const
+{
+    if (!m_indexDirty)
+        return;
+    m_byExact.clear();
+    m_byFolded.clear();
+    m_byExact.reserve(m_uni.size());
+    m_byFolded.reserve(m_uni.size());
+    for (auto it = m_uni.constBegin(); it != m_uni.constEnd(); ++it) {
+        m_byExact.append(it.key());
+        m_byFolded.append(qMakePair(fold(it.key()), it.key()));
+    }
+    std::sort(m_byExact.begin(), m_byExact.end());
+    std::sort(m_byFolded.begin(), m_byFolded.end());
+    m_indexDirty = false;
+}
+
+QVector<QString> NgramModel::withPrefix(const QString &prefix, bool folded) const
+{
+    reindex();
+    QVector<QString> out;
+    if (folded) {
+        auto it = std::lower_bound(m_byFolded.constBegin(), m_byFolded.constEnd(), prefix,
+                                   [](const QPair<QString, QString> &a, const QString &p) { return a.first < p; });
+        for (; it != m_byFolded.constEnd() && it->first.startsWith(prefix); ++it)
+            out.append(it->second);
+    } else {
+        auto it = std::lower_bound(m_byExact.constBegin(), m_byExact.constEnd(), prefix);
+        for (; it != m_byExact.constEnd() && it->startsWith(prefix); ++it)
+            out.append(*it);
+    }
+    return out;
+}
+
+quint64 NgramModel::biCount(const QString &h, const QString &w) const
+{
+    auto it = m_bi.constFind(h);
+    return it == m_bi.constEnd() ? 0 : it->value(w, 0);
+}
+
+quint64 NgramModel::triCount(const QString &k, const QString &w) const
+{
+    auto it = m_tri.constFind(k);
+    return it == m_tri.constEnd() ? 0 : it->value(w, 0);
+}
+
+QStringList NgramModel::predict(const NgramModel *user, const QStringList &context,
+                                const QString &prefix, int limit) const
+{
+    const QString pl = prefix.toLower();
+    if (pl.isEmpty() || limit <= 0)
+        return QStringList();
+    static const NgramModel empty;
+    if (!user)
+        user = &empty;
+    const bool foldedMode = (fold(pl) == pl);
+    auto matches = [&](const QString &w) {
+        return foldedMode ? fold(w).startsWith(pl) : w.startsWith(pl);
+    };
+    const double uw = UserWeight;
+    QHash<QString, double> scores;
+    auto bump = [&](const QString &w, double s) {
+        auto it = scores.find(w);
+        if (it == scores.end())
+            scores.insert(w, s);
+        else if (s > *it)
+            *it = s;
+    };
+    const QString h1 = context.value(context.size() - 1, SentenceStart);
+    const QString h2 = context.size() >= 2 ? context.at(context.size() - 2) : SentenceStart;
+
+    const QString k3 = triKey(h2, h1);
+    const double d3 = m_triCtx.value(k3, 0) + uw * user->m_triCtx.value(k3, 0);
+    if (d3 > 0) {
+        for (const NgramModel *m : { this, user }) {
+            auto it = m->m_tri.constFind(k3);
+            if (it == m->m_tri.constEnd())
+                continue;
+            for (auto w = it->constBegin(); w != it->constEnd(); ++w)
+                if (matches(w.key()))
+                    bump(w.key(), (triCount(k3, w.key()) + uw * user->triCount(k3, w.key())) / d3);
+        }
+    }
+    const double d2 = m_biCtx.value(h1, 0) + uw * user->m_biCtx.value(h1, 0);
+    if (d2 > 0) {
+        for (const NgramModel *m : { this, user }) {
+            auto it = m->m_bi.constFind(h1);
+            if (it == m->m_bi.constEnd())
+                continue;
+            for (auto w = it->constBegin(); w != it->constEnd(); ++w)
+                if (matches(w.key()))
+                    bump(w.key(), BackoffBigram * (biCount(h1, w.key()) + uw * user->biCount(h1, w.key())) / d2);
+        }
+    }
+    const double d1 = m_total + uw * user->m_total;
+    if (d1 > 0) {
+        for (const NgramModel *m : { this, user })
+            for (const QString &w : m->withPrefix(pl, foldedMode))
+                bump(w, BackoffUnigram * (uniCount(w) + uw * user->uniCount(w)) / d1);
+    }
+    scores.remove(pl);
+
+    QVector<QPair<double, QString>> ranked;
+    ranked.reserve(scores.size());
+    for (auto it = scores.constBegin(); it != scores.constEnd(); ++it)
+        ranked.append(qMakePair(it.value(), it.key()));
+    std::sort(ranked.begin(), ranked.end(), [](const QPair<double, QString> &a, const QPair<double, QString> &b) {
+        if (a.first != b.first)
+            return a.first > b.first;
+        return a.second < b.second;
+    });
+    QStringList out;
+    for (const auto &r : ranked) {
+        if (out.size() >= limit)
+            break;
+        QString surface = r.second;
+        auto u = m_uni.constFind(r.second);
+        if (u != m_uni.constEnd()) {
+            surface = u->surface;
+        } else {
+            auto v = user->m_uni.constFind(r.second);
+            if (v != user->m_uni.constEnd())
+                surface = v->surface;
+        }
+        out.append(surface);
+    }
+    return out;
+}
