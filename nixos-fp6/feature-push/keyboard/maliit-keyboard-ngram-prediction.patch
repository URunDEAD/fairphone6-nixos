+++ b/plugins/westernsupport/ngrampredictor.h
@@ -0,0 +1,90 @@
+/*
+ * Word n-gram prediction for the western language plugins (Fairphone 6).
+ *
+ * Replaces the presage-based prediction that upstream removed in 2.3.1
+ * ("Remove text prediction feature for now", #146). Models are plain TSV
+ * files ("fp6-ngram 1") built by fp6-kbd-ngram from public-domain/CC0
+ * corpora and installed next to each language plugin as ngram_<lang>.tsv.
+ * Words the user types are learned into a per-language user model.
+ *
+ * Scoring is stupid backoff over trigram/bigram/unigram counts, with
+ * diacritic-insensitive prefix matching while the typed prefix has no
+ * diacritics ("fata" -> "față"). Keep in sync with
+ * nixos-fp6/feature-push/keyboard/ngram/src/lib.rs.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+
+#ifndef NGRAMPREDICTOR_H
+#define NGRAMPREDICTOR_H
+
+#include <QHash>
+#include <QPair>
+#include <QString>
+#include <QStringList>
+#include <QVector>
+
+namespace NgramText {
+extern const QString SentenceStart; // "<s>"
+QString normalize(const QString &lang, const QString &text);
+QChar foldChar(QChar c);
+QString fold(const QString &s);
+bool isSentenceBreak(QChar c);
+// Words of the text, split into sentences (keyboard mode: every newline breaks).
+QList<QStringList> sentences(const QString &text);
+// Last two lowercase words of the current sentence left of the cursor,
+// padded with "<s>".
+QStringList contextOf(const QString &lang, const QString &left);
+// If `left` ends after a complete word (followed by space/punctuation),
+// returns {h2, h1, word} (word in its typed form); otherwise empty.
+QStringList lastCompletedWord(const QString &lang, const QString &left);
+}
+
+class NgramModel
+{
+public:
+    static const double BackoffBigram;
+    static const double BackoffUnigram;
+    static const double UserWeight;
+
+    bool load(const QString &path, QString *error = nullptr);
+    bool save(const QString &path, const QString &lang) const;
+    void clear();
+    bool isEmpty() const { return m_uni.isEmpty(); }
+    int vocabulary() const { return m_uni.size(); }
+    int entries() const;
+    bool contains(const QString &lowerWord) const { return m_uni.contains(lowerWord); }
+    quint64 total() const { return m_total; }
+
+    // Learn `word` after context {h2, h1} (lowercase, "<s>" padded).
+    void learn(const QStringList &context, const QString &word);
+    // Drop entries seen only once (keeps learned models bounded).
+    void pruneSingletons();
+
+    QStringList predict(const NgramModel *user, const QStringList &context,
+                        const QString &prefix, int limit) const;
+
+private:
+    struct Uni { QString surface; quint64 count; };
+    static QString triKey(const QString &h2, const QString &h1);
+    void reindex() const;
+    // Unigram keys whose (folded) form starts with prefix.
+    QVector<QString> withPrefix(const QString &prefix, bool folded) const;
+    quint64 uniCount(const QString &w) const { auto it = m_uni.constFind(w); return it == m_uni.constEnd() ? 0 : it->count; }
+    quint64 biCount(const QString &h, const QString &w) const;
+    quint64 triCount(const QString &k, const QString &w) const;
+
+    QHash<QString, Uni> m_uni;
+    QHash<QString, QHash<QString, quint64>> m_bi;
+    QHash<QString, QHash<QString, quint64>> m_tri; // key h2 \x1f h1
+    quint64 m_total = 0;
+    QHash<QString, quint64> m_biCtx;
+    QHash<QString, quint64> m_triCtx;
+    mutable bool m_indexDirty = true;
+    mutable QVector<QString> m_byExact;
+    mutable QVector<QPair<QString, QString>> m_byFolded;
+};
+
+#endif // NGRAMPREDICTOR_H
