+
+namespace {
+// Candidates shown after the typed word itself.
+const int PredictionLimit = 5;
+// Learned models are pruned of one-off entries beyond this size.
+const int UserModelMaxEntries = 60000;
+}
 
 SpellPredictWorker::SpellPredictWorker(QObject *parent)
     : QObject(parent)
     , m_spellChecker()
     , m_limit(5)
+    , m_unsavedLearns(0)
+    , m_saveTimer(new QTimer(this))
+{
+    m_saveTimer->setSingleShot(true);
+    m_saveTimer->setInterval(2000);
+    connect(m_saveTimer, &QTimer::timeout, this, &SpellPredictWorker::saveUserModel);
+}
+
+SpellPredictWorker::~SpellPredictWorker()
+{
+    saveUserModel();
+}
+
+QString SpellPredictWorker::userModelPath() const
+{
+    // Next to the spell checker's <lang>_userDictionary.dic.
+    return QStandardPaths::writableLocation(QStandardPaths::DataLocation)
+            + QDir::separator() + m_language + QStringLiteral("_ngram_user.tsv");
+}
+
+void SpellPredictWorker::saveUserModel()
+{
+    m_saveTimer->stop();
+    if (m_unsavedLearns == 0 || m_language.isEmpty())
+        return;
+    if (m_userModel.entries() > UserModelMaxEntries)
+        m_userModel.pruneSingletons();
+    if (!m_userModel.save(userModelPath(), m_language))
+        qWarning() << "fp6 ngram: could not save" << userModelPath();
+    m_unsavedLearns = 0;
+}
+
+void SpellPredictWorker::learnFrom(const QString& surroundingLeft)
 {
+    // Implicit learning, like presage did: once the next word starts, the
+    // word before it is complete. Only words the shipped model or the
+    // spell checker (incl. the user dictionary) know are learned, so typos
+    // are not. Nothing is learned while prediction is off (password, email,
+    // URL fields: the word engine is disabled there).
+    const QStringList w = NgramText::lastCompletedWord(m_language, surroundingLeft);
+    if (w.size() != 3)
+        return;
+    const QString key = surroundingLeft.right(80);
+    if (key == m_lastLearnKey)
+        return;
+    m_lastLearnKey = key;
+    const QString word = w.at(2);
+    if (word.size() > 40)
+        return;
+    const bool known = m_baseModel.contains(word.toLower())
+            || (m_spellChecker.enabled() && m_spellChecker.spell(word));
+    if (!known)
+        return;
+    m_userModel.learn(w.mid(0, 2), word);
+    if (++m_unsavedLearns >= 20)
+        saveUserModel();
+    else
+        m_saveTimer->start();
 }
 
