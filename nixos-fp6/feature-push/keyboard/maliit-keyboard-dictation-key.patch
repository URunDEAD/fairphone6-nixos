diff --git a/src/plugin/dictationbridge.cpp b/src/plugin/dictationbridge.cpp
new file mode 100644
index 0000000..a1a2538
--- /dev/null
+++ b/src/plugin/dictationbridge.cpp
@@ -0,0 +1,311 @@
+/*
+ * FP6: see dictationbridge.h.
+ *
+ * Service contract (dictation/docs/com.fairphone6.Dictation1.xml, DESIGN.md):
+ *   Start() -> t id; Stop(t id) -> s text (may take up to 90 s; clients use a
+ *   100 s timeout); Cancel(t id); StatusChanged(s state, b mic_active) with
+ *   state idle/starting/recording/transcribing. Only the connection that
+ *   called Start may Stop/Cancel, so one QDBusConnection is used throughout.
+ *   The service never puts recognised text in a signal; it only comes back in
+ *   the Stop reply, and this bridge never logs it.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+
+#include "dictationbridge.h"
+
+#include <QDebug>
+#include <QtDBus/QDBusConnectionInterface>
+#include <QtDBus/QDBusMessage>
+#include <QtDBus/QDBusPendingCallWatcher>
+#include <QtDBus/QDBusPendingReply>
+#include <QtDBus/QDBusServiceWatcher>
+
+using namespace MaliitKeyboard;
+
+const QString DictationBridge::DefaultService = QStringLiteral("com.fairphone6.Dictation1");
+const QString DictationBridge::ObjectPath = QStringLiteral("/com/fairphone6/Dictation1");
+const QString DictationBridge::Interface = QStringLiteral("com.fairphone6.Dictation1");
+
+namespace {
+const int StartTimeoutMs = 25000;
+const int StopTimeoutMs = 100000;
+const int CancelTimeoutMs = 25000;
+}
+
+DictationBridge::DictationBridge(const QDBusConnection &bus, QObject *parent, const QString &service)
+    : QObject(parent)
+    , m_bus(bus)
+    , m_service(service)
+    , m_watcher(new QDBusServiceWatcher(service, bus,
+                                        QDBusServiceWatcher::WatchForRegistration
+                                        | QDBusServiceWatcher::WatchForUnregistration, this))
+{
+    m_messageTimer.setSingleShot(true);
+    connect(&m_messageTimer, &QTimer::timeout, this, [this]() { setMessage(QString(), 0); });
+
+    connect(m_watcher, &QDBusServiceWatcher::serviceRegistered, this, &DictationBridge::onServiceRegistered);
+    connect(m_watcher, &QDBusServiceWatcher::serviceUnregistered, this, &DictationBridge::onServiceUnregistered);
+
+    if (!m_bus.isConnected()) {
+        qWarning() << "fp6 dictation: no session bus, microphone key disabled";
+        return;
+    }
+
+    // Subscribe before asking whether the service is there (no missed idle).
+    m_bus.connect(m_service, ObjectPath, Interface, QStringLiteral("StatusChanged"),
+                  this, SLOT(onStatusChanged(QString,bool)));
+
+    QDBusMessage hasOwner = QDBusMessage::createMethodCall(
+        QStringLiteral("org.freedesktop.DBus"), QStringLiteral("/org/freedesktop/DBus"),
+        QStringLiteral("org.freedesktop.DBus"), QStringLiteral("NameHasOwner"));
+    hasOwner << m_service;
+    auto *w = new QDBusPendingCallWatcher(m_bus.asyncCall(hasOwner), this);
+    connect(w, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *w) {
+        QDBusPendingReply<bool> reply = *w;
+        w->deleteLater();
+        if (!reply.isError() && reply.value() && !m_registered)
+            onServiceRegistered();
+    });
+}
+
+DictationBridge::~DictationBridge()
+{
+    // Do not leave the microphone open if the keyboard goes away mid-session.
+    if (m_id != 0 && (m_phase == Phase::Listening || m_phase == Phase::Transcribing))
+        sendCancel(m_id);
+}
+
+bool DictationBridge::available() const { return m_available; }
+
+QString DictationBridge::phase() const
+{
+    switch (m_phase) {
+    case Phase::Starting: return QStringLiteral("starting");
+    case Phase::Listening: return QStringLiteral("listening");
+    case Phase::Transcribing: return QStringLiteral("transcribing");
+    case Phase::Idle: break;
+    }
+    return QStringLiteral("idle");
+}
+
+bool DictationBridge::listening() const { return m_phase == Phase::Listening || m_phase == Phase::Starting; }
+bool DictationBridge::busy() const { return m_phase == Phase::Transcribing; }
+QString DictationBridge::message() const { return m_message; }
+
+void DictationBridge::setEnabled(bool enabled)
+{
+    if (m_enabled == enabled)
+        return;
+    m_enabled = enabled;
+    if (!enabled)
+        invalidate();
+    updateAvailable();
+}
+
+void DictationBridge::setAllowed(bool allowed)
+{
+    if (m_allowed == allowed)
+        return;
+    m_allowed = allowed;
+    if (!allowed)
+        invalidate();
+    updateAvailable();
+}
+
+void DictationBridge::updateAvailable()
+{
+    const bool available = m_enabled && m_registered && m_allowed;
+    if (available == m_available)
+        return;
+    m_available = available;
+    Q_EMIT availableChanged();
+}
+
+void DictationBridge::setPhase(Phase phase)
+{
+    if (phase == m_phase)
+        return;
+    m_phase = phase;
+    if (phase == Phase::Listening)
+        m_listenClock.start();
+    Q_EMIT phaseChanged();
+}
+
+void DictationBridge::setMessage(const QString &message, int timeoutMs)
+{
+    m_messageTimer.stop();
+    if (!message.isEmpty() && timeoutMs > 0)
+        m_messageTimer.start(timeoutMs);
+    if (message == m_message)
+        return;
+    m_message = message;
+    Q_EMIT messageChanged();
+}
+
+QDBusPendingCallWatcher *DictationBridge::call(const QString &method, const QList<QVariant> &args, int timeoutMs)
+{
+    QDBusMessage msg = QDBusMessage::createMethodCall(m_service, ObjectPath, Interface, method);
+    msg.setArguments(args);
+    return new QDBusPendingCallWatcher(m_bus.asyncCall(msg, timeoutMs), this);
+}
+
+void DictationBridge::sendCancel(quint64 id)
+{
+    auto *w = call(QStringLiteral("Cancel"), { QVariant::fromValue<qulonglong>(id) }, CancelTimeoutMs);
+    connect(w, &QDBusPendingCallWatcher::finished, w, &QObject::deleteLater);
+}
+
+void DictationBridge::toggle()
+{
+    switch (m_phase) {
+    case Phase::Idle:
+        break;
+    case Phase::Starting:
+        // Second tap before Start replied: stop as soon as the id arrives.
+        m_stopWhenStarted = true;
+        return;
+    case Phase::Listening:
+        stopSession();
+        return;
+    case Phase::Transcribing:
+        // Text is on its way; a tap here does nothing (long-press cancels).
+        return;
+    }
+
+    if (!m_available) {
+        setMessage(m_registered ? QStringLiteral("not-here") : QStringLiteral("no-service"));
+        return;
+    }
+
+    setMessage(QString(), 0);
+    m_stopWhenStarted = false;
+    m_id = 0;
+    setPhase(Phase::Starting);
+
+    const quint64 generation = m_generation;
+    auto *w = call(QStringLiteral("Start"), {}, StartTimeoutMs);
+    connect(w, &QDBusPendingCallWatcher::finished, this, [this, generation](QDBusPendingCallWatcher *w) {
+        QDBusPendingReply<qulonglong> reply = *w;
+        w->deleteLater();
+        if (generation != m_generation) {
+            // The field went away while starting: release the microphone.
+            if (!reply.isError())
+                sendCancel(reply.value());
+            return;
+        }
+        if (reply.isError()) {
+            setPhase(Phase::Idle);
+            setMessage(describeError(reply.error().message()));
+            return;
+        }
+        m_id = reply.value();
+        setPhase(Phase::Listening);
+        if (m_stopWhenStarted) {
+            m_stopWhenStarted = false;
+            stopSession();
+        }
+    });
+}
+
+void DictationBridge::stopSession()
+{
+    if (m_phase != Phase::Listening || m_id == 0)
+        return;
+    setPhase(Phase::Transcribing);
+
+    const quint64 generation = m_generation;
+    auto *w = call(QStringLiteral("Stop"), { QVariant::fromValue<qulonglong>(m_id) }, StopTimeoutMs);
+    connect(w, &QDBusPendingCallWatcher::finished, this, [this, generation](QDBusPendingCallWatcher *w) {
+        QDBusPendingReply<QString> reply = *w;
+        w->deleteLater();
+        if (generation != m_generation)
+            return; // never deliver text to a field other than the one it was spoken for
+        m_id = 0;
+        setPhase(Phase::Idle);
+        if (reply.isError()) {
+            setMessage(describeError(reply.error().message()));
+            return;
+        }
+        const QString text = reply.value().trimmed();
+        if (text.isEmpty()) {
+            setMessage(QStringLiteral("nothing-heard"));
+            return;
+        }
+        Q_EMIT finalText(text);
+    });
+}
+
+void DictationBridge::cancel()
+{
+    invalidate();
+}
+
+void DictationBridge::invalidate()
+{
+    ++m_generation;
+    m_stopWhenStarted = false;
+    if (m_id != 0 && m_phase != Phase::Idle)
+        sendCancel(m_id);
+    m_id = 0;
+    setPhase(Phase::Idle);
+}
+
+void DictationBridge::onStatusChanged(const QString &state, bool micActive)
+{
+    Q_UNUSED(micActive);
+    // The service goes idle before its Stop reply arrives, so only a session
+    // that is still listening has ended on its own (30 s limit, capture
+    // error). The text of that session is discarded by the service.
+    if (state == QLatin1String("idle") && m_phase == Phase::Listening) {
+        const bool limit = m_listenClock.isValid() && m_listenClock.elapsed() >= 29000;
+        ++m_generation;
+        m_id = 0;
+        setPhase(Phase::Idle);
+        setMessage(limit ? QStringLiteral("limit") : QStringLiteral("failed"));
+    }
+}
+
+void DictationBridge::onServiceRegistered()
+{
+    m_registered = true;
+    updateAvailable();
+}
+
+void DictationBridge::onServiceUnregistered()
+{
+    m_registered = false;
+    // Whatever was running died with the service.
+    ++m_generation;
+    m_id = 0;
+    m_stopWhenStarted = false;
+    if (m_phase != Phase::Idle)
+        setMessage(QStringLiteral("failed"));
+    setPhase(Phase::Idle);
+    updateAvailable();
+}
+
+QString DictationBridge::describeError(const QString &serviceMessage)
+{
+    if (serviceMessage.contains(QLatin1String("Model missing")))
+        return QStringLiteral("no-model");
+    if (serviceMessage == QLatin1String("Busy"))
+        return QStringLiteral("busy");
+    if (serviceMessage.contains(QLatin1String("Recording limit")))
+        return QStringLiteral("limit");
+    return QStringLiteral("failed");
+}
+
+QString DictationBridge::spaced(const QString &left, const QString &right, const QString &result)
+{
+    QString text = result.trimmed();
+    if (text.isEmpty())
+        return text;
+    if (!left.isEmpty() && !left.back().isSpace())
+        text.prepend(QLatin1Char(' '));
+    if (right.isEmpty() || !(right.front().isSpace() || right.front().isPunct()))
+        text.append(QLatin1Char(' '));
+    return text;
+}
diff --git a/src/plugin/dictationbridge.h b/src/plugin/dictationbridge.h
new file mode 100644
index 0000000..76b8e0e
--- /dev/null
+++ b/src/plugin/dictationbridge.h
@@ -0,0 +1,125 @@
+/*
+ * FP6: bridge between the keyboard's microphone key and the on-device
+ * dictation service (com.fairphone6.Dictation1 on the session bus,
+ * nixos-fp6/feature-push/dictation).
+ *
+ * Tap the key: Start. Tap again: Stop, and the recognised text is emitted
+ * through finalText() so InputMethod can commit it to the focused field.
+ * Long-press: Cancel. All D-Bus calls are asynchronous.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+
+#ifndef MALIIT_KEYBOARD_DICTATIONBRIDGE_H
+#define MALIIT_KEYBOARD_DICTATIONBRIDGE_H
+
+#include <QElapsedTimer>
+#include <QObject>
+#include <QString>
+#include <QTimer>
+#include <QtDBus/QDBusConnection>
+
+class QDBusPendingCallWatcher;
+class QDBusServiceWatcher;
+
+namespace MaliitKeyboard {
+
+class DictationBridge : public QObject
+{
+    Q_OBJECT
+    // The key is shown when this is true.
+    Q_PROPERTY(bool available READ available NOTIFY availableChanged)
+    // "idle", "starting", "listening", "transcribing"
+    Q_PROPERTY(QString phase READ phase NOTIFY phaseChanged)
+    Q_PROPERTY(bool listening READ listening NOTIFY phaseChanged)
+    Q_PROPERTY(bool busy READ busy NOTIFY phaseChanged)
+    // Short, non-modal status for the key's bubble, as a code the QML
+    // translates: "", "busy", "no-model", "no-service", "limit", "failed",
+    // "not-here", "nothing-heard".
+    Q_PROPERTY(QString message READ message NOTIFY messageChanged)
+
+public:
+    static const QString DefaultService;
+    static const QString ObjectPath;
+    static const QString Interface;
+
+    explicit DictationBridge(const QDBusConnection &bus,
+                             QObject *parent = nullptr,
+                             const QString &service = DefaultService);
+    ~DictationBridge() override;
+
+    bool available() const;
+    QString phase() const;
+    bool listening() const;
+    bool busy() const;
+    QString message() const;
+
+    bool serviceRegistered() const { return m_registered; }
+
+    //! The user setting (GSettings dictation-key).
+    void setEnabled(bool enabled);
+    //! Whether the focused field may receive dictation (free text, not hidden).
+    void setAllowed(bool allowed);
+
+    //! Mic key tap: start when idle, stop when listening.
+    Q_INVOKABLE void toggle();
+    //! Mic key long-press, or the user aborting: discard the session.
+    Q_INVOKABLE void cancel();
+    //! The input context went away (focus loss, field change, hide, reset):
+    //! cancel any session and drop any result still on its way.
+    void invalidate();
+
+    //! Text to commit for a result, given the text left/right of the cursor:
+    //! trimmed; a space before it unless at the start or after whitespace,
+    //! a space after it unless more text follows that starts with whitespace
+    //! or punctuation. Empty when there is nothing to insert.
+    static QString spaced(const QString &left, const QString &right, const QString &result);
+
+    //! Message code for a service error text (see the message property).
+    static QString describeError(const QString &serviceMessage);
+
+Q_SIGNALS:
+    void availableChanged();
+    void phaseChanged();
+    void messageChanged();
+    //! Recognised text for the input context that was current at Start.
+    void finalText(const QString &text);
+
+private:
+    enum class Phase { Idle, Starting, Listening, Transcribing };
+
+    void setPhase(Phase phase);
+    void setMessage(const QString &message, int timeoutMs = 4000);
+    void updateAvailable();
+    void stopSession();
+    void sendCancel(quint64 id);
+    QDBusPendingCallWatcher *call(const QString &method, const QList<QVariant> &args, int timeoutMs);
+
+    Q_SLOT void onStatusChanged(const QString &state, bool micActive);
+    Q_SLOT void onServiceRegistered();
+    Q_SLOT void onServiceUnregistered();
+
+    QDBusConnection m_bus;
+    QString m_service;
+    QDBusServiceWatcher *m_watcher;
+    QTimer m_messageTimer;
+    QElapsedTimer m_listenClock;
+
+    bool m_enabled = false;
+    bool m_allowed = true;
+    bool m_registered = false;
+    bool m_available = false;
+
+    Phase m_phase = Phase::Idle;
+    QString m_message;
+    quint64 m_id = 0;
+    // Bumped on every invalidate(); replies carry the value they were sent with.
+    quint64 m_generation = 0;
+    bool m_stopWhenStarted = false;
+};
+
+} // namespace MaliitKeyboard
+
+#endif // MALIIT_KEYBOARD_DICTATIONBRIDGE_H
