+//! \brief InputMethod::onDictationText commits recognised dictation text at
+//! the cursor through the input method host, like a word picked from the
+//! ribbon. The bridge only emits it for the input context the dictation was
+//! started in; the field is checked once more here. No key events, no
+//! clipboard, and the word engine does not see (or auto-correct) the text.
+void InputMethod::onDictationText(const QString &text)
+{
+    Q_D(InputMethod);
+    if (!d->m_geometry->shown() || !d->fieldAllowsDictation())
+        return;
+
+    d->editor.commitPreedit();
+    const QString left = d->editor.text()->surroundingLeft();
+    const QString right = d->editor.text()->surroundingRight();
+    const QString commit = DictationBridge::spaced(left, right, text);
+    if (commit.isEmpty())
+        return;
+
+    d->host->sendCommitString(commit);
+    // Keep the local copy in step until the client reports the new text.
+    d->editor.text()->setSurrounding(left + commit + right);
+    d->editor.text()->setSurroundingOffset(left.length() + commit.length());
+    d->editor.wordEngine()->clearCandidates();
+    checkAutocaps();
+}
