+/*
+ * FP6: fp6-fake-dictation [TEXT] - serves FakeDictationService as
+ * com.fairphone6.Dictation1 on the session bus for the keyboard render
+ * harness. Stop answers TEXT (synthetic); no microphone is used.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+
+#include "fake_dictation_service.h"
+
+#include <QCoreApplication>
+#include <cstdio>
+
+int main(int argc, char **argv)
+{
+    QCoreApplication app(argc, argv);
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    FakeDictationService fake(bus);
+    if (argc > 1)
+        fake.text = QString::fromUtf8(argv[1]);
+    fake.stopDelayMs = 1500; // long enough to see the "transcribing" state
+    if (!fake.registerOn(QStringLiteral("com.fairphone6.Dictation1"))) {
+        std::fprintf(stderr, "fp6-fake-dictation: cannot register on the session bus\n");
+        return 1;
+    }
+    std::printf("fp6-fake-dictation: ready\n");
+    std::fflush(stdout);
+    return app.exec();
+}
