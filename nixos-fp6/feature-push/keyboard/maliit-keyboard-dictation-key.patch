+++ b/tests/fp6/fake_dictation_service.h
@@ -0,0 +1,137 @@
+/*
+ * FP6 test helper: a stand-in for com.fairphone6.Dictation1 (the real one is
+ * nixos-fp6/feature-push/dictation, Rust). It never touches a microphone:
+ * Stop answers with a fixed synthetic text. Used by dictationbridge_test.cpp
+ * and, as fp6-fake-dictation, by the keyboard render harness.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+
+#ifndef FP6_FAKE_DICTATION_SERVICE_H
+#define FP6_FAKE_DICTATION_SERVICE_H
+
+#include <QStringList>
+#include <QTimer>
+#include <QtDBus/QDBusConnection>
+#include <QtDBus/QDBusMessage>
+#include <QtDBus/QDBusVirtualObject>
+
+class FakeDictationService : public QDBusVirtualObject
+{
+public:
+    static constexpr const char *Path = "/com/fairphone6/Dictation1";
+    static constexpr const char *Iface = "com.fairphone6.Dictation1";
+
+    explicit FakeDictationService(const QDBusConnection &bus) : m_bus(bus) {}
+
+    // Behaviour knobs.
+    QString text = QStringLiteral("hello from the fake service");
+    QString startError;           // non-empty: Start fails with this message
+    int startDelayMs = 0;
+    int stopDelayMs = 0;
+
+    // What happened (method names with ids, in order).
+    QStringList calls;
+    quint64 activeId = 0;
+    QString state = QStringLiteral("idle");
+
+    bool registerOn(const QString &name)
+    {
+        return m_bus.registerVirtualObject(QString::fromLatin1(Path), this)
+            && m_bus.registerService(name);
+    }
+
+    // End the session as the 30 s limit would.
+    void endOnItsOwn()
+    {
+        activeId = 0;
+        setState(QStringLiteral("idle"));
+    }
+
+    QString introspect(const QString &) const override
+    {
+        return QStringLiteral(
+            "<interface name=\"com.fairphone6.Dictation1\">"
+            "<method name=\"Start\"><arg name=\"id\" type=\"t\" direction=\"out\"/></method>"
+            "<method name=\"Stop\"><arg name=\"id\" type=\"t\" direction=\"in\"/><arg name=\"text\" type=\"s\" direction=\"out\"/></method>"
+            "<method name=\"Cancel\"><arg name=\"id\" type=\"t\" direction=\"in\"/></method>"
+            "<signal name=\"StatusChanged\"><arg name=\"state\" type=\"s\"/><arg name=\"mic_active\" type=\"b\"/></signal>"
+            "</interface>");
+    }
+
+    bool handleMessage(const QDBusMessage &message, const QDBusConnection &connection) override
+    {
+        if (message.interface() != QLatin1String(Iface))
+            return false;
+        const QString member = message.member();
+        QDBusConnection bus(connection);
+        message.setDelayedReply(true);
+
+        if (member == QLatin1String("Start")) {
+            calls << QStringLiteral("Start");
+            QTimer::singleShot(startDelayMs, [this, message, bus]() mutable {
+                if (!startError.isEmpty()) {
+                    bus.send(message.createErrorReply(QStringLiteral("org.freedesktop.DBus.Error.Failed"), startError));
+                    return;
+                }
+                if (activeId != 0) {
+                    bus.send(message.createErrorReply(QStringLiteral("org.freedesktop.DBus.Error.Failed"), QStringLiteral("Busy")));
+                    return;
+                }
+                activeId = ++m_next;
+                setState(QStringLiteral("recording"));
+                bus.send(message.createReply(QVariant::fromValue<qulonglong>(activeId)));
+            });
+            return true;
+        }
+
+        const quint64 id = message.arguments().value(0).toULongLong();
+        if (member == QLatin1String("Stop")) {
+            calls << QStringLiteral("Stop %1").arg(id);
+            if (id == 0 || id != activeId) {
+                bus.send(message.createErrorReply(QStringLiteral("org.freedesktop.DBus.Error.Failed"), QStringLiteral("No session")));
+                return true;
+            }
+            setState(QStringLiteral("transcribing"));
+            QTimer::singleShot(stopDelayMs, [this, message, bus, id]() mutable {
+                if (activeId != id) { // cancelled meanwhile
+                    bus.send(message.createErrorReply(QStringLiteral("org.freedesktop.DBus.Error.Failed"), QStringLiteral("Cancelled")));
+                    return;
+                }
+                activeId = 0;
+                setState(QStringLiteral("idle")); // the real service signals idle before replying
+                bus.send(message.createReply(text));
+            });
+            return true;
+        }
+        if (member == QLatin1String("Cancel")) {
+            calls << QStringLiteral("Cancel %1").arg(id);
+            if (id == 0 || id != activeId) {
+                bus.send(message.createErrorReply(QStringLiteral("org.freedesktop.DBus.Error.Failed"), QStringLiteral("No session")));
+                return true;
+            }
+            activeId = 0;
+            setState(QStringLiteral("idle"));
+            bus.send(message.createReply());
+            return true;
+        }
+        return false;
+    }
+
+private:
+    void setState(const QString &s)
+    {
+        state = s;
+        QDBusMessage sig = QDBusMessage::createSignal(QString::fromLatin1(Path), QString::fromLatin1(Iface),
+                                                      QStringLiteral("StatusChanged"));
+        sig << s << (s == QLatin1String("recording"));
+        m_bus.send(sig);
+    }
+
+    QDBusConnection m_bus;
+    quint64 m_next = 0;
+};
+
+#endif
