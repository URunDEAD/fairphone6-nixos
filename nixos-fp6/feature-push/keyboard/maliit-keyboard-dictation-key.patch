diff --git a/tests/fp6/dictationbridge_test.cpp b/tests/fp6/dictationbridge_test.cpp
new file mode 100644
index 0000000..2e76af5
--- /dev/null
+++ b/tests/fp6/dictationbridge_test.cpp
@@ -0,0 +1,304 @@
+/*
+ * FP6: tests for DictationBridge (src/plugin/dictationbridge.cpp) against
+ * FakeDictationService on a private session bus. No microphone, synthetic
+ * text only. Run under a private dbus-daemon (see keyboard/overlay.nix).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+
+#include "dictationbridge.h"
+#include "fake_dictation_service.h"
+
+#include <QCoreApplication>
+#include <QElapsedTimer>
+#include <QtDBus/QDBusConnection>
+#include <QtDBus/QDBusConnectionInterface>
+
+#include <cstdio>
+#include <cstdlib>
+#include <functional>
+
+using MaliitKeyboard::DictationBridge;
+
+namespace {
+int failures = 0;
+
+void check(bool ok, const char *what, int line)
+{
+    if (!ok) {
+        std::fprintf(stderr, "FAIL line %d: %s\n", line, what);
+        ++failures;
+    }
+}
+#define CHECK(x) check((x), #x, __LINE__)
+#define CHECK_EQ(a, b) check((a) == (b), #a " == " #b, __LINE__)
+
+bool waitFor(const std::function<bool()> &pred, int ms = 3000)
+{
+    QElapsedTimer t;
+    t.start();
+    while (!pred()) {
+        if (t.elapsed() > ms)
+            return false;
+        QCoreApplication::processEvents(QEventLoop::AllEvents, 20);
+    }
+    return true;
+}
+
+void settle(int ms = 150)
+{
+    QElapsedTimer t;
+    t.start();
+    while (t.elapsed() < ms)
+        QCoreApplication::processEvents(QEventLoop::AllEvents, 20);
+}
+
+struct Fixture {
+    explicit Fixture(FakeDictationService &fake) : fake(fake)
+    {
+        fake.calls.clear();
+        fake.text = QStringLiteral("hello from the fake service");
+        fake.startError.clear();
+        fake.startDelayMs = 0;
+        fake.stopDelayMs = 0;
+        fake.activeId = 0;
+        bridge.reset(new DictationBridge(QDBusConnection::sessionBus()));
+        QObject::connect(bridge.data(), &DictationBridge::finalText,
+                         [this](const QString &t) { texts << t; });
+        bridge->setEnabled(true);
+        waitFor([this]() { return bridge->available(); });
+    }
+    FakeDictationService &fake;
+    QScopedPointer<DictationBridge> bridge;
+    QStringList texts;
+};
+
+void testSpacing()
+{
+    CHECK_EQ(DictationBridge::spaced("", "", " Hello world. "), QStringLiteral("Hello world. "));
+    CHECK_EQ(DictationBridge::spaced("Hi", "", "there"), QStringLiteral(" there "));
+    CHECK_EQ(DictationBridge::spaced("Hi ", "", "there"), QStringLiteral("there "));
+    CHECK_EQ(DictationBridge::spaced("Hi\n", "", "there"), QStringLiteral("there "));
+    CHECK_EQ(DictationBridge::spaced("a", " b", "x"), QStringLiteral(" x"));
+    CHECK_EQ(DictationBridge::spaced("a", ".", "x"), QStringLiteral(" x"));
+    CHECK_EQ(DictationBridge::spaced("a", "b", "x"), QStringLiteral(" x "));
+    CHECK_EQ(DictationBridge::spaced("Bună", "", "ziua, ce faci?"), QStringLiteral(" ziua, ce faci? "));
+    CHECK(DictationBridge::spaced("a", "b", "   ").isEmpty());
+}
+
+void testErrors()
+{
+    CHECK_EQ(DictationBridge::describeError("Model missing or incomplete; run fp6-dictate download base-q5_1"),
+             QStringLiteral("no-model"));
+    CHECK_EQ(DictationBridge::describeError("Busy"), QStringLiteral("busy"));
+    CHECK_EQ(DictationBridge::describeError("Recording limit reached; audio discarded"), QStringLiteral("limit"));
+    CHECK_EQ(DictationBridge::describeError("Cannot start PipeWire capture"), QStringLiteral("failed"));
+}
+
+void testAvailability(FakeDictationService &fake)
+{
+    DictationBridge b(QDBusConnection::sessionBus());
+    settle();
+    CHECK(b.serviceRegistered());
+    CHECK(!b.available()); // setting off by default
+    b.setEnabled(true);
+    CHECK(b.available());
+    b.setAllowed(false); // password field
+    CHECK(!b.available());
+    b.toggle();
+    CHECK_EQ(b.phase(), QStringLiteral("idle"));
+    CHECK_EQ(b.message(), QStringLiteral("not-here"));
+    settle();
+    CHECK(fake.calls.isEmpty());
+    b.setAllowed(true);
+    CHECK(b.available());
+    fake.calls.clear();
+}
+
+void testTapTap(FakeDictationService &fake)
+{
+    Fixture f(fake);
+    CHECK(f.bridge->available());
+    f.bridge->toggle();
+    CHECK_EQ(f.bridge->phase(), QStringLiteral("starting"));
+    CHECK(f.bridge->listening());
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("listening"); }));
+    f.bridge->toggle();
+    CHECK_EQ(f.bridge->phase(), QStringLiteral("transcribing"));
+    CHECK(f.bridge->busy());
+    f.bridge->toggle(); // tap while transcribing: ignored
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("idle"); }));
+    settle();
+    CHECK_EQ(f.texts, QStringList { QStringLiteral("hello from the fake service") });
+    CHECK_EQ(fake.calls, (QStringList { "Start", "Stop 1" }));
+    CHECK(f.bridge->message().isEmpty());
+}
+
+void testSecondTapBeforeStartReply(FakeDictationService &fake)
+{
+    Fixture f(fake);
+    fake.startDelayMs = 200;
+    f.bridge->toggle();
+    f.bridge->toggle(); // still starting
+    CHECK(waitFor([&]() { return !f.texts.isEmpty(); }));
+    CHECK_EQ(f.texts.size(), 1);
+    CHECK_EQ(fake.calls.size(), 2);
+    CHECK(fake.calls.value(1).startsWith("Stop "));
+}
+
+void testInvalidateWhileTranscribing(FakeDictationService &fake)
+{
+    Fixture f(fake);
+    fake.stopDelayMs = 300;
+    f.bridge->toggle();
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("listening"); }));
+    f.bridge->toggle();
+    f.bridge->invalidate(); // focus moved to another field
+    CHECK_EQ(f.bridge->phase(), QStringLiteral("idle"));
+    settle(600);
+    CHECK(f.texts.isEmpty());
+    CHECK(fake.calls.contains(fake.calls.value(1).replace("Stop", "Cancel")));
+    CHECK_EQ(fake.activeId, 0u);
+}
+
+void testInvalidateWhileStarting(FakeDictationService &fake)
+{
+    Fixture f(fake);
+    fake.startDelayMs = 200;
+    f.bridge->toggle();
+    f.bridge->invalidate();
+    CHECK_EQ(f.bridge->phase(), QStringLiteral("idle"));
+    CHECK(waitFor([&]() { return fake.calls.size() == 2; }));
+    CHECK(fake.calls.value(1).startsWith("Cancel "));
+    settle();
+    CHECK_EQ(fake.activeId, 0u); // microphone released
+    CHECK(f.texts.isEmpty());
+}
+
+void testCancel(FakeDictationService &fake)
+{
+    Fixture f(fake);
+    f.bridge->toggle();
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("listening"); }));
+    f.bridge->cancel(); // long-press
+    CHECK_EQ(f.bridge->phase(), QStringLiteral("idle"));
+    CHECK(waitFor([&]() { return fake.activeId == 0; }));
+    CHECK(f.texts.isEmpty());
+}
+
+void testStartErrors(FakeDictationService &fake)
+{
+    Fixture f(fake);
+    fake.startError = QStringLiteral("Model missing or incomplete; run fp6-dictate download base-q5_1");
+    f.bridge->toggle();
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("idle"); }));
+    CHECK_EQ(f.bridge->message(), QStringLiteral("no-model"));
+
+    fake.startError.clear();
+    fake.activeId = 99; // someone else is dictating
+    f.bridge->toggle();
+    CHECK(waitFor([&]() { return f.bridge->message() == QLatin1String("busy"); }));
+    CHECK_EQ(f.bridge->phase(), QStringLiteral("idle"));
+    fake.activeId = 0;
+
+    // A new tap clears the message and works.
+    f.bridge->toggle();
+    CHECK(f.bridge->message().isEmpty());
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("listening"); }));
+    f.bridge->toggle();
+    CHECK(waitFor([&]() { return f.texts.size() == 1; }));
+}
+
+void testEmptyResult(FakeDictationService &fake)
+{
+    Fixture f(fake);
+    fake.text = QStringLiteral("  ");
+    f.bridge->toggle();
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("listening"); }));
+    f.bridge->toggle();
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("idle"); }));
+    CHECK(f.texts.isEmpty());
+    CHECK_EQ(f.bridge->message(), QStringLiteral("nothing-heard"));
+}
+
+void testEndsOnItsOwn(FakeDictationService &fake)
+{
+    Fixture f(fake);
+    f.bridge->toggle();
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("listening"); }));
+    fake.endOnItsOwn(); // capture failed / limit
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("idle"); }));
+    CHECK_EQ(f.bridge->message(), QStringLiteral("failed"));
+    f.bridge->toggle(); // starts a fresh session
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("listening"); }));
+    f.bridge->toggle();
+    CHECK(waitFor([&]() { return f.texts.size() == 1; }));
+}
+
+void testServiceGoesAway(FakeDictationService &fake, QDBusConnection &serviceBus)
+{
+    Fixture f(fake);
+    f.bridge->toggle();
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("listening"); }));
+    CHECK(serviceBus.unregisterService(DictationBridge::DefaultService));
+    CHECK(waitFor([&]() { return !f.bridge->available(); }));
+    CHECK_EQ(f.bridge->phase(), QStringLiteral("idle"));
+    CHECK_EQ(f.bridge->message(), QStringLiteral("failed"));
+    fake.activeId = 0;
+    CHECK(serviceBus.registerService(DictationBridge::DefaultService));
+    CHECK(waitFor([&]() { return f.bridge->available(); }));
+}
+
+void testSettingOffCancels(FakeDictationService &fake)
+{
+    Fixture f(fake);
+    f.bridge->toggle();
+    CHECK(waitFor([&]() { return f.bridge->phase() == QLatin1String("listening"); }));
+    f.bridge->setEnabled(false);
+    CHECK(!f.bridge->available());
+    CHECK_EQ(f.bridge->phase(), QStringLiteral("idle"));
+    CHECK(waitFor([&]() { return fake.activeId == 0; }));
+}
+
+} // namespace
+
+int main(int argc, char **argv)
+{
+    QCoreApplication app(argc, argv);
+
+    testSpacing();
+    testErrors();
+
+    if (!QDBusConnection::sessionBus().isConnected()) {
+        std::fprintf(stderr, "dictationbridge_test: no session bus (run under dbus-run-session)\n");
+        return 2;
+    }
+    QDBusConnection serviceBus = QDBusConnection::connectToBus(QDBusConnection::SessionBus,
+                                                               QStringLiteral("fp6-fake-dictation"));
+    FakeDictationService fake(serviceBus);
+    if (!fake.registerOn(DictationBridge::DefaultService)) {
+        std::fprintf(stderr, "dictationbridge_test: cannot register the fake service\n");
+        return 2;
+    }
+
+    testAvailability(fake);
+    testTapTap(fake);
+    testSecondTapBeforeStartReply(fake);
+    testInvalidateWhileTranscribing(fake);
+    testInvalidateWhileStarting(fake);
+    testCancel(fake);
+    testStartErrors(fake);
+    testEmptyResult(fake);
+    testEndsOnItsOwn(fake);
+    testServiceGoesAway(fake, serviceBus);
+    testSettingOffCancels(fake);
+
+    if (failures) {
+        std::fprintf(stderr, "dictationbridge_test: %d failure(s)\n", failures);
+        return 1;
+    }
+    std::printf("dictationbridge_test: ok\n");
+    return 0;
+}
