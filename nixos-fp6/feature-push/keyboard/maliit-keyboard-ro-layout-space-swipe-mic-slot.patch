diff --git a/qml/keys/MicKey.qml b/qml/keys/MicKey.qml
new file mode 100644
index 0000000..b2bb821
--- /dev/null
+++ b/qml/keys/MicKey.qml
@@ -0,0 +1,50 @@
+/*
+ * FP6: reserved slot for a dictation (microphone) key.
+ *
+ * Zero width and invisible until a "dictation" context object exists and
+ * reports available === true. The dictation bridge (com.fairphone6.Dictation1,
+ * ~/Desktop/fp6-codex/dictation/integration) is expected to expose that object
+ * from InputMethod and implement start()/stop()/cancel() there; this key only
+ * forwards press/release. Nothing calls D-Bus from here.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+
+import QtQuick 2.4
+import MaliitKeyboard 2.0
+
+ActionKey {
+    id: micKey
+
+    readonly property bool available: typeof dictation !== "undefined" && dictation !== null
+                                      && dictation.available === true
+    property bool held: false
+
+    visible: available
+    width: available ? panel.keyWidth : 0
+    iconNormal: available ? "audio-input-microphone-symbolic" : ""
+    iconShifted: iconNormal
+    iconCapsLock: iconNormal
+    label: ""
+    shifted: ""
+    noMagnifier: true
+    padding: 0
+    overridePressArea: true
+    action: "dictation"
+
+    onPressed: {
+        if (!available)
+            return;
+        Feedback.keyPressed();
+        held = true;
+        dictation.start();
+    }
+    onReleased: {
+        if (!available || !held)
+            return;
+        held = false;
+        dictation.stop();
+    }
+}
