diff --git a/qml/components/Fp6Histogram.qml b/qml/components/Fp6Histogram.qml
new file mode 100644
index 0000000..f90a4ad
--- /dev/null
+++ b/qml/components/Fp6Histogram.qml
@@ -0,0 +1,57 @@
+/*
+ * FP6 Pro mode: live histogram (luma filled, R/G/B lines).
+ * values: 4 x 64 values 0..1 (Fp6ProControls.histogram).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+import QtQuick 2.12
+import Lomiri.Components 1.3
+
+Item {
+    id: hist
+    property var values: []
+    width: units.gu(16)
+    height: units.gu(7)
+    onValuesChanged: canvas.requestPaint()
+
+    Rectangle {
+        anchors.fill: parent
+        radius: units.gu(0.5)
+        color: Qt.rgba(0, 0, 0, 0.45)
+    }
+
+    Canvas {
+        id: canvas
+        anchors.fill: parent
+        anchors.margins: units.gu(0.5)
+        onPaint: {
+            var ctx = getContext("2d");
+            ctx.clearRect(0, 0, width, height);
+            var d = hist.values;
+            if (!d || d.length < 256)
+                return;
+            var bw = width / 64;
+            ctx.fillStyle = Qt.rgba(1, 1, 1, 0.55);
+            ctx.beginPath();
+            ctx.moveTo(0, height);
+            for (var i = 0; i < 64; i++)
+                ctx.lineTo(i * bw + bw / 2, height - d[i] * height);
+            ctx.lineTo(width, height);
+            ctx.closePath();
+            ctx.fill();
+            var colours = ["#ff4040", "#40ff40", "#4080ff"];
+            ctx.lineWidth = 1;
+            for (var c = 1; c < 4; c++) {
+                ctx.strokeStyle = colours[c - 1];
+                ctx.beginPath();
+                for (var j = 0; j < 64; j++) {
+                    var y = height - d[c * 64 + j] * height;
+                    if (j === 0) ctx.moveTo(0, y); else ctx.lineTo(j * bw + bw / 2, y);
+                }
+                ctx.stroke();
+            }
+        }
+    }
+}
diff --git a/qml/components/Fp6LevelIndicator.qml b/qml/components/Fp6LevelIndicator.qml
new file mode 100644
index 0000000..2ba3738
--- /dev/null
+++ b/qml/components/Fp6LevelIndicator.qml
@@ -0,0 +1,107 @@
+/*
+ * FP6 Pro mode: electronic level (horizon) from the accelerometer
+ * (QtSensors via iio-sensor-proxy). The line shows the true horizon in
+ * the screen; it turns green within 1 degree of level. Pitch (camera
+ * pointing up/down) is shown as a small number, and "flat" when the phone
+ * lies face up/down (use the bubble then).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+import QtQuick 2.12
+import QtSensors 5.0
+import Lomiri.Components 1.3
+
+Item {
+    id: level
+    property bool active: visible
+
+    // roll: rotation of the horizon in the screen (degrees, clockwise)
+    property real roll: 0
+    property real pitch: 0
+    property bool flat: false
+    property real bx: 0
+    property real by: 0
+    readonly property real snapped: {
+        // nearest of 0/90/180/270 (portrait/landscape), deviation from it
+        var r = ((roll % 360) + 360) % 360;
+        var q = Math.round(r / 90) * 90;
+        return r - q;
+    }
+    readonly property bool isLevel: !flat && Math.abs(snapped) < 1.0
+
+    Accelerometer {
+        id: accel
+        active: level.active
+        dataRate: 20
+        onReadingChanged: {
+            var x = reading.x, y = reading.y, z = reading.z;
+            var g = Math.sqrt(x * x + y * y + z * z);
+            if (g < 1) return;
+            var a = 0.25;   // low pass
+            level.flat = Math.abs(z) / g > 0.9;
+            // Gravity in screen coordinates: x right, y up (device frame).
+            var r = Math.atan2(x, y) * 180 / Math.PI;     // 0 = upright portrait
+            var d = r - level.roll;
+            while (d > 180) d -= 360;
+            while (d < -180) d += 360;
+            level.roll += a * d;
+            level.pitch += a * (Math.asin(Math.max(-1, Math.min(1, z / g))) * 180 / Math.PI - level.pitch);
+            level.bx += a * (x / g - level.bx);
+            level.by += a * (y / g - level.by);
+        }
+    }
+
+    // horizon line through the centre
+    Item {
+        anchors.centerIn: parent
+        width: Math.min(parent.width, parent.height) * 0.7
+        height: units.dp(2)
+        visible: !level.flat
+        rotation: level.roll
+        Rectangle {
+            anchors.fill: parent
+            color: level.isLevel ? "#40ff60" : "white"
+            opacity: 0.85
+        }
+        Rectangle {   // fixed reference marks at the ends
+            anchors.verticalCenter: parent.verticalCenter
+            anchors.left: parent.left
+            width: units.gu(2); height: units.dp(4)
+            color: level.isLevel ? "#40ff60" : "white"
+        }
+        Rectangle {
+            anchors.verticalCenter: parent.verticalCenter
+            anchors.right: parent.right
+            width: units.gu(2); height: units.dp(4)
+            color: level.isLevel ? "#40ff60" : "white"
+        }
+    }
+    Label {
+        anchors.centerIn: parent
+        anchors.verticalCenterOffset: units.gu(2.5)
+        visible: !level.flat
+        color: level.isLevel ? "#40ff60" : "white"
+        style: Text.Outline; styleColor: "black"
+        textSize: Label.Small
+        text: "%1°".arg(Math.abs(level.snapped).toFixed(1))
+    }
+
+    // bubble for shooting straight down/up
+    Item {
+        anchors.centerIn: parent
+        width: units.gu(8); height: width
+        visible: level.flat
+        Rectangle {
+            anchors.fill: parent; radius: width / 2
+            color: "transparent"; border.color: "white"; border.width: units.dp(1)
+        }
+        Rectangle {
+            width: units.gu(1.5); height: width; radius: width / 2
+            color: Math.abs(level.bx) < 0.02 && Math.abs(level.by) < 0.02 ? "#40ff60" : "white"
+            x: parent.width / 2 - width / 2 - level.bx * parent.width * 2
+            y: parent.height / 2 - height / 2 + level.by * parent.height * 2
+        }
+    }
+}
diff --git a/qml/components/Fp6LongExposureFeedback.qml b/qml/components/Fp6LongExposureFeedback.qml
new file mode 100644
index 0000000..0b924d7
--- /dev/null
+++ b/qml/components/Fp6LongExposureFeedback.qml
@@ -0,0 +1,137 @@
+/*
+ * FP6 Pro mode: progress of a stacked long exposure / bulb exposure, and
+ * the dark-frame prompt. The viewfinder itself shows the running result.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+import QtQuick 2.12
+import Lomiri.Components 1.3
+
+Item {
+    id: fb
+    property var pro
+    property real totalUs: 0          // 0 = bulb
+    readonly property int state: pro ? pro.stackState : 0
+    readonly property bool busy: state >= 1 && state <= 5
+    visible: busy
+
+    // effective exposure collected so far, in us
+    readonly property real collectedUs: pro ? pro.stackFrames * pro.stackFrameUs : 0
+    readonly property real frameUs: pro && pro.frameDurationUs > 0 ? pro.frameDurationUs
+                                    : (pro ? pro.stackFrameUs : 0)
+
+    property real tick: 0
+    Timer {
+        interval: 250; repeat: true; running: fb.busy
+        onTriggered: fb.tick = pro.stackElapsedMs
+    }
+
+    function fmt(us) {
+        var s = Math.max(0, Math.round(us / 1e6));
+        var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), r = s % 60;
+        if (h > 0) return "%1:%2:%3".arg(h).arg(m < 10 ? "0" + m : m).arg(r < 10 ? "0" + r : r);
+        return "%1:%2".arg(m).arg(r < 10 ? "0" + r : r);
+    }
+
+    Rectangle {
+        anchors.centerIn: parent
+        width: Math.min(parent.width - units.gu(4), units.gu(40))
+        height: content.height + units.gu(3)
+        radius: units.gu(1)
+        color: Qt.rgba(0, 0, 0, 0.6)
+
+        Column {
+            id: content
+            anchors { left: parent.left; right: parent.right; top: parent.top; margins: units.gu(1.5) }
+            spacing: units.gu(1)
+
+            Label {
+                width: parent.width
+                horizontalAlignment: Text.AlignHCenter
+                color: "white"
+                textSize: Label.Large
+                text: {
+                    switch (fb.state) {
+                    case 1: return i18n.tr("Preparing…");
+                    case 2: return fb.totalUs > 0 ? i18n.tr("Long exposure") : i18n.tr("Bulb");
+                    case 3: return i18n.tr("Dark frame");
+                    case 4: return i18n.tr("Dark frame…");
+                    case 5: return i18n.tr("Saving…");
+                    }
+                    return "";
+                }
+            }
+            // big timer: exposure collected (/ total) and remaining
+            Label {
+                width: parent.width
+                horizontalAlignment: Text.AlignHCenter
+                color: "white"
+                font.pixelSize: units.gu(5)
+                font.weight: Font.Light
+                visible: fb.state === 2
+                text: fb.totalUs > 0 ? "%1 / %2".arg(fb.fmt(fb.collectedUs)).arg(fb.fmt(fb.totalUs))
+                                     : fb.fmt(fb.collectedUs)
+            }
+            Label {
+                width: parent.width
+                horizontalAlignment: Text.AlignHCenter
+                color: "white"
+                textSize: Label.Small
+                visible: fb.state === 2 || fb.state === 4
+                text: {
+                    var t = pro.stackTargetFrames;
+                    var s = fb.state === 4 ? i18n.tr("dark frames %1").arg(pro.stackDarkFrames)
+                          : t > 0 ? i18n.tr("frame %1 of %2").arg(pro.stackFrames).arg(t)
+                                  : i18n.tr("frame %1").arg(pro.stackFrames);
+                    if (fb.state === 2 && t > 0)
+                        s += " · " + i18n.tr("%1 left").arg(fb.fmt((t - pro.stackFrames) * fb.frameUs));
+                    if (fb.state === 2 && t === 0)
+                        s += " · " + i18n.tr("tap the shutter to stop");
+                    return s;
+                }
+            }
+            ProgressBar {
+                width: parent.width
+                visible: fb.state === 2 && pro.stackTargetFrames > 0
+                minimumValue: 0
+                maximumValue: Math.max(1, pro.stackTargetFrames)
+                value: pro.stackFrames
+            }
+            Label {
+                width: parent.width
+                wrapMode: Text.WordWrap
+                horizontalAlignment: Text.AlignHCenter
+                color: "white"
+                visible: fb.state === 3
+                text: i18n.tr("Cover the lens completely, then tap Continue. The dark frame removes sensor noise and hot pixels.")
+            }
+            Row {
+                anchors.horizontalCenter: parent.horizontalCenter
+                spacing: units.gu(1)
+                visible: fb.state >= 1 && fb.state <= 4
+                Button {
+                    visible: fb.state === 3
+                    text: i18n.tr("Continue")
+                    color: theme.palette.normal.positive
+                    onClicked: pro.continueStack()
+                }
+                Button {
+                    visible: fb.state === 3
+                    text: i18n.tr("Skip")
+                    onClicked: pro.stopStack()
+                }
+                Button {
+                    visible: fb.state === 2 || fb.state === 4
+                    text: i18n.tr("Stop")
+                    onClicked: pro.stopStack()
+                }
+                Button {
+                    text: i18n.tr("Cancel")
+                    onClicked: pro.cancelStack()
+                }
+            }
+        }
+    }
+}
diff --git a/qml/components/Fp6ProChip.qml b/qml/components/Fp6ProChip.qml
new file mode 100644
index 0000000..2d37dfc
--- /dev/null
+++ b/qml/components/Fp6ProChip.qml
@@ -0,0 +1,50 @@
+/*
+ * FP6 Pro mode: small text toggle/selector button.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+import QtQuick 2.12
+import Lomiri.Components 1.3
+
+AbstractButton {
+    id: chip
+
+    property string title: ""
+    property string value: ""
+    property bool selected: false
+    property bool highlighted: false   // a manual value is active
+
+    implicitHeight: units.gu(4.5)
+    implicitWidth: Math.max(units.gu(5.5), column.width + units.gu(2))
+    opacity: enabled ? 1.0 : 0.4
+
+    Rectangle {
+        anchors.fill: parent
+        radius: units.gu(1)
+        color: chip.selected ? Qt.rgba(1, 1, 1, 0.25) : Qt.rgba(0, 0, 0, 0.45)
+        border.width: chip.highlighted ? units.dp(1) : 0
+        border.color: LomiriColors.orange
+    }
+
+    Column {
+        id: column
+        anchors.centerIn: parent
+        Label {
+            anchors.horizontalCenter: parent.horizontalCenter
+            text: chip.title
+            textSize: Label.XSmall
+            color: "white"
+            opacity: 0.7
+            visible: text !== ""
+        }
+        Label {
+            anchors.horizontalCenter: parent.horizontalCenter
+            text: chip.value
+            textSize: Label.Small
+            font.weight: Font.DemiBold
+            color: chip.highlighted ? LomiriColors.orange : "white"
+        }
+    }
+}
diff --git a/qml/components/Fp6ProPanel.qml b/qml/components/Fp6ProPanel.qml
new file mode 100644
index 0000000..7ef68d6
--- /dev/null
+++ b/qml/components/Fp6ProPanel.qml
@@ -0,0 +1,408 @@
+/*
+ * FP6 Pro mode: manual shutter (incl. long exposure / bulb), ISO, EV,
+ * white balance, focus and the viewfinder tools. Values live in the
+ * viewfinder Settings (persisted); this panel only edits them.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+import QtQuick 2.12
+import Lomiri.Components 1.3
+import Lomiri.Components.Popups 1.3
+
+Item {
+    id: panel
+
+    property var settings
+    property var pro                 // Fp6ProControls
+    property string current: ""      // open editor: s, iso, ev, wb, f, tools
+    property bool aeLock: false
+    property bool awbLock: false
+    property bool afLock: false
+
+    readonly property bool longExposure: settings.proExposureUs < 0
+        || (pro.maxExposureUs > 0 && settings.proExposureUs > pro.maxExposureUs)
+
+    // shutter stops in us; 0 = auto, -1 = bulb
+    readonly property var shutterStops: [0, 125, 250, 500, 1000, 2000, 4000, 8000,
+        16667, 33333, 66667, 125000, 250000, 500000, 1000000, 2000000, 4000000,
+        8000000, 15000000, 30000000, 60000000, 120000000, 300000000, 600000000,
+        1200000000, 1800000000, 3600000000, -1]
+    readonly property var isoStops: [0, 100, 125, 160, 200, 250, 320, 400, 500, 640,
+        800, 1000, 1250, 1600, 2000, 2500, 3200, 4000, 5000, 6400]
+    readonly property var wbPresets: [
+        { label: i18n.tr("Auto"), k: 0 },
+        { label: i18n.tr("Tungsten"), k: 2850 },
+        { label: i18n.tr("Fluorescent"), k: 4000 },
+        { label: i18n.tr("Daylight"), k: 5500 },
+        { label: i18n.tr("Cloudy"), k: 6500 },
+        { label: i18n.tr("Shade"), k: 7500 }
+    ]
+
+    function nearestIndex(list, v) {
+        var best = 0;
+        for (var i = 0; i < list.length; i++) {
+            if (list[i] === v) return i;
+            if (list[i] > 0 && v > 0 && Math.abs(Math.log(list[i] / v)) <
+                    Math.abs(Math.log((list[best] > 0 ? list[best] : 1) / v)))
+                best = i;
+        }
+        return best;
+    }
+
+    function shutterLabel(us) {
+        if (us < 0) return "B";
+        return pro.formatShutter(us);
+    }
+
+    function evLabel(ev) {
+        var r = Math.round(ev * 3) / 3;
+        if (Math.abs(r) < 0.01) return "±0";
+        return (r > 0 ? "+" : "−") + Math.abs(r).toFixed(1);
+    }
+
+    function toggle(name) { current = (current === name) ? "" : name; }
+
+    implicitHeight: column.height
+    height: column.height
+
+    Column {
+        id: column
+        anchors { left: parent.left; right: parent.right; bottom: parent.bottom }
+        spacing: units.gu(1)
+
+        // ---------------------------------------------------------- editors
+        Item {
+            id: editor
+            anchors { left: parent.left; right: parent.right }
+            height: visible ? editorColumn.height + units.gu(2) : 0
+            visible: panel.current !== ""
+
+            Rectangle {
+                anchors.fill: parent
+                radius: units.gu(1)
+                color: Qt.rgba(0, 0, 0, 0.55)
+            }
+
+            Column {
+                id: editorColumn
+                anchors {
+                    left: parent.left; right: parent.right; top: parent.top
+                    margins: units.gu(1)
+                }
+                spacing: units.gu(1)
+
+                // ------------------------------------------------ shutter
+                Column {
+                    width: parent.width
+                    spacing: units.gu(1)
+                    visible: panel.current === "s"
+
+                    Label {
+                        width: parent.width
+                        horizontalAlignment: Text.AlignHCenter
+                        color: "white"
+                        text: settings.proExposureUs < 0 ? i18n.tr("Bulb: shutter open until you tap again")
+                              : settings.proExposureUs === 0 ? i18n.tr("Shutter: automatic")
+                              : i18n.tr("Shutter %1").arg(shutterLabel(settings.proExposureUs))
+                    }
+                    Fp6Slider {
+                        id: shutterSlider
+                        width: parent.width
+                        minimumValue: 0
+                        maximumValue: panel.shutterStops.length - 1
+                        value: panel.nearestIndex(panel.shutterStops, settings.proExposureUs)
+                        onMoved: settings.proExposureUs =
+                                            panel.shutterStops[Math.round(value)]
+                    }
+                    Row {
+                        anchors.horizontalCenter: parent.horizontalCenter
+                        spacing: units.gu(1)
+                        Fp6ProChip { value: i18n.tr("Auto"); selected: settings.proExposureUs === 0
+                            onClicked: settings.proExposureUs = 0 }
+                        Fp6ProChip { value: i18n.tr("Custom…"); onClicked: PopupUtils.open(customShutterDialog) }
+                        Fp6ProChip { value: "B"; title: i18n.tr("bulb"); selected: settings.proExposureUs < 0
+                            onClicked: settings.proExposureUs = -1 }
+                        Fp6ProChip { title: "AE-L"; value: panel.aeLock ? i18n.tr("on") : i18n.tr("off")
+                            selected: panel.aeLock; onClicked: panel.aeLock = !panel.aeLock }
+                    }
+                    // long exposure options
+                    Column {
+                        width: parent.width
+                        spacing: units.gu(1)
+                        visible: panel.longExposure
+                        Label {
+                            width: parent.width
+                            wrapMode: Text.WordWrap
+                            horizontalAlignment: Text.AlignHCenter
+                            textSize: Label.Small
+                            color: "white"
+                            text: i18n.tr("Longest single frame: %1. Longer exposures stack frames.")
+                                  .arg(pro.formatShutter(pro.maxExposureUs))
+                        }
+                        Row {
+                            anchors.horizontalCenter: parent.horizontalCenter
+                            spacing: units.gu(1)
+                            Fp6ProChip { title: i18n.tr("stack"); value: i18n.tr("Sum")
+                                selected: settings.proStackMode === 0; onClicked: settings.proStackMode = 0 }
+                            Fp6ProChip { title: i18n.tr("stack"); value: i18n.tr("Mean")
+                                selected: settings.proStackMode === 1; onClicked: settings.proStackMode = 1 }
+                            Fp6ProChip { title: i18n.tr("dark frame"); value: settings.proDarkFrame ? i18n.tr("on") : i18n.tr("off")
+                                selected: settings.proDarkFrame; onClicked: settings.proDarkFrame = !settings.proDarkFrame }
+                        }
+                    }
+                }
+
+                // ------------------------------------------------ ISO
+                Column {
+                    width: parent.width
+                    spacing: units.gu(1)
+                    visible: panel.current === "iso"
+                    Label {
+                        width: parent.width
+                        horizontalAlignment: Text.AlignHCenter
+                        color: "white"
+                        text: settings.proIso > 0 ? "ISO %1".arg(settings.proIso)
+                                                  : i18n.tr("ISO automatic (now %1)").arg(pro.currentIso)
+                    }
+                    Fp6Slider {
+                        width: parent.width
+                        minimumValue: 0
+                        maximumValue: panel.isoStops.length - 1
+                        value: panel.nearestIndex(panel.isoStops, settings.proIso)
+                        onMoved: settings.proIso = panel.isoStops[Math.round(value)]
+                    }
+                    Row {
+                        anchors.horizontalCenter: parent.horizontalCenter
+                        spacing: units.gu(1)
+                        Fp6ProChip { value: i18n.tr("Auto"); selected: settings.proIso === 0
+                            onClicked: settings.proIso = 0 }
+                        Fp6ProChip { title: "AE-L"; value: panel.aeLock ? i18n.tr("on") : i18n.tr("off")
+                            selected: panel.aeLock; onClicked: panel.aeLock = !panel.aeLock }
+                    }
+                }
+
+                // ------------------------------------------------ EV
+                Column {
+                    width: parent.width
+                    spacing: units.gu(1)
+                    visible: panel.current === "ev"
+                    Label {
+                        width: parent.width
+                        horizontalAlignment: Text.AlignHCenter
+                        color: "white"
+                        text: (settings.proExposureUs > 0 && settings.proIso > 0)
+                              ? i18n.tr("EV has no effect with manual shutter and ISO")
+                              : i18n.tr("Exposure compensation %1 EV").arg(panel.evLabel(settings.proEv))
+                    }
+                    Fp6Slider {
+                        width: parent.width
+                        minimumValue: -12
+                        maximumValue: 12
+                        value: Math.round(settings.proEv * 3)
+                        onMoved: settings.proEv = Math.round(value) / 3
+                    }
+                    Fp6ProChip { anchors.horizontalCenter: parent.horizontalCenter
+                        value: "±0"; onClicked: settings.proEv = 0 }
+                }
+
+                // ------------------------------------------------ WB
+                Column {
+                    width: parent.width
+                    spacing: units.gu(1)
+                    visible: panel.current === "wb"
+                    Label {
+                        width: parent.width
+                        horizontalAlignment: Text.AlignHCenter
+                        color: "white"
+                        text: settings.proWbKelvin > 0 ? i18n.tr("White balance %1 K").arg(settings.proWbKelvin)
+                              : i18n.tr("White balance automatic (now %1 K)").arg(pro.currentKelvin)
+                    }
+                    Flow {
+                        width: parent.width
+                        spacing: units.gu(1)
+                        Repeater {
+                            model: panel.wbPresets
+                            Fp6ProChip {
+                                value: modelData.label
+                                selected: settings.proWbKelvin === modelData.k
+                                onClicked: { settings.proWbKelvin = modelData.k; panel.awbLock = false; }
+                            }
+                        }
+                        Fp6ProChip { title: "AWB-L"; value: panel.awbLock ? i18n.tr("on") : i18n.tr("off")
+                            selected: panel.awbLock; enabled: settings.proWbKelvin === 0
+                            onClicked: panel.awbLock = !panel.awbLock }
+                    }
+                    Fp6Slider {
+                        width: parent.width
+                        minimumValue: 2000
+                        maximumValue: 10000
+                        value: settings.proWbKelvin > 0 ? settings.proWbKelvin
+                               : (pro.currentKelvin > 0 ? pro.currentKelvin : 5000)
+                        onMoved: settings.proWbKelvin = Math.round(value / 50) * 50
+                    }
+                }
+
+                // ------------------------------------------------ focus
+                Column {
+                    width: parent.width
+                    spacing: units.gu(1)
+                    visible: panel.current === "f"
+                    Label {
+                        width: parent.width
+                        horizontalAlignment: Text.AlignHCenter
+                        color: "white"
+                        text: !pro.hasFocus ? i18n.tr("This camera has fixed focus")
+                              : settings.proFocus < 0 ? i18n.tr("Autofocus (tap the image to focus there)")
+                              : i18n.tr("Manual focus %1 %").arg(Math.round(settings.proFocus * 100))
+                    }
+                    Row {
+                        width: parent.width
+                        spacing: units.gu(1)
+                        enabled: pro.hasFocus
+                        Label { text: "∞"; color: "white"; anchors.verticalCenter: parent.verticalCenter }
+                        Fp6Slider {
+                            width: parent.width - units.gu(6)
+                            minimumValue: 0
+                            maximumValue: 1
+                            value: settings.proFocus >= 0 ? settings.proFocus
+                                   : (pro.currentFocus >= 0 ? pro.currentFocus : 0)
+                            onMoved: settings.proFocus = value
+                        }
+                        Label { text: i18n.tr("near"); color: "white"; textSize: Label.Small
+                            anchors.verticalCenter: parent.verticalCenter }
+                    }
+                    Row {
+                        anchors.horizontalCenter: parent.horizontalCenter
+                        spacing: units.gu(1)
+                        enabled: pro.hasFocus
+                        Fp6ProChip { value: "AF"; selected: settings.proFocus < 0
+                            onClicked: { settings.proFocus = -1; panel.afLock = false; } }
+                        Fp6ProChip { title: "AF-L"; value: panel.afLock ? i18n.tr("on") : i18n.tr("off")
+                            selected: panel.afLock; enabled: settings.proFocus < 0
+                            onClicked: panel.afLock = !panel.afLock }
+                        Fp6ProChip { title: i18n.tr("peaking"); value: settings.proPeaking ? i18n.tr("on") : i18n.tr("off")
+                            selected: settings.proPeaking; onClicked: settings.proPeaking = !settings.proPeaking }
+                    }
+                }
+
+                // ------------------------------------------------ tools
+                Flow {
+                    width: parent.width
+                    spacing: units.gu(1)
+                    visible: panel.current === "tools"
+                    Fp6ProChip { title: i18n.tr("histogram"); value: settings.proHistogram ? i18n.tr("on") : i18n.tr("off")
+                        selected: settings.proHistogram; onClicked: settings.proHistogram = !settings.proHistogram }
+                    Fp6ProChip { title: i18n.tr("zebra"); value: settings.proZebra ? i18n.tr("on") : i18n.tr("off")
+                        selected: settings.proZebra; onClicked: settings.proZebra = !settings.proZebra }
+                    Fp6ProChip { title: i18n.tr("peaking"); value: settings.proPeaking ? i18n.tr("on") : i18n.tr("off")
+                        selected: settings.proPeaking; onClicked: settings.proPeaking = !settings.proPeaking }
+                    Fp6ProChip { title: i18n.tr("level"); value: settings.proLevel ? i18n.tr("on") : i18n.tr("off")
+                        selected: settings.proLevel; onClicked: settings.proLevel = !settings.proLevel }
+                    Fp6ProChip { title: i18n.tr("grid"); value: settings.gridEnabled ? i18n.tr("on") : i18n.tr("off")
+                        selected: settings.gridEnabled; onClicked: settings.gridEnabled = !settings.gridEnabled }
+                    Fp6ProChip { value: i18n.tr("Reset all")
+                        onClicked: {
+                            settings.proExposureUs = 0; settings.proIso = 0; settings.proEv = 0;
+                            settings.proWbKelvin = 0; settings.proFocus = -1;
+                            panel.aeLock = false; panel.awbLock = false; panel.afLock = false;
+                        }
+                    }
+                }
+            }
+        }
+
+        // ---------------------------------------------------------- chips
+        Row {
+            anchors.horizontalCenter: parent.horizontalCenter
+            spacing: units.gu(0.75)
+
+            Fp6ProChip {
+                title: "S"
+                value: settings.proExposureUs === 0 ? "A" : shutterLabel(settings.proExposureUs)
+                highlighted: settings.proExposureUs !== 0 || panel.aeLock
+                selected: panel.current === "s"
+                onClicked: panel.toggle("s")
+            }
+            Fp6ProChip {
+                title: "ISO"
+                value: settings.proIso > 0 ? settings.proIso : "A"
+                highlighted: settings.proIso > 0
+                selected: panel.current === "iso"
+                onClicked: panel.toggle("iso")
+            }
+            Fp6ProChip {
+                title: "EV"
+                value: panel.evLabel(settings.proEv)
+                highlighted: Math.abs(settings.proEv) > 0.01
+                selected: panel.current === "ev"
+                onClicked: panel.toggle("ev")
+            }
+            Fp6ProChip {
+                title: "WB"
+                value: settings.proWbKelvin > 0 ? (settings.proWbKelvin / 1000).toFixed(1) + "K"
+                       : (panel.awbLock ? "L" : "A")
+                highlighted: settings.proWbKelvin > 0 || panel.awbLock
+                selected: panel.current === "wb"
+                onClicked: panel.toggle("wb")
+            }
+            Fp6ProChip {
+                title: i18n.tr("focus")
+                value: !pro.hasFocus ? "—" : settings.proFocus >= 0 ? "MF"
+                       : (panel.afLock ? "AF-L" : "AF")
+                highlighted: settings.proFocus >= 0 || panel.afLock
+                selected: panel.current === "f"
+                onClicked: panel.toggle("f")
+            }
+            Fp6ProChip {
+                value: "⋯"
+                selected: panel.current === "tools"
+                onClicked: panel.toggle("tools")
+            }
+        }
+    }
+
+    Component {
+        id: customShutterDialog
+        Dialog {
+            id: dialog
+            title: i18n.tr("Shutter time")
+            text: i18n.tr("For example 1/8000, 1/30, 0.5, 2.5s, 90, 5m or 1h30m. "
+                          + "Times above %1 are stacked from several frames.")
+                  .arg(pro.formatShutter(pro.maxExposureUs))
+            TextField {
+                id: field
+                inputMethodHints: Qt.ImhNoPredictiveText | Qt.ImhPreferNumbers
+                placeholderText: "1/250"
+                text: settings.proExposureUs > 0 ? pro.formatShutter(settings.proExposureUs).replace("\"", "s") : ""
+                Component.onCompleted: forceActiveFocus()
+                onAccepted: okButton.clicked()
+            }
+            Label {
+                id: error
+                visible: text !== ""
+                color: theme.palette.normal.negative
+                text: ""
+            }
+            Button {
+                id: okButton
+                text: i18n.tr("Set")
+                color: theme.palette.normal.positive
+                onClicked: {
+                    var us = pro.parseShutter(field.text);
+                    if (us < 30 || us > 4 * 3600e6) {
+                        error.text = i18n.tr("Use a time between 1/30000 s and 4 h");
+                        return;
+                    }
+                    settings.proExposureUs = Math.round(us);
+                    PopupUtils.close(dialog);
+                }
+            }
+            Button {
+                text: i18n.tr("Cancel")
+                onClicked: PopupUtils.close(dialog)
+            }
+        }
+    }
+}
diff --git a/qml/components/Fp6Slider.qml b/qml/components/Fp6Slider.qml
new file mode 100644
index 0000000..28e35e5
--- /dev/null
+++ b/qml/components/Fp6Slider.qml
@@ -0,0 +1,56 @@
+/*
+ * FP6 Pro mode: simple slider. "value" may stay bound; user drags emit
+ * moved(value) with the new value instead of breaking the binding.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+import QtQuick 2.12
+import Lomiri.Components 1.3
+
+Item {
+    id: slider
+    property real minimumValue: 0
+    property real maximumValue: 1
+    property real value: 0
+    readonly property bool pressed: area.pressed
+    signal moved(real value)
+
+    implicitHeight: units.gu(4)
+    height: units.gu(4)
+
+    readonly property real fraction: maximumValue > minimumValue
+        ? Math.max(0, Math.min(1, (value - minimumValue) / (maximumValue - minimumValue))) : 0
+
+    Rectangle {
+        id: track
+        anchors { left: parent.left; right: parent.right; verticalCenter: parent.verticalCenter
+                  leftMargin: thumb.width / 2; rightMargin: thumb.width / 2 }
+        height: units.dp(2)
+        color: Qt.rgba(1, 1, 1, 0.45)
+        Rectangle {
+            width: slider.fraction * parent.width
+            height: parent.height
+            color: LomiriColors.orange
+        }
+    }
+    Rectangle {
+        id: thumb
+        width: units.gu(2.5); height: width; radius: width / 2
+        color: "white"
+        anchors.verticalCenter: parent.verticalCenter
+        x: slider.fraction * track.width
+    }
+    MouseArea {
+        id: area
+        anchors.fill: parent
+        preventStealing: true
+        function update(mx) {
+            var f = Math.max(0, Math.min(1, (mx - track.x) / track.width));
+            slider.moved(slider.minimumValue + f * (slider.maximumValue - slider.minimumValue));
+        }
+        onPressed: update(mouse.x)
+        onPositionChanged: update(mouse.x)
+    }
+}
