diff --git a/CameraApp/fp6procontrols.cpp b/CameraApp/fp6procontrols.cpp
new file mode 100644
index 0000000..15d872b
--- /dev/null
+++ b/CameraApp/fp6procontrols.cpp
@@ -0,0 +1,371 @@
+/*
+ * FP6 "Pro" camera controls, see fp6procontrols.h.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+#include "fp6procontrols.h"
+
+#include <QDateTime>
+#include <QDebug>
+#include <QDir>
+#include <QRegularExpression>
+#include <QtMath>
+
+#include <glib-object.h>
+
+#include <cmath>
+
+static QMutex s_overlayLock;
+static QImage s_overlay;
+
+/* GLib boolean / GBytes etc. only; no GStreamer headers needed */
+
+Fp6ProControls::Fp6ProControls(QObject *parent)
+    : QObject(parent)
+{
+    m_timer.setInterval(250);
+    connect(&m_timer, &QTimer::timeout, this, &Fp6ProControls::poll);
+}
+
+Fp6ProControls::~Fp6ProControls()
+{
+}
+
+void *Fp6ProControls::element() const
+{
+    GType t = g_type_from_name("Fp6LibcameraSrc");
+    if (!t)
+        return nullptr;
+    GWeakRef *ref = static_cast<GWeakRef *>(
+        g_type_get_qdata(t, g_quark_from_static_string("fp6-manual-active")));
+    return ref ? g_weak_ref_get(ref) : nullptr;
+}
+
+void Fp6ProControls::setPolling(bool on)
+{
+    if (on == m_polling)
+        return;
+    m_polling = on;
+    if (on) {
+        poll();
+        m_timer.start();
+    } else {
+        m_timer.stop();
+    }
+    Q_EMIT pollingChanged();
+}
+
+void Fp6ProControls::changed()
+{
+    Q_EMIT settingsChanged();
+    GObject *obj = static_cast<GObject *>(element());
+    if (obj) {
+        sync(obj);
+        g_object_unref(obj);
+    }
+}
+
+#define SETTER(name, member, type)              \
+    void Fp6ProControls::name(type v)           \
+    {                                           \
+        if (member == v)                        \
+            return;                             \
+        member = v;                             \
+        changed();                              \
+    }
+
+SETTER(setExposureUs, m_exposureUs, double)
+SETTER(setIso, m_iso, int)
+SETTER(setEv, m_ev, double)
+SETTER(setWbKelvin, m_wbKelvin, int)
+SETTER(setAeLock, m_aeLock, bool)
+SETTER(setAwbLock, m_awbLock, bool)
+SETTER(setAfLock, m_afLock, bool)
+SETTER(setFocus, m_focus, double)
+SETTER(setUltrawide, m_ultrawide, bool)
+SETTER(setAnalysis, m_analysis, int)
+SETTER(setZebraLevel, m_zebraLevel, int)
+#undef SETTER
+
+/* Push every setting that differs from the element's. */
+void Fp6ProControls::sync(void *p)
+{
+    GObject *obj = static_cast<GObject *>(p);
+    gint64 exp = 0;
+    gint iso = 0, kelvin = 0, zebra = 0;
+    gfloat ev = 0, focus = -1;
+    gboolean ae = FALSE, awb = FALSE, af = FALSE, uw = FALSE;
+    guint an = 0;
+
+    g_object_get(obj, "exposure-us", &exp, "iso", &iso, "ev", &ev,
+                 "wb-kelvin", &kelvin, "ae-lock", &ae, "awb-lock", &awb,
+                 "af-lock", &af, "focus", &focus, "ultrawide", &uw,
+                 "analysis", &an, "zebra-level", &zebra, NULL);
+
+    const gint64 wantExp = qMax<gint64>(0, qint64(m_exposureUs));
+    if (exp != wantExp)
+        g_object_set(obj, "exposure-us", wantExp, NULL);
+    if (iso != m_iso)
+        g_object_set(obj, "iso", m_iso, NULL);
+    if (std::fabs(ev - m_ev) > 0.001)
+        g_object_set(obj, "ev", gfloat(m_ev), NULL);
+    if (kelvin != m_wbKelvin)
+        g_object_set(obj, "wb-kelvin", m_wbKelvin, NULL);
+    if (bool(ae) != m_aeLock)
+        g_object_set(obj, "ae-lock", gboolean(m_aeLock), NULL);
+    if (bool(awb) != m_awbLock)
+        g_object_set(obj, "awb-lock", gboolean(m_awbLock), NULL);
+    if (bool(af) != m_afLock)
+        g_object_set(obj, "af-lock", gboolean(m_afLock), NULL);
+    const gfloat wantFocus = m_focus < 0 ? -1.0f : gfloat(qBound(0.0, m_focus, 1.0));
+    if (std::fabs(focus - wantFocus) > 0.0005)
+        g_object_set(obj, "focus", wantFocus, NULL);
+    if (bool(uw) != m_ultrawide)
+        g_object_set(obj, "ultrawide", gboolean(m_ultrawide), NULL);
+    if (an != guint(m_analysis))
+        g_object_set(obj, "analysis", guint(m_analysis), NULL);
+    if (zebra != m_zebraLevel)
+        g_object_set(obj, "zebra-level", m_zebraLevel, NULL);
+}
+
+void Fp6ProControls::poll()
+{
+    GObject *obj = static_cast<GObject *>(element());
+    const bool avail = obj != nullptr;
+
+    if (avail != m_available) {
+        m_available = avail;
+        Q_EMIT availableChanged();
+    }
+    if (!obj)
+        return;
+
+    sync(obj);
+
+    gint64 curExp = 0, frame = 0, maxExp = 0, stackFrameUs = 0;
+    gint curIso = 0, kelvin = 0, afState = -1, st = 0, frames = 0, target = 0, dark = 0;
+    gfloat curFocus = -1;
+    gboolean hasFocus = FALSE;
+    guint serial = 0;
+    gchar *lens = nullptr, *result = nullptr, *error = nullptr;
+
+    g_object_get(obj, "current-exposure-us", &curExp, "current-iso", &curIso,
+                 "current-kelvin", &kelvin, "current-focus", &curFocus,
+                 "frame-duration-us", &frame, "max-exposure-us", &maxExp,
+                 "af-state", &afState, "has-focus", &hasFocus,
+                 "active-lens", &lens, "analysis-serial", &serial,
+                 "stack-state", &st, "stack-frames", &frames,
+                 "stack-target-frames", &target, "stack-frame-us", &stackFrameUs,
+                 "stack-dark-frames", &dark, "stack-result", &result,
+                 "stack-error", &error, NULL);
+
+    m_curExposureUs = curExp;
+    m_curIso = curIso;
+    m_curKelvin = kelvin;
+    m_curFocus = curFocus;
+    m_frameDurationUs = frame;
+    m_maxExposureUs = maxExp;
+    m_afState = afState;
+    m_hasFocus = hasFocus;
+    m_activeLens = QString::fromUtf8(lens ? lens : "");
+    Q_EMIT readoutChanged();
+
+    if (serial != m_analysisSerial) {
+        m_analysisSerial = serial;
+        GBytes *hist = nullptr, *mask = nullptr;
+        gint mw = 0, mh = 0;
+        g_object_get(obj, "histogram", &hist, "overlay", &mask,
+                     "overlay-width", &mw, "overlay-height", &mh, NULL);
+        if (hist) {
+            gsize n = 0;
+            const guint32 *b = static_cast<const guint32 *>(g_bytes_get_data(hist, &n));
+            n /= sizeof(guint32);
+            QVariantList out;
+            if (n == 256) {
+                for (int c = 0; c < 4; c++) {
+                    guint32 mx = 1;
+                    /* ignore the clipped end bins for the scale */
+                    for (int i = 1; i < 63; i++)
+                        mx = qMax(mx, b[c * 64 + i]);
+                    for (int i = 0; i < 64; i++)
+                        out << qMin(1.0, double(b[c * 64 + i]) / mx);
+                }
+            }
+            m_histogram = out;
+            g_bytes_unref(hist);
+            Q_EMIT histogramChanged();
+        }
+        if (mask && mw > 0 && mh > 0) {
+            gsize n = 0;
+            const guint8 *d = static_cast<const guint8 *>(g_bytes_get_data(mask, &n));
+            if (n >= gsize(mw * mh)) {
+                QImage img(mw, mh, QImage::Format_ARGB32_Premultiplied);
+                for (int y = 0; y < mh; y++) {
+                    QRgb *line = reinterpret_cast<QRgb *>(img.scanLine(y));
+                    for (int x = 0; x < mw; x++) {
+                        const guint8 v = d[y * mw + x];
+                        QRgb c = qRgba(0, 0, 0, 0);
+                        if (v & 2)
+                            c = qPremultiply(qRgba(40, 255, 40, 230));
+                        else if ((v & 1) && ((x + y) / 2) % 2 == 0)
+                            c = qPremultiply(qRgba(255, 40, 200, 190));
+                        line[x] = c;
+                    }
+                }
+                QMutexLocker lock(&s_overlayLock);
+                s_overlay = img;
+            }
+            m_overlaySerial++;
+            Q_EMIT overlayChanged();
+        }
+        if (mask)
+            g_bytes_unref(mask);
+    }
+
+    const int oldState = m_stackState;
+    const bool stackChange = st != m_stackState || frames != m_stackFrames
+        || dark != m_stackDark || target != m_stackTarget;
+    m_stackState = st;
+    m_stackFrames = frames;
+    m_stackTarget = target;
+    m_stackFrameUs = stackFrameUs;
+    m_stackDark = dark;
+    if (st == StackLight && oldState != StackLight)
+        m_stackStartMs = QDateTime::currentMSecsSinceEpoch();
+    if (stackChange || st == StackLight)
+        Q_EMIT stackChanged();
+    if (st != oldState) {
+        if (st == StackDone && result)
+            Q_EMIT stackFinished(QString::fromUtf8(result));
+        else if (st == StackError)
+            Q_EMIT stackFailed(QString::fromUtf8(error ? error : "failed"));
+    }
+    g_free(lens);
+    g_free(result);
+    g_free(error);
+    g_object_unref(obj);
+}
+
+double Fp6ProControls::stackElapsedMs() const
+{
+    if (m_stackState < StackLight || m_stackState > StackDark || !m_stackStartMs)
+        return 0;
+    return QDateTime::currentMSecsSinceEpoch() - m_stackStartMs;
+}
+
+void Fp6ProControls::triggerAutofocus(double x, double y)
+{
+    GObject *obj = static_cast<GObject *>(element());
+    if (!obj)
+        return;
+    g_signal_emit_by_name(obj, "trigger-autofocus", x, y);
+    g_object_unref(obj);
+}
+
+bool Fp6ProControls::startStack(const QString &directory, double totalUs, int mode,
+                                bool darkFrame, int orientation, int quality)
+{
+    GObject *obj = static_cast<GObject *>(element());
+    if (!obj)
+        return false;
+    QDir().mkpath(directory);
+    const QString path = QDir(directory).filePath(
+        QStringLiteral("image%1_LE.jpg")
+            .arg(QDateTime::currentDateTime().toString(QStringLiteral("yyyyMMdd_hhmmsszzz"))));
+    gboolean ok = FALSE;
+    g_signal_emit_by_name(obj, "stack-start", path.toUtf8().constData(),
+                          gint64(qMax(0.0, totalUs)), gint(mode), gboolean(darkFrame),
+                          gint(orientation), gint(quality), &ok);
+    g_object_unref(obj);
+    if (ok) {
+        m_stackStartMs = 0;
+        poll();
+    }
+    return ok;
+}
+
+#define ACTION(fn, sig)                                         \
+    void Fp6ProControls::fn()                                   \
+    {                                                           \
+        GObject *obj = static_cast<GObject *>(element());       \
+        if (!obj)                                               \
+            return;                                             \
+        g_signal_emit_by_name(obj, sig);                        \
+        g_object_unref(obj);                                    \
+        poll();                                                 \
+    }
+ACTION(stopStack, "stack-stop")
+ACTION(continueStack, "stack-continue")
+ACTION(cancelStack, "stack-cancel")
+#undef ACTION
+
+double Fp6ProControls::parseShutter(const QString &text) const
+{
+    QString t = text.trimmed().toLower().remove(QLatin1Char(' '));
+    if (t.isEmpty())
+        return 0;
+    static const QRegularExpression frac(QStringLiteral("^(\\d+(?:\\.\\d+)?)/(\\d+(?:\\.\\d+)?)s?$"));
+    auto m = frac.match(t);
+    if (m.hasMatch()) {
+        const double d = m.captured(2).toDouble();
+        return d > 0 ? 1e6 * m.captured(1).toDouble() / d : 0;
+    }
+    /* 1h30m10s, 5m, 2.5s, 90, 0.004 */
+    static const QRegularExpression parts(QStringLiteral("(\\d+(?:\\.\\d+)?)(h|m|s|ms)?"));
+    double us = 0;
+    int pos = 0;
+    auto it = parts.globalMatch(t);
+    while (it.hasNext()) {
+        auto p = it.next();
+        if (p.capturedStart() != pos)
+            return 0;
+        pos = p.capturedEnd();
+        const double v = p.captured(1).toDouble();
+        const QString u = p.captured(2);
+        us += v * (u == QLatin1String("h") ? 3.6e9 : u == QLatin1String("m") ? 6e7
+                   : u == QLatin1String("ms") ? 1e3 : 1e6);
+    }
+    return pos == t.size() ? us : 0;
+}
+
+QString Fp6ProControls::formatShutter(double us) const
+{
+    if (us <= 0)
+        return QStringLiteral("Auto");
+    if (us >= 0.3e6 && us < 0.95e6)
+        return QStringLiteral("%1\"").arg(QString::number(us / 1e6, 'f', 1));
+    if (us < 0.95e6) {
+        const double d = 1e6 / us;
+        return QStringLiteral("1/%1").arg(d >= 10 ? QString::number(qRound(d))
+                                                  : QString::number(d, 'g', 2));
+    }
+    const double s = us / 1e6;
+    if (s < 60)
+        return QStringLiteral("%1\"").arg(QString::number(s, 'g', s < 10 ? 2 : 3));
+    const qint64 total = qRound64(s);
+    const qint64 h = total / 3600, mi = (total % 3600) / 60, se = total % 60;
+    if (h)
+        return QStringLiteral("%1h%2m").arg(h).arg(mi, 2, 10, QLatin1Char('0'));
+    return se ? QStringLiteral("%1m%2s").arg(mi).arg(se, 2, 10, QLatin1Char('0'))
+              : QStringLiteral("%1m").arg(mi);
+}
+
+QImage Fp6ProControls::overlayImage()
+{
+    QMutexLocker lock(&s_overlayLock);
+    return s_overlay;
+}
+
+QImage Fp6OverlayProvider::requestImage(const QString &, QSize *size, const QSize &)
+{
+    QImage img = Fp6ProControls::overlayImage();
+    if (img.isNull()) {
+        img = QImage(1, 1, QImage::Format_ARGB32_Premultiplied);
+        img.fill(Qt::transparent);
+    }
+    if (size)
+        *size = img.size();
+    return img;
+}
diff --git a/CameraApp/fp6procontrols.h b/CameraApp/fp6procontrols.h
new file mode 100644
index 0000000..434a709
--- /dev/null
+++ b/CameraApp/fp6procontrols.h
@@ -0,0 +1,187 @@
+/*
+ * FP6 "Pro" camera controls: bridge from QML to the fp6libcamerasrc
+ * GStreamer element (gst-fp6camera, manual controls section).
+ *
+ * The element registers a GWeakRef to its most recently built instance as
+ * qdata "fp6-manual-active" on its GType; this class finds it there, so no
+ * library has to be linked besides GObject (same process, same GLib).
+ * Settings are re-synchronised to the element every poll, so a new camera
+ * instance (camera switch, restart) picks them up by itself.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+#ifndef FP6PROCONTROLS_H
+#define FP6PROCONTROLS_H
+
+#include <QImage>
+#include <QMutex>
+#include <QObject>
+#include <QQuickImageProvider>
+#include <QTimer>
+#include <QVariantList>
+
+class Fp6ProControls : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(bool available READ available NOTIFY availableChanged)
+    Q_PROPERTY(bool polling READ polling WRITE setPolling NOTIFY pollingChanged)
+
+    /* requested settings (0 / -1 = automatic) */
+    Q_PROPERTY(double exposureUs READ exposureUs WRITE setExposureUs NOTIFY settingsChanged)
+    Q_PROPERTY(int iso READ iso WRITE setIso NOTIFY settingsChanged)
+    Q_PROPERTY(double ev READ ev WRITE setEv NOTIFY settingsChanged)
+    Q_PROPERTY(int wbKelvin READ wbKelvin WRITE setWbKelvin NOTIFY settingsChanged)
+    Q_PROPERTY(bool aeLock READ aeLock WRITE setAeLock NOTIFY settingsChanged)
+    Q_PROPERTY(bool awbLock READ awbLock WRITE setAwbLock NOTIFY settingsChanged)
+    Q_PROPERTY(bool afLock READ afLock WRITE setAfLock NOTIFY settingsChanged)
+    Q_PROPERTY(double focus READ focus WRITE setFocus NOTIFY settingsChanged)
+    Q_PROPERTY(bool ultrawide READ ultrawide WRITE setUltrawide NOTIFY settingsChanged)
+    Q_PROPERTY(int analysis READ analysis WRITE setAnalysis NOTIFY settingsChanged)
+    Q_PROPERTY(int zebraLevel READ zebraLevel WRITE setZebraLevel NOTIFY settingsChanged)
+
+    /* what the camera really uses (metadata) */
+    Q_PROPERTY(double currentExposureUs READ currentExposureUs NOTIFY readoutChanged)
+    Q_PROPERTY(int currentIso READ currentIso NOTIFY readoutChanged)
+    Q_PROPERTY(int currentKelvin READ currentKelvin NOTIFY readoutChanged)
+    Q_PROPERTY(double currentFocus READ currentFocus NOTIFY readoutChanged)
+    Q_PROPERTY(double frameDurationUs READ frameDurationUs NOTIFY readoutChanged)
+    Q_PROPERTY(double maxExposureUs READ maxExposureUs NOTIFY readoutChanged)
+    Q_PROPERTY(int afState READ afState NOTIFY readoutChanged)
+    Q_PROPERTY(bool hasFocus READ hasFocus NOTIFY readoutChanged)
+    Q_PROPERTY(QString activeLens READ activeLens NOTIFY readoutChanged)
+    Q_PROPERTY(QVariantList histogram READ histogram NOTIFY histogramChanged)
+    Q_PROPERTY(int overlaySerial READ overlaySerial NOTIFY overlayChanged)
+
+    /* long exposure (stack) */
+    Q_PROPERTY(int stackState READ stackState NOTIFY stackChanged)
+    Q_PROPERTY(int stackFrames READ stackFrames NOTIFY stackChanged)
+    Q_PROPERTY(int stackTargetFrames READ stackTargetFrames NOTIFY stackChanged)
+    Q_PROPERTY(double stackFrameUs READ stackFrameUs NOTIFY stackChanged)
+    Q_PROPERTY(int stackDarkFrames READ stackDarkFrames NOTIFY stackChanged)
+    Q_PROPERTY(double stackElapsedMs READ stackElapsedMs NOTIFY stackChanged)
+
+public:
+    enum StackState { StackIdle = 0, StackSettle, StackLight, StackWaitDark,
+                      StackDark, StackSaving, StackDone, StackError };
+    Q_ENUM(StackState)
+
+    explicit Fp6ProControls(QObject *parent = nullptr);
+    ~Fp6ProControls();
+
+    bool available() const { return m_available; }
+    bool polling() const { return m_polling; }
+    void setPolling(bool on);
+
+    double exposureUs() const { return m_exposureUs; }
+    void setExposureUs(double v);
+    int iso() const { return m_iso; }
+    void setIso(int v);
+    double ev() const { return m_ev; }
+    void setEv(double v);
+    int wbKelvin() const { return m_wbKelvin; }
+    void setWbKelvin(int v);
+    bool aeLock() const { return m_aeLock; }
+    void setAeLock(bool v);
+    bool awbLock() const { return m_awbLock; }
+    void setAwbLock(bool v);
+    bool afLock() const { return m_afLock; }
+    void setAfLock(bool v);
+    double focus() const { return m_focus; }
+    void setFocus(double v);
+    bool ultrawide() const { return m_ultrawide; }
+    void setUltrawide(bool v);
+    int analysis() const { return m_analysis; }
+    void setAnalysis(int v);
+    int zebraLevel() const { return m_zebraLevel; }
+    void setZebraLevel(int v);
+
+    double currentExposureUs() const { return m_curExposureUs; }
+    int currentIso() const { return m_curIso; }
+    int currentKelvin() const { return m_curKelvin; }
+    double currentFocus() const { return m_curFocus; }
+    double frameDurationUs() const { return m_frameDurationUs; }
+    double maxExposureUs() const { return m_maxExposureUs; }
+    int afState() const { return m_afState; }
+    bool hasFocus() const { return m_hasFocus; }
+    QString activeLens() const { return m_activeLens; }
+    QVariantList histogram() const { return m_histogram; }
+    int overlaySerial() const { return m_overlaySerial; }
+
+    int stackState() const { return m_stackState; }
+    int stackFrames() const { return m_stackFrames; }
+    int stackTargetFrames() const { return m_stackTarget; }
+    double stackFrameUs() const { return m_stackFrameUs; }
+    int stackDarkFrames() const { return m_stackDark; }
+    double stackElapsedMs() const;
+
+    Q_INVOKABLE void triggerAutofocus(double x = -1, double y = -1);
+    Q_INVOKABLE bool startStack(const QString &directory, double totalUs, int mode,
+                                bool darkFrame, int orientation, int quality = 95);
+    Q_INVOKABLE void stopStack();
+    Q_INVOKABLE void continueStack();
+    Q_INVOKABLE void cancelStack();
+    /* "1/250", "0.5", "2.5s", "90", "5m", "1h", "1h30m" -> us (0 = invalid) */
+    Q_INVOKABLE double parseShutter(const QString &text) const;
+    Q_INVOKABLE QString formatShutter(double us) const;
+
+    /* overlay image for the "fp6pro" image provider */
+    static QImage overlayImage();
+
+Q_SIGNALS:
