+bool CameraApplication::fp6Secure() const
+{
+    // Secure mode: the photo roll shows only this run's photos and videos,
+    // nothing is shared/exported through content-hub, and no button opens
+    // another app (gallery, media player, settings, links).
+    static const bool secure = QCoreApplication::arguments().contains(QStringLiteral("--secure"))
+        || qgetenv("FP6_CAMERA_SECURE") == "1";
+    return secure;
+}
+
 bool CameraApplication::fp6Trace() const
 {
     return fp6TraceOn();
