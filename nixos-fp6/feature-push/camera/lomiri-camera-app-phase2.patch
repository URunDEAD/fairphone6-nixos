diff --git a/qml/components/Fp6JobFeedback.qml b/qml/components/Fp6JobFeedback.qml
new file mode 100644
index 0000000..18acf04
--- /dev/null
+++ b/qml/components/Fp6JobFeedback.qml
@@ -0,0 +1,64 @@
+/*
+ * FP6 phase 2: progress of a capture job (HDR, night, ...) of
+ * fp6libcamerasrc. Capturing shows "hold still"; processing runs in the
+ * background while the viewfinder stays live.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+import QtQuick 2.12
+import Lomiri.Components 1.3
+
+Item {
+    id: fb
+    property var pro
+    readonly property int state: pro ? pro.jobState : 0
+    visible: state === 1 || state === 2
+    implicitWidth: units.gu(28)
+    implicitHeight: column.height + units.gu(1.5)
+
+    function kindLabel(k) {
+        switch (k) {
+        case "hdr": return i18n.tr("HDR");
+        case "night": return i18n.tr("Night");
+        case "bracket": return i18n.tr("Bracket");
+        case "timelapse": return i18n.tr("Timelapse");
+        case "panorama": return i18n.tr("Panorama");
+        }
+        return k;
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        radius: units.gu(1)
+        color: Qt.rgba(0, 0, 0, 0.55)
+    }
+    Column {
+        id: column
+        anchors { left: parent.left; right: parent.right; verticalCenter: parent.verticalCenter
+                  margins: units.gu(1) }
+        spacing: units.gu(0.5)
+        Label {
+            width: parent.width
+            horizontalAlignment: Text.AlignHCenter
+            color: "white"
+            font.weight: Font.DemiBold
+            text: fb.state === 1
+                  ? (pro.jobTargetFrames > 0
+                     ? i18n.tr("%1: hold still (%2/%3)").arg(fb.kindLabel(pro.jobKind))
+                       .arg(pro.jobFrames).arg(pro.jobTargetFrames)
+                     : i18n.tr("%1: %2 frames").arg(fb.kindLabel(pro.jobKind)).arg(pro.jobFrames))
+                  : i18n.tr("Processing %1… %2%").arg(fb.kindLabel(pro.jobKind))
+                    .arg(Math.round(pro.jobProgress * 100))
+        }
+        ProgressBar {
+            width: parent.width
+            visible: !(fb.state === 1 && pro.jobTargetFrames === 0)   // open ended (timelapse)
+            height: units.gu(0.5)
+            minimumValue: 0
+            maximumValue: 1
+            value: pro ? pro.jobProgress : 0
+        }
+    }
+}
diff --git a/qml/components/Fp6PanoGuide.qml b/qml/components/Fp6PanoGuide.qml
new file mode 100644
index 0000000..45da2e3
--- /dev/null
+++ b/qml/components/Fp6PanoGuide.qml
@@ -0,0 +1,60 @@
+/*
+ * FP6 phase 2: panorama sweep guidance. A line across the middle of the
+ * viewfinder and a dot that follows the vertical drift (keep the dot on the
+ * line), an arrow for the sweep direction and the progress to the next
+ * frame. Tap the shutter to finish.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+import QtQuick 2.12
+import Lomiri.Components 1.3
+
+Item {
+    id: guide
+    property var pro
+    readonly property real drift: pro ? pro.panoDrift : 0
+    readonly property bool off: Math.abs(drift) > 0.06
+
+    Rectangle {
+        id: line
+        anchors.verticalCenter: parent.verticalCenter
+        x: units.gu(4); width: parent.width - units.gu(8); height: units.dp(2)
+        color: Qt.rgba(1, 1, 1, 0.8)
+    }
+    Rectangle {
+        id: dot
+        width: units.gu(3); height: width; radius: width / 2
+        anchors.horizontalCenter: parent.horizontalCenter
+        // drift is in frame heights; exaggerate so small errors show
+        y: parent.height / 2 - height / 2 + Math.max(-1, Math.min(1, guide.drift * 4)) * parent.height * 0.25
+        color: guide.off ? LomiriColors.orange : "white"
+        border.color: "black"; border.width: units.dp(1)
+    }
+    Label {
+        anchors { horizontalCenter: parent.horizontalCenter; bottom: line.top; bottomMargin: units.gu(6) }
+        color: "white"; style: Text.Outline; styleColor: "black"
+        horizontalAlignment: Text.AlignHCenter
+        text: (!pro || pro.panoDirection === 0)
+              ? i18n.tr("Turn slowly to the left or right")
+              : (guide.off ? (guide.drift > 0 ? i18n.tr("Tilt up a little") : i18n.tr("Tilt down a little"))
+                           : i18n.tr("%1 photos · tap the shutter to finish").arg(pro.jobFrames))
+    }
+    // direction arrow and progress to the next frame
+    Label {
+        anchors { verticalCenter: line.verticalCenter
+                  right: pro && pro.panoDirection < 0 ? undefined : parent.right
+                  left: pro && pro.panoDirection < 0 ? parent.left : undefined
+                  margins: units.gu(1) }
+        text: pro && pro.panoDirection < 0 ? "◀" : "▶"
+        color: "white"; style: Text.Outline; styleColor: "black"
+        textSize: Label.Large
+        visible: pro && pro.panoDirection !== 0
+    }
+    Rectangle {
+        anchors { top: line.bottom; topMargin: units.gu(1); left: line.left }
+        width: line.width * (pro ? pro.panoStep : 0); height: units.dp(4)
+        color: LomiriColors.orange
+    }
+}
