+bool Fp6ProControls::startJob(const QString &kind, const QString &directory,
+                              int rotate, int quality, const QString &params)
+{
+    GObject *obj = static_cast<GObject *>(element());
+    if (!obj)
+        return false;
+    QDir().mkpath(directory);
+    const QString suffix = kind.toUpper();
+    const QString path = QDir(directory).filePath(
+        QStringLiteral("image%1_%2.jpg")
+            .arg(QDateTime::currentDateTime().toString(QStringLiteral("yyyyMMdd_hhmmsszzz")))
+            .arg(suffix));
+    gboolean ok = FALSE;
+    g_signal_emit_by_name(obj, "job-start", kind.toUtf8().constData(),
+                          path.toUtf8().constData(), gint(((rotate % 360) + 360) % 360),
+                          gint(quality), params.toUtf8().constData(), &ok);
+    g_object_unref(obj);
+    if (ok)
+        poll();
+    return ok;
+}
+
+void Fp6ProControls::stopJob()
+{
+    GObject *obj = static_cast<GObject *>(element());
+    if (!obj)
+        return;
+    g_signal_emit_by_name(obj, "job-stop");
+    g_object_unref(obj);
+}
+
+void Fp6ProControls::cancelJob()
+{
+    GObject *obj = static_cast<GObject *>(element());
+    if (!obj)
+        return;
+    g_signal_emit_by_name(obj, "job-cancel");
+    g_object_unref(obj);
+    poll();
+}
+
+bool Fp6ProControls::captureRaw(const QString &photoDirectory, int rotate)
+{
+    GObject *obj = static_cast<GObject *>(element());
+    if (!obj)
+        return false;
+    const QString dir = QDir(photoDirectory).filePath(QStringLiteral("RAW"));
+    QDir().mkpath(dir);
+    const QString path = QDir(dir).filePath(
+        QStringLiteral("image%1.dng")
+            .arg(QDateTime::currentDateTime().toString(QStringLiteral("yyyyMMdd_hhmmsszzz"))));
+    gboolean ok = FALSE;
+    g_signal_emit_by_name(obj, "raw-capture", path.toUtf8().constData(),
+                          gint(((rotate % 360) + 360) % 360), &ok);
+    g_object_unref(obj);
+    if (ok) {
+        m_rawPending = path;
+        m_rawDone.clear();
+        m_rawJpeg.clear();
+    }
+    return ok;
+}
+
+void Fp6ProControls::pairRaw(const QString &jpegPath)
+{
+    if (m_rawPending.isEmpty() && m_rawDone.isEmpty())
+        return;
+    m_rawJpeg = jpegPath;
+    tryPairRaw();
+}
+
+/* both the DNG and the JPEG exist: give the DNG the JPEG's name (a DNG
+   whose JPEG never comes keeps its own timestamp name) */
+void Fp6ProControls::tryPairRaw()
+{
+    if (m_rawDone.isEmpty() || m_rawJpeg.isEmpty())
+        return;
+    QString path = m_rawDone;
+    const QString target = QDir(QFileInfo(m_rawDone).absolutePath())
+        .filePath(QFileInfo(m_rawJpeg).completeBaseName() + QStringLiteral(".dng"));
+    if (target != m_rawDone && !QFile::exists(target) && QFile::rename(m_rawDone, target))
+        path = target;
+    m_rawDone.clear();
+    m_rawJpeg.clear();
+    Q_EMIT rawSaved(path);
+}
