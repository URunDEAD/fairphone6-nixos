new file mode 100644
index 0000000..9777f1b
--- /dev/null
+++ b/qml/components/Fp6JobFeedback.qml
@@ -0,0 +1,65 @@
+/*
+ * FP6 phase 2: progress of a capture job (HDR, night, ...) of
+ * fp6libcamerasrc. Capturing shows "hold still"; processing runs in the
+ * background while the viewfinder stays live.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ */
+import QtQuick 2.12
+import Lomiri.Components 1.3
+
+Item {
+    id: fb
+    property var pro
+    readonly property int state: pro ? pro.jobState : 0
+    visible: state === 1 || state === 2
+    implicitWidth: units.gu(28)
+    implicitHeight: column.height + units.gu(1.5)
+
+    function kindLabel(k) {
+        switch (k) {
+        case "hdr": return i18n.tr("HDR");
+        case "night": return i18n.tr("Night");
+        case "bracket": return i18n.tr("Bracket");
+        case "timelapse": return i18n.tr("Timelapse");
+        case "panorama": return i18n.tr("Panorama");
+        case "document": return i18n.tr("Document");
+        }
+        return k;
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        radius: units.gu(1)
+        color: Qt.rgba(0, 0, 0, 0.55)
+    }
+    Column {
+        id: column
+        anchors { left: parent.left; right: parent.right; verticalCenter: parent.verticalCenter
+                  margins: units.gu(1) }
+        spacing: units.gu(0.5)
+        Label {
+            width: parent.width
+            horizontalAlignment: Text.AlignHCenter
+            color: "white"
+            font.weight: Font.DemiBold
+            text: fb.state === 1
+                  ? (pro.jobTargetFrames > 0
+                     ? i18n.tr("%1: hold still (%2/%3)").arg(fb.kindLabel(pro.jobKind))
+                       .arg(pro.jobFrames).arg(pro.jobTargetFrames)
+                     : i18n.tr("%1: %2 frames").arg(fb.kindLabel(pro.jobKind)).arg(pro.jobFrames))
+                  : i18n.tr("Processing %1… %2%").arg(fb.kindLabel(pro.jobKind))
+                    .arg(Math.round(pro.jobProgress * 100))
+        }
+        ProgressBar {
+            width: parent.width
+            visible: !(fb.state === 1 && pro.jobTargetFrames === 0)   // open ended (timelapse)
+            height: units.gu(0.5)
+            minimumValue: 0
+            maximumValue: 1
+            value: pro ? pro.jobProgress : 0
+        }
+    }
+}
