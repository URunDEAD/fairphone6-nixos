+    // ---- FP6 fast launch (lomiri-camera-app-fast-launch.patch)
+    // Open the camera (libcamera manager, IPA, sensor configuration) while
+    // the overlay QML still loads; streaming starts when it is Ready.
+    Component.onCompleted: Qt.callLater(function() {
+        if (camera.cameraState == Camera.UnloadedState)
+            camera.cameraState = Camera.LoadedState;
+    })
+    // Stream as soon as the camera is opened instead of waiting for the
+    // overlay QML (~1 s): the resolutions the overlay would apply are read
+    // here (same settings keys); viewfinder and capture resolution only take
+    // effect at the start, the overlay's other bindings also apply live.
+    Settings {
+        id: fp6EarlySettings
+        property var photoResolutions
+        property var videoResolutions
+    }
+    function fp6EarlyStart() {
+        var res = camera.captureMode === Camera.CaptureStillImage
+                ? fp6EarlySettings.photoResolutions : fp6EarlySettings.videoResolutions;
+        var want = res ? res[camera.deviceId] : undefined;
+        if (want) {
+            var p = String(want).split("x");
+            var target = Qt.size(parseInt(p[0]), parseInt(p[1]));
+            if (camera.captureMode === Camera.CaptureStillImage)
+                camera.imageCapture.resolution = target;
+            else
+                camera.videoRecorder.resolution = target;
+            // the overlay's rule: the largest viewfinder size of the same aspect
+            var best, list = camera.supportedViewfinderResolutions();
+            for (var i = 0; i < list.length; i++) {
+                if (Math.abs(list[i].width / list[i].height - target.width / target.height) <= 0.02
+                        && (!best || list[i].width > best.width))
+                    best = list[i];
+            }
+            if (best)
+                camera.viewfinder.resolution = Qt.size(best.width, best.height);
+        }
+        application.fp6Mark("early-start");
+        camera.cameraState = Camera.ActiveState;
+    }
+    Connections {
+        target: camera
+        onCameraStatusChanged: {
+            if (camera.cameraStatus == Camera.LoadedStatus
+                    && camera.cameraState == Camera.LoadedState
+                    && viewFinderOverlay.status != Loader.Ready
+                    && !viewFinderView.fp6Hidden && !viewFinderView.fp6Parked
+                    && Qt.application.state === Qt.ApplicationActive)
+                fp6EarlyStart();
+        }
+    }
+    // Started by "Keep ready" in the background: no streaming until shown.
+    property bool fp6Hidden: application.fp6StartedHidden()
+    // In the background the sensor stops streaming (nixpkgs' Lomiri does not
+    // suspend apps, so a backgrounded or locked-screen camera kept streaming):
+    // with Keep ready the camera stays opened (Loaded) before the app is
+    // frozen; otherwise it is released after 2 s for other apps.
+    property bool fp6KeepReady: application.fp6KeepReadyForced()
+                                || (main.fp6AppReady !== null && main.fp6AppReady.keepReady)
+    property bool fp6Parked: false
+    Connections {
+        target: Qt.application
+        onStateChanged: {
+            application.fp6Mark("app-state-" + Qt.application.state);
+            if (Qt.application.state === Qt.ApplicationActive) {
+                fp6ParkTimer.stop();
+                if (viewFinderView.fp6Hidden || viewFinderView.fp6Parked) {
+                    viewFinderView.fp6Hidden = false;
+                    viewFinderView.fp6Parked = false;
+                    decideCameraState();
+                }
+            } else {
+                fp6ParkTimer.interval = viewFinderView.fp6KeepReady || viewFinderView.fp6Hidden ? 400 : 2000;
+                fp6ParkTimer.restart();
+            }
+        }
+    }
+    Timer {
+        id: fp6ParkTimer
+        onTriggered: {
+            if (Qt.application.state !== Qt.ApplicationActive
+                    && camera.cameraState != Camera.UnloadedState
+                    && camera.videoRecorder.recorderState == CameraRecorder.StoppedState
+                    && !camera.photoCaptureInProgress && !camera.timedCaptureInProgress
+                    && !camera.pro.jobBusy && camera.pro.stackState == 0) {
+                viewFinderView.fp6Parked = true;
+                camera.cameraState = viewFinderView.fp6KeepReady || viewFinderView.fp6Hidden
+                        ? Camera.LoadedState : Camera.UnloadedState;
+                application.fp6Mark("parked-" + camera.cameraState);
+            }
+        }
+    }
+    Connections {
+        target: camera
+        onCameraStatusChanged: application.fp6Mark("camera-status-" + camera.cameraStatus)
+    }
+    Connections {
+        target: viewFinderOverlay
+        onStatusChanged: if (viewFinderOverlay.status == Loader.Ready) application.fp6Mark("overlay-ready")
+    }
+
