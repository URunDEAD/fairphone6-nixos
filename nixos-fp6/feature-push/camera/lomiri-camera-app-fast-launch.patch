diff --git a/qml/components/Fp6AppReady.qml b/qml/components/Fp6AppReady.qml
new file mode 100644
index 0000000..0b9af05
--- /dev/null
+++ b/qml/components/Fp6AppReady.qml
@@ -0,0 +1,42 @@
+/*
+ * FP6 fast launch: the Camera's entries in the phone-wide "Keep apps ready"
+ * lists (fp6-app-ready, GSettings com.fairphone6.app-ready). Loaded through a
+ * Loader: without gsettings-qt or the schema it fails or is not available,
+ * and the Camera settings hide the choice.
+ *   mode 0 = off, 1 = preload (page cache), 2 = keep ready (prelaunched,
+ *   suspended in the background, camera opened but not streaming)
+ */
+import QtQuick 2.12
+import GSettings 1.0
+
+QtObject {
+    id: root
+
+    // GSettings is a property map: it cannot carry QML properties itself
+    property GSettings settings: GSettings {
+        schema.id: "com.fairphone6.app-ready"
+    }
+
+    readonly property string appId: "lomiri-camera-app"
+    readonly property bool available: settings.schema.isValid
+    readonly property bool keepReady: available && has(settings.keepReady)
+    readonly property bool preloaded: available && has(settings.preload)
+    readonly property int mode: keepReady ? 2 : (preloaded ? 1 : 0)
+
+    function has(list) {
+        return !!list && Array.prototype.indexOf.call(list, appId) >= 0;
+    }
+    function withApp(list, on) {
+        var out = [];
+        for (var i = 0; list && i < list.length; i++)
+            if (list[i] !== appId) out.push(list[i]);
+        if (on) out.push(appId);
+        return out;
+    }
+    function setMode(m) {
+        if (!available) return;
+        settings.preload = withApp(settings.preload, m >= 1);
+        settings.prelaunch = withApp(settings.prelaunch, m === 2);
+        settings.keepReady = withApp(settings.keepReady, m === 2);
+    }
+}
