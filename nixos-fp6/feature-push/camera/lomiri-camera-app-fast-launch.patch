 #include "config.h"
 
+// FP6 fast launch: FP6_CAMERA_TRACE=1 prints "FLMARK <what> <unix time>"
+// on stderr (tools/feature-push/camera-fast-launch/measure.sh).
+#include <QElapsedTimer>
+#include <QDateTime>
+#include <QDir>
+#include <QFileInfo>
+#include <QStandardPaths>
+#include <QTimer>
+#include <QQuickWindow>
+#include <cstdio>
+#include <ctime>
+
+static bool fp6TraceOn()
+{
+    static const bool on = qEnvironmentVariableIsSet("FP6_CAMERA_TRACE");
+    return on;
+}
+
+static void fp6TraceMark(const char *what)
+{
+    if (!fp6TraceOn())
+        return;
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    fprintf(stderr, "FLMARK %s %lld.%09ld\n", what, (long long) ts.tv_sec, ts.tv_nsec);
+}
+
+static const int fp6MainMark = (fp6TraceMark("main"), 0);   // before main()
+
 static void printUsage(const QStringList& arguments)
 {
     qDebug() << "usage:"
@@ -40,6 +69,7 @@ CameraApplication::CameraApplication(int &argc, char **argv)
     : QGuiApplication(argc, argv),
       m_mode(CameraMode::NORMAL)
 {
+    fp6TraceMark("qguiapplication");
 
     // The testability driver is only loaded by QApplication but not by QGuiApplication.
     // However, QApplication depends on QWidget which would add some unneeded overhead => Let's load the testability driver on our own.
@@ -105,7 +135,59 @@ bool CameraApplication::setup()
     m_engine->addImportPath(cameraAppImportDirectory());
     qDebug() << "Import path added" << cameraAppImportDirectory();
     qDebug() << "Camera app directory" << cameraAppDirectory();
+    fp6TraceMark("engine-load");
     m_engine->load(QUrl::fromLocalFile(sourceQml(m_mode)));
+    fp6TraceMark("engine-loaded");
+
+    // FP6 fast launch: QML_FORCE_DISK_CACHE (wrapper) caches the imported
+    // modules here; entries of replaced module builds are never used again.
+    QTimer::singleShot(30000, this, []() {
+        QDir cache(QStandardPaths::writableLocation(QStandardPaths::CacheLocation)
+                   + QStringLiteral("/qmlcache"));
+        const QDateTime limit = QDateTime::currentDateTime().addDays(-30);
+        const QFileInfoList files = cache.entryInfoList(
+            QStringList() << QStringLiteral("*.qmlc") << QStringLiteral("*.jsc"), QDir::Files);
+        for (const QFileInfo &f : files)
+            if (f.lastModified() < limit)
+                QFile::remove(f.absoluteFilePath());   // recompiled on next use
+    });
+
+    // FP6 fast launch trace: buffer swaps of the first 15 s (render thread)
+    QQuickWindow *window = m_engine->rootObjects().isEmpty() ? nullptr
+        : qobject_cast<QQuickWindow *>(m_engine->rootObjects().first());
+    if (fp6TraceOn() && window) {
+        QElapsedTimer *since = new QElapsedTimer;
+        since->start();
+        QObject::connect(window, &QQuickWindow::frameSwapped, window, [since]() {
+            if (!since->hasExpired(15000))
+                fp6TraceMark("swap");
+        }, Qt::DirectConnection);
+    }
 
     return true;
 }
+
+bool CameraApplication::fp6Trace() const
+{
+    return fp6TraceOn();
+}
+
+bool CameraApplication::fp6StartedHidden() const
+{
+    // fp6-app-ready (nixos-fp6/feature-push/app-ready) creates this before a
+    // hidden prelaunch; Lomiri then does not activate the first window.
+    static const bool hidden = QFileInfo::exists(
+        qEnvironmentVariable("XDG_RUNTIME_DIR")
+        + QStringLiteral("/fp6-app-ready/background/lomiri-camera-app"));
+    return hidden;
+}
+
+bool CameraApplication::fp6KeepReadyForced() const
+{
+    return qgetenv("FP6_CAMERA_KEEP_READY") == "1";
+}
+
+void CameraApplication::fp6Mark(const QString &what) const
+{
+    fp6TraceMark(what.toUtf8().constData());
+}
