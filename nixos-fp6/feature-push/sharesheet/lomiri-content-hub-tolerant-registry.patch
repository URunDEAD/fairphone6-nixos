+/* fp6: QGSettings::get()/trySet() on a key that is not in the schema
+ * aborts the whole service (g_settings_schema_get_value). Peer files
+ * name arbitrary type strings (e.g. share: ["all"], which the share
+ * schema does not have), so every lookup checks the schema first. */
+bool has_key(QGSettings* settings, const QString& key)
+{
+    return settings->keys().contains(key);
+}
+
+QStringList get_list(QGSettings* settings, const QString& key)
+{
+    if (not has_key(settings, key))
+        return QStringList();
+    return settings->get(key).toStringList();
+}
+
 } // End anonymous namespace
 
