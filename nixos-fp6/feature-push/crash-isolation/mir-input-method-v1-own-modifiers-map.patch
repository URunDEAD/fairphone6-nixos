 struct wl_array;
 
@@ -142,7 +144,11 @@ struct TextInputChange
     std::optional<TextInputKeySym> keysym;
 
     /// \remark Defined for text input v1 and v2, not v3.
-    std::optional<wl_array*> modifier_map;
+    /// The bytes of the input method's modifiers_map array. A copy: the
+    /// wl_array passed to the request handler is freed by libwayland as soon
