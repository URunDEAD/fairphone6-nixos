     }
     if (change.modifier_map)
     {
-        send_modifiers_map_event(change.modifier_map.value());
+        auto const& bytes = change.modifier_map.value();
+        // Read-only view of the owned bytes for libwayland's marshaller.
+        wl_array map{bytes.size(), bytes.size(), const_cast<uint8_t*>(bytes.data())};
+        send_modifiers_map_event(&map);
     }
     if (change.direction)
     {
