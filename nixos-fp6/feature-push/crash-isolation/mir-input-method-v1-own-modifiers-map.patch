diff --git a/src/server/frontend_wayland/input_method_v1.cpp b/src/server/frontend_wayland/input_method_v1.cpp
index b030d48..cdb6c37 100644
--- a/src/server/frontend_wayland/input_method_v1.cpp
+++ b/src/server/frontend_wayland/input_method_v1.cpp
@@ -327,7 +327,12 @@ private:
 
         void modifiers_map(struct wl_array *map) override
         {
-            change.pending_change.modifier_map = map;
+            // Copy: *map belongs to libwayland's request closure and is
+            // freed when this handler returns. Keeping the pointer made the
+            // next text change send freed memory (SIGSEGV in
+            // serialize_closure on the Mir/Wayland thread).
+            auto const* const bytes = static_cast<uint8_t const*>(map->data);
+            change.pending_change.modifier_map = std::vector<uint8_t>(bytes, bytes + map->size);
             change.waiting_status = InputMethodV1ChangeWaitingStatus::none;
         }
 
