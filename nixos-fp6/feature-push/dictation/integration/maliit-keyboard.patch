--- a/src/plugin/inputmethod.cpp
+++ b/src/plugin/inputmethod.cpp
@@ InputMethod::InputMethod(MAbstractInputMethodHost *host)
+    d->dictation = new DictationBridge(QDBusConnection::sessionBus(), this);
+    d->view->rootContext()->setContextProperty("dictation", d->dictation);
+    connect(d->dictation, &DictationBridge::finalText, this,
+            [this, d](quint64 generation, const QString &text) {
+        if (generation != d->inputContextGeneration || !d->mayDictate()) return;
+        if (text.isEmpty()) return;
+        d->editor.commitPreedit();
+        d->host->sendCommitString(text);
+    });
@@ void InputMethod::reset()
+    ++d->inputContextGeneration;
+    d->dictation->invalidate();
@@ void InputMethod::handleClientChange()
+    ++d->inputContextGeneration;
+    d->dictation->invalidate();
@@ void InputMethod::handleFocusChange(bool focusIn)
+    if (!focusIn) {
+        ++d->inputContextGeneration;
+        d->dictation->invalidate();
+    }
