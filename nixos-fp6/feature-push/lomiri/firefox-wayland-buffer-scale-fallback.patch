+void WaylandSurface::SetBufferScaleFallbackLocked(
+    const WaylandSurfaceLock& aProofOfLock, int aScale) {
+  MOZ_DIAGNOSTIC_ASSERT(&aProofOfLock == mSurfaceLock);
+  if (!mBufferScaleFallback || !mIsMapped || !mSurface || aScale < 1 ||
+      mBufferScaleFallbackValue == aScale) {
+    return;
+  }
+  mBufferScaleFallbackValue = aScale;
+  LOGWAYLAND("WaylandSurface::SetBufferScaleFallbackLocked() scale %d", aScale);
+  wl_surface_set_buffer_scale(mSurface, aScale);
+  mSurfaceNeedsCommit = true;
+}
