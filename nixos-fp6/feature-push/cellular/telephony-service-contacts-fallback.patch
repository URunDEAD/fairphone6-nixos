diff --git a/liblomiritelephonyservice/contactutils.cpp b/liblomiritelephonyservice/contactutils.cpp
index 45a53cc..4f76330 100644
--- a/liblomiritelephonyservice/contactutils.cpp
+++ b/liblomiritelephonyservice/contactutils.cpp
@@ -22,6 +22,7 @@
 #include "contactutils.h"
 #include <QContactName>
 #include <QContactDisplayLabel>
+#include <QDebug>
 
 QTCONTACTS_USE_NAMESPACE
 
@@ -30,11 +31,28 @@ namespace ContactUtils
 
 QContactManager *sharedManager(const QString &engine)
 {
-    QString finalEngine = engine;
-    if (!qgetenv("TELEPHONY_SERVICE_TEST").isEmpty()) {
-        finalEngine = "memory";
-    }
-    static QContactManager *instance = new QContactManager(finalEngine);
+    // FP6: backport of upstream 611f2583/e1d8b523 (lomiri-telephony-service
+    // main): default to qtcontacts-sqlite, the store lomiri-addressbook-app and
+    // lomiri-history-service use, overridable with LOMIRI_CONTACT_BACKEND.
+    // 0.6.2 hard-wired "galera" (address-book-service), which is not packaged:
+    // QtContacts then hands back its invalid engine, whose fetch requests never
+    // start or finish, so no contact name ever resolved. If the chosen engine
+    // is not installed either, use "memory" rather than the invalid engine.
+    static QContactManager *instance = [&engine]() {
+        QString finalEngine = engine;
+        if (qEnvironmentVariableIsSet("TELEPHONY_SERVICE_TEST")) {
+            finalEngine = QStringLiteral("memory");
+        } else if (finalEngine.isEmpty()) {
+            finalEngine = qEnvironmentVariable("LOMIRI_CONTACT_BACKEND", "org.nemomobile.contacts.sqlite");
+        }
+        const QStringList available = QContactManager::availableManagers();
+        if (!available.contains(finalEngine)) {
+            qWarning() << "ContactUtils: contacts engine" << finalEngine << "is not available"
+                       << available << "- using \"memory\"";
+            finalEngine = QStringLiteral("memory");
+        }
+        return new QContactManager(finalEngine);
+    }();
     return instance;
 }
 
