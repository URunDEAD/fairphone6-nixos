+/* ---- SHA-256 (FIPS 180-4) ---------------------------------------------- */
+
+struct sha256_ctx {
+	uint32_t h[8];
+	uint64_t len;
+	uint8_t buf[64];
+	size_t fill;
+};
+
+static const uint32_t sha256_k[64] = {
+	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+};
+
+#define ROR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
+
+static void sha256_block(struct sha256_ctx *c, const uint8_t *p)
+{
+	uint32_t w[64], a, b, d, e, f, g, h, cc, t1, t2;
+	int i;
+
+	for (i = 0; i < 16; i++)
+		w[i] = (uint32_t)p[4 * i] << 24 | (uint32_t)p[4 * i + 1] << 16 |
+		       (uint32_t)p[4 * i + 2] << 8 | p[4 * i + 3];
+	for (i = 16; i < 64; i++)
+		w[i] = (ROR(w[i - 2], 17) ^ ROR(w[i - 2], 19) ^ (w[i - 2] >> 10)) + w[i - 7] +
+		       (ROR(w[i - 15], 7) ^ ROR(w[i - 15], 18) ^ (w[i - 15] >> 3)) + w[i - 16];
+
+	a = c->h[0]; b = c->h[1]; cc = c->h[2]; d = c->h[3];
+	e = c->h[4]; f = c->h[5]; g = c->h[6]; h = c->h[7];
+	for (i = 0; i < 64; i++) {
+		t1 = h + (ROR(e, 6) ^ ROR(e, 11) ^ ROR(e, 25)) + ((e & f) ^ (~e & g)) + sha256_k[i] + w[i];
+		t2 = (ROR(a, 2) ^ ROR(a, 13) ^ ROR(a, 22)) + ((a & b) ^ (a & cc) ^ (b & cc));
+		h = g; g = f; f = e; e = d + t1;
+		d = cc; cc = b; b = a; a = t1 + t2;
+	}
+	c->h[0] += a; c->h[1] += b; c->h[2] += cc; c->h[3] += d;
+	c->h[4] += e; c->h[5] += f; c->h[6] += g; c->h[7] += h;
+}
+
+void shadow_sha256(const void *data, size_t len, uint8_t out[32])
+{
+	static const uint32_t init[8] = {
+		0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+		0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
+	};
+	struct sha256_ctx c;
+	const uint8_t *p = data;
+	uint64_t bits;
+	int i;
+
+	memcpy(c.h, init, sizeof(init));
+	c.len = len;
+	c.fill = 0;
+
+	while (len >= 64) {
+		sha256_block(&c, p);
+		p += 64;
+		len -= 64;
+	}
+	memcpy(c.buf, p, len);
+	c.fill = len;
+	c.buf[c.fill++] = 0x80;
+	if (c.fill > 56) {
+		memset(c.buf + c.fill, 0, 64 - c.fill);
+		sha256_block(&c, c.buf);
+		c.fill = 0;
+	}
+	memset(c.buf + c.fill, 0, 56 - c.fill);
+	bits = c.len * 8;
+	for (i = 0; i < 8; i++)
+		c.buf[63 - i] = bits >> (8 * i);
+	sha256_block(&c, c.buf);
+
+	for (i = 0; i < 8; i++) {
+		out[4 * i] = c.h[i] >> 24;
+		out[4 * i + 1] = c.h[i] >> 16;
+		out[4 * i + 2] = c.h[i] >> 8;
+		out[4 * i + 3] = c.h[i];
+	}
+}
+
+/* ---- image files --------------------------------------------------------- */
+
+int shadow_check_name(const char *name)
+{
+	size_t n = strlen(name);
+	size_t i;
+
+	if (n == 0 || n >= SHADOW_NAME_MAX || name[0] == '.')
+		return -1;
+	for (i = 0; i < n; i++) {
+		char ch = name[i];
+
+		if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+		      (ch >= '0' && ch <= '9') || ch == '_' || ch == '-' || ch == '.'))
+			return -1;
+	}
+	return 0;
+}
+
+static void put_le64(uint8_t *p, uint64_t v)
+{
+	int i;
+
+	for (i = 0; i < 8; i++)
+		p[i] = v >> (8 * i);
+}
+
+static uint64_t get_le64(const uint8_t *p)
+{
+	uint64_t v = 0;
+	int i;
+
+	for (i = 0; i < 8; i++)
+		v |= (uint64_t)p[i] << (8 * i);
+	return v;
+}
+
+static int read_full(int fd, void *buf, size_t len)
+{
+	size_t done = 0;
+	ssize_t n;
+
+	while (done < len) {
+		n = read(fd, (char *)buf + done, len - done);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0)
+			return -1;
+		done += n;
+	}
+	return 0;
+}
+
+static int write_full(int fd, const void *buf, size_t len)
+{
+	size_t done = 0;
+	ssize_t n;
+
+	while (done < len) {
+		n = write(fd, (const char *)buf + done, len - done);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0)
+			return -1;
+		done += n;
+	}
+	return 0;
+}
+
+int shadow_read_image(const char *path, size_t expect_len, const uint8_t src_sha[32],
+		      void **out, const char **why)
+{
+	uint8_t hdr[SHADOW_HDR_LEN];
+	uint8_t sha[32];
+	struct stat st;
+	const char *reason;
+	void *data = NULL;
+	int fd;
+
+	fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0) {
+		reason = "missing";
+		goto fail;
+	}
+	if (fstat(fd, &st) || !S_ISREG(st.st_mode)) {
+		reason = "not a regular file";
+		goto fail;
+	}
+	if ((uint64_t)st.st_size != (uint64_t)SHADOW_HDR_LEN + expect_len) {
+		reason = "size mismatch";
+		goto fail;
+	}
+	if (read_full(fd, hdr, sizeof(hdr))) {
+		reason = "short header";
+		goto fail;
+	}
+	if (memcmp(hdr, shadow_magic, sizeof(shadow_magic))) {
+		reason = "bad magic";
+		goto fail;
+	}
+	if (get_le64(hdr + 16) != expect_len) {
+		reason = "length mismatch";
+		goto fail;
+	}
+	if (memcmp(hdr + 56, src_sha, 32)) {
+		reason = "source partition changed";
+		goto fail;
+	}
+	data = malloc(expect_len ? expect_len : 1);
+	if (!data) {
+		reason = "out of memory";
+		goto fail;
+	}
+	if (read_full(fd, data, expect_len)) {
+		reason = "short data";
+		goto fail;
+	}
+	shadow_sha256(data, expect_len, sha);
+	if (memcmp(hdr + 24, sha, 32)) {
+		reason = "checksum mismatch";
+		goto fail;
+	}
+
+	close(fd);
+	*out = data;
+	return 0;
+
+fail:
+	free(data);
+	if (fd >= 0)
+		close(fd);
+	if (why)
+		*why = reason;
+	return -1;
+}
+
+int shadow_write_image(const char *dir, const char *name, const void *data, size_t len,
+		       const uint8_t src_sha[32], mode_t mode, bool keep_existing)
+{
+	char path[PATH_MAX];
+	char tmp[PATH_MAX];
+	uint8_t hdr[SHADOW_HDR_LEN];
+	struct stat st;
+	int saved;
+	int dfd;
+	int fd;
+
+	if (shadow_check_name(name)) {
+		errno = EINVAL;
+		return -1;
+	}
+	if (snprintf(path, sizeof(path), "%s/%s.img", dir, name) >= (int)sizeof(path) ||
+	    snprintf(tmp, sizeof(tmp), "%s/%s.img.tmp", dir, name) >= (int)sizeof(tmp)) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	if (keep_existing && lstat(path, &st) == 0)
+		return 1;
+
+	memset(hdr, 0, sizeof(hdr));
+	memcpy(hdr, shadow_magic, sizeof(shadow_magic));
+	put_le64(hdr + 16, len);
+	shadow_sha256(data, len, hdr + 24);
+	memcpy(hdr + 56, src_sha, 32);
+
+	unlink(tmp);
+	fd = open(tmp, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (fd < 0)
+		return -1;
+	if (write_full(fd, hdr, sizeof(hdr)) || write_full(fd, data, len) ||
+	    fchmod(fd, mode) || fsync(fd)) {
+		saved = errno;
+		close(fd);
+		unlink(tmp);
+		errno = saved;
+		return -1;
+	}
+	if (close(fd)) {
+		saved = errno;
+		unlink(tmp);
+		errno = saved;
+		return -1;
+	}
+	if (rename(tmp, path)) {
+		saved = errno;
+		unlink(tmp);
+		errno = saved;
+		return -1;
+	}
+
+	dfd = open(dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (dfd >= 0) {
+		fsync(dfd);
+		close(dfd);
+	}
+
+	return 0;
+}
