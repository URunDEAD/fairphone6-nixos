+	persist_dir = dir;
+	return 0;
+}
+
+static long ms_since(const struct timespec *t)
+{
+	struct timespec now;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return (now.tv_sec - t->tv_sec) * 1000L + (now.tv_nsec - t->tv_nsec) / 1000000L;
+}
+
+static void storage_persist_attach(struct rmtfd *rmtfd, const char *file)
+{
+	char path[PATH_MAX];
+	const char *name;
+	const char *why = NULL;
+	void *saved;
+	int ret;
+
+	name = strrchr(file, '/');
+	name = name ? name + 1 : file;
+	if (shadow_check_name(name)) {
+		fprintf(stderr, "[storage] persist: unusable name '%s', not persisted\n", name);
+		return;
+	}
+
+	snprintf(rmtfd->persist_name, sizeof(rmtfd->persist_name), "%s", name);
+	rmtfd->src_len = rmtfd->shadow_len;
+	shadow_sha256(rmtfd->shadow_buf, rmtfd->shadow_len, rmtfd->src_sha);
+
+	/* First capture: keep the untouched source partition contents. */
+	ret = shadow_write_image(persist_original_dir, name, rmtfd->shadow_buf, rmtfd->shadow_len,
+				 rmtfd->src_sha, 0400, true);
+	if (ret == 0)
+		fprintf(stderr, "[storage] persist: saved original %s (%zu bytes)\n", name, rmtfd->shadow_len);
+	else if (ret < 0)
+		fprintf(stderr, "[storage] persist: saving original %s failed: %s\n", name, strerror(errno));
+
+	snprintf(path, sizeof(path), "%s/%s.img", persist_dir, name);
+	if (shadow_read_image(path, rmtfd->src_len, rmtfd->src_sha, &saved, &why) == 0) {
+		free(rmtfd->shadow_buf);
+		rmtfd->shadow_buf = saved;
+		fprintf(stderr, "[storage] persist: loaded saved shadow for %s\n", name);
+	} else {
+		fprintf(stderr, "[storage] persist: no saved shadow for %s (%s), using the partition\n",
+			name, why ? why : "?");
+	}
+
+	rmtfd->persist = true;
+	rmtfd->dirty = false;
+}
+
+static bool storage_persist_reset_requested(void)
+{
+	char path[PATH_MAX];
+
+	snprintf(path, sizeof(path), "%s/RESET", persist_dir);
+	if (access(path, F_OK))
+		return false;
+	if (!persist_reset_logged)
+		fprintf(stderr, "[storage] persist: %s present, not saving until restart\n", path);
+	persist_reset_logged = true;
+	return true;
+}
+
+static void storage_persist_flush_one(struct rmtfd *rmtfd)
+{
+	if (!persist_dir || !rmtfd->persist || !rmtfd->dirty)
+		return;
+
+	if (storage_persist_reset_requested()) {
+		rmtfd->dirty = false;
+		return;
+	}
+	if (rmtfd->shadow_len != rmtfd->src_len) {
+		fprintf(stderr, "[storage] persist: %s grew to %zu bytes (partition %zu), not saved\n",
+			rmtfd->persist_name, rmtfd->shadow_len, rmtfd->src_len);
+		rmtfd->dirty = false;
+		return;
+	}
+	if (shadow_write_image(persist_dir, rmtfd->persist_name, rmtfd->shadow_buf,
+			       rmtfd->shadow_len, rmtfd->src_sha, 0600, false)) {
+		fprintf(stderr, "[storage] persist: saving %s failed: %s (retrying)\n",
+			rmtfd->persist_name, strerror(errno));
+		/* retry after another debounce period */
+		clock_gettime(CLOCK_MONOTONIC, &rmtfd->last_write);
+		return;
+	}
+	rmtfd->dirty = false;
+}
+
+void storage_flush(bool force)
+{
+	int i;
+
+	for (i = 0; i < MAX_CALLERS; i++) {
+		struct rmtfd *rmtfd = &rmtfds[i];
+
+		if (!rmtfd->persist || !rmtfd->dirty)
+			continue;
+		if (!force && ms_since(&rmtfd->last_write) < PERSIST_DEBOUNCE_MS)
+			continue;
+		storage_persist_flush_one(rmtfd);
+	}
+}
+
+int storage_next_flush_ms(void)
+{
+	long best = -1;
+	long left;
+	int i;
+
+	for (i = 0; i < MAX_CALLERS; i++) {
+		if (!rmtfds[i].persist || !rmtfds[i].dirty)
+			continue;
+		left = PERSIST_DEBOUNCE_MS - ms_since(&rmtfds[i].last_write);
+		if (left < 0)
+			left = 0;
+		if (best < 0 || left < best)
+			best = left;
+	}
+	return best;
+}
