@@ -0,0 +1,51 @@
+#ifndef __SHADOW_H__
+#define __SHADOW_H__
+
+/*
+ * Persistent EFS shadow for read-only rmtfs (-r -D <dir>).
+ *
+ * The real partitions are only ever read. The RAM shadow that -r keeps is
+ * saved to <dir>/<name>.img (header + data, written to <name>.img.tmp,
+ * fsync'd, renamed, directory fsync'd) and loaded at the next start when
+ * it is valid for the same source partition. A first-capture copy of each
+ * source partition is kept in <dir>/original/<name>.img (mode 0400, never
+ * replaced).
+ *
+ * Image layout (all integers little endian):
+ *   0   16  magic "FP6RMTFSSHADOW1\0"
+ *   16   8  data length
+ *   24  32  sha256(data)
+ *   56  32  sha256(source partition contents when this shadow was based on it)
+ *   88  40  zero
+ *   128     data
+ */
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+
+#define SHADOW_HDR_LEN 128
+#define SHADOW_NAME_MAX 64
+
+void shadow_sha256(const void *data, size_t len, uint8_t out[32]);
+
+/* 0 if name is a safe file name component. */
+int shadow_check_name(const char *name);
+
+/*
+ * Load <path> if it is a valid image of exactly expect_len data bytes whose
+ * source hash equals src_sha. Returns 0 and a malloc'd buffer in *out, or
+ * -1 (missing / invalid; reason in *why when non-NULL).
+ */
+int shadow_read_image(const char *path, size_t expect_len, const uint8_t src_sha[32],
+		      void **out, const char **why);
+
+/*
+ * Atomically write <dir>/<name>.img. With keep_existing, an existing image
+ * is left untouched (returns 1). Returns 0 on success, -1 on error (errno).
+ */
+int shadow_write_image(const char *dir, const char *name, const void *data, size_t len,
+		       const uint8_t src_sha[32], mode_t mode, bool keep_existing);
+
+#endif
