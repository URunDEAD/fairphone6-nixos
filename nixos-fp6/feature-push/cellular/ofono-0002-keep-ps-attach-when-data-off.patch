 	return FALSE;
 }
 
+static void gprs_list_active_contexts_callback(const struct ofono_error *error,
+						void *data);
+
+/*
+ * Powered=false: release the active internet contexts (the modem stays
+ * attached and on LTE).  Powered=true on LTE/NR: the default bearer is
+ * still up in the modem, so ask the driver to report it again; elsewhere
+ * the context manager (NetworkManager) activates contexts as usual.
+ */
+static void gprs_set_powered_contexts(struct ofono_gprs *gprs)
+{
+	GSList *l;
+
+	if (gprs->powered) {
+		if (on_lte(gprs) && !have_active_contexts(gprs) &&
+				gprs->driver->list_active_contexts)
+			gprs->driver->list_active_contexts(gprs,
+					gprs_list_active_contexts_callback,
+					gprs);
+		return;
+	}
+
+	for (l = gprs->contexts; l; l = l->next) {
+		struct pri_context *ctx = l->data;
+		struct ofono_gprs_context *gc = ctx->context_driver;
+
+		if (ctx->active == FALSE || ctx->pending)
+			continue;
+
+		/* Data off only affects internet contexts (MMS, IMS stay) */
+		if (ctx->type != OFONO_GPRS_CONTEXT_TYPE_INTERNET)
+			continue;
+
+		DBG("mobile data off: releasing %s", ctx->path);
+
+		if (gc && gc->driver->detach_shutdown != NULL)
+			gc->driver->detach_shutdown(gc, ctx->context.cid);
+
+		pri_reset_context_settings(ctx);
+		release_context(ctx);
+		pri_context_signal_active(ctx);
+	}
+
+	gprs_attached_update(gprs);
+}
+
 static void gprs_attached_update(struct ofono_gprs *gprs)
 {
 	ofono_bool_t attached;
@@ -1631,7 +1685,19 @@ static void gprs_attached_update(struct ofono_gprs *gprs)
 		 * expect the gprs status to be unknown. That must not
 		 * result in detaching...
 		 */
-		attached = have_active_contexts(gprs);
+		attached = have_active_contexts(gprs) ||
+			/*
+			 * Mobile data off: the modem is still PS attached;
+			 * report it so MMS/IMS contexts can be activated.
+			 * (With data on, Attached keeps following the
+			 * automatic default-bearer context, as upstream.)
+			 */
+			(!gprs->powered && gprs->driver_attached &&
+				L_IN_SET(status,
+				NETWORK_REGISTRATION_STATUS_REGISTERED,
+				NETWORK_REGISTRATION_STATUS_REGISTERED_SMS_EUTRAN,
+				NETWORK_REGISTRATION_STATUS_ROAMING,
+				NETWORK_REGISTRATION_STATUS_ROAMING_SMS_EUTRAN));
 	else
 		attached = gprs->driver_attached && L_IN_SET(status,
 			NETWORK_REGISTRATION_STATUS_REGISTERED,
@@ -1746,7 +1812,13 @@ static void gprs_netreg_update(struct ofono_gprs *gprs)
 		((gprs->netreg_status == NETWORK_REGISTRATION_STATUS_ROAMING) ||
 		(gprs->netreg_status == NETWORK_REGISTRATION_STATUS_ROAMING_SMS_EUTRAN)));
 
-	attach = attach && gprs->powered;
+	/*
+	 * FP6: keep the packet-domain attach while mobile data is off
+	 * (Powered=false), as Android does.  Detaching made QMI modems drop
+	 * to a CS-only service domain and leave LTE for GSM, which also
+	 * kills IMS/VoLTE and SMS over SGs/IMS.  Powered only controls the
+	 * user-facing contexts (see gprs_set_powered_contexts()).
+	 */
 
 	DBG("attach: %u, driver_attached: %u", attach, gprs->driver_attached);
 
@@ -1904,6 +1976,7 @@ static DBusMessage *gprs_set_property(DBusConnection *conn,
 					gprs->settings);
 		}
 
+		gprs_set_powered_contexts(gprs);
 		gprs_netreg_update(gprs);
 	} else {
 		return __ofono_error_invalid_args(msg);
@@ -2041,6 +2114,16 @@ void ofono_gprs_cid_activated(struct ofono_gprs  *gprs, unsigned int cid,
 		return;
 	}
 
+	/*
+	 * Mobile data off: the modem keeps its default EPS bearer (we stay
+	 * attached), but it is not exposed as an active internet context.
+	 * Powered=true asks the driver again (list_active_contexts).
+	 */
+	if (!gprs->powered) {
+		DBG("cid %u not exposed: ConnectionManager not powered", cid);
+		return;
+	}
+
 	if (strlen(apn) > OFONO_GPRS_MAX_APN_LENGTH
 				|| is_valid_apn(apn) == FALSE) {
 		ofono_error("Context activated with an invalid APN");
@@ -2653,10 +2736,6 @@ void ofono_gprs_status_notify(struct ofono_gprs *gprs, int status)
 		return;
 	}
 
-	/* We registered without being powered */
-	if (gprs->powered == FALSE)
-		goto detach;
-
 	if (gprs->roaming_allowed == FALSE &&
 			status == NETWORK_REGISTRATION_STATUS_ROAMING)
 		goto detach;
