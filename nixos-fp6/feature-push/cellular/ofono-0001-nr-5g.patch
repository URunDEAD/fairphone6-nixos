+	 */
+	switch (mode) {
+	case OFONO_RADIO_ACCESS_MODE_ANY:
 		pref = data->rat_mode_any;
-	else {
+		break;
+	case OFONO_RADIO_ACCESS_MODE_NR:
+		pref = data->rat_mode_any;
+		break;
+	case OFONO_RADIO_ACCESS_MODE_LTE:
+		pref = QMI_NAS_RAT_MODE_PREF_LTE | QMI_NAS_RAT_MODE_PREF_UMTS |
+					QMI_NAS_RAT_MODE_PREF_GSM;
+		break;
+	case OFONO_RADIO_ACCESS_MODE_UMTS:
+		pref = QMI_NAS_RAT_MODE_PREF_UMTS | QMI_NAS_RAT_MODE_PREF_GSM;
+		break;
+	case OFONO_RADIO_ACCESS_MODE_GSM:
+		pref = QMI_NAS_RAT_MODE_PREF_GSM;
+		break;
+	default:
 		if (mode & OFONO_RADIO_ACCESS_MODE_GSM)
 			pref |= QMI_NAS_RAT_MODE_PREF_GSM;
 
@@ -115,12 +136,30 @@ static void qmi_set_rat_mode(struct ofono_radio_settings *rs, unsigned int mode,
 
 		if (mode & OFONO_RADIO_ACCESS_MODE_LTE)
 			pref |= QMI_NAS_RAT_MODE_PREF_LTE;
