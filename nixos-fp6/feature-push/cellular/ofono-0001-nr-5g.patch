+/*
+ * 5G NSA: the serving system only lists the LTE anchor.  Like Android's
+ * default "not restricted" policy, report E-UTRA-NR ("nr") while the LTE
+ * cell offers EN-DC and the network does not restrict DCNR for us.
+ */
+static void update_nsa(struct ofono_netreg *netreg, struct qmi_result *result,
+				uint8_t endc_tlv, uint8_t dcnr_tlv)
+{
+	struct netreg_data *data = ofono_netreg_get_data(netreg);
+	uint8_t endc = 0, restricted = 0;
+	bool nsa;
+
+	qmi_result_get_uint8(result, endc_tlv, &endc);
+	qmi_result_get_uint8(result, dcnr_tlv, &restricted);
+
+	nsa = endc && !restricted;
+
+	DBG("EN-DC available %u, DCNR restricted %u", endc, restricted);
+
+	if (nsa == data->nsa)
+		return;
+
+	data->nsa = nsa;
+
+	/* Re-evaluate Technology from the current serving system */
+	qmi_service_send(data->nas, QMI_NAS_GET_SERVING_SYSTEM, NULL,
+					ss_info_notify, netreg, NULL);
+}
+
 static void system_info_notify(struct qmi_result *result, void *user_data)
 {
+	struct ofono_netreg *netreg = user_data;
+
 	DBG("");
 
-	qmi_result_print_tlvs(result);
+	update_nsa(netreg, result, QMI_NAS_NOTIFY_SYSINFO_ENDC_AVAILABLE,
+				QMI_NAS_NOTIFY_SYSINFO_DCNR_RESTRICTED);
+}
+
+static void get_system_info_cb(struct qmi_result *result, void *user_data)
+{
+	struct ofono_netreg *netreg = user_data;
+
+	if (qmi_result_set_error(result, NULL))
+		return;
+
+	update_nsa(netreg, result, QMI_NAS_RESULT_SYSINFO_ENDC_AVAILABLE,
+				QMI_NAS_RESULT_SYSINFO_DCNR_RESTRICTED);
 }
 
 static void signal_info_notify(struct qmi_result *result, void *user_data)
@@ -592,6 +642,9 @@ static void register_indications_cb(struct qmi_result *result,
 	qmi_service_register(data->nas, QMI_NAS_SYSTEM_INFO_INDICATION,
 					system_info_notify, netreg, NULL);
 
+	qmi_service_send(data->nas, QMI_NAS_GET_SYSTEM_INFO, NULL,
+					get_system_info_cb, netreg, NULL);
+
 	qmi_service_register(data->nas, QMI_NAS_SIGNAL_INFO_INDICATION,
 					signal_info_notify, netreg, NULL);
 }
