diff --git a/qml/Notifications/Notifications.qml b/qml/Notifications/Notifications.qml
index fc66815..4b07f7b 100644
--- a/qml/Notifications/Notifications.qml
+++ b/qml/Notifications/Notifications.qml
@@ -15,6 +15,7 @@
  */
 
 import QtQuick 2.15
+import GSettings 1.0
 import Lomiri.Components 1.3
 import Lomiri.Notifications 1.0 as LomiriNotifications
 import Utils 0.1
@@ -34,6 +35,31 @@ ListView {
 
     readonly property bool useModal: snapDecisionProxyModel.count > 0
 
+    // FP6 Do Not Disturb (nixos-fp6/feature-push/notifications): fp6-notifyd
+    // keeps dnd-active up to date (switch, schedules, bedtime).
+    readonly property alias fp6Dnd: fp6DndSettings
+    GSettings {
+        id: fp6DndSettings
+        schema.id: "com.fairphone6.notifications"
+    }
+    // true: no sound, no screen wake (and no bubble if dnd-hide-popups).
+    function fp6Silenced(hints, type, urgency) {
+        if (!fp6DndSettings.dndActive) return false;
+        var h = hints || {};
+        // Calls and SMS: the telephony daemons asked fp6-notifyd (exceptions).
+        if (h["x-fp6-dnd"] === "silenced") return true;
+        if (h["x-fp6-dnd"] === "allowed") return false;
+        // Alarms (lomiri-indicator-datetime snap decisions), OSDs, critical ones.
+        if (type === LomiriNotifications.Notification.SnapDecision ||
+            type === LomiriNotifications.Notification.Confirmation ||
+            urgency === LomiriNotifications.Notification.Critical) return false;
+        var app = h["x-fp6-app-name"] || "";
+        // Emergency SOS (privacy-lock module) always shows.
+        if (app === "fp6-privacy") return false;
+        var allowed = fp6DndSettings.dndAllowedApps || [];
+        return allowed.indexOf(app) < 0;
+    }
+
     LomiriSortFilterProxyModel {
         id: snapDecisionProxyModel
         objectName: "snapDecisionProxyModel"
