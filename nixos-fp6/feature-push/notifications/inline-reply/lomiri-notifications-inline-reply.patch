+// FP6 inline replies
+void TestNotifications::testInlineReply() {
+    NotificationModel *m = new NotificationModel(this);
+    NotificationServer *s = new NotificationServer(QDBusConnection::sessionBus(), *m, this);
+    QVERIFY(s->GetCapabilities().contains(INLINE_REPLY_CAPABILITY));
+    QSignalSpy replied(s, SIGNAL(NotificationReplied(unsigned int, const QString &)));
+    QSignalSpy invoked(s, SIGNAL(ActionInvoked(unsigned int, const QString &)));
+    QVariantMap hints;
+    hints[INLINE_REPLY_HINT] = QStringLiteral("forged"); // only the server sets it
+    int plain = s->Notify("test-app", 0, "", "Test Contact", "no reply", {}, hints, -1);
+    QVERIFY(!m->getNotification(plain)->canReply());
+    QVERIFY(!m->getNotification(plain)->getHints().contains(INLINE_REPLY_HINT));
+    QVERIFY(!m->fp6Reply(plain, "x"));
+
+    int id = s->Notify("test-app", 0, "", "Test Contact", "Hello from +999 555 0100",
+                       {"default", "Open", "inline-reply", "Reply"}, QVariantMap(), -1);
+    QSharedPointer<Notification> n = m->getNotification(id);
+    QVERIFY(n->canReply());
+    QCOMPARE(n->getHints()[INLINE_REPLY_HINT].toString(), QStringLiteral("Reply"));
+    QCOMPARE(n->getDisplayTime(), 8000);
+    QVERIFY(m->fp6CanReply(id));
+    QVERIFY(!m->fp6Reply(id, "   "));            // empty replies are not sent
+    QCOMPARE(replied.count(), 0);
+    QSignalSpy replyable(m, SIGNAL(fp6ReplyableChanged()));
+    QVERIFY(m->fp6Reply(id, "On my way"));
+    QVERIFY(replyable.count() >= 1);
+    QCOMPARE(replied.count(), 1);
+    QCOMPARE(replied.at(0).at(0).toUInt(), (unsigned int) id);
+    QCOMPARE(replied.at(0).at(1).toString(), QStringLiteral("On my way"));
+    QCOMPARE(invoked.count(), 0);
+    QVERIFY(!m->hasNotification(id));             // closed after the reply
+    QVERIFY(!m->fp6Reply(id, "again"));
+
+    // Interactive notifications still need exactly two real actions.
+    QVariantMap ihints;
+    ihints[INTERACTIVE_HINT] = QStringLiteral("true");
+    int iid = s->Notify("test-app", 0, "", "s", "b", {"a", "A", "inline-reply", "Reply"}, ihints, -1);
+    QVERIFY(iid != 0);
+    QCOMPARE(m->getNotification(iid)->getActions()->getRawActions(), QStringList({"a", "A"}));
+}
+
+void TestNotifications::testInlineReplyParked() {
+    NotificationModel *m = new NotificationModel(this);
+    NotificationServer *s = new NotificationServer(QDBusConnection::sessionBus(), *m, this);
+    QSignalSpy replied(s, SIGNAL(NotificationReplied(unsigned int, const QString &)));
+    QSharedPointer<Notification> n(new Notification(77, 50, Notification::Low, "b", Notification::Ephemeral, s));
+    n->setCanReply(true);
+    QSharedPointer<Notification> plain(new Notification(78, 50, Notification::Low, "b", Notification::Ephemeral));
+    m->insertNotification(n);
+    m->insertNotification(plain);
+    QTRY_VERIFY(!m->showingNotification(77));
+    QVERIFY(m->isParked(77));                     // bubble gone, still open
+    QVERIFY(m->hasNotification(77));
+    QVERIFY(m->fp6CanReply(77));
+    QTRY_VERIFY(!m->showingNotification(78));
+    QVERIFY(!m->hasNotification(78));             // not replyable: gone
+    QVERIFY(m->fp6Reply(77, "Test reply"));
+    QCOMPARE(replied.count(), 1);
+
+    QSharedPointer<Notification> k(new Notification(79, 50, Notification::Low, "b", Notification::Ephemeral));
+    k->setCanReply(true);
+    m->insertNotification(k);
+    QTRY_VERIFY(m->isParked(79));
+    m->fp6Release(79);
+    QSharedPointer<Notification> d(new Notification(80, 60000, Notification::Low, "b", Notification::Ephemeral));
+    QSharedPointer<Notification> e(new Notification(81, 60000, Notification::Low, "b", Notification::Interactive));
+    d->setCanReply(true);
+    m->insertNotification(d);
+    m->insertNotification(e);
+    QVERIFY(!m->fp6ParkNow(81));                  // not replyable: untouched
+    QVERIFY(m->showingNotification(81));
+    QVERIFY(m->fp6ParkNow(80));                   // DND "hide popups"
+    QVERIFY(!m->showingNotification(80));
+    QVERIFY(m->isParked(80));
+    m->fp6Release(80);
+    m->removeNotification(81);
+    QVERIFY(!m->hasNotification(79));
+    QVERIFY(!m->fp6CanReply(79));
+    QVERIFY(m->takeParked(79) == false);
+}
+
+void TestNotifications::testInlineReplyHold() {
+    NotificationModel *m = new NotificationModel(this);
+    NotificationServer *s = new NotificationServer(QDBusConnection::sessionBus(), *m, this);
+    QSharedPointer<Notification> n(new Notification(88, 100, Notification::Low, "b", Notification::Ephemeral, s));
+    n->setCanReply(true);
+    m->insertNotification(n);
+    n->holdForReply(true);
+    QCOMPARE(n->getDisplayTime(), -1);
+    QTest::qWait(400);
+    QVERIFY(m->showingNotification(88));          // held while typing
+    n->holdForReply(false);
+    QVERIFY(m->showingNotification(88));          // display time restarts
+    QTRY_VERIFY(!m->showingNotification(88));
+    QVERIFY(m->isParked(88));
+    m->fp6Release(88);
+}
+
