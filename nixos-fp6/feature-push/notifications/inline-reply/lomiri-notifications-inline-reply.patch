+
+void Notification::holdForReply(bool hold) {
+    if (p->held == hold) return;
+    p->held = hold;
+    if (p->server) {
+        p->server->refreshTimeout(p->id);
+    }
+}
+
+bool Notification::reply(const QString &text) {
+    if (!p->canReply || !p->server || text.trimmed().isEmpty()) {
+        return false;
+    }
+    p->held = false;
+    setCanReply(false);
+    p->server->invokeReply(p->id, text);
+    Q_EMIT completed(p->id);
+    return true;
