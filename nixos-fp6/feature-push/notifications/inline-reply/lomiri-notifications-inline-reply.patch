+void NotificationModel::park(const QSharedPointer<Notification> &n) {
+    p->parked.append(n);
+    while (p->parked.size() > MAX_PARKED_REPLIES) {
+        p->parked.removeFirst(); // closed (NotificationClosed) when released
+    }
+    Q_EMIT fp6ReplyableChanged();
+}
+
+bool NotificationModel::isParked(NotificationID id) const {
+    for (const auto &n : p->parked) {
+        if (n->getID() == id) return true;
+    }
+    return false;
+}
+
+bool NotificationModel::takeParked(NotificationID id) {
+    for (int i = 0; i < p->parked.size(); i++) {
+        if (p->parked[i]->getID() == id) {
+            p->parked[i]->detachFromServer();
+            p->parked.removeAt(i);
+            Q_EMIT fp6ReplyableChanged();
+            return true;
+        }
+    }
+    return false;
+}
+
+bool NotificationModel::fp6CanReply(const unsigned int id) const {
+    QSharedPointer<Notification> n = getNotification(id);
+    return n && n->canReply();
+}
+
+bool NotificationModel::fp6Reply(const unsigned int id, const QString &text) {
+    QSharedPointer<Notification> n = getNotification(id);
+    if (!n || !n->canReply()) {
+        return false;
+    }
+    bool ok = n->reply(text);
+    Q_EMIT fp6ReplyableChanged();
+    return ok;
+}
+
+void NotificationModel::fp6Release(const unsigned int id) {
+    for (int i = 0; i < p->parked.size(); i++) {
+        if (p->parked[i]->getID() == id) {
+            // Dropping the last reference closes it (NotificationClosed).
+            p->parked.removeAt(i);
+            Q_EMIT fp6ReplyableChanged();
+            return;
+        }
+    }
+}
+
+bool NotificationModel::fp6ParkNow(const unsigned int id) {
+    for (int i = 0; i < p->displayedNotifications.size(); i++) {
+        QSharedPointer<Notification> n = p->displayedNotifications[i];
+        if (n->getID() == id) {
+            if (!n->canReply()) {
+                return false;
+            }
+            deleteFromVisible(i);
+            park(n);
+            timeout(); // Simulate a timeout so visual state is updated.
+            return true;
+        }
+    }
+    return false;
+}
