diff --git a/liblomiritelephonyservice/fp6dnd.h b/liblomiritelephonyservice/fp6dnd.h
new file mode 100644
index 0000000..73c7633
--- /dev/null
+++ b/liblomiritelephonyservice/fp6dnd.h
@@ -0,0 +1,42 @@
+/*
+ * FP6 Do Not Disturb (nixos-fp6/feature-push/notifications): ask fp6-notifyd
+ * whether an incoming call / message may ring, vibrate and wake the screen.
+ * Returns true (alert as usual) when DND is off, fp6-notifyd is not running
+ * or does not answer within 400 ms.
+ */
+#ifndef FP6DND_H
+#define FP6DND_H
+
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QContact>
+#include <QContactFavorite>
+#include <QString>
+
+namespace Fp6Dnd {
+
+inline bool shouldAlert(const QString &kind, const QString &id, const QtContacts::QContact &contact)
+{
+    QDBusMessage msg = QDBusMessage::createMethodCall(QStringLiteral("com.fairphone6.Dnd"),
+                                                      QStringLiteral("/com/fairphone6/Dnd"),
+                                                      QStringLiteral("com.fairphone6.Dnd"),
+                                                      QStringLiteral("ShouldAlert"));
+    msg.setAutoStartService(false);
+    const bool isContact = !contact.isEmpty();
+    const bool isFavourite = isContact && contact.detail<QtContacts::QContactFavorite>().isFavorite();
+    msg << kind << id << isContact << isFavourite;
+    const QDBusMessage reply = QDBusConnection::sessionBus().call(msg, QDBus::Block, 400);
+    if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+        return true;
+    }
+    return reply.arguments().first().toBool();
+}
+
+inline const char *hint(bool alert)
+{
+    return alert ? "allowed" : "silenced";
+}
+
+}
+
+#endif
