+/* FP6: adbd always drops to the unprivileged account named by $ADBD_USER. */
+static struct passwd *fp6_adbd_account(void) {
+    const char *name = getenv("ADBD_USER");
+    struct passwd *pw;
+    if (name == NULL || name[0] == '\0') {
+        fprintf(stderr, "adbd: ADBD_USER is not set\n");
+        exit(1);
+    }
+    pw = getpwnam(name);
+    if (pw == NULL || pw->pw_uid == 0 || pw->pw_gid == 0) {
+        fprintf(stderr, "adbd: ADBD_USER must name an existing non-root account\n");
+        exit(1);
+    }
+    return pw;
+}
