+void IIOSensorProxyOrientationSensor::tryClaim()
+{
+    if (!m_wanted || m_claimed || !isServiceRunning())
+        return;
+    if (!m_sensorProxyInterface->hasAccelerometer())
+        return; // claimed later from the HasAccelerometer change
+    QDBusPendingReply<> reply = m_sensorProxyInterface->ClaimAccelerometer();
+    reply.waitForFinished();
+    if (reply.isError()) {
+        qWarning("fp6-iio-sensor-proxy: ClaimAccelerometer failed: %s",
+                 qPrintable(reply.error().message()));
+        return;
+    }
+    m_claimed = true;
+    updateOrientation(m_sensorProxyInterface->accelerometerOrientation());
+}
+
+void IIOSensorProxyOrientationSensor::serviceAppeared()
+{
+    tryClaim();
+}
+
+void IIOSensorProxyOrientationSensor::serviceVanished()
+{
+    m_claimed = false;
+    if (!m_wanted)
+        sensorStopped();
+}
