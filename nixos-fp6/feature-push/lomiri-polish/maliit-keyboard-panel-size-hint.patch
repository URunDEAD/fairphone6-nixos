+    // FP6: lay out for the shell's (rotated) input-method area when Lomiri
+    // publishes it; otherwise fall back to the output geometry as before.
+    const QString hintPath = panelSizeHintPath();
+    auto applyGeometry = [d, hintPath]() {
+        QScreen *output = qGuiApp->primaryScreen();
+        const QRect screen = output->geometry();
+        QRect geometry = screen;
+        QFile hint(hintPath);
+        if (!hintPath.isEmpty() && hint.open(QIODevice::ReadOnly)) {
+            const QSize size = parsePanelSizeHint(hint.read(64), output->devicePixelRatio(),
+                                                  screen.size());
+            if (size.isValid())
+                geometry = QRect(screen.topLeft(), size);
+        }
+        if (d->view->geometry() != geometry)
+            d->view->setGeometry(geometry);
+    };
+    applyGeometry();
+    connect(qGuiApp->primaryScreen(), &QScreen::geometryChanged, this, applyGeometry);
+    if (!hintPath.isEmpty()) {
+        // The hint is replaced atomically (rename), which drops a file watch,
+        // so also watch the directory and re-arm the file watch every time.
+        auto *watcher = new QFileSystemWatcher(this);
+        const QString hintDir = QFileInfo(hintPath).absolutePath();
+        auto rearm = [watcher, hintPath, applyGeometry]() {
+            if (QFileInfo::exists(hintPath) && !watcher->files().contains(hintPath))
+                watcher->addPath(hintPath);
+            applyGeometry();
+        };
+        watcher->addPath(hintDir);
+        rearm();
+        connect(watcher, &QFileSystemWatcher::directoryChanged, this, rearm);
+        connect(watcher, &QFileSystemWatcher::fileChanged, this, rearm);
+    }
