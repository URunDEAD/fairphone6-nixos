+                this.devices.select (AudioDeviceSelector.Kind.OUTPUT, param.get_string ());
+        });
+        this.output_device_action.change_state.connect ((action, val) => {
+            this.devices.select (AudioDeviceSelector.Kind.OUTPUT, val.get_string ());
+        });
+        this.actions.add_action (this.output_device_action);
+
+        this.input_device_action = new SimpleAction.stateful ("input-device", VariantType.STRING, new Variant.string (""));
+        this.input_device_action.activate.connect ((action, param) => {
+            if (param != null)
+                this.devices.select (AudioDeviceSelector.Kind.INPUT, param.get_string ());
+        });
+        this.input_device_action.change_state.connect ((action, val) => {
+            this.devices.select (AudioDeviceSelector.Kind.INPUT, val.get_string ());
+        });
+        this.actions.add_action (this.input_device_action);
+
+        /* JSON lists [{id, label, icon, active}] for Settings > Sound */
+        this.output_devices_action = new SimpleAction.stateful ("output-devices", null, new Variant.string ("[]"));
+        this.actions.add_action (this.output_devices_action);
+        this.input_devices_action = new SimpleAction.stateful ("input-devices", null, new Variant.string ("[]"));
+        this.actions.add_action (this.input_devices_action);
+
+        /* Settings > Sound: "Automatically switch to new devices" */
+        this.switch_new_action = new SimpleAction.stateful ("switch-to-new-devices", VariantType.BOOLEAN, new Variant.boolean (this.devices.auto_switch));
+        this.switch_new_action.activate.connect ((action, param) => {
+            action.change_state (param ?? new Variant.boolean (!action.get_state ().get_boolean ()));
+        });
+        this.switch_new_action.change_state.connect ((action, val) => {
+            this.devices.set_switch_to_new_devices (val.get_boolean ());
+            action.set_state (val);
+        });
+        this.actions.add_action (this.switch_new_action);
+
+        /* Settings > Sound > App audio: JSON [{key, name, icon, playing,
+         * recording, output, input}] and "output|input <TAB> key <TAB> device id
+         * or default" to change one app's choice. */
+        this.apps_action = new SimpleAction.stateful ("app-streams", null, new Variant.string ("[]"));
+        this.actions.add_action (this.apps_action);
+        var set_app = new SimpleAction ("set-app-device", VariantType.STRING);
+        set_app.activate.connect ((action, param) => {
+            string[] f = param.get_string ().split ("\t", 3);
+            if (f.length != 3)
+                return;
+            this.devices.set_app_device (f[0] == "input" ? AudioDeviceSelector.Kind.INPUT : AudioDeviceSelector.Kind.OUTPUT, f[1], f[2]);
+        });
+        this.actions.add_action (set_app);
+
+        this.devices.changed.connect (() => {
+            this.switch_new_action.set_state (new Variant.boolean (this.devices.auto_switch));
+            this.apps_action.set_state (new Variant.string (this.devices.apps_json ()));
+            this.menus.@foreach ((profile, menu) => menu.update_devices (this.devices));
+            this.output_device_action.set_state (new Variant.string (this.devices.active_output));
+            this.input_device_action.set_state (new Variant.string (this.devices.active_input));
+            this.output_devices_action.set_state (new Variant.string (this.devices.to_json (AudioDeviceSelector.Kind.OUTPUT)));
+            this.input_devices_action.set_state (new Variant.string (this.devices.to_json (AudioDeviceSelector.Kind.INPUT)));
+        });
+    }
+
