+/*
+ * Output and input device selection for the sound menu.
+ *
+ * Every (card, port) pair is one choice, as in GNOME's and pavucontrol's
+ * port lists. Choosing a port that the card's active profile does not
+ * carry switches the card profile first (PulseAudio >= 15 and PipeWire
+ * build one UCM profile per device combination when devices share a PCM,
+ * e.g. "HiFi (Mic1, Speaker)" / "HiFi (Earpiece, Mic1)"; Bluetooth
+ * microphones need the headset profile). The profile is picked so that the
+ * other direction keeps its current device. Then the port is set and the
+ * node becomes the default sink/source (WirePlumber stores that as the
+ * configured default: it sticks, falls back while the device is away and
+ * returns when it reappears). Volumes are not touched: the session manager
+ * restores each device's own volume.
+ *
+ * Also here:
+ *  - switching to newly connected Bluetooth/USB devices (a card whose first
+ *    node appears after startup), unless the user turned it off;
+ *  - per-app routing: each app (key = application.process.binary, else
+ *    application.name) can be pinned to an output and an input device. The
+ *    choice is kept in $XDG_CONFIG_HOME/ayatana-indicator-sound/fp6-audio-routing.ini
+ *    and applied to the app's streams whenever they or the device appear.
+ *    Call streams (media.role phone) are left to the telephony routing.
+ */
+
+using PulseAudio;
+
+/* AudioDeviceSelectorPa (vapi/fp6-pulse-ports.vapi) mirrors the pa_card_port_info
+ * and pa_card_profile_info2 members that the libpulse vapi keeps private. */
+
+public class AudioDeviceSelector : Object
+{
+    public enum Kind {
+        OUTPUT,
+        INPUT
+    }
+
+    public class Device {
+        public string id;
+        public string label;
+        public string icon;
+    }
+
+    class CardPort {
+        public string name;
+        public string description;
+        public uint32 priority;
+        public bool output;
+        public bool unavailable;
+        public string[] profiles = {};
+    }
+
+    class Card {
+        public uint32 index;
+        public string name;
+        public string description;
+        public string bus;
+        public string form_factor;
+        public string address;
+        public string active_profile;
+        public Gee.ArrayList<CardPort> ports = new Gee.ArrayList<CardPort> ();
+        public HashTable<string, uint32> profile_priority = new HashTable<string, uint32> (str_hash, str_equal);
+        public HashTable<string, bool> profile_available = new HashTable<string, bool> (str_hash, str_equal);
+
+        public bool is_bluetooth () {
+            return this.name.has_prefix ("bluez_card.") || this.bus == "bluetooth";
+        }
+
+        public bool is_internal () {
+            return this.name.has_prefix ("alsa_card.platform-");
+        }
+
+        public bool is_usb () {
+            return this.bus == "usb";
+        }
+    }
+
+    class Node {
+        public uint32 index;
+        public string name;
+        public string description;
+        public uint32 card;
+        public string? active_port;
+        public string[] ports = {};
+        public bool output;
+        public bool is_monitor;
+    }
+
+    class Stream {
+        public uint32 index;
+        public bool output;
+        public string key;
+        public string name;
+        public string icon;
+        public uint32 node;
+        public bool corked;
+    }
+
+    class Pending {
+        public bool output;
+        public uint32 card;
+        public string port;
+        public int64 deadline;
+    }
+
+    /* The selector owns its PulseAudio main loop. The loop must outlive the
+     * context: freeing a context unlinks its I/O events through the loop's
+     * API, so a loop freed first (it used to be a separate field of the
+     * service, freed before the selector) made every exit of the service
+     * segfault in glib_io_free (seen at each greeter logout). */
+    private PulseAudio.GLibMainLoop loop = new PulseAudio.GLibMainLoop ();
+    private PulseAudio.Context context = null;
+    private uint reconnect_timer = 0;
+    private uint refresh_idle = 0;
+    private int ops_in_flight = 0;
+    private bool refresh_again = false;
+    private bool ready = false;
+
+    /* Snapshot being collected and the last complete one */
+    private Gee.ArrayList<Card> new_cards;
+    private Gee.ArrayList<Node> new_nodes;
+    private string new_default_sink = "";
+    private string new_default_source = "";
+    private Gee.ArrayList<Card> cards = new Gee.ArrayList<Card> ();
+    private Gee.ArrayList<Node> nodes = new Gee.ArrayList<Node> ();
+    private Gee.ArrayList<Stream> new_streams;
+    private Gee.ArrayList<Stream> streams = new Gee.ArrayList<Stream> ();
+    private string default_sink = "";
+    private string default_source = "";
+
+    private Gee.ArrayList<Pending> pending = new Gee.ArrayList<Pending> ();
+    /* Bluetooth cards put on the headset profile for a call (back to A2DP after it) */
+    private Gee.HashSet<string> call_headsets = new Gee.HashSet<string> ();
+    private string last_signature = "";
+
+    public Gee.ArrayList<Device> outputs { get; private set; default = new Gee.ArrayList<Device> (); }
+    public Gee.ArrayList<Device> inputs { get; private set; default = new Gee.ArrayList<Device> (); }
+    public string active_output { get; private set; default = ""; }
+    public bool auto_switch { get; private set; default = true; }
+    /* Diagnostics: observe only, never change the sound server */
+    public bool read_only { get; set; default = false; }
+    public string active_input { get; private set; default = ""; }
+    public bool in_call { get; private set; default = false; }
+
+    public signal void changed ();
+
+    public AudioDeviceSelector ()
+    {
+        this.load_settings ();
+        this.reconnect ();
+    }
+
+    /* Settings file (per user; the indicator is the only writer) */
+
+    private KeyFile settings = new KeyFile ();
+    private string settings_path;
+    private int64 bt_names_mtime = -1;
+    private KeyFile bt_names = new KeyFile ();
+
+    private void load_settings ()
+    {
+        this.settings_path = Path.build_filename (Environment.get_user_config_dir (), "ayatana-indicator-sound", "fp6-audio-routing.ini");
+        try {
+            this.settings.load_from_file (this.settings_path, KeyFileFlags.KEEP_COMMENTS);
+        } catch (GLib.Error e) {
+            /* first run */
+        }
+        try {
+            this.auto_switch = this.settings.get_boolean ("General", "switch-to-new-devices");
+        } catch (GLib.Error e) {
+            this.auto_switch = true;
+        }
+    }
+
+    private void save_settings ()
+    {
+        try {
+            DirUtils.create_with_parents (Path.get_dirname (this.settings_path), 0700);
+            this.settings.save_to_file (this.settings_path);
+        } catch (GLib.Error e) {
+            warning ("audio devices: cannot save %s: %s", this.settings_path, e.message);
+        }
+    }
+
+    private string? setting (string group, string key)
+    {
+        try {
+            return this.settings.get_string (group, key);
+        } catch (GLib.Error e) {
+            return null;
+        }
+    }
+
+    public void set_switch_to_new_devices (bool on)
+    {
+        this.auto_switch = on;
+        this.settings.set_boolean ("General", "switch-to-new-devices", on);
+        this.save_settings ();
+        this.last_signature = "";
+        this.rebuild ();
+    }
+
+    /* Names and types the Bluetooth settings page lets the user choose:
+     * $XDG_CONFIG_HOME/fp6-bluetooth/devices.ini, one group per address
+     * ("AA:BB:CC:DD:EE:FF") with optional keys name= and type= (car, speaker,
+     * hifi, portable, headphones, earbuds, headset, phone, computer, tv, other). */
+    private void load_bt_names ()
+    {
+        string path = Path.build_filename (Environment.get_user_config_dir (), "fp6-bluetooth", "devices.ini");
+        int64 mtime = 0;
+        try {
+            var info = File.new_for_path (path).query_info (FileAttribute.TIME_MODIFIED, FileQueryInfoFlags.NONE);
+            mtime = (int64) info.get_attribute_uint64 (FileAttribute.TIME_MODIFIED);
+        } catch (GLib.Error e) {
+            mtime = 0;
+        }
+        if (mtime == this.bt_names_mtime)
+            return;
+        this.bt_names_mtime = mtime;
+        this.bt_names = new KeyFile ();
+        if (mtime == 0)
+            return;
+        try {
+            this.bt_names.load_from_file (path, KeyFileFlags.NONE);
+        } catch (GLib.Error e) {
+            warning ("audio devices: cannot read %s: %s", path, e.message);
+        }
+    }
+
+    private string? bt_value (Card card, string key)
+    {
+        if (card.address == "")
+            return null;
+        try {
+            string v = this.bt_names.get_string (card.address.up (), key).strip ();
+            return v != "" ? v : null;
+        } catch (GLib.Error e) {
+            return null;
+        }
+    }
+
+    ~AudioDeviceSelector ()
+    {
+        if (this.reconnect_timer != 0)
+            Source.remove (this.reconnect_timer);
+        if (this.refresh_idle != 0)
+            Source.remove (this.refresh_idle);
+        if (this.context != null) {
+            this.context.set_state_callback (null);
+            this.context.disconnect ();
+            /* Unref now, while this.loop is still alive: fields are freed
+             * only after this body, and the loop may go first. */
+            this.context = null;
+        }
+    }
+
+    /* Connection */
+
+    private void reconnect ()
+    {
+        if (this.context != null) {
+            this.context.disconnect ();
+            this.context = null;
+        }
+        this.ready = false;
+
+        var props = new Proplist ();
+        props.sets (Proplist.PROP_APPLICATION_NAME, "Ayatana Indicator Sound (devices)");
+        props.sets (Proplist.PROP_APPLICATION_ID, "org.ayatana.indicator.sound.devices");
+
+        this.context = new PulseAudio.Context (this.loop.get_api (), null, props);
+        this.context.set_state_callback (this.context_state_cb);
+
+        unowned string server_string = Environment.get_variable ("PULSE_SERVER");
+        if (this.context.connect (server_string, Context.Flags.NOFAIL, null) < 0)
+            warning ("audio devices: pa_context_connect() failed: %s", PulseAudio.strerror (this.context.errno ()));
+    }
+
+    private void context_state_cb (Context c)
+    {
+        switch (c.get_state ()) {
+            case Context.State.READY:
+                this.ready = true;
+                c.set_subscribe_callback (this.context_events_cb);
+                c.subscribe (Context.SubscriptionMask.SINK |
+                             Context.SubscriptionMask.SOURCE |
+                             Context.SubscriptionMask.CARD |
+                             Context.SubscriptionMask.SINK_INPUT |
+                             Context.SubscriptionMask.SOURCE_OUTPUT |
+                             Context.SubscriptionMask.SERVER);
+                this.queue_refresh ();
+                break;
+
+            case Context.State.FAILED:
+            case Context.State.TERMINATED:
+                this.ready = false;
+                if (this.reconnect_timer == 0) {
+                    this.reconnect_timer = Timeout.add_seconds (2, () => {
+                        this.reconnect_timer = 0;
+                        this.reconnect ();
+                        return Source.REMOVE;
+                    });
+                }
+                break;
+
+            default:
+                break;
+        }
+    }
+
+    private void context_events_cb (Context c, Context.SubscriptionEventType t, uint32 index)
+    {
+        this.queue_refresh ();
+    }
+
+    /* Collecting a snapshot */
+
+    private void queue_refresh ()
+    {
+        if (this.refresh_idle != 0)
+            return;
+        /* Coalesce the burst of events a profile switch produces */
+        this.refresh_idle = Timeout.add (60, () => {
+            this.refresh_idle = 0;
+            this.refresh ();
+            return Source.REMOVE;
+        });
+    }
+
+    private void refresh ()
+    {
+        if (!this.ready)
+            return;
+        if (this.ops_in_flight > 0) {
+            this.refresh_again = true;
+            return;
+        }
+
+        this.new_cards = new Gee.ArrayList<Card> ();
+        this.new_nodes = new Gee.ArrayList<Node> ();
+        this.new_default_sink = "";
+        this.new_default_source = "";
+        this.new_streams = new Gee.ArrayList<Stream> ();
+        this.ops_in_flight = 6;
+
+        this.context.get_server_info (this.server_info_cb);
+        this.context.get_card_info_list (this.card_info_cb);
+        this.context.get_sink_info_list (this.sink_info_cb);
+        this.context.get_source_info_list (this.source_info_cb);
+        this.context.get_sink_input_info_list (this.sink_input_info_cb);
+        this.context.get_source_output_info_list (this.source_output_info_cb);
+    }
+
+    private Stream? make_stream (uint32 index, Proplist props, uint32 node, int corked, bool output)
+    {
+        unowned string? role = props.gets ("media.role");
+        if (role != null && role.down () == "phone")
+            return null;  /* calls: telephony-service routes them */
+        if (props.gets ("application.id") == "org.ayatana.indicator.sound.devices")
+            return null;
+        unowned string? binary = props.gets ("application.process.binary");
+        unowned string? name = props.gets ("application.name");
+        if (binary == null && name == null)
+            return null;
+        var st = new Stream ();
+        st.index = index;
+        st.output = output;
+        /* Wrapped Nix binaries are called .foo-wrapped */
+        string key = binary ?? name;
+        if (key.has_prefix (".") && key.has_suffix ("-wrapped"))
+            key = key.substring (1, key.length - 9);
+        st.key = key;
+        st.name = name ?? key;
+        st.icon = props.gets ("application.icon_name") ?? props.gets ("application.icon-name") ?? "";
+        st.node = node;
+        st.corked = corked != 0;
+        return st;
+    }
+
+    private void sink_input_info_cb (Context c, SinkInputInfo? i, int eol)
+    {
+        if (eol != 0 || i == null) {
+            this.op_done ();
+            return;
+        }
+        var st = this.make_stream (i.index, i.proplist, i.sink, i.corked, true);
+        if (st != null)
+            this.new_streams.add (st);
+    }
+
+    private void source_output_info_cb (Context c, SourceOutputInfo? i, int eol)
+    {
+        if (eol != 0 || i == null) {
+            this.op_done ();
+            return;
+        }
+        /* Peak meters and other monitor readers are not apps recording */
+        unowned string? target = i.proplist.gets ("target.object");
+        if (target != null && target.has_suffix (".monitor"))
+            return;
+        var st = this.make_stream (i.index, i.proplist, i.source, i.corked, false);
+        if (st != null)
+            this.new_streams.add (st);
+    }
+
+    private void op_done ()
+    {
+        this.ops_in_flight--;
+        if (this.ops_in_flight > 0)
+            return;
+
+        this.cards = this.new_cards;
+        this.nodes = this.new_nodes;
+        this.streams = this.new_streams;
+        this.default_sink = this.new_default_sink;
+        this.default_source = this.new_default_source;
+        this.rebuild ();
+
+        if (this.refresh_again) {
+            this.refresh_again = false;
+            this.queue_refresh ();
+        }
+    }
+
+    private void server_info_cb (Context c, ServerInfo? i)
+    {
+        if (i != null) {
+            this.new_default_sink = i.default_sink_name ?? "";
+            this.new_default_source = i.default_source_name ?? "";
+        }
+        this.op_done ();
+    }
+
+    private void card_info_cb (Context c, CardInfo? i, int eol)
+    {
+        if (eol != 0 || i == null) {
+            this.op_done ();
+            return;
+        }
+
+        var card = new Card ();
+        card.index = i.index;
+        card.name = i.name;
+        card.description = i.proplist.gets ("device.description") ?? i.name;
+        card.bus = i.proplist.gets ("device.bus") ?? "";
+        card.form_factor = i.proplist.gets ("device.form_factor") ?? "";
+        card.address = i.proplist.gets ("api.bluez5.address") ?? "";
+        card.active_profile = (i.active_profile2 != null) ? i.active_profile2->name : "";
+
+        for (int p = 0; p < i.profiles2.length; p++) {
+            var prof = (AudioDeviceSelectorPa.ProfileInfo2*) i.profiles2[p];
+            card.profile_priority.insert (prof->name, prof->priority);
+            card.profile_available.insert (prof->name, prof->available != 0);
+        }
+
+        for (int p = 0; p < i.ports.length; p++) {
+            var port = (AudioDeviceSelectorPa.PortInfo*) i.ports[p];
+            var cp = new CardPort ();
+            cp.name = port->name;
+            cp.description = port->description ?? port->name;
+            cp.priority = port->priority;
+            cp.output = (port->direction & (int) PulseAudio.Direction.OUTPUT) != 0;
+            cp.unavailable = port->available == (int) PulseAudio.PortAvailable.NO;
+            for (int q = 0; q < port->profiles2.length; q++)
+                cp.profiles += port->profiles2[q]->name;
+            card.ports.add (cp);
+        }
+
+        this.new_cards.add (card);
+    }
+
+    private void sink_info_cb (Context c, SinkInfo? i, int eol)
+    {
+        if (eol != 0 || i == null) {
+            this.op_done ();
+            return;
+        }
+
+        var node = new Node ();
+        node.index = i.index;
+        node.name = i.name;
+        node.description = i.description ?? i.name;
+        node.card = i.card;
+        node.output = true;
+        node.is_monitor = false;
+        node.active_port = (i.active_port != null) ? i.active_port->name : null;
+        for (int p = 0; p < i.ports.length; p++)
+            node.ports += i.ports[p]->name;
+        this.new_nodes.add (node);
+    }
+
+    private void source_info_cb (Context c, SourceInfo? i, int eol)
+    {
+        if (eol != 0 || i == null) {
+            this.op_done ();
+            return;
+        }
+
+        var node = new Node ();
+        node.index = i.index;
+        node.name = i.name;
+        node.description = i.description ?? i.name;
+        node.card = i.card;
+        node.output = false;
+        node.is_monitor = i.monitor_of_sink != PulseAudio.INVALID_INDEX;
+        node.active_port = (i.active_port != null) ? i.active_port->name : null;
+        for (int p = 0; p < i.ports.length; p++)
+            node.ports += i.ports[p]->name;
+        this.new_nodes.add (node);
+    }
+
+    /* Model */
+
+    private static string strip_ucm_prefix (string port)
+    {
+        if (port.has_prefix ("[Out] "))
+            return port.substring (6);
+        if (port.has_prefix ("[In] "))
+            return port.substring (5);
+        return port;
+    }
+
+    private static string id_for (Card card, CardPort port)
+    {
+        return "%s|%s".printf (card.name, port.name);
+    }
+
+
+    private Card? card_by_name (string name)
+    {
+        foreach (var c in this.cards)
+            if (c.name == name)
+                return c;
+        return null;
+    }
+
+    private Node? node_by_name (string name)
+    {
+        foreach (var n in this.nodes)
+            if (n.name == name)
+                return n;
+        return null;
+    }
+
+    private Node? node_on_card (uint32 card, bool output, string? port)
+    {
+        foreach (var n in this.nodes) {
+            if (n.card != card || n.output != output || n.is_monitor)
+                continue;
+            if (port == null)
+                return n;
+            foreach (var p in n.ports)
+                if (p == port)
+                    return n;
+        }
+        return null;
+    }
+
+    private string label_for (Card card, CardPort port, int ports_in_direction)
+    {
+        if (card.is_internal ()) {
+            string dev = strip_ucm_prefix (port.name);
+            if (port.output) {
+                if (dev.contains ("Earpiece") || dev == "output-earpiece")
+                    return _("Earpiece");
+                if (dev.contains ("Speaker") || dev == "output-speaker")
+                    return _("Phone speaker");
+                if (dev.contains ("Headphone") || dev.contains ("Headset") || dev.contains ("wired"))
+                    return _("Wired headset");
+            } else {
+                if (dev == "Mic1" || dev == "Mic" || dev == "DigitalMic" || dev == "input-builtin_mic")
+                    return _("Built-in microphone");
+                if (dev == "Mic2")
+                    return _("Built-in microphone (top)");
+                if (dev.contains ("Headset") || dev.contains ("wired"))
+                    return _("Headset microphone");
+            }
+            return port.description;
+        }
+
+        if (card.is_bluetooth ()) {
+            string name = this.bt_value (card, "name") ?? card.description;
+            if (port.output)
+                return name;
+            return _("%s microphone").printf (name);
+        }
+
+        if (ports_in_direction > 1)
+            return "%s – %s".printf (card.description, port.description);
+        return card.description;
+    }
+
+    private string icon_for (Card card, CardPort port)
+    {
+        if (card.is_bluetooth ()) {
+            if (!port.output)
+                return "audio-input-microphone-symbolic";
+            /* Types as chosen on Settings > Bluetooth (fp6-bluetooth/devices.ini),
+             * else PipeWire's device.form_factor; same icons as that page. */
+            switch (this.bt_value (card, "type") ?? card.form_factor) {
+                case "car":
+                    return "audio-carkit-symbolic";
+                case "speaker":
+                case "hifi":
+                case "portable":
+                    return "audio-speakers-symbolic";
+                case "headphones":
+                case "headphone":
+                    return "audio-headphones-symbolic";
+                case "earbuds":
+                    return "fp6-audio-earbuds-symbolic";
+                case "headset":
+                case "handsfree":
+                    return "audio-headset-symbolic";
+                case "phone":
+                case "handset":
+                    return "phone-smartphone-symbolic";
+                case "computer":
+                    return "computer-symbolic";
+                case "tv":
+                    return "video-display-symbolic";
+                case "other":
+                    return "bluetooth-active";
+                default:
+                    return "audio-headphones-symbolic";
+            }
+        }
+        if (!port.output)
+            return "audio-input-microphone-symbolic";
+        string dev = strip_ucm_prefix (port.name);
+        if (card.is_internal () && dev.contains ("Earpiece"))
+            return "phone-symbolic";
+        if (card.is_internal () && dev.contains ("Speaker"))
+            return "audio-speakers-symbolic";
+        return "audio-headphones-symbolic";
+    }
+
+    private static int card_order (Card a, Card b)
+    {
+        int ra = a.is_internal () ? 0 : (a.is_usb () ? 1 : (a.is_bluetooth () ? 2 : 3));
+        int rb = b.is_internal () ? 0 : (b.is_usb () ? 1 : (b.is_bluetooth () ? 2 : 3));
+        if (ra != rb)
+            return ra - rb;
+        return (int) a.index - (int) b.index;
+    }
+
+    private Gee.ArrayList<Device> build_list (bool output, out string active_id)
+    {
+        var list = new Gee.ArrayList<Device> ();
+        string default_name = output ? this.default_sink : this.default_source;
+        Node? default_node = this.node_by_name (default_name);
+        active_id = "";
+
+        var sorted = new Gee.ArrayList<Card> ();
+        sorted.add_all (this.cards);
+        sorted.sort (card_order);
+
+        foreach (var card in sorted) {
+            var ports = new Gee.ArrayList<CardPort> ();
+            foreach (var port in card.ports) {
+                if (port.output != output || port.unavailable)
+                    continue;
+                /* The earpiece only makes sense next to the ear */
+                if (output && card.is_internal () && !this.in_call &&
+                        strip_ucm_prefix (port.name).contains ("Earpiece"))
+                    continue;
+                bool usable = false;
+                foreach (var prof in port.profiles)
+                    if (card.profile_available.lookup (prof))
+                        usable = true;
+                if (!usable)
+                    continue;
+                ports.add (port);
+            }
+
+            if (ports.size == 0) {
+                /* Cards without ports (some USB devices): one entry per node */
+                foreach (var n in this.nodes) {
+                    if (n.card != card.index || n.output != output || n.is_monitor)
+                        continue;
+                    var dev = new Device ();
+                    dev.id = "node|" + n.name;
+                    dev.label = card.is_bluetooth () && !output ? _("%s microphone").printf (card.description) : card.description;
+                    dev.icon = output ? "audio-headphones-symbolic" : "audio-input-microphone-symbolic";
+                    list.add (dev);
+                    if (n.name == default_name)
+                        active_id = dev.id;
+                }
+                continue;
+            }
+
+            foreach (var port in ports) {
+                var dev = new Device ();
+                dev.id = id_for (card, port);
+                dev.label = this.label_for (card, port, ports.size);
+                dev.icon = this.icon_for (card, port);
+                list.add (dev);
+
+                if (default_node != null && default_node.card == card.index &&
+                        (default_node.active_port == port.name ||
+                         (default_node.active_port == null && default_node.ports.length == 0)))
+                    active_id = dev.id;
+            }
+        }
+
+        /* A default without a card (filter or virtual node): still show what is in use */
+        if (active_id == "" && default_node != null && default_node.card == PulseAudio.INVALID_INDEX &&
+                !default_node.name.has_prefix ("auto_null")) {
+            var dev = new Device ();
+            dev.id = "node|" + default_node.name;
+            dev.label = default_node.description;
+            dev.icon = output ? "audio-speakers-symbolic" : "audio-input-microphone-symbolic";
+            list.add (dev);
+            active_id = dev.id;
+        }
+
+        return list;
+    }
+
+    private void rebuild ()
+    {
+        bool call = false;
+        foreach (var card in this.cards)
+            if (card.is_internal () && card.active_profile.has_prefix ("Voice Call"))
+                call = true;
+        if (call != this.in_call) {
+            this.in_call = call;
+            if (!call)
+                this.restore_call_headsets ();
+        }
+
+        this.process_pending ();
+        this.load_bt_names ();
+        this.switch_to_new_devices ();
+        this.apply_app_routes ();
+
+        string out_id, in_id;
+        var outs = this.build_list (true, out out_id);
+        var ins = this.build_list (false, out in_id);
+
+        var sig = new StringBuilder ();
+        foreach (var d in outs)
+            sig.append_printf ("o:%s=%s;", d.id, d.label);
+        foreach (var d in ins)
+            sig.append_printf ("i:%s=%s;", d.id, d.label);
+        sig.append_printf ("ao:%s;ai:%s;c:%d;a:%d;", out_id, in_id, call ? 1 : 0, this.auto_switch ? 1 : 0);
+        sig.append (this.apps_json ());
+
+        if (sig.str == this.last_signature)
+            return;
+        this.last_signature = sig.str;
+
+        this.outputs = outs;
+        this.inputs = ins;
+        this.active_output = out_id;
+        this.active_input = in_id;
+        this.changed ();
+    }
+
+    /* Switching to new devices */
+
+    private bool first_snapshot = true;
+    private Gee.HashSet<string> known_cards = new Gee.HashSet<string> ();
+    /* Cards that appeared after startup and have not got their first node yet */
+    private Gee.HashMap<string, int64?> appeared_cards = new Gee.HashMap<string, int64?> ();
+
+    private void switch_to_new_devices ()
+    {
+        int64 now = GLib.get_monotonic_time ();
+        var present = new Gee.HashSet<string> ();
+        foreach (var c in this.cards) {
+            present.add (c.name);
+            /* A card is new when it appears, not when a profile switch
+             * (A2DP <-> headset, call profiles) recreates its nodes. */
+            if (!this.first_snapshot && !this.known_cards.contains (c.name) && (c.is_bluetooth () || c.is_usb ()))
+                this.appeared_cards[c.name] = now + 10 * TimeSpan.SECOND;
+        }
+        this.known_cards = present;
+        this.first_snapshot = false;
+
+        var done = new Gee.ArrayList<string> ();
+        foreach (var name in this.appeared_cards.keys) {
+            Card? card = this.card_by_name (name);
+            if (card == null || now > this.appeared_cards[name]) {
+                done.add (name);
+                continue;
+            }
+            Node? out_node = this.node_on_card (card.index, true, null);
+            if (out_node == null)
+                continue;
+            done.add (name);
+            if (!this.auto_switch || this.in_call || this.read_only)
+                continue;
+            debug ("audio devices: new output %s", out_node.name);
+            this.apply_node (out_node, null);
+            /* A Bluetooth microphone only exists on the headset profile:
+             * following it would drag music onto HFP. USB mics are fine. */
+            Node? in_node = card.is_usb () ? this.node_on_card (card.index, false, null) : null;
+            if (in_node != null)
+                this.apply_node (in_node, null);
+        }
+        foreach (var name in done)
+            this.appeared_cards.unset (name);
+    }
+
+    /* Per-app routing */
+
+    private const string APP_OUTPUT = "App output";
+    private const string APP_INPUT = "App input";
+    private const string APP_NAMES = "App names";
+    private const string APP_ICONS = "App icons";
+
+    /* Node currently realising a device id, or null when it is not available
+     * without a profile switch (per-app routes never switch profiles). */
+    private Node? node_for_id (string id, bool output)
+    {
+        if (id.has_prefix ("node|"))
+            return this.node_by_name (id.substring (5));
+        int bar = id.index_of ("|");
+        if (bar <= 0)
+            return null;
+        Card? card = this.card_by_name (id.substring (0, bar));
+        if (card == null)
+            return null;
+        string port = id.substring (bar + 1);
+        Node? n = this.node_on_card (card.index, output, port);
+        if (n == null)
+            return null;
+        if (n.active_port != null && n.active_port != port)
+            return null;
+        return n;
+    }
+
+    private void apply_app_routes ()
+    {
+        if (this.read_only)
+            return;
+        foreach (var st in this.streams) {
+            string? want = this.setting (st.output ? APP_OUTPUT : APP_INPUT, st.key);
+            Node? target = null;
+            if (want != null && want != "")
+                target = this.node_for_id (want, st.output);
+            if (target == null) {
+                /* Default (or the chosen device is away): follow the default */
+                if (want == null || want == "" || !this.moved_streams.contains (st.index))
+                    continue;
+                target = this.node_by_name (st.output ? this.default_sink : this.default_source);
+                if (target == null)
+                    continue;
+            }
+            if (target.index == st.node)
+                continue;
+            debug ("audio devices: moving %s stream of %s to %s", st.output ? "output" : "input", st.key, target.name);
+            this.moved_streams.add (st.index);
+            if (st.output)
+                this.context.move_sink_input_by_index (st.index, target.index, null);
+            else
+                this.context.move_source_output_by_index (st.index, target.index, null);
+        }
+    }
+
+    private Gee.HashSet<uint32> moved_streams = new Gee.HashSet<uint32> ();
+
+    public void set_app_device (Kind kind, string key, string id)
+    {
+        bool output = kind == Kind.OUTPUT;
+        string group = output ? APP_OUTPUT : APP_INPUT;
+        if (id == "" || id == "default") {
+            try {
+                this.settings.remove_key (group, key);
+            } catch (GLib.Error e) {
+            }
+        } else {
+            this.settings.set_string (group, key, id);
+        }
+        foreach (var st in this.streams) {
+            if (st.key == key) {
+                this.settings.set_string (APP_NAMES, key, st.name);
+                if (st.icon != "")
+                    this.settings.set_string (APP_ICONS, key, st.icon);
+            }
+        }
+        this.save_settings ();
+
+        if (!this.ready)
+            return;
+        /* "Default": put the running streams back on the default device */
+        if (id == "" || id == "default") {
+            Node? def = this.node_by_name (output ? this.default_sink : this.default_source);
+            foreach (var st in this.streams) {
+                if (st.key != key || st.output != output || def == null || st.node == def.index)
+                    continue;
+                if (output)
+                    this.context.move_sink_input_by_index (st.index, def.index, null);
+                else
+                    this.context.move_source_output_by_index (st.index, def.index, null);
+            }
+        }
+        this.last_signature = "";
+        this.queue_refresh ();
+    }
+
+    /* Apps playing or recording now, plus the remembered ones */
+    public string apps_json ()
+    {
+        var keys = new Gee.ArrayList<string> ();
+        var names = new HashTable<string, string> (str_hash, str_equal);
+        var icons = new HashTable<string, string> (str_hash, str_equal);
+        var playing = new Gee.HashSet<string> ();
+        var recording = new Gee.HashSet<string> ();
+
+        foreach (var st in this.streams) {
+            if (!keys.contains (st.key))
+                keys.add (st.key);
+            names.insert (st.key, st.name);
+            if (st.icon != "")
+                icons.insert (st.key, st.icon);
+            if (!st.corked)
+                (st.output ? playing : recording).add (st.key);
+            else if (!st.output)
+                recording.add (st.key);
+        }
+        foreach (var group in new string[] { APP_OUTPUT, APP_INPUT }) {
+            try {
+                foreach (var k in this.settings.get_keys (group))
+                    if (!keys.contains (k))
+                        keys.add (k);
+            } catch (GLib.Error e) {
+            }
+        }
+
+        var b = new StringBuilder ("[");
+        bool first = true;
+        foreach (var k in keys) {
+            string name = names.lookup (k) ?? this.setting (APP_NAMES, k) ?? k;
+            string icon = icons.lookup (k) ?? this.setting (APP_ICONS, k) ?? "";
+            if (!first)
+                b.append (",");
+            first = false;
+            b.append_printf ("{\"key\":\"%s\",\"name\":\"%s\",\"icon\":\"%s\",\"playing\":%s,\"recording\":%s,\"output\":\"%s\",\"input\":\"%s\"}",
+                             json_escape (k), json_escape (name), json_escape (icon),
+                             playing.contains (k) ? "true" : "false",
+                             recording.contains (k) ? "true" : "false",
+                             json_escape (this.setting (APP_OUTPUT, k) ?? "default"),
+                             json_escape (this.setting (APP_INPUT, k) ?? "default"));
+        }
+        b.append ("]");
+        return b.str;
+    }
+
+    /* Selection */
+
+    private static string profile_family (Card card, string profile)
+    {
+        if (card.is_bluetooth ()) {
+            if (profile.has_prefix ("a2dp"))
+                return "a2dp";
+            if (profile.has_prefix ("headset-head-unit") || profile.has_prefix ("handsfree") || profile.has_prefix ("headset_head_unit"))
+                return "hfp";
+            return profile;
+        }
+        int paren = profile.index_of (" (");
+        return paren > 0 ? profile.substring (0, paren) : profile;
+    }
+
+    private string? best_profile (Card card, CardPort port)
+    {
+        string family = profile_family (card, card.active_profile);
+
+        /* Keep the device of the other direction on this card if possible */
+        string? keep = null;
+        Node? other = this.node_on_card (card.index, !port.output, null);
+        if (other != null && other.active_port != null)
+            keep = strip_ucm_prefix (other.active_port);
+
+        string? best = null;
+        int64 best_score = int64.MIN;
+        foreach (var prof in port.profiles) {
+            if (!card.profile_available.lookup (prof))
+                continue;
+            int64 score = (int64) card.profile_priority.lookup (prof);
+            if (card.is_bluetooth ()) {
+                bool hfp = profile_family (card, prof) == "hfp";
+                /* Calls and microphones need the headset profile, music wants A2DP */
+                if ((this.in_call || !port.output) == hfp)
+                    score += (int64) 1 << 40;
+            } else if (profile_family (card, prof) == family) {
+                score += (int64) 1 << 40;
+            }
+            if (keep != null && prof.contains (keep))
+                score += (int64) 1 << 36;
+            if (score > best_score) {
+                best_score = score;
+                best = prof;
+            }
+        }
+        return best;
+    }
+
+    private void restore_call_headsets ()
+    {
+        foreach (var name in this.call_headsets) {
+            Card? card = this.card_by_name (name);
+            if (card == null || profile_family (card, card.active_profile) != "hfp")
+                continue;
+            string? best = null;
+            uint32 best_prio = 0;
+            foreach (var prof in card.profile_priority.get_keys ()) {
+                if (profile_family (card, prof) != "a2dp" || !card.profile_available.lookup (prof))
+                    continue;
+                uint32 prio = card.profile_priority.lookup (prof);
+                if (best == null || prio > best_prio) {
+                    best = prof;
+                    best_prio = prio;
+                }
+            }
+            if (best != null) {
+                debug ("audio devices: call ended, %s back to '%s'", card.name, best);
+                this.context.set_card_profile_by_index (card.index, best, this.profile_set_cb);
+            }
+        }
+        this.call_headsets.clear ();
+    }
+
+    private void apply_node (Node node, string? port)
+    {
+        if (this.read_only)
+            return;
+        if (port != null && node.active_port != port) {
+            if (node.output)
+                this.context.set_sink_port_by_name (node.name, port, null);
+            else
+                this.context.set_source_port_by_name (node.name, port, null);
+        }
+        if (node.output) {
+            if (this.default_sink != node.name)
+                this.context.set_default_sink (node.name, null);
+        } else {
+            if (this.default_source != node.name)
+                this.context.set_default_source (node.name, null);
+        }
+    }
+
+    private void process_pending ()
+    {
+        int64 now = GLib.get_monotonic_time ();
+        var done = new Gee.ArrayList<Pending> ();
+        foreach (var p in this.pending) {
+            Node? node = this.node_on_card (p.card, p.output, p.port);
+            if (node != null) {
+                debug ("audio devices: %s ready on %s", p.port, node.name);
+                this.apply_node (node, p.port);
+                done.add (p);
+            } else if (now > p.deadline) {
+                warning ("audio devices: %s did not appear after the profile switch", p.port);
+                done.add (p);
+            }
+        }
+        this.pending.remove_all (done);
+    }
+
+    private void select_card_port (Card card, CardPort port)
+    {
+        Node? node = this.node_on_card (card.index, port.output, port.name);
+        if (node != null) {
+            this.apply_node (node, port.name);
+            return;
+        }
+
+        string? profile = this.best_profile (card, port);
+        if (profile == null) {
+            warning ("audio devices: no usable profile for %s on %s", port.name, card.name);
+            return;
+        }
+
+        debug ("audio devices: switching %s to profile '%s' for %s", card.name, profile, port.name);
+        var p = new Pending ();
+        p.output = port.output;
+        p.card = card.index;
+        p.port = port.name;
+        p.deadline = GLib.get_monotonic_time () + 5 * TimeSpan.SECOND;
+        this.pending.add (p);
+        this.context.set_card_profile_by_index (card.index, profile, this.profile_set_cb);
+    }
+
+    private void profile_set_cb (Context c, int success)
+    {
+        if (success == 0)
+            warning ("audio devices: a card profile switch failed");
+        this.queue_refresh ();
+    }
+
+    public void select (Kind kind, string id)
+    {
+        if (!this.ready || this.read_only)
+            return;
+
+        bool output = kind == Kind.OUTPUT;
+
+        if (id.has_prefix ("node|")) {
+            Node? node = this.node_by_name (id.substring (5));
+            if (node != null)
+                this.apply_node (node, null);
+            return;
+        }
+
+        int bar = id.index_of ("|");
+        if (bar <= 0)
+            return;
+        Card? card = this.card_by_name (id.substring (0, bar));
+        if (card == null)
+            return;
+        string port_name = id.substring (bar + 1);
+        CardPort? port = null;
+        foreach (var p in card.ports)
+            if (p.name == port_name && p.output == output)
+                port = p;
+        if (port == null)
+            return;
+
+        this.select_card_port (card, port);
+
+        /* A Bluetooth headset chosen during a call takes the call's microphone too */
+        if (output && this.in_call && card.is_bluetooth ()) {
+            this.call_headsets.add (card.name);
+            foreach (var p in card.ports) {
+                if (!p.output && !p.unavailable) {
+                    var pend = new Pending ();
+                    pend.output = false;
+                    pend.card = card.index;
+                    pend.port = p.name;
+                    pend.deadline = GLib.get_monotonic_time () + 5 * TimeSpan.SECOND;
+                    this.pending.add (pend);
+                    break;
+                }
+            }
+            this.process_pending ();
+        }
+    }
+
+    /* JSON for Settings > Sound (the QML side parses the action state) */
+    private static string json_escape (string s)
+    {
+        var b = new StringBuilder ();
+        unichar c;
+        int i = 0;
+        while (s.get_next_char (ref i, out c)) {
+            switch (c) {
+                case '"': b.append ("\\\""); break;
+                case '\\': b.append ("\\\\"); break;
+                case '\n': b.append ("\\n"); break;
+                case '\r': b.append ("\\r"); break;
+                case '\t': b.append ("\\t"); break;
+                default:
+                    if (c < 0x20)
+                        b.append_printf ("\\u%04x", (uint) c);
+                    else
+                        b.append_unichar (c);
+                    break;
+            }
+        }
+        return b.str;
+    }
+
+    public string to_json (Kind kind)
+    {
+        var list = kind == Kind.OUTPUT ? this.outputs : this.inputs;
+        string active = kind == Kind.OUTPUT ? this.active_output : this.active_input;
+        var b = new StringBuilder ("[");
+        bool first = true;
+        foreach (var d in list) {
+            if (!first)
+                b.append (",");
+            first = false;
+            b.append_printf ("{\"id\":\"%s\",\"label\":\"%s\",\"icon\":\"%s\",\"active\":%s}",
+                             json_escape (d.id), json_escape (d.label), json_escape (d.icon),
+                             d.id == active ? "true" : "false");
+        }
+        b.append ("]");
+        return b.str;
+    }
+}
