 }
 
+// App drawer folders: an application's desktop entry may say
+//   X-Lomiri-Folder=Tools
+// and is then shown inside the drawer folder "Tools". The folder's (localised)
+// name and icon come from desktop-directories/Tools.directory (Name[xx]=, Icon=)
+// in the XDG data dirs, if present; otherwise the folder id is the name.
+static QString keyFileString(GKeyFile *kf, const char *key, bool localised)
+{
+    gchar *v = localised ? g_key_file_get_locale_string(kf, G_KEY_FILE_DESKTOP_GROUP, key, nullptr, nullptr)
+                         : g_key_file_get_string(kf, G_KEY_FILE_DESKTOP_GROUP, key, nullptr);
+    QString s = QString::fromUtf8(v).trimmed();
+    g_free(v);
+    return s;
+}
+
+static void readDrawerFolder(const QString &appId, UalWrapper::AppInfo &info)
+{
+    GKeyFile *kf = g_key_file_new();
+    QByteArray rel = QStringLiteral("applications/%1.desktop").arg(appId).toUtf8();
+    if (g_key_file_load_from_data_dirs(kf, rel.constData(), nullptr, G_KEY_FILE_NONE, nullptr)) {
+        info.folder = keyFileString(kf, "X-Lomiri-Folder", false);
+    }
+    g_key_file_free(kf);
+    if (info.folder.isEmpty()) {
+        return;
+    }
+    info.folderName = info.folder;
+    static const QRegularExpression safeId(QStringLiteral("^[A-Za-z0-9._-]+$"));
+    if (!safeId.match(info.folder).hasMatch()) {
+        return;
+    }
+    kf = g_key_file_new();
+    rel = QStringLiteral("desktop-directories/%1.directory").arg(info.folder).toUtf8();
+    if (g_key_file_load_from_data_dirs(kf, rel.constData(), nullptr, G_KEY_FILE_NONE, nullptr)) {
+        const QString name = keyFileString(kf, G_KEY_FILE_DESKTOP_KEY_NAME, true);
+        if (!name.isEmpty()) {
+            info.folderName = name;
+        }
+        info.folderIcon = keyFileString(kf, G_KEY_FILE_DESKTOP_KEY_ICON, false);
+    }
+    g_key_file_free(kf);
+}
