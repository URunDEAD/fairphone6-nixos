new file mode 100644
index 0000000..3c2d02c
--- /dev/null
+++ b/qml/Launcher/DrawerFolder.qml
@@ -0,0 +1,141 @@
+/*
+ * Copyright (C) 2026 Paul Schuldesz
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 3.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+import QtQuick 2.15
+import Lomiri.Components 1.3
+import Utils 0.1
+
+// An open app drawer folder (desktop key X-Lomiri-Folder): the folder's apps
+// in a panel above the drawer grid, with the drawer's own app delegate.
+// Tapping outside the panel, Escape, typing a search (search lists the apps
+// of folders directly) or closing the drawer closes it.
+Item {
+    id: root
+
+    property var appModel
+    property bool lightMode: false
+    property real delegateWidth: units.gu(10)
+    property alias delegate: grid.delegate
+
+    readonly property bool opened: state === "open"
+    // Kept while the close animation runs; cleared once hidden.
+    property string folder: ""
+    property string title: ""
+
+    function open(folderId, name, tile) {
+        folder = folderId;
+        title = name;
+        if (tile) {
+            var c = tile.mapToItem(root, tile.width / 2, tile.height / 2);
+            panel.originX = c.x;
+            panel.originY = c.y;
+        }
+        grid.positionViewAtBeginning();
+        state = "open";
+    }
+
+    function close() {
+        state = "";
+    }
+
+    visible: opacity > 0
+    enabled: opened
+    opacity: 0
+    onVisibleChanged: if (!visible) folder = ""
+
+    states: State {
+        name: "open"
+        PropertyChanges { target: root; opacity: 1 }
+        PropertyChanges { target: panel; progress: 1 }
+    }
+    transitions: Transition {
+        LomiriNumberAnimation { properties: "opacity,progress"; duration: LomiriAnimation.FastDuration }
+    }
+
+    // Tap outside the panel closes the folder.
+    MouseArea {
+        anchors.fill: parent
+        onClicked: root.close()
+        onWheel: wheel.accepted = true
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        color: root.lightMode ? Qt.rgba(0, 0, 0, 0.15) : Qt.rgba(0, 0, 0, 0.45)
+    }
+
+    Rectangle {
+        id: panel
+        objectName: "drawerFolderPanel"
+
+        readonly property int columns: Math.max(1, Math.min(4, grid.count,
+            Math.floor((root.width - units.gu(4)) / root.delegateWidth)))
+        readonly property int rows: Math.max(1, Math.ceil(grid.count / columns))
+        // Grows out of the folder tile.
+        property real originX: root.width / 2
+        property real originY: root.height / 2
+        property real progress: 0
+
+        width: columns * root.delegateWidth + units.gu(2)
+        height: Math.min(root.height - units.gu(6),
+                         titleLabel.height + units.gu(4) + rows * units.gu(11))
+        x: (root.width - width) / 2 + (originX - root.width / 2) * (1 - progress)
+        y: (root.height - height) / 2 + (originY - root.height / 2) * (1 - progress)
+        scale: 0.3 + 0.7 * progress
+        radius: units.gu(2)
+        color: root.lightMode ? LomiriColors.porcelain : LomiriColors.jet
+
+        // Taps on the panel itself do not close the folder.
+        MouseArea { anchors.fill: parent }
+
+        Label {
+            id: titleLabel
+            objectName: "drawerFolderTitle"
+            anchors { left: parent.left; right: parent.right; top: parent.top; margins: units.gu(1.5) }
+            horizontalAlignment: Text.AlignHCenter
+            elide: Text.ElideRight
+            fontSize: "large"
+            text: root.title
+        }
+
+        GridView {
+            id: grid
+            objectName: "drawerFolderAppList"
+            anchors {
+                top: titleLabel.bottom
+                topMargin: units.gu(1.5)
+                left: parent.left
+                leftMargin: units.gu(1)
+                right: parent.right
+                rightMargin: units.gu(1)
+                bottom: parent.bottom
+            }
+            clip: true
+            interactive: contentHeight > height
+            cellWidth: root.delegateWidth
+            cellHeight: units.gu(11)
+            currentIndex: -1
+            model: root.folder !== "" ? folderApps : null
+        }
+    }
+
+    AppDrawerProxyModel {
+        id: folderApps
+        source: root.appModel
+        folderFilter: root.folder
+        sortBy: AppDrawerProxyModel.SortByAToZ
+    }
+}
