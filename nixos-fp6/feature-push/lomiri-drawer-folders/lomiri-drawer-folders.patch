+import QtQuick 2.15
+import Lomiri.Components 1.3
+import Utils 0.1
+
+// Icon of an app drawer folder tile: the first four apps of the folder as
+// small icons on a translucent plate, or the folder's own Icon= (from its
+// desktop-directories/<folder>.directory) when it has one.
+Item {
+    id: root
+
+    property var appModel
+    property string folder
+    property string folderIcon
+    property bool lightMode: false
+
+    readonly property string iconSource: folderIcon === "" ? ""
+        : folderIcon.charAt(0) === "/" ? "file://" + folderIcon
+        : "image://theme/" + folderIcon
+
+    LomiriShape {
+        anchors.fill: parent
+        radius: "medium"
+        borderSource: 'undefined'
+        backgroundColor: root.lightMode ? Qt.rgba(0, 0, 0, 0.18) : Qt.rgba(1, 1, 1, 0.22)
+        source: Image {
+            asynchronous: true
+            sourceSize.width: root.width
+            source: root.iconSource
+        }
+        sourceFillMode: LomiriShape.PreserveAspectCrop
+    }
+
+    Grid {
+        anchors.centerIn: parent
+        visible: root.iconSource === ""
+        columns: 2
+        spacing: units.gu(0.5)
+
+        Repeater {
+            model: root.iconSource === "" ? folderApps : null
+            delegate: LomiriShape {
+                visible: index < 4
+                width: units.gu(2.25)
+                height: 7.5 / 8 * width
+                radius: "small"
+                borderSource: 'undefined'
+                source: Image {
+                    asynchronous: true
+                    sourceSize.width: units.gu(2.25)
+                    source: model.icon
+                }
+                sourceFillMode: LomiriShape.PreserveAspectCrop
+            }
+        }
+    }
+
+    AppDrawerProxyModel {
+        id: folderApps
+        source: root.appModel
+        folderFilter: root.folder
+        sortBy: AppDrawerProxyModel.SortByAToZ
+    }
+}
