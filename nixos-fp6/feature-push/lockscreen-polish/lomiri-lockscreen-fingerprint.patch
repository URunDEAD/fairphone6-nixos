+    // FP6 lockscreen-polish: the fingerprint sensor is in the power button
+    // on the right edge; hint there, above the cover page and the passcode
+    // screen (fingerprint unlock works on both), below the emergency sheet.
+    GSettings {
+        id: fp6Lockscreen
+        schema.id: "com.fairphone6.lockscreen"
+    }
+    GSettings {
+        id: fp6Bedtime
+        schema.id: "@FP6_BEDTIME_SCHEMA@"
+    }
+    Fp6FingerprintHint {
+        id: fp6FingerprintHint
+        anchors.fill: parent
+        z: 950
+        available: root.fingerprintActive && root.locked
+        lockedOut: root.fp6FingerprintLockedOut && root.locked
+        portrait: root.height > root.width && root.orientation !== Qt.InvertedPortraitOrientation
+        sensorCenter: fp6Lockscreen.fingerprintSensorCenter > 0 ? fp6Lockscreen.fingerprintSensorCenter : 0.443
+        sensorLength: fp6Lockscreen.fingerprintSensorLength > 0 ? fp6Lockscreen.fingerprintSensorLength : 0.075
+        textCue: fp6Lockscreen.fingerprintHintText !== false
+        haptics: fp6Lockscreen.fingerprintHaptics !== false
+        quiet: fp6Bedtime.bedtimeActive === true
+        coverProgress: coverPage.shown ? coverPage.showProgress : 0
+        passphrase: root.alphanumeric
