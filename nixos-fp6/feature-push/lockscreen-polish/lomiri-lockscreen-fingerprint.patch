diff --git a/qml/Greeter/Fp6FingerprintHint.qml b/qml/Greeter/Fp6FingerprintHint.qml
new file mode 100644
index 0000000..0fdf38b
--- /dev/null
+++ b/qml/Greeter/Fp6FingerprintHint.qml
@@ -0,0 +1,323 @@
+/*
