+
+    // where: "home", "lock" or "both".
+    function fp6Apply(uri, where) {
+        if (where === "lock") {
+            fp6Wallpapers.setLockWallpaper(uri);
+        } else if (where === "home") {
+            // Android-like: changing only the home screen keeps the lock
+            // screen as it was: pin the current home picture as the lock
+            // picture first (the stock code may delete its old copy).
+            if (!fp6Wallpapers.hasLockWallpaper) {
+                fp6PendingHome = uri;
+                fp6Wallpapers.setLockWallpaper(fp6HomeWallpaper);
+            } else {
+                Utilities.setBackground(uri);
+            }
+        } else {
+            Utilities.setBackground(uri);
+            fp6Wallpapers.clearLockWallpaper();
+        }
+    }
