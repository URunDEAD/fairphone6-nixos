+    // FP6 wallpapers (nixos-fp6/feature-push/lockscreen-polish): home and
+    // lock screen can differ. Home = the stock AccountsService
+    // BackgroundFile; lock = Fp6Wallpapers (a copy in the greeter data dir,
+    // none = same as home).
+    readonly property string fp6DefaultWallpaper: "file://@FP6_DEFAULT_WALLPAPER@"
+    readonly property string fp6HomeWallpaper: fp6Wallpapers.existingOr(welcomeBackground, fp6DefaultWallpaper)
