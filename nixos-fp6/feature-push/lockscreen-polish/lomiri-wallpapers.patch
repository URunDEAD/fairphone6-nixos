+
+// FP6 wallpapers (nixos-fp6/feature-push/lockscreen-polish): optional blur
+// and dim of the home-screen wallpaper (Wallpaper.qml fp6Blur / fp6Dim, set
+// by Stage.qml from com.fairphone6.lockscreen). The blur is cached: it is
+// computed once per image, not per frame. Nothing exists while both are 0.
+
+import QtQuick 2.15
+import QtGraphicalEffects 1.12
+
+Item {
+    id: root
+    property Item source
+    property real blur: 0   // 0..1
+    property real dim: 0    // 0..1
+    readonly property bool blurring: blur > 0 && source !== null
+
+    Loader {
+        anchors.fill: parent
+        active: root.blurring
+        sourceComponent: FastBlur {
+            source: root.source
+            radius: Math.round(16 + 48 * root.blur)
+            cached: true
+        }
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        color: "black"
+        opacity: Math.max(0, Math.min(0.8, root.dim))
+        visible: opacity > 0
+    }
+}
