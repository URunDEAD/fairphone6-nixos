+/* FP6 app permissions: the client's process as the socket shows it
+ * (SO_PEERCRED), for the session manager to tell apps apart. Set again after
+ * every merge of the client's own property list, so a client cannot choose
+ * it; PipeWire refuses later changes of an existing pipewire.* key anyway. */
+static void client_set_peer_pid(struct client *client)
+{
+	pid_t pid = 0;
+
+	if (client->source != NULL)
+		pid = get_client_pid(client, client->source->fd);
+	if (pid > 0)
+		pw_properties_setf(client->props, "pipewire.pulse.peer.pid", "%d", (int)pid);
+	else
+		pw_properties_set(client->props, "pipewire.pulse.peer.pid", NULL);
+}
