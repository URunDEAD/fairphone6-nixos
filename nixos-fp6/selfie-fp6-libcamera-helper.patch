+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <cmath>
+#include <iostream>
+#include "camera_sensor_helper.h"
+#include "test.h"
+using namespace libcamera;
+using namespace ipa;
+class Fp6SelfieSensorHelperTest : public Test
+{
+protected:
+	int run() override
+	{
+		auto sensor = CameraSensorHelperFactoryBase::create("fp6-s5kkd1");
+		if (!sensor)
+			return TestFail;
+		/* Exact kernel control minimum/default/maximum plus intermediate gains. */
+		for (double gain : { 1.0, 1.5, 2.0, 4.0, 8.0, 64.0 }) {
+			unsigned int code = static_cast<unsigned int>(gain * 32);
+			if (sensor->gainCode(gain) != code ||
+			    std::abs(sensor->gain(code) - gain) > 1e-8) {
+				std::cerr << "S5KKD1 gain code mismatch at " << gain << "x\n";
+				return TestFail;
+			}
+		}
+		return TestPass;
+	}
+};
+TEST_REGISTER(Fp6SelfieSensorHelperTest)
