+    // Preservation policy used by the real trustlet and D-Bus paths. A negative
+    // SET_ACTIVE_GROUP is never hidden by an unrelated successful enumeration.
+    enum class GroupLoad { Failed, Loaded, MissingEmpty };
+    struct Reply {
+        bool invoked = false;
+        std::uint32_t result = 0;
+        std::int32_t rc = 0;
+    };
+    inline GroupLoad ClassifyGroupReload(Reply selected, Reply enumerated,
+                                        std::span<const std::uint32_t> fids) {
+        if (!selected.invoked || selected.result != 0 || !enumerated.invoked
+            || enumerated.result != 0 || enumerated.rc < 0
+            || enumerated.rc > static_cast<std::int32_t>(MaxFingersPerGroup)
+            || fids.size() != static_cast<std::size_t>(enumerated.rc))
+            return GroupLoad::Failed;
+        for (std::size_t i = 0; i < fids.size(); ++i)
+            if (fids[i] == 0 || std::ranges::find(fids.first(i), fids[i]) != fids.first(i).end())
+                return GroupLoad::Failed;
+        if (selected.rc == 0) return GroupLoad::Loaded;
+        // Exact protocol case: absent namespace/group, followed by a successful
+        // zero enumeration. This is NOT permission to enroll by itself.
+        if (selected.rc == -2 && enumerated.rc == 0 && fids.empty())
+            return GroupLoad::MissingEmpty;
+        return GroupLoad::Failed;
+    }
+    inline std::string_view CheckEnrollmentName(const Map& map, Finger finger) {
+        if (!map.Trusted()) return "finger map is unreadable or incomplete; repair it before enrollment";
+        if (map.Has(finger)) return "finger is already mapped; explicit user-requested removal is required before replacement";
+        if (map.Full()) return "finger map is full; no existing finger was removed";
+        return {};
+    }
+    inline std::string_view CheckEnrollmentReload(Gid gid, bool mapTrusted,
+            bool mapMissing, std::span<const std::uint32_t> named,
+            GroupLoad load, std::span<const std::uint32_t> loaded,
+            bool allowEmptyUserGroup, bool originalNamespace) {
+        if (!mapTrusted) return "finger map is not fully trusted; nothing enrolled or deleted";
+        if (load == GroupLoad::Failed) return "group reload failed; nothing enrolled or deleted";
+        if (!GroupIsManaged(gid)) return "group zero is protected from enrollment";
+        if (load == GroupLoad::MissingEmpty) {
+            if (allowEmptyUserGroup && gid == 10000 && originalNamespace
+                && mapMissing && named.empty() && loaded.empty()) return {};
+            return "empty new group is not authorized: requires uid10000, absent map, original namespace and explicit opt-in";
+        }
+        for (auto fid : loaded)
+            if (!std::ranges::contains(named, fid))
+                return "unnamed template preserved; reconcile its name or request explicit deletion before enrollment";
+        for (auto fid : named)
+            if (!std::ranges::contains(loaded, fid))
+                return "mapped template missing from reloaded group; reconcile state before enrollment";
+        return {};
+    }
+
+    inline bool MayWriteStore(bool readOnly, bool explicitMutation) {
+        return !readOnly && explicitMutation;
+    }
+    inline bool MayDeleteTemplate(bool readOnly, bool deletionEnabled, bool explicitRemoval) {
+        return !readOnly && deletionEnabled && explicitRemoval;
+    }
+    inline bool MayCommitNewTemplate(std::uint32_t fid, std::span<const std::uint32_t> existing) {
+        return fid != 0 && !std::ranges::contains(existing, fid);
+    }
