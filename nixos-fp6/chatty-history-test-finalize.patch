 #include "chatty-message.h"
 #include "chatty-contact.h"
 #include "chatty-settings.h"
+
+/* GTask callbacks may run before the worker drops its last reference. */
+static void
+assert_finalize_async (gpointer object)
+{
+  GWeakRef weak;
+  gint64 deadline = g_get_monotonic_time () + 2 * G_TIME_SPAN_SECOND;
+  g_weak_ref_init (&weak, object);
+  g_object_unref (object);
+  do {
+    GObject *remaining = g_weak_ref_get (&weak);
+    if (!remaining) {
+      g_weak_ref_clear (&weak);
+      return;
+    }
+    g_object_unref (remaining);
+    while (g_main_context_iteration (NULL, FALSE));
+    g_usleep (1000);
+  } while (g_get_monotonic_time () < deadline);
+  g_weak_ref_clear (&weak);
+  g_error ("Object retained after asynchronous history completion");
+}
 
 typedef struct Message {
   ChattyChat *chat;
