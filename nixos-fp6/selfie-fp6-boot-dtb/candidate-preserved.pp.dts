  qcom,micbias2-microvolt = <1800000>;
  qcom,micbias3-microvolt = <1800000>;

  qcom,rx-device = <&wcd9378_rx>;
  qcom,tx-device = <&wcd9378_tx>;

  #sound-dai-cells = <1>;
 };

 thermal-zones {
  pm8008-thermal {
