         <0 338 4 0>,
         <0 339 4 0>,
         <0 340 4 0>,
         <0 341 4 0>,
         <0 342 4 0>,
         <0 343 4 0>,
         <0 344 4 0>,
         <0 345 4 0>,
         <0 395 4 0>,
         <0 396 4 0>,
         <0 397 4 0>,
         <0 398 4 0>,
         <0 399 4 0>,
         <0 400 4 0>,
         <0 401 4 0>,
         <0 402 4 0>,
         <0 403 4 0>,
