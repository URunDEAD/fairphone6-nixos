   reg = <0x0 0x400>;

   clocks = <&cpufreq_hw 1>;

   power-domains = <&cpu_pd4>;
   power-domain-names = "psci";

   enable-method = "psci";
   next-level-cache = <&l2_4>;
   capacity-dmips-mhz = <1670>;
   dynamic-power-coefficient = <264>;

   qcom,freq-domain = <&cpufreq_hw 1>;

