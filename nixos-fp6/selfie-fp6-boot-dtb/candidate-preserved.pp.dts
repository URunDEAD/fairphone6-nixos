    drive-strength = <2>;
    bias-disable;
   };

   ov13b10_reset_default: ov13b10-reset-default-state {
    pins = "gpio41";
    function = "gpio";
    drive-strength = <2>;
    bias-disable;
   };

   cci0_0_default: cci0-0-default-state {
    sda-pins {
     pins = "gpio88";
     function = "cci_i2c_sda";
