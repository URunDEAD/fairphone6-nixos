  pmiv0104_gpios: gpio@8800 {
   compatible = "qcom,pmiv0104-gpio", "qcom,spmi-gpio";
   reg = <0x8800>;
   gpio-controller;
   gpio-ranges = <&pmiv0104_gpios 0 0 10>;
   #gpio-cells = <2>;
   interrupt-controller;
   #interrupt-cells = <2>;
  };

  pmiv0104_eusb2_repeater: phy@fd00 {
   compatible = "qcom,pmiv0104-eusb2-repeater";
   reg = <0xfd00>;
   #phy-cells = <0>;
  };
 };
};
