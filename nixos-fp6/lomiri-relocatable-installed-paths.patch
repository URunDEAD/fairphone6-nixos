+"""Exercise real paths.h helpers before/after an ASCII store-reference rewrite."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+binary, prefix = map(Path, sys.argv[1:])
+env = os.environ.copy()
+for name in ('SNAP', 'LOMIRI_TESTING_DATADIR', 'LOMIRI_SOURCE_DIR', 'LOMIRI_BINARY_DIR'):
+    env.pop(name, None)
+subprocess.run([str(binary), str(prefix)], env=env, check=True)
+with tempfile.TemporaryDirectory(prefix='fp6-paths-') as temporary:
+    padding = len(str(prefix)) - len(temporary) - 1
+    assert padding > 0
+    relocated = Path(temporary) / ('r' * padding)
+    before, after = str(prefix).encode(), str(relocated).encode()
+    assert len(before) == len(after)
+    data = binary.read_bytes()
+    assert before in data, 'Configured paths must be ASCII references in the ELF'
+    target = relocated / 'bin' / binary.name
+    target.parent.mkdir(parents=True)
+    target.write_bytes(data.replace(before, after))
+    target.chmod(0o755)
+    qml = relocated / 'share/lomiri'
+    qml.mkdir(parents=True)
+    for name in ('ShellApplication.qml', 'ErrorApplication.qml'):
+        (qml / name).symlink_to(prefix / 'share/lomiri' / name)
+    subprocess.run([str(target), str(relocated)], env=env, check=True)
+print('Installed QML path relocation regression passed')
