+#include <algorithm>
+#include <paths.h>
+#include <QFileInfo>
+#include <iostream>
+
+int main(int argc, char **argv)
+{
+    QCoreApplication application(argc, argv);
+    if (argc != 2 || !isRunningInstalled()) {
+        std::cerr << "Installed binary was mistaken for a development build\n";
+        return 1;
+    }
+    const QString expected = QDir::cleanPath(QString::fromLocal8Bit(argv[1]) + "/share/lomiri");
+    if (QDir::cleanPath(qmlDirectory()) != expected || !overrideImportPaths().isEmpty()) {
+        std::cerr << "Wrong installed QML/import directory: " << qmlDirectory().toStdString() << '\n';
+        return 1;
+    }
+    for (const char *name : { "/ShellApplication.qml", "/ErrorApplication.qml" }) {
+        if (!QFileInfo::exists(expected + name)) {
+            std::cerr << "Installed QML file missing: " << name << '\n';
+            return 1;
+        }
+    }
+    std::cout << "Installed QML paths verified: " << expected.toStdString() << '\n';
+    return 0;
+}
