--- a/tests/matrix-disabled.c
+++ b/tests/matrix-disabled.c
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "config.h"
+#include <adwaita.h>
+#include "chatty-manager.h"
+#include "chatty-resources.h"
+#include "chatty-mm-account.h"
+#include "chatty-window.h"
+#include "dialogs/chatty-settings-dialog.h"
+
+#ifdef MATRIX_ENABLED
+#error This test exercises the Matrix-disabled variant
+#endif
+
+static void
+check_widget (GtkWidget *widget)
+{
+  const char *type = G_OBJECT_TYPE_NAME (widget);
+  const char *id = gtk_buildable_get_buildable_id (GTK_BUILDABLE (widget));
+  g_assert_false (g_str_has_prefix (type, "ChattyMaAccount") ||
+                  g_str_has_prefix (type, "ChattyMaChat") ||
+                  g_str_has_prefix (type, "ChattyMaKey") ||
+                  g_str_has_prefix (type, "ChattyMaUser"));
+  g_assert_cmpstr (type, !=, "ChattyVerificationPage");
+  if (g_strcmp0 (id, "matrix_row") == 0 ||
+      g_strcmp0 (id, "matrix_radio_button") == 0 ||
+      g_strcmp0 (id, "accounts_list_box") == 0)
+    g_assert_false (gtk_widget_get_visible (widget));
+  for (GtkWidget *child = gtk_widget_get_first_child (widget); child;
+       child = gtk_widget_get_next_sibling (child))
+    check_widget (child);
+}
+
+static void
+test_matrix_disabled_widgets (void)
+{
+  g_autoptr(AdwApplication) app = adw_application_new ("sm.puri.Chatty.MatrixDisabledTest", G_APPLICATION_NON_UNIQUE);
+  g_autoptr(GError) error = NULL;
+  ChattyManager *manager;
+  GtkWidget *window, *settings;
+
+  g_assert_true (g_application_register (G_APPLICATION (app), NULL, &error));
+  g_assert_no_error (error);
+  g_assert_nonnull (chatty_get_resource ());
+  manager = chatty_manager_get_default ();
+  g_assert_true (CHATTY_IS_MM_ACCOUNT (chatty_manager_get_mm_account (manager)));
+  g_assert_null (chatty_manager_matrix_client_new (manager));
+  g_assert_false (chatty_manager_has_matrix_with_id (manager, "@test:example.invalid"));
+
+  window = chatty_window_new (GTK_APPLICATION (app));
+  gtk_window_present (GTK_WINDOW (window));
+  settings = g_object_ref_sink (chatty_settings_dialog_new (GTK_WINDOW (window)));
+  adw_dialog_present (ADW_DIALOG (settings), window);
+  while (g_main_context_iteration (NULL, FALSE));
+  check_widget (window);
+  check_widget (settings);
+  adw_dialog_force_close (ADW_DIALOG (settings));
+  g_object_unref (settings);
+  gtk_window_destroy (GTK_WINDOW (window));
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  gtk_init ();
+  /* Missing desktop/modem services in the isolated test bus are warnings. */
+  g_log_set_always_fatal (G_LOG_FATAL_MASK | G_LOG_LEVEL_CRITICAL);
+  adw_init ();
+  g_test_add_func ("/chatty/matrix-disabled/shared-widgets-and-sms-account", test_matrix_disabled_widgets);
+  return g_test_run ();
+}
