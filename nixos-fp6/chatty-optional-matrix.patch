--- a/src/filter-matrix-resources.py
+++ b/src/filter-matrix-resources.py
@@ -0,0 +1,23 @@
+#!/usr/bin/env python3
+"""Remove unavailable Matrix widget subtrees; keep resource paths stable."""
+import sys
+from pathlib import Path
+import xml.etree.ElementTree as ET
+inputs, outputs = sys.argv[1:5], sys.argv[5:9]
+types = {'ChattyVerificationPage', 'ChattyMaChatInfo', 'ChattyMaAccountDetails'}
+for source, destination in zip(inputs[1:], outputs[1:]):
+    tree = ET.parse(source)
+    for parent in tree.iter():
+        for child in list(parent):
+            if child.tag == 'child' and any(node.get('class') in types for node in child.iter('object')):
+                # The removed object is the direct child, never its enclosing UI.
+                if next(iter(child), None) is not None and child[0].get('class') in types:
+                    parent.remove(child)
+    tree.write(destination, encoding='utf-8', xml_declaration=True)
+tree = ET.parse(inputs[0])
+for node in tree.iter('file'):
+    for source, destination in zip(inputs[1:], outputs[1:]):
+        if node.text == 'ui/' + Path(source).name:
+            node.set('alias', node.text)
+            node.text = Path(destination).name
+tree.write(outputs[0], encoding='utf-8', xml_declaration=True)
