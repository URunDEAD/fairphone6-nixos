@@ -69,6 +91,9 @@ int Af::configure(IPAContext &context,
 	context.activeState.knobs.focus_sweep = false;
 	context.activeState.knobs.focus_pos = 0;
 	context.configuration.focus.skip = kSettleSkipLong;
+	waitStable_ = false;
+	failed_ = false;
+	window_ = kDefaultWindow;
 
 	/*
 	 * Start focusing as soon as the camera streams. Applications that do
@@ -110,16 +135,87 @@ void Af::queueRequest(typename Module::Context &context,
 			<< "Setting focus position to " << lensPosition.value();
 	}
 
+	const auto &metering = controls.get(controls::AfMetering);
+	const auto &windows = controls.get(controls::AfWindows);
+	if (metering.has_value() && metering.value() == controls::AfMeteringAuto)
+		setWindow(context, nullptr);
+	else if (windows.has_value() && !windows->empty() &&
+		 (metering.value_or(controls::AfMeteringWindows) ==
+		  controls::AfMeteringWindows))
+		setWindow(context, &(*windows)[0]);
+
+	/*
+	 * A trigger starts a sweep in auto mode and also in continuous mode
+	 * (tap to focus: focus on the given window now rather than waiting
+	 * for a scene change); cancel stops a running sweep where it is.
+	 */
 	const auto &afTrigger = controls.get(controls::AfTrigger);
 	if (afTrigger.has_value() &&
-	    context.activeState.knobs.af_mode == controls::AfModeAuto) {
-		if (afTrigger.value() == controls::AfTriggerStart)
+	    context.activeState.knobs.af_mode != controls::AfModeManual) {
+		if (afTrigger.value() == controls::AfTriggerStart) {
 			restart(context);
-		else
+		} else if (context.activeState.knobs.focus_sweep.value_or(false)) {
 			context.activeState.knobs.focus_sweep = false;
+			context.configuration.focus.settled = false;
+			waitStable_ = false;
+		}
