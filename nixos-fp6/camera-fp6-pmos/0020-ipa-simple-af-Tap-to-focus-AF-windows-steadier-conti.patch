+/*
+ * Set the sharpness window from an AfWindows rectangle in sensor output
+ * pixels, or back to the default centre window. Tiny windows are grown
+ * around their centre: too few samples make the sharpness metric noisy.
+ */
+void Af::setWindow(IPAContext &context, const Rectangle *window)
+{
+	if (!window) {
+		if (window_ != kDefaultWindow)
+			LOG(IPASoftAutoFocus, Debug) << "AF window: default";
+		window_ = kDefaultWindow;
+		return;
+	}
+
+	const Size &size = context.sensorInfo.outputSize;
+	if (size.isNull() || window->isNull())
+		return;
+
+	auto edge = [](int64_t v, unsigned int full) {
+		return static_cast<int>(std::clamp<int64_t>(v * 1024 / full, 0, 1024));
+	};
+	int l = edge(window->x, size.width);
+	int t = edge(window->y, size.height);
+	int r = edge(static_cast<int64_t>(window->x) + window->width, size.width);
+	int b = edge(static_cast<int64_t>(window->y) + window->height, size.height);
+
+	auto grow = [](int &lo, int &hi) {
+		const int min = kMinWindow;
+		if (hi - lo >= min)
+			return;
+		const int c = std::clamp((lo + hi) / 2, min / 2, 1024 - min / 2);
+		lo = c - min / 2;
+		hi = c + min / 2;
+	};
+	grow(l, r);
+	grow(t, b);
+
+	std::array<uint16_t, 4> w = { static_cast<uint16_t>(l), static_cast<uint16_t>(t),
+				      static_cast<uint16_t>(r), static_cast<uint16_t>(b) };
+	if (w != window_)
+		LOG(IPASoftAutoFocus, Debug)
+			<< "AF window: " << l << "," << t << " - " << r << "," << b
+			<< " /1024 from " << window->toString();
+	window_ = w;
+}
+
+void Af::prepare([[maybe_unused]] IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 DebayerParams *params)
+{
+	params->afWindow = window_;
+}
+
 void Af::updateFocus(IPAContext &context, IPAFrameContext &frameContext,
 		     [[maybe_unused]] double exposureMSV)
 {
@@ -144,6 +240,9 @@ void Af::restart(IPAContext &context)
 	focus.skip = kSettleSkipLong;
 	focus.settled = false;
 	focus.lossCount = 0;
+	waitStable_ = false;
+	sharpnessMin_ = UINT64_MAX;
+	failed_ = false;
 	context.activeState.knobs.focus_pos = 0;
 	context.activeState.knobs.focus_sweep = true;
 	LOG(IPASoftAutoFocus, Info) << "Starting focus sweep";
@@ -190,25 +289,58 @@ void Af::step(IPAContext &context, double &focus_pos, uint64_t sharp, bool &swee
 			return;
 		}
 
+		if (waitStable_) {
+			/*
+			 * The scene changed: wait for it to hold still (the
+			 * user stopped moving the phone) before sweeping, so
+			 * the sweep does not measure a moving target.
+			 */
+			const bool stable = utils::abs_diff(sharp, prevSharp_) <=
+					    prevSharp_ * kStableThreshold;
+			prevSharp_ = sharp;
+			stableCount_ = stable ? stableCount_ + 1 : 0;
+			if (stableCount_ < kStableFrames && ++waitFrames_ < kStableTimeout)
+				return;
+
+			LOG(IPASoftAutoFocus, Info)
+				<< "Scene stable after " << waitFrames_ << " frames";
+			restart(context);
+			return;
+		}
+
 		if (++focus.lossCount < kFocusLossFrames)
 			return;
 
 		LOG(IPASoftAutoFocus, Info)
 			<< "Focus lost: " << sharp << " vs "
 			<< focus.sharpness_max;
-		restart(context);
+		waitStable_ = true;
+		prevSharp_ = sharp;
+		stableCount_ = 0;
+		waitFrames_ = 0;
 		return;
 	}
 
+	if (focus.step == kCoarseStep)
+		sharpnessMin_ = std::min(sharpnessMin_, sharp);
+
 	if (sharp > focus.sharpness_max) {
 		focus.sharpness_max = sharp;
 		focus.focus_max_pos = focus_pos;
 	}
 
+	/*
+	 * The coarse sweep always covers the whole travel: stopping after the
+	 * first peak would lock onto the background (swept first, from the
+	 * infinity end) behind a closer subject.
+	 */
 	focus_pos += focus.step;
 	if (focus_pos > focus.start && focus_pos < focus.stop)
 		return;
 
+	if (focus.step == kCoarseStep)
+		failed_ = focus.sharpness_max < sharpnessMin_ * kFlatSweepRatio;
+
 	/* Sweep phase over, narrow the range around the best position. */
 	focus.start = std::clamp(focus.focus_max_pos - focus.step, 0.0, 100.0);
 	focus.stop = std::clamp(focus.focus_max_pos + focus.step, 0.0, 100.0);
@@ -232,7 +364,8 @@ void Af::step(IPAContext &context, double &focus_pos, uint64_t sharp, bool &swee
 	focus.settled = false;
 	LOG(IPASoftAutoFocus, Info)
 		<< "Sweep end. Best focus: " << focus.focus_max_pos
-		<< " after " << steps_ << " frames";
+		<< " after " << steps_ << " frames"
+		<< (failed_ ? " (no clear peak)" : "");
 }
 
 void Af::process(IPAContext &context,
@@ -254,10 +387,13 @@ void Af::process(IPAContext &context,
 	updateFocus(context, frameContext, 0);
 
 	int32_t afState = controls::AfStateIdle;
-	if (context.activeState.knobs.af_mode != controls::AfModeManual)
-		afState = context.activeState.knobs.focus_sweep.value()
-				  ? controls::AfStateScanning
-				  : controls::AfStateFocused;
+	if (context.activeState.knobs.af_mode != controls::AfModeManual) {
+		if (context.activeState.knobs.focus_sweep.value())
+			afState = controls::AfStateScanning;
+		else
+			afState = failed_ ? controls::AfStateFailed
+					  : controls::AfStateFocused;
+	}
 
 	metadata.set(controls::AfState, afState);
 	metadata.set(controls::LensPosition,
