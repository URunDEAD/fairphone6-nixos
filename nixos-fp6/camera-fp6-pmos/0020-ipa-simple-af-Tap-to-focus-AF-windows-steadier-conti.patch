From b972240e622608a3225fac36f30f2ed1e7470e87 Mon Sep 17 00:00:00 2001
From: Paul Schuldesz <paulschuldesz@gmail.com>
Date: Mon, 26 Oct 2026 16:42:20 +0200
Subject: [PATCH 20/21] ipa: simple: af: Tap to focus, AF windows, steadier
 continuous AF

* AfTrigger start/cancel now also work in continuous mode, so an
  application can request focus on demand (tap to focus) without
  leaving continuous AF.
* Support AfMetering/AfWindows: the first window (sensor output pixels)
  becomes the sharpness window, grown to at least 1/8 of the frame so
  the metric does not get noisy; AfMeteringAuto restores the centre.
* Continuous AF no longer re-sweeps while the scene is still changing:
  after focus loss it waits until consecutive stats frames agree within
  12% for 3 frames (at most 30 frames) and only then sweeps, instead of
  sweeping a moving scene and settling on a wrong position.
* A sweep whose maximum is within 15% of its minimum (flat, textureless
  scene) reports AfStateFailed instead of AfStateFocused.
---
 src/ipa/simple/algorithms/af.cpp | 158 ++++++++++++++++++++++++++++---
 src/ipa/simple/algorithms/af.h   |  24 +++++
 2 files changed, 171 insertions(+), 11 deletions(-)

diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
index 6c951038..fb2619ca 100644
--- a/src/ipa/simple/algorithms/af.cpp
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -35,7 +35,21 @@ constexpr uint32_t kSettleSkipLong = 3;
 /* Relative sharpness change that makes a settled scene worth re-focusing. */
 constexpr double kFocusLossThreshold = 0.3;
 /* Consecutive stats frames that change must persist for before re-focusing. */
-constexpr uint32_t kFocusLossFrames = 4;
+constexpr uint32_t kFocusLossFrames = 3;
+/*
+ * After a scene change, continuous AF waits until consecutive stats frames
+ * agree within kStableThreshold for kStableFrames frames (the user stopped
+ * panning) before sweeping, or kStableTimeout frames at most.
+ */
+constexpr double kStableThreshold = 0.12;
+constexpr uint32_t kStableFrames = 3;
+constexpr uint32_t kStableTimeout = 30;
+/* A sweep whose maximum is within this ratio of its minimum found no peak. */
+constexpr double kFlatSweepRatio = 1.15;
+/* Smallest AF window edge, in 1/1024 of the frame. */
+constexpr unsigned int kMinWindow = 128;
+/* The default AF window: the centre fifth of the frame. */
+constexpr std::array<uint16_t, 4> kDefaultWindow = { 410, 410, 614, 614 };
 /*
  * Focus continuously by default: applications that know nothing about AF never
  * send an AfMode or an AfTrigger, and they are the ones this exists for.
@@ -45,7 +59,9 @@ constexpr int32_t kDefaultAfMode = controls::AfModeContinuous;
 } /* namespace */
 
 Af::Af()
-	: steps_(0)
+	: steps_(0), waitStable_(false), prevSharp_(0), stableCount_(0),
+	  waitFrames_(0), sharpnessMin_(0), failed_(false),
+	  window_(kDefaultWindow)
 {
 }
 
