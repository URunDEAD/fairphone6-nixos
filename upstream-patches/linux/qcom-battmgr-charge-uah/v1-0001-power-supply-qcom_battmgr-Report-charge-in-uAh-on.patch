From b1eb0d979d01cb20d180174dfd657eee29b3efeb Mon Sep 17 00:00:00 2001
From: Paul Schuldesz <paulschuldesz@gmail.com>
Date: Mon, 26 Oct 2026 15:26:28 +0200
Subject: [PATCH v1 1/1] power: supply: qcom_battmgr: Report charge in uAh on
 SM8350/SM8550 variants
To: Sebastian Reichel <sre@kernel.org>
Cc: linux-arm-msm@vger.kernel.org,
    linux-pm@vger.kernel.org,
    linux-kernel@vger.kernel.org

On the SM8350 and SM8550 pmic_glink variants battmgr->unit is never
initialised: only the SC8280XP-style battery info response sets it. It
therefore stays at QCOM_BATTMGR_UNIT_mWh (0), and charge_full and
charge_full_design, which these variants advertise, always return
-ENODATA. There is also no charge_now or energy_now, so userspace such
as UPower reports an energy of 0 Wh and cannot estimate the time to
empty or full.

The property interface of these variants reports BATT_CHG_FULL,
BATT_CHG_FULL_DESIGN and BATT_CHG_COUNTER in uAh. Set the unit to mAh
for them, and expose charge_now from the battery charge counter.

On the Fairphone 6 (qcom,milos-pmic-glink with the qcom,sm8550-pmic-glink
fallback) this gives charge_full = 4517000 uAh for the 4415 mAh design
cell, and charge_now follows charge_counter. Before the change both
properties returned "No data available".

Only tested on the SM8550 variant (Fairphone 6). The SM8350 fallback is
assumed to use the same units because it shares the property interface.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/power/supply/qcom_battmgr.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 7716eb9e1aff..f93b092d66c4 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -439,6 +439,7 @@ static const u8 sm8350_bat_prop_map[] = {
 	[POWER_SUPPLY_PROP_TEMP] = BATT_TEMP,
 	[POWER_SUPPLY_PROP_TECHNOLOGY] = BATT_TECHNOLOGY,
 	[POWER_SUPPLY_PROP_CHARGE_COUNTER] =  BATT_CHG_COUNTER,
+	[POWER_SUPPLY_PROP_CHARGE_NOW] = BATT_CHG_COUNTER,
 	[POWER_SUPPLY_PROP_CYCLE_COUNT] = BATT_CYCLE_COUNT,
 	[POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN] =  BATT_CHG_FULL_DESIGN,
 	[POWER_SUPPLY_PROP_CHARGE_FULL] = BATT_CHG_FULL,
@@ -583,7 +584,11 @@ static int qcom_battmgr_bat_get_property(struct power_supply *psy,
 	case POWER_SUPPLY_PROP_CHARGE_NOW:
 		if (unit != QCOM_BATTMGR_UNIT_mAh)
 			return -ENODATA;
-		val->intval = battmgr->status.capacity;
+		if (battmgr->variant == QCOM_BATTMGR_SM8350 ||
+		    battmgr->variant == QCOM_BATTMGR_SM8550)
+			val->intval = battmgr->info.charge_count;
+		else
+			val->intval = battmgr->status.capacity;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_COUNTER:
 		val->intval = battmgr->info.charge_count;
@@ -876,6 +881,7 @@ static const enum power_supply_property sm8350_bat_props[] = {
 	POWER_SUPPLY_PROP_TEMP,
 	POWER_SUPPLY_PROP_TECHNOLOGY,
 	POWER_SUPPLY_PROP_CHARGE_COUNTER,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
 	POWER_SUPPLY_PROP_CYCLE_COUNT,
 	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
 	POWER_SUPPLY_PROP_CHARGE_FULL,
@@ -908,6 +914,7 @@ static const enum power_supply_property sm8550_bat_props[] = {
 	POWER_SUPPLY_PROP_TEMP,
 	POWER_SUPPLY_PROP_TECHNOLOGY,
 	POWER_SUPPLY_PROP_CHARGE_COUNTER,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
 	POWER_SUPPLY_PROP_CYCLE_COUNT,
 	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
 	POWER_SUPPLY_PROP_CHARGE_FULL,
@@ -1658,6 +1665,16 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 	else
 		battmgr->variant = QCOM_BATTMGR_SM8350;
 
+	/*
+	 * The SM8350-family property interface reports CHG_FULL, CHG_FULL_DESIGN
+	 * and CHG_COUNTER in uAh. battmgr->unit is otherwise only filled in by
+	 * the SC8280XP-style info response, so it stayed at mWh (0) and every
+	 * listed charge_* property returned -ENODATA (observed on FP6/milos).
+	 */
+	if (battmgr->variant == QCOM_BATTMGR_SM8350 ||
+	    battmgr->variant == QCOM_BATTMGR_SM8550)
+		battmgr->unit = QCOM_BATTMGR_UNIT_mAh;
+
 	ret = qcom_battmgr_charge_control_thresholds_init(battmgr);
 	if (ret < 0)
 		return dev_err_probe(dev, ret,
-- 
