From 885c7af1119fcb2b5188c077ff1c105123a5b8e8 Mon Sep 17 00:00:00 2001
From: Paul Schuldesz <paulschuldesz@gmail.com>
Date: Mon, 26 Oct 2026 15:26:29 +0200
Subject: [PATCH v1 1/1] iio: light: stk3310: Do not enable proximity
 interrupts without an IRQ
To: Jonathan Cameron <jic23@kernel.org>
Cc: David Lechner <dlechner@baylibre.com>,
    Nuno Sá <nuno.sa@analog.com>,
    Andy Shevchenko <andy@kernel.org>,
    linux-iio@vger.kernel.org,
    linux-kernel@vger.kernel.org

The probe accepts devices without an interrupt (client->irq <= 0) and
then only skips requesting the IRQ. stk3310_init() still enables the
proximity interrupt in the chip unconditionally, and the channels keep
advertising threshold events that can never be delivered. Writing the
event enable attribute also re-enables INT_PS on a line that is not
connected.

For IRQ-less devices:
- only enable the proximity interrupt in stk3310_init() when an IRQ is
  present,
- register a copy of the channel specs without event specs, so no event
  attributes are created (the shared chip_info channel arrays stay
  unchanged for devices with an IRQ),
- report the event as disabled without touching the hardware, and
  reject attempts to enable it with -EOPNOTSUPP.

Devices with an interrupt keep the existing behaviour.

Tested on the Fairphone 6, whose STK36C61 is wired without an interrupt
line: proximity (0 -> ~115 when covered) and ambient light readings work
with iio-sensor-proxy polling. That kernel also carried a local,
unsubmitted retry patch for the bit-banged i2c-gpio bus the sensor
sits on.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/iio/light/stk3310.c | 42 ++++++++++++++++++++++++++++++-------
 1 file changed, 35 insertions(+), 7 deletions(-)

diff --git a/drivers/iio/light/stk3310.c b/drivers/iio/light/stk3310.c
index 0a16e326e939..39e25cfb7e3a 100644
--- a/drivers/iio/light/stk3310.c
+++ b/drivers/iio/light/stk3310.c
@@ -18,6 +18,7 @@
 #include <linux/pm.h>
 #include <linux/property.h>
 #include <linux/regmap.h>
+#include <linux/slab.h>
 #include <linux/sprintf.h>
 #include <linux/sysfs.h>
 #include <linux/types.h>
@@ -398,6 +399,10 @@ static int stk3310_read_event_config(struct iio_dev *indio_dev,
 	int ret;
 	struct stk3310_data *data = iio_priv(indio_dev);
 
+	/* An IRQ-less polling device cannot deliver threshold events. */
+	if (data->client->irq <= 0)
+		return 0;
+
 	ret = regmap_field_read(data->reg_int_ps, &event_val);
 	if (ret < 0)
 		return ret;
@@ -415,6 +420,10 @@ static int stk3310_write_event_config(struct iio_dev *indio_dev,
 	struct stk3310_data *data = iio_priv(indio_dev);
 	struct i2c_client *client = data->client;
 
+	/* Do not re-enable an unconnected interrupt through the event API. */
+	if (client->irq <= 0)
+		return -EOPNOTSUPP;
+
 	/* Set INT_PS value */
 	mutex_lock(&data->lock);
 	ret = regmap_field_write(data->reg_int_ps, state);
@@ -618,14 +627,15 @@ static int stk3310_init(struct iio_dev *indio_dev)
 		return ret;
 	}
 
-	/* Enable PS interrupts */
-	ret = regmap_field_write(data->reg_int_ps, STK3310_PSINT_EN);
-	if (ret < 0) {
-		dev_err(&client->dev, "failed to enable interrupts!\n");
-		return ret;
+	/* Enable PS interrupts only when an IRQ can deliver them. */
+	if (client->irq > 0) {
+		ret = regmap_field_write(data->reg_int_ps, STK3310_PSINT_EN);
+		if (ret < 0) {
+			dev_err(&client->dev, "failed to enable interrupts!\n");
+			return ret;
+		}
+		data->ps_int_enabled = true;
 	}
-
-	data->ps_int_enabled = true;
 	data->ps_thdh = STK3310_PS_MAX_VAL;
 
 	return 0;
@@ -758,6 +768,24 @@ static int stk3310_probe(struct i2c_client *client)
 	indio_dev->channels = chip_info->channels;
 	indio_dev->num_channels = chip_info->num_channels;
 
+	if (client->irq <= 0) {
+		struct iio_chan_spec *channels;
+		unsigned int i;
+
+		/* Keep chip-global channel descriptions unchanged for IRQ users. */
+		channels = devm_kmemdup(&client->dev, chip_info->channels,
+					array_size(chip_info->num_channels,
+						   sizeof(*channels)),
+					GFP_KERNEL);
+		if (!channels)
+			return -ENOMEM;
+		for (i = 0; i < chip_info->num_channels; i++) {
+			channels[i].event_spec = NULL;
+			channels[i].num_event_specs = 0;
+		}
+		indio_dev->channels = channels;
+	}
+
 	ret = stk3310_init(indio_dev);
 	if (ret < 0)
 		return ret;
-- 
